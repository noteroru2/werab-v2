{
  // CANDIDATE ONLY: Astro 5 + @astrojs/cloudflare v12. DO NOT COPY TO REPOSITORY ROOT UNTIL TESTED.
  // Put a verified Wrangler config in root after npm lock refresh and build.
  "name": "werab-v2",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  "previews": {
    "vars": {
      "SEO_PREVIEW": "1"
    }
  }
}
