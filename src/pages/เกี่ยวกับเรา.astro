---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import CTA from '../components/CTA.astro';
import { BUSINESS_FACTS, getDisplayLine, getDisplayPhone } from '../config/business';
import { resolveSeo } from '../lib/seo/resolve';

const seo = resolveSeo('/เกี่ยวกับเรา/');
const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'เกี่ยวกับเรา', url: '/เกี่ยวกับเรา/' }
];
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={breadcrumbs}>
  <section class="commercial-hero">
    <div class="container container-narrow">
      <Breadcrumb items={breadcrumbs} />
      <div class="commercial-hero-content" style="text-align:center;">
        <span class="badge badge-accent" style="margin-bottom:.75rem;">ABOUT</span>
        <h1 class="hero-h1">{seo.h1}</h1>
        <p class="hero-lead-text">
          {BUSINESS_FACTS.VERIFIED.brandName} จัดทำข้อมูลสำหรับผู้ที่ต้องการขายสินค้าไอทีมือสอง โดยเน้นให้รู้ว่าต้องส่งข้อมูลอะไร ราคาเปลี่ยนจากอะไร และควรตรวจอะไรให้ชัดก่อนตกลงซื้อขาย
        </p>
      </div>
    </div>
  </section>

  <TrustBar />

  <section class="commercial-section section-white">
    <div class="container container-narrow">
      <div class="comm-card">
        <h2>ใครดูแลข้อมูลการประเมินบนเว็บไซต์</h2>
        <p>
          ผู้ดูแลการประเมินที่ระบุในเว็บไซต์คือ <strong>{BUSINESS_FACTS.VERIFIED.contactPerson}</strong> ภายใต้แบรนด์ <strong>{BUSINESS_FACTS.VERIFIED.brandName}</strong>
          ช่องทางหลักที่ใช้ติดต่อคือ LINE <strong>{getDisplayLine()}</strong> และโทรศัพท์ <strong>{getDisplayPhone()}</strong>
        </p>
        <p>
          เราแสดงข้อมูลผู้ดูแลและช่องทางติดต่อให้ตรงกันในหน้าบริการหลัก เพื่อให้ผู้ขายตรวจสอบได้ว่าเนื้อหาที่อ่านเชื่อมกับบริการใดและติดต่อใครเมื่อมีคำถาม
        </p>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container container-narrow">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เราใช้ความรู้แบบไหนในการประเมิน</h2>
          <p>การประเมินสินค้าไอทีมือสองไม่ควรดูเพียงชื่อยี่ห้อหรือปีที่ซื้อ เพราะรุ่นเดียวกันอาจมี Configuration และสภาพต่างกันมาก</p>
          <ul>
            <li>Notebook และคอม: รุ่น CPU, GPU, RAM, SSD และชิ้นส่วนปัจจุบัน</li>
            <li>MacBook, iPhone และ iPad: รุ่นย่อย ความจุ แบตเตอรี่ สภาพจอ ระบบล็อกและประวัติซ่อมที่ทราบ</li>
            <li>กล้อง: Body, Lens, Sensor, Shutter, แบตเตอรี่ อุปกรณ์ และสภาพชิ้นส่วนสำคัญ</li>
          </ul>
          <p>หน้าหมวดสินค้าหลักจึงอธิบายวิธีดูรุ่นและจุดตรวจเฉพาะประเภท ไม่ใช้คำตอบเดียวกับสินค้าทุกชนิด</p>
        </div>

        <div class="comm-card">
          <h2>ราคาบนแชทกับราคาสุดท้ายต่างกันอย่างไร</h2>
          <p>รูปและข้อมูลช่วยให้ประเมินช่วงราคาได้ก่อน แต่ไม่สามารถยืนยันรายละเอียดที่มองไม่เห็นจากภาพทั้งหมด</p>
          <p>ราคาสุดท้ายจึงควรยืนยันหลังตรวจว่ารุ่น สเปก การทำงาน ตำหนิ และอุปกรณ์ตรงกับข้อมูลที่ใช้ประเมินหรือไม่</p>
          <p>หากมีจุดที่ทำให้ราคาเปลี่ยน ควรอธิบายจากสิ่งที่ตรวจพบ เช่น สเปกไม่ตรง แบตเตอรี่เสื่อม จอมีปัญหา อุปกรณ์ขาด หรือเครื่องมีประวัติซ่อมที่มีผลต่อมูลค่า</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container container-narrow">
      <div class="comm-card">
        <h2>สิ่งที่เว็บไซต์นี้ตั้งใจช่วยผู้ขาย</h2>
        <ol>
          <li>ระบุรุ่นและสเปกให้ถูกก่อนเปรียบเทียบราคา</li>
          <li>เข้าใจว่าตำหนิและอุปกรณ์มีผลต่อมูลค่าอย่างไร</li>
          <li>เตรียมรูปและข้อมูลที่ใช้ประเมินได้จริง</li>
          <li>แยกการประเมินออนไลน์ออกจากการยืนยันราคาหลังตรวจสินค้า</li>
          <li>หลีกเลี่ยงการส่งข้อมูลลับที่ไม่จำเป็น เช่น Password, PIN หรือ OTP</li>
        </ol>
        <div class="local-links-container" style="margin-top:1.25rem;">
          <a href="/เช็กราคาก่อนขาย/" class="local-link-chip">วิธีเช็กราคาก่อนขาย</a>
          <a href="/ความน่าเชื่อถือ/" class="local-link-chip">มาตรฐานการประเมินและหลักฐาน</a>
          <a href="/contact/" class="local-link-chip">ช่องทางติดต่อ</a>
          <a href="/privacy-policy/" class="local-link-chip">แนวทางความเป็นส่วนตัว</a>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
