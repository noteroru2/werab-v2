---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อคอมมหาสารคาม คอมประกอบ Gaming PC เช็กสเปกก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อคอมมือสองในมหาสารคาม ทั้งคอมประกอบ Gaming PC คอมสำนักงานและเครื่องใช้งานทั่วไป ประเมินจาก CPU GPU RAM SSD Mainboard PSU สภาพและอุปกรณ์";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อคอมพิวเตอร์",
    "url": "/รับซื้อคอม/"
  },
  {
    "name": "รับซื้อคอมมหาสารคาม เช็ก CPU การ์ดจอ และสเปกก่อนขาย",
    "url": "/รับซื้อคอม-สารคาม/"
  }
];

const faqs = [
  {
    "question": "Gaming PC ต้องแจ้งสเปกอะไรบ้าง?",
    "answer": "ควรแจ้ง CPU, GPU, RAM, SSD, Mainboard และ PSU รวมถึงรูปและอาการถ้ามี เพราะชื่อ Gaming PC อย่างเดียวไม่สามารถบอก Configuration ได้ครบ"
  },
  {
    "question": "ต้องรวมจอขายกับเครื่องหรือไม่?",
    "answer": "ไม่จำเป็น สามารถแจ้งได้ว่าขายเฉพาะตัวเครื่องหรือรวม Monitor และอุปกรณ์ใดบ้าง"
  },
  {
    "question": "ต้องล้างข้อมูลใน SSD ก่อนถามราคาไหม?",
    "answer": "เพื่อถามราคาไม่จำเป็นต้องส่งข้อมูลส่วนตัว หากต้องการเก็บ SSD สามารถแจ้งว่าไม่รวม Storage แล้วประเมินจาก Hardware ที่ขายจริง"
  },
  {
    "question": "คอมเปิดไม่ติดยังประเมินได้ไหม?",
    "answer": "ได้ สามารถส่งสเปกที่ทราบ รูปและอาการก่อนเสียเพื่อประเมินเบื้องต้น โดยไม่ควรเปิดซ้ำหลายครั้งหากมีกลิ่นไหม้หรือความร้อนผิดปกติ"
  },
  {
    "question": "มีคอมสำนักงานหลายเครื่องส่งรายการมาได้ไหม?",
    "answer": "ได้ ควรแบ่งตาม CPU, RAM, SSD, GPU จำนวนและสภาพ เพื่อไม่ให้ใช้ Configuration ของเครื่องเดียวแทนทั้งล็อต"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อคอมมหาสารคาม เช็ก CPU การ์ดจอ และสเปกก่อนขาย</h1>
        
        
        <p>การประเมินคอมประกอบมือสองควรดูเป็นชุด Hardware ไม่ควรใช้เพียงคำว่า Gaming PC หรือ Core i5 เป็นข้อมูลทั้งหมด</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ข้อมูลที่ควรส่งก่อน:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>CPU + GPU + RAM + SSD/HDD + Mainboard + PSU + Case + รูป + อาการ</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-desktop-pc-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-desktop-pc-500.webp" type="image/webp" />
              <source srcset="/images/hero-desktop-pc.avif" type="image/avif" />
              <source srcset="/images/hero-desktop-pc.webp" type="image/webp" />
              <img
                src="/images/hero-desktop-pc.webp"
                alt="รับซื้อคอมมหาสารคาม เช็ก CPU การ์ดจอ และสเปกก่อนขาย"
                width="688"
                height="784"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่มหาสารคามสามารถส่งสเปกคอมมาเช็กราคาก่อนได้</h2>
        <p>ไม่จำเป็นต้องยกคอมทั้งเครื่องไปเพียงเพื่อสอบถามราคาเบื้องต้น</p>
        <p>สามารถเริ่มจากส่ง:</p>
        <ul>
        <li>CPU</li>
        <li>GPU</li>
        <li>RAM</li>
        <li>SSD หรือ HDD</li>
        <li>Mainboard</li>
        <li>PSU</li>
        <li>Case</li>
        <li>รูปเครื่อง</li>
        <li>อาการ</li>
        <li>อุปกรณ์ที่รวมขาย</li>
        </ul>
        <p>หากยังตรวจสเปกไม่ครบ สามารถเริ่มจากข้อมูลที่มีแล้วค่อยตรวจเพิ่มเติม</p>
        <p>หลังทราบข้อมูลเบื้องต้นจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>การเช็กราคาเบื้องต้นเริ่มจากส่งข้อมูลออนไลน์ก่อน และขั้นตอนตรวจหรือส่งมอบจะนัดหมายตามพื้นที่จริงโดยไม่ได้ระบุว่ามีสาขาประจำในทุกอำเภอของมหาสารคาม</p>
        </div>
        <div class="comm-card">
          <h2>CPU ต้องแจ้งรุ่นเต็ม</h2>
        <p>คำว่า:</p>
        <p><strong>Core i5</strong></p>
        <p>หรือ</p>
        <p><strong>Ryzen 5</strong></p>
        <p>ยังไม่เพียงพอสำหรับประเมินคอม</p>
        <p>ควรแจ้งรหัสเต็ม เช่น:</p>
        <p><strong>Intel Core i5-12400F</strong></p>
        <p><strong>Intel Core i7-12700</strong></p>
        <p><strong>AMD Ryzen 5 5600</strong></p>
        <p><strong>AMD Ryzen 7 5700X</strong></p>
        <p>CPU คนละ Generation อาจใช้ Platform คนละรุ่นและมีมูลค่าต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>การ์ดจอควรระบุรุ่นและความจุให้ถูก</h2>
        <p>สำหรับ Gaming PC หรือเครื่องทำงานกราฟิก ควรแจ้ง GPU เช่น:</p>
        <p><strong>GeForce RTX 3060 12GB</strong></p>
        <p><strong>GeForce RTX 4060 8GB</strong></p>
        <p>หรือรุ่นอื่นตามเครื่องจริง</p>
        <p>ถ้าทราบ Brand หรือรุ่นย่อยสามารถแจ้งเพิ่มได้</p>
        <p>ไม่ควรประเมินจากคำว่า:</p>
        <p><strong>RTX</strong></p>
        <p>อย่างเดียว</p>
        <p>เพราะแต่ละรุ่นมีประสิทธิภาพและตลาดต่างกัน</p>
        </div>
        <div class="comm-card">
          <h2>RAM ควรแจ้งทั้งความจุและจำนวนแถวถ้าทราบ</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>16GB (8GB × 2)</strong></p>
        <p>หรือ</p>
        <p><strong>32GB (16GB × 2)</strong></p>
        <p>หากทราบว่าเป็น DDR4 หรือ DDR5 สามารถแจ้งประกอบได้</p>
        <p>เครื่องที่มี RAM ความจุเท่ากันอาจใช้ Platform ต่างกัน จึงควรพิจารณาร่วมกับ CPU และ Mainboard</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>SSD และ HDD ต้องแจ้งตามของที่รวมขายจริง</h2>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>SSD NVMe</li>
        <li>SSD SATA</li>
        <li>HDD</li>
        <li>ความจุ</li>
        <li>จำนวน Drive</li>
        </ul>
        <p>ตัวอย่าง:</p>
        <p><strong>NVMe SSD 512GB + HDD 1TB</strong></p>
        <p>หากต้องการเก็บ Storage ที่มีข้อมูลส่วนตัวไว้ ควรแจ้งว่า:</p>
        <p><strong>ไม่รวม SSD</strong></p>
        <p>หรือ</p>
        <p><strong>ไม่รวม HDD</strong></p>
        <p>ตั้งแต่ก่อนประเมิน</p>
        </div>
        <div class="comm-card">
          <h2>Mainboard ช่วยบอก Platform และความสามารถในการอัปเกรด</h2>
        <p>หากตรวจได้ ควรแจ้งรุ่น Mainboard เช่น:</p>
        <p><strong>B550</strong></p>
        <p><strong>B660</strong></p>
        <p><strong>B760</strong></p>
        <p><strong>A520</strong></p>
        <p>หรือชื่อรุ่นเต็ม</p>
        <p>Mainboard มีผลต่อ:</p>
        <ul>
        <li>CPU ที่รองรับ</li>
        <li>RAM</li>
        <li>Slot</li>
        <li>Storage</li>
        <li>Port</li>
        <li>การอัปเกรด</li>
        </ul>
        <p>จึงไม่ควรประเมินคอมจาก CPU และ GPU เพียงสองอย่าง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>PSU ควรระบุยี่ห้อ รุ่น และกำลังไฟถ้าทราบ</h2>
        <p>สำหรับ Gaming PC โดยเฉพาะเครื่องที่มีการ์ดจอแยก ควรแจ้ง PSU</p>
        <p>ตัวอย่าง:</p>
        <p><strong>650W 80+</strong></p>
        <p>แต่หากทราบเฉพาะกำลังไฟก็สามารถส่งข้อมูลเท่าที่มีได้</p>
        <p>ไม่ควรเปิด PSU หรือแกะชิ้นส่วนภายในเพียงเพื่อเช็กข้อมูลก่อนขาย</p>
        </div>
        <div class="comm-card">
          <h2>Case และสภาพภายนอกมีผลต่อความพร้อมใช้งาน</h2>
        <p>ควรถ่าย:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านข้าง</li>
        <li>ด้านในที่มองเห็นได้</li>
        <li>ด้านหลัง</li>
        <li>Port</li>
        <li>Tempered Glass ถ้ามี</li>
        </ul>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ฝาแตก</li>
        <li>กระจกแตก</li>
        <li>มีสนิม</li>
        <li>Port หน้าเสีย</li>
        <li>Fan ไม่หมุน</li>
        <li>RGB มีปัญหา</li>
        <li>Case บุบ</li>
        </ul>
        <p>ไม่จำเป็นต้องเปลี่ยน Case ก่อนเช็กราคา</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเปิดติดแต่มีอาการควรแจ้งตามจริง</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>เปิดแล้วดับ</li>
        <li>Restart</li>
        <li>จอฟ้า</li>
        <li>ค้าง</li>
        <li>การ์ดจอไม่ขึ้น</li>
        <li>ภาพแตก</li>
        <li>เล่นเกมแล้วดับ</li>
        <li>Fan เสียงดัง</li>
        <li>ความร้อนผิดปกติ</li>
        </ul>
        <p>ควรแจ้งว่าอาการเกิดขึ้นเมื่อใดและเกิดบ่อยแค่ไหนเท่าที่ทราบ</p>
        <p>ไม่ควรวินิจฉัยว่า Mainboard, PSU หรือ GPU เสียโดยยังไม่ได้ตรวจ</p>
        </div>
        <div class="comm-card">
          <h2>คอมเปิดไม่ติดยังเช็กราคาได้</h2>
        <p>สามารถเริ่มจากส่ง:</p>
        <ul>
        <li>CPU</li>
        <li>GPU</li>
        <li>Mainboard</li>
        <li>RAM</li>
        <li>Storage</li>
        <li>PSU</li>
        <li>รูป</li>
        <li>อาการก่อนเสีย</li>
        </ul>
        <p>เครื่องที่ทดสอบไม่ได้จะมีความไม่แน่นอนมากกว่าเครื่องปกติ แต่ไม่ได้หมายความว่า Hardware ทุกชิ้นไม่มีมูลค่า</p>
        <p>หากมีกลิ่นไหม้ ควัน หรือความร้อนผิดปกติ ไม่ควรเปิดซ้ำหลายครั้งเพียงเพื่อขอราคา</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ขายเฉพาะเครื่องหรือรวมจอก็ต้องแจ้งให้ชัด</h2>
        <p>หากมี:</p>
        <ul>
        <li>Monitor</li>
        <li>Keyboard</li>
        <li>Mouse</li>
        <li>Wi-Fi Adapter</li>
        <li>Speaker</li>
        <li>UPS</li>
        <li>อุปกรณ์อื่น</li>
        </ul>
        <p>ควรแจ้งว่าอะไร <strong>รวมขาย</strong> และอะไร <strong>ไม่รวม</strong></p>
        <p>ไม่ควรรวมราคาจอหรืออุปกรณ์โดยอัตโนมัติหากเจ้าของยังต้องการเก็บไว้</p>
        </div>
        <div class="comm-card">
          <h2>คอมจากสำนักงานหลายเครื่องควรแยก Configuration</h2>
        <p>หากมีหลายเครื่องสามารถจัดข้อมูล เช่น:</p>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>CPU</th>
                <th>RAM</th>
                <th>SSD</th>
                <th>GPU</th>
                <th>จำนวน</th>
                <th>สภาพ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>i5-...</td>
                <td>8GB</td>
                <td>256GB</td>
                <td>Integrated</td>
                <td>5</td>
                <td>ใช้งานได้</td>
              </tr>
              <tr>
                <td>i5-...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>Integrated</td>
                <td>3</td>
                <td>มีตำหนิ</td>
              </tr>
              <tr>
                <td>Ryzen 5 ...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>RTX ...</td>
                <td>2</td>
                <td>ใช้งานได้</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>ไม่ควรใช้สเปกของเครื่องเดียวแทนทั้งล็อตหาก Hardware ต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ข้อมูลใน Storage ไม่จำเป็นสำหรับการประเมิน Hardware</h2>
        <p>เพื่อสอบถามราคา ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        <li>ข้อมูลลูกค้า</li>
        <li>เอกสารภายในองค์กร</li>
        </ul>
        <p>หากต้องการเก็บ SSD หรือ HDD ไว้สามารถแจ้งได้ตั้งแต่ต้น</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคาคอมในมหาสารคาม</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง CPU</h3>
              <p>ใช้รุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. ส่ง GPU</h3>
              <p>ถ้ามีการ์ดจอแยก</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่ง RAM</h3>
              <p>ความจุและประเภทถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. ส่ง Storage</h3>
              <p>SSD/HDD และความจุ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Mainboard</h3>
              <p>รุ่นเท่าที่ตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง PSU</h3>
              <p>Brand รุ่นและ Watt ถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. ส่งรูป Case</h3>
              <p>รวมด้านในและตำหนิที่มองเห็น</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งอาการ</h3>
              <p>หากเครื่องไม่ปกติ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. แจ้งสิ่งที่รวมขาย</h3>
              <p>จอและอุปกรณ์แยกให้ชัด</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยัน Hardware และสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาคอมในมหาสารคาม</h2>
        <p>ส่ง:</p>
        <p><strong>CPU + GPU + RAM + SSD + Mainboard + PSU + รูป + อาการ</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-surface">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายคอมในมหาสารคาม" subtitle="" />
    </div>
  </section>
</BaseLayout>
