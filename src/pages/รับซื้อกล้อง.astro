---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อกล้องมือสอง กล้อง Mirrorless DSLR และเลนส์ | เรารับซื้อ.com";
const pageDescription = "รับซื้อกล้องมือสอง Mirrorless DSLR และเลนส์ ประเมินจากรุ่น Body เลนส์ สภาพ Sensor Shutter หน้าจอ แบตเตอรี่ เชื้อรา ฝ้า และอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อกล้อง', url: '/รับซื้อกล้อง/' }
];

const faqs = [
  {
    question: "รับซื้อกล้องและเลนส์มือสองยี่ห้ออะไรบ้าง?",
    answer: "สามารถส่งกล้องและเลนส์หลายแบรนด์มาประเมินได้ เช่น Canon, Sony, Fujifilm, Nikon, Panasonic, Olympus หรือ OM System และแบรนด์อื่น โดยควรแจ้งรุ่น Body รุ่นเลนส์ สภาพ และอุปกรณ์"
  },
  {
    question: "กล้องมีฝุ่นที่ Sensor หรือเลนส์มีเชื้อราขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรถ่ายรูปหรือแจ้งระดับปัญหาที่พบ ไม่จำเป็นต้องรีบส่งทำความสะอาดก่อนทุกกรณี เพราะควรเปรียบเทียบต้นทุนกับมูลค่าที่อาจเพิ่มขึ้นก่อน"
  },
  {
    question: "ขายเฉพาะ Body หรือเฉพาะเลนส์ได้ไหม?",
    answer: "สามารถส่ง Body หรือ Lens แยกมาประเมินได้ ควรแจ้งรุ่นเต็มและสภาพของแต่ละชิ้น เพราะกล้องและเลนส์มีมูลค่าแยกจากกัน"
  },
  {
    question: "กล้องเปิดไม่ติดหรือเคยซ่อมยังขายได้ไหม?",
    answer: "บางกรณีสามารถประเมินตามสภาพได้ ควรแจ้งรุ่น อาการก่อนเสีย Battery, Charger และประวัติการซ่อมหากทราบ เพื่อพิจารณาความเสี่ยงและมูลค่าคงเหลือ"
  },
  {
    question: "ต้องส่ง Shutter Count เพื่อเช็กราคากล้องไหม?",
    answer: "หากสามารถตรวจได้สามารถส่งประกอบการประเมินได้ แต่ Shutter Count ไม่ใช่ปัจจัยเดียว ต้องดูรุ่น สภาพ Sensor การทำงาน หน้าจอ EVF เลนส์ และประวัติของกล้องร่วมด้วย"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อกล้องมือสอง เช็กรุ่น Body เลนส์ และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขายกล้องมือสอง แต่ไม่แน่ใจว่าควรประเมิน Body และเลนส์อย่างไร?</p>
          <p>
            กล้องถ่ายรูปต่างจากอุปกรณ์ไอทีหลายประเภท เพราะมูลค่าของชุดอาจอยู่ทั้งใน <strong>ตัวกล้อง เลนส์ แบตเตอรี่ อุปกรณ์ และสภาพของชิ้นส่วนระบบภาพ</strong>
          </p>
          <p>
            กล้องรุ่นเดียวกัน แต่สภาพ Sensor, Shutter, ช่องมองภาพ หน้าจอ หรือเลนส์ต่างกัน สามารถมีราคามือสองต่างกันได้มาก
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนขายควรเริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>รุ่น Body + รุ่นเลนส์ + รูป + สภาพ + อาการ + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-camera-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-camera-500.webp" type="image/webp" />
              <source srcset="/images/hero-camera.avif" type="image/avif" />
              <source srcset="/images/hero-camera.webp" type="image/webp" />
              <img
                src="/images/hero-camera.webp"
                alt="รับซื้อกล้องมือสอง Mirrorless DSLR และเลนส์ เช็กรุ่น Body เลนส์ และสภาพก่อนขาย"
                width="971"
                height="716"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: CAMERA TYPES & BRANDS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>กล้องแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียดกล้องหลายประเภทมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>Mirrorless</li>
              <li>DSLR</li>
              <li>Compact Camera</li>
              <li>กล้อง Full Frame</li>
              <li>กล้อง APS-C</li>
              <li>กล้อง Micro Four Thirds</li>
              <li>กล้อง Medium Format บางรุ่น</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>กล้องพร้อม Kit Lens</li>
              <li>Body อย่างเดียว</li>
              <li>เลนส์แยก</li>
              <li>กล้องมีตำหนิ</li>
              <li>กล้องเคยซ่อม</li>
              <li>กล้องมีรอย</li>
              <li>กล้องเปิดไม่ติดบางกรณี</li>
              <li>เลนส์มีฝ้าหรือเชื้อราบางกรณี</li>
            </ul>
          </div>
        </div>

        <p>แบรนด์ที่พบในตลาดมือสอง เช่น</p>
        <ul>
          <li>Canon</li>
          <li>Sony</li>
          <li>Fujifilm</li>
          <li>Nikon</li>
          <li>Panasonic</li>
          <li>Olympus / OM System</li>
          <li>Leica</li>
          <li>Sigma</li>
          <li>และแบรนด์อื่น</li>
        </ul>

        <p>การประเมินต้องดูรุ่นและสภาพของสินค้าจริง</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BODY IDENTIFICATION & LENS SEPARATION -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายต้องรู้รุ่น Body ให้ชัด</h2>
          <p>ควรแจ้งชื่อรุ่นเต็ม</p>
          <p>การบอกเพียงว่า “กล้อง Canon” หรือ “กล้อง Fuji” ยังไม่พอ</p>
          <p>เพราะ Body แต่ละรุ่นมี Sensor ขนาด ความละเอียด ระบบโฟกัส อายุ และตลาดมือสองต่างกัน</p>
          <p>หากไม่แน่ใจ สามารถถ่ายรูป:</p>
          <ul>
            <li>ด้านหน้า</li>
            <li>ด้านหลัง</li>
            <li>ด้านบน</li>
            <li>ใต้กล้อง</li>
            <li>ป้าย Model</li>
            <li>หน้าจอเมนู</li>
          </ul>
          <p>เพื่อช่วยตรวจรุ่นได้</p>
        </div>

        <div class="comm-card">
          <h2>Body กับ Lens ควรแยกประเมินก่อน</h2>
          <p>หากมีกล้องพร้อมเลนส์ ควรแจ้งข้อมูลของทั้งสองส่วนแยกกัน</p>
          <p>เพราะเลนส์บางตัวมีมูลค่ามือสองสูงและสามารถขายแยกได้</p>
          <p>ไม่ควรแจ้งเพียงว่า “กล้องพร้อมเลนส์” หากสามารถดูรุ่น Lens ได้</p>

          <h2 style="margin-top: 1.5rem;">วิธีดูรุ่นเลนส์</h2>
          <p>ข้อมูลรุ่นเลนส์มักอยู่บริเวณ:</p>
          <ul>
            <li>ด้านหน้ากระบอก</li>
            <li>รอบขอบหน้าเลนส์</li>
            <li>ด้านข้าง</li>
            <li>ใกล้ Mount</li>
            <li>Sticker หรือข้อความบนตัว Lens</li>
          </ul>
          <p>ควรส่งชื่อรุ่นเต็ม พร้อมชื่อแบรนด์และ Series</p>
          <p>เพราะเลนส์ระยะใกล้กันอาจมีมูลค่าต่างกันมากจาก Aperture, Mount และ Generation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SENSOR & SHUTTER COUNT -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Sensor ต้องตรวจอะไรบ้าง</h2>
          <p>Sensor เป็นส่วนสำคัญของกล้องดิจิทัล</p>
          <p>หากสามารถถอดเลนส์ได้ ควรตรวจอย่างระมัดระวังโดยไม่สัมผัส Sensor โดยตรง</p>
          <p>สิ่งที่อาจพบ เช่น</p>
          <ul>
            <li>ฝุ่น</li>
            <li>คราบ</li>
            <li>รอย</li>
            <li>จุดผิดปกติ</li>
            <li>ความเสียหายจากการทำความสะอาด</li>
          </ul>
          <p>ฝุ่นเล็กน้อยบางกรณีสามารถทำความสะอาดได้ แต่รอยหรือความเสียหายต่อ Sensor มีความสำคัญมากกว่า</p>
          <p>ไม่ควรใช้ของแข็งหรือวัสดุที่ไม่เหมาะสมเช็ด Sensor เพื่อเตรียมขาย</p>
          <p>หากไม่แน่ใจ ให้ถ่ายรูปหรือแจ้งอาการก่อน</p>

          <h2 style="margin-top: 1.5rem;">วิธีตรวจฝุ่นบน Sensor เบื้องต้น</h2>
          <p>ถ้ากล้องและเลนส์ใช้งานได้ สามารถทดลองถ่ายพื้นสว่าง เช่น ผนังหรือท้องฟ้า ด้วย Aperture แคบ</p>
          <p>จากนั้นดูภาพว่ามีจุดดำซ้ำในตำแหน่งเดิมหรือไม่</p>
          <p>การทดสอบนี้ช่วยสังเกตฝุ่นหรือคราบบางประเภทได้ แต่ไม่ได้ใช้ตัดสินความเสียหายทั้งหมดของ Sensor</p>
          <p>หากพบจุดผิดปกติควรแจ้งประกอบการประเมิน</p>
        </div>

        <div class="comm-card">
          <h2>Shutter Count มีผลไหม</h2>
          <p>มีผลกับกล้องบางประเภท โดยเฉพาะกล้องที่ใช้ Mechanical Shutter</p>
          <p>Shutter Count เป็นข้อมูลหนึ่งที่ช่วยดูปริมาณการใช้งาน</p>
          <p>แต่ไม่ควรใช้เพียงจำนวน Shutter เป็นตัวกำหนดราคาทั้งเครื่อง</p>
          <p>ต้องดูร่วมกับ:</p>
          <ul>
            <li>รุ่น</li>
            <li>อายุ</li>
            <li>สภาพ</li>
            <li>การทำงาน</li>
            <li>Sensor</li>
            <li>ปุ่ม</li>
            <li>จอ</li>
            <li>EVF</li>
            <li>ประวัติซ่อม</li>
          </ul>

          <h2 style="margin-top: 1.5rem;">หน้าจอและช่องมองภาพควรตรวจ</h2>
          <h3>หน้าจอ</h3>
          <ul>
            <li>ภาพขึ้น</li>
            <li>Touch ถ้ารองรับ</li>
            <li>พับหรือหมุนได้ตามรุ่น</li>
            <li>ไม่มีเส้น</li>
            <li>ไม่มีจุดผิดปกติชัดเจน</li>
            <li>ไม่มีรอยแตก</li>
          </ul>
          <h3>EVF</h3>
          <p>ถ้ารุ่นมี Electronic Viewfinder ควรตรวจ:</p>
          <ul>
            <li>ภาพขึ้น</li>
            <li>สีปกติ</li>
            <li>ไม่มีอาการกะพริบ</li>
            <li>Sensor สลับจอ/EVF ทำงานถ้ารุ่นรองรับ</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: AUTOFOCUS, VIDEO, DIALS & BATTERY -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Autofocus ควรทดสอบอย่างไร</h2>
          <p>ถ้ามีเลนส์ที่ใช้งานได้ ลอง Focus วัตถุหลายระยะ</p>
          <p>สังเกตว่า:</p>
          <ul>
            <li>Focus เข้า</li>
            <li>ไม่มีเสียงผิดปกติ</li>
            <li>ไม่ค้าง</li>
            <li>เปลี่ยนจุด Focus ได้</li>
          </ul>
          <p>ไม่จำเป็นต้องทดสอบเชิงห้องแล็บเพื่อถามราคาเบื้องต้น</p>

          <h2 style="margin-top: 1.5rem;">กล้องถ่ายภาพได้แต่ Video มีปัญหาต้องแจ้งไหม</h2>
          <p>ควรแจ้ง</p>
          <p>ถ้าสะดวกควรลอง:</p>
          <ul>
            <li>Record Video</li>
            <li>Microphone</li>
            <li>Playback</li>
            <li>HDMI หากใช้งาน</li>
            <li>ช่อง Mic</li>
            <li>ช่อง Headphone ถ้ามี</li>
          </ul>
          <p>หากฟังก์ชันบางอย่างยังไม่ได้ทดสอบ สามารถระบุว่า “ยังไม่ได้ทดสอบ” ได้</p>
        </div>

        <div class="comm-card">
          <h2>ปุ่ม Dial และพอร์ตต่าง ๆ</h2>
          <p>ควรตรวจ:</p>
          <ul>
            <li>Shutter Button</li>
            <li>Mode Dial</li>
            <li>Command Dial</li>
            <li>Menu</li>
            <li>Playback</li>
            <li>Joystick</li>
            <li>ปุ่ม Function</li>
            <li>USB</li>
            <li>HDMI</li>
            <li>Mic</li>
            <li>SD Card Slot</li>
            <li>Battery Door</li>
          </ul>
          <p>ปุ่มบางปุ่มกดยากหรือ Dial หมุนแล้วข้ามค่าควรแจ้งตามจริง</p>

          <h2 style="margin-top: 1.5rem;">แบตเตอรี่และ Charger มีผลหรือไม่</h2>
          <p>มีผลต่อความพร้อมใช้งานของชุด</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>มี Battery กี่ก้อน</li>
            <li>Battery ใช้งานได้หรือไม่</li>
            <li>มี Charger หรือไม่</li>
            <li>ชาร์จผ่านกล้องได้หรือไม่ หากรุ่นรองรับ</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: LENS CONDITION, FUNGUS & MOUNT -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เลนส์ต้องตรวจเชื้อรา ฝ้า และรอยอย่างไร</h2>
          <p>เลนส์ควรตรวจทั้งด้านหน้าและด้านหลัง</p>
          <p>สิ่งที่ควรสังเกต:</p>
          <ul>
            <li>รอยหน้าเลนส์</li>
            <li>ฝุ่นภายใน</li>
            <li>ฝ้า</li>
            <li>เชื้อรา</li>
