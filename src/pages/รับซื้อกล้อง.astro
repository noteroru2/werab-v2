---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';

const seo = resolveSeo('/รับซื้อกล้อง/');
const breadcrumbs = [
  { name: 'หมวดหมู่รับซื้อ', url: '/รับซื้อ/' },
  { name: 'รับซื้อกล้องและเลนส์', url: '/รับซื้อกล้อง/' }
];
const internalLinks = getInternalLinks(seo);

const faqs = [
  {
    question: 'รับซื้อกล้องและเลนส์ค่ายใดบ้าง?',
    answer: 'เรารับซื้อกล้อง Mirrorless, DSLR, และเลนส์ทุกค่าย เช่น Sony (Alpha, FX, ZV), Canon (EOS R, EOS M, EF), Fujifilm (X Series, GFX), Nikon (Z Series, D Series), Panasonic Lumix และเลนส์อิสระ Sigma, Tamron'
  },
  {
    question: 'เลนส์มีฝุ่น ฝ้า รา รับซื้อหรือไม่?',
    answer: 'รับซื้อตามสภาพ โดยทีมงานจะทำการส่องตรวจชิ้นเลนส์เพื่อประเมินความสมบูรณ์และหักลบค่าซ่อม/ล้างตามจริง'
  }
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="section" style="padding-top: 3rem; padding-bottom: 2rem; text-align: center;">
    <div class="container container-narrow">
      <span class="badge badge-accent" style="margin-bottom: 0.75rem;">CAMERA & LENS BUYBACK</span>
      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">{seo.h1}</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted);">
        รับซื้อกล้องถ่ายรูป เลนส์ Mirrorless, DSLR ทุกค่าย เช็กชัตเตอร์ ตรวจเซนเซอร์ ตีราคาแม่นยำ
      </p>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container container-narrow">
      <div class="card" style="padding: 2.5rem 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">เกณฑ์การประเมินราคากล้องและอุปกรณ์ถ่ายภาพ</h2>
        <ul>
          <li><strong>จำนวนชัตเตอร์ (Shutter Count)</strong>: การใช้งานชัตเตอร์เทียบกับอายุขัยมาตรฐานของกล้องแต่ละรุ่น</li>
          <li><strong>สภาพเซนเซอร์และชิ้นเลนส์</strong>: เซนเซอร์สะอาด ไม่มีรอยขูดขีด เลนส์ใสไม่มีฝ้า รา หรือฝุ่นหนาแน่น</li>
          <li><strong>ระบบโฟกัสและกันสั่น</strong>: Autofocus และ In-Body Image Stabilization (IBIS) ทำงานแม่นยำ</li>
          <li><strong>อุปกรณ์ดั้งเดิม</strong>: แบตเตอรี่แท้ แท่นชาร์จ สายคล้องคอ ฝาปิดบอดี้/เลนส์ และกล่อง</li>
        </ul>
      </div>

      <ProcessSteps />

      <div style="margin-top: 3.5rem;">
        <FAQ items={faqs} />
      </div>

      <RelatedLinks
        clusterLinks={internalLinks.clusterLinks}
        parentLink={internalLinks.parentLink}
        guideLinks={internalLinks.guideLinks}
      />
    </div>
  </section>

  <CTA />
</BaseLayout>
