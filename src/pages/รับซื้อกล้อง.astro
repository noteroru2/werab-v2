---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อกล้องมือสอง กล้อง Mirrorless DSLR และเลนส์ | เรารับซื้อ.com";
const pageDescription = "รับซื้อกล้องมือสอง Mirrorless DSLR และเลนส์ ประเมินจากรุ่น Body เลนส์ สภาพ Sensor Shutter หน้าจอ แบตเตอรี่ เชื้อรา ฝ้า และอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อกล้อง', url: '/รับซื้อกล้อง/' }
];

const cameraFaqs = [
  {
    question: "รับซื้อกล้องและเลนส์มือสองยี่ห้ออะไรบ้าง?",
    answer: "สามารถส่งกล้องและเลนส์หลายแบรนด์มาประเมินได้ เช่น Canon, Sony, Fujifilm, Nikon, Panasonic, Olympus หรือ OM System และแบรนด์อื่น โดยควรแจ้งรุ่น Body รุ่นเลนส์ สภาพ และอุปกรณ์"
  },
  {
    question: "กล้องมีฝุ่นที่ Sensor หรือเลนส์มีเชื้อราขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรถ่ายรูปหรือแจ้งระดับปัญหาที่พบ ไม่จำเป็นต้องรีบส่งทำความสะอาดก่อนทุกกรณี เพราะควรเปรียบเทียบต้นทุนกับมูลค่าที่อาจเพิ่มขึ้นก่อน"
  },
  {
    question: "ขายเฉพาะ Body หรือเฉพาะเลนส์ได้ไหม?",
    answer: "สามารถส่ง Body หรือ Lens แยกมาประเมินได้ ควรแจ้งรุ่นเต็มและสภาพของแต่ละชิ้น เพราะกล้องและเลนส์มีมูลค่าแยกจากกัน"
  },
  {
    question: "กล้องเปิดไม่ติดหรือเคยซ่อมยังขายได้ไหม?",
    answer: "บางกรณีสามารถประเมินตามสภาพได้ ควรแจ้งรุ่น อาการก่อนเสีย Battery, Charger และประวัติการซ่อมหากทราบ เพื่อพิจารณาความเสี่ยงและมูลค่าคงเหลือ"
  },
  {
    question: "ต้องส่ง Shutter Count เพื่อเช็กราคากล้องไหม?",
    answer: "หากสามารถตรวจได้สามารถส่งประกอบการประเมินได้ แต่ Shutter Count ไม่ใช่ปัจจัยเดียว ต้องดูรุ่น สภาพ Sensor การทำงาน หน้าจอ EVF เลนส์ และประวัติของกล้องร่วมด้วย"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={cameraFaqs}
>
  <Breadcrumb items={breadcrumbs} />

  <!-- 1. HERO SECTION -->
  <section class="section cam-hero-section">
    <div class="container container-narrow">
      <span class="badge badge-accent cam-badge">CAMERA BUYBACK</span>
      <h1 class="cam-title">รับซื้อกล้องมือสอง เช็กรุ่น Body เลนส์ และสภาพก่อนขาย</h1>
      <p class="cam-subtitle">
        ประเมินราคาตามรุ่น Body เลนส์ สภาพเซนเซอร์ ชัตเตอร์ อาการฝ้า รา และอุปกรณ์เสริม
      </p>
    </div>
  </section>

  <!-- 2. PROCESS / VALUATION STEPS (STEPS 4-10) -->
  <section class="section" style="padding-top: 1rem;">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-accent" style="margin-bottom: 0.75rem;">แนวทางการประเมิน</span>
        <h2>ขั้นตอนเช็กราคากล้องก่อนขาย</h2>
        <p>ตรวจสอบความสมบูรณ์ของตัวกล้อง ชิ้นเลนส์ และอุปกรณ์ส่วนควบ</p>
      </div>

      <div class="cam-steps-grid">
        <div class="card cam-step-card">
          <div class="cam-step-num">4</div>
          <h3>แจ้งการทำงานของ Body</h3>
          <p>ตรวจสอบการทำงาน เช่น:</p>
          <ul class="cam-step-list">
            <li>เปิดติด</li>
            <li>ถ่ายได้</li>
            <li>Focus ได้</li>
            <li>EVF ปกติ</li>
            <li>Video ปกติ</li>
            <li>มีอาการอะไร</li>
          </ul>
        </div>

        <div class="card cam-step-card">
          <div class="cam-step-num">5</div>
          <h3>แจ้งสภาพ Lens</h3>
          <p>ตรวจชิ้นเลนส์ เช่น:</p>
          <ul class="cam-step-list">
            <li>ใส</li>
            <li>มีฝุ่น</li>
            <li>มีฝ้า</li>
            <li>มีเชื้อรา</li>
            <li>มีรอย</li>
          </ul>
        </div>

        <div class="card cam-step-card">
          <div class="cam-step-num">6</div>
          <h3>แจ้งอุปกรณ์</h3>
          <p>อุปกรณ์ร่วม เช่น:</p>
          <ul class="cam-step-list">
            <li>Battery</li>
            <li>Charger</li>
            <li>Box</li>
            <li>Strap</li>
            <li>Flash</li>
            <li>อุปกรณ์อื่น</li>
          </ul>
        </div>

        <div class="card cam-step-card">
          <div class="cam-step-num">7</div>
          <h3>แจ้งประวัติ</h3>
          <p>เคยซ่อม ตก หรือโดนน้ำหรือไม่</p>
        </div>

        <div class="card cam-step-card">
          <div class="cam-step-num">8</div>
          <h3>ประเมินเบื้องต้น</h3>
          <p>พิจารณา Body, Lens, สภาพ และอุปกรณ์ร่วมกัน</p>
        </div>

        <div class="card cam-step-card">
          <div class="cam-step-num">9</div>
          <h3>ตัดสินใจ</h3>
          <p>สามารถพิจารณาก่อนว่าจะขายเป็นชุดหรือแยกบางรายการ</p>
        </div>

        <div class="card cam-step-card" style="grid-column: 1 / -1; max-width: 600px; margin: 0 auto; width: 100%;">
          <div class="cam-step-num">10</div>
          <h3>ตรวจสินค้าจริงและซื้อขาย</h3>
          <p>ตรวจรุ่น สภาพ และการทำงานให้ตรงกับรายละเอียดที่ใช้ประเมินก่อนดำเนินการซื้อขาย</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROVINCIAL / REMOTE VALUATION SECTION -->
  <section class="section section-muted">
    <div class="container container-narrow">
      <div class="card provincial-card">
        <h2>อยู่ต่างจังหวัดเริ่มเช็กราคากล้องได้อย่างไร</h2>
        <p>ไม่จำเป็นต้องเดินทางพร้อมกล้องเพียงเพื่อถามราคาเบื้องต้น</p>
        <p>เริ่มจากส่ง:</p>

        <div class="provincial-formula">
          <strong>รุ่น Body + รุ่น Lens + รูป + สภาพ + อาการ + อุปกรณ์</strong>
        </div>

        <p>จากนั้นจึงค่อยตกลงวิธีส่งมอบหรือนัดหมายตามพื้นที่ ประเภทสินค้า และความเหมาะสม</p>
        <p class="provincial-note">
          หน้า <code>/รับซื้อกล้อง/</code> เป็นข้อมูลบริการภาพรวม ไม่ได้ใช้เพื่ออ้างว่ามีสาขาในทุกจังหวัด
          หน้ารับซื้อกล้องรายพื้นที่ที่มี Historical Search Equity จะเชื่อมเข้ากับหมวดนี้ในภายหลัง เมื่อผ่าน Content QA และ Index Release ของแต่ละหน้า
        </p>
      </div>
    </div>
  </section>

  <!-- 4. INTAKE & CONTACT CTA SECTION -->
  <section class="section">
    <div class="container container-narrow">
      <div class="card intake-card">
        <h2>เริ่มเช็กราคากล้องของคุณ</h2>
        <p>ส่งข้อมูล:</p>

        <div class="intake-spec-box">
          <strong>รุ่น Body + รุ่น Lens + รูปกล้อง + รูปเลนส์ + สภาพ + อาการ + อุปกรณ์</strong>
        </div>

        <p class="intake-helper">
          หากมีกล้องหรือเลนส์หลายชิ้น สามารถจัดเป็นรายการแล้วส่งพร้อมรูปได้
        </p>

        <div class="cta-buttons-row">
          <a
            href={getLineUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-line btn-lg"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-109-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>

          <a href={getPhoneUrl()} class="btn btn-outline btn-lg intake-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div class="intake-links-footer">
          <p>
            ดูขั้นตอนภาพรวมได้ที่ <a href="/เช็กราคาก่อนขาย/">เช็กราคาก่อนขาย</a> และ วิธีขาย
          </p>
          <div class="intake-motto">
            <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ SECTION -->
  <section class="section section-muted">
    <div class="container">
      <FAQ
        items={cameraFaqs}
        title="คำถามที่พบบ่อยเกี่ยวกับการรับซื้อกล้องและเลนส์"
        subtitle="ข้อสงสัยเกี่ยวกับแบรนด์ ฝุ่น/รา การแยกขายบอดี้หรือเลนส์ และชัตเตอร์"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .cam-hero-section {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    text-align: center;
  }

  .cam-badge {
    margin-bottom: 1rem;
  }

  .cam-title {
    font-size: 2.15rem;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .cam-title {
      font-size: 2.65rem;
    }
  }

  .cam-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Steps Grid (4-10) */
  .cam-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .cam-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cam-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cam-step-card {
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cam-step-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .cam-step-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .cam-step-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .cam-step-list {
    margin: 0.5rem 0 0 1.25rem;
    padding: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .cam-step-list li {
    margin-bottom: 0.25rem;
  }

  /* Provincial Card */
  .provincial-card {
    padding: 2.5rem 2rem;
    background-color: #ffffff;
  }

  .provincial-card h2 {
    font-size: 1.65rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .provincial-formula {
    font-size: 1.2rem;
    color: var(--color-primary);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    margin: 1rem 0 1.25rem 0;
    text-align: center;
  }

  .provincial-note {
    background-color: var(--color-bg-subtle);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-top: 1.25rem;
    margin-bottom: 0;
  }

  /* Intake Card */
  .intake-card {
    padding: 2.75rem 2rem;
    text-align: center;
    background-color: #ffffff;
  }

  .intake-card h2 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .intake-spec-box {
    font-size: 1.15rem;
    color: var(--color-primary);
    background-color: var(--color-accent-light);
    border: 1px solid #fde68a;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    margin: 1rem auto 1.25rem auto;
    max-width: 720px;
  }

  .cta-buttons-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .intake-phone {
    border-color: var(--color-border);
  }

  .intake-helper {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 620px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.6;
  }

  .intake-links-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .intake-links-footer a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .intake-motto {
    font-size: 1.15rem;
    color: var(--color-accent-hover);
    background-color: var(--color-accent-light);
    border: 1px solid #fde68a;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    max-width: 480px;
    margin: 1.25rem auto 0 auto;
  }
</style>
