---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อซากคอมพิวเตอร์ คอมเสีย เปิดไม่ติด และอะไหล่ | เรารับซื้อ.com";
const pageDescription = "รับซื้อซากคอมพิวเตอร์ คอมเสีย เปิดไม่ติด และชิ้นส่วนคอม ประเมินจาก CPU การ์ดจอ RAM SSD เมนบอร์ด PSU อาการและสภาพ ส่งสเปกกับรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อคอม', url: '/รับซื้อคอม/' },
  { name: 'รับซื้อซากคอมพิวเตอร์', url: '/รับซื้อซากคอมพิวเตอร์/' }
];

const faqs = [
  {
    question: "คอมเปิดไม่ติดยังขายได้ไหม?",
    answer: "บางกรณีสามารถส่งมาประเมินตามสภาพได้ เพราะแม้เครื่องเปิดไม่ติด อาจยังมี CPU, GPU, RAM, SSD หรือชิ้นส่วนอื่นที่มีมูลค่า ควรแจ้งสเปกที่ทราบ อาการ และส่งรูปภายในเครื่องประกอบ"
  },
  {
    question: "คอมเสียควรซ่อมก่อนขายหรือขายตามสภาพ?",
    answer: "ไม่จำเป็นต้องซ่อมทุกกรณี ควรเปรียบเทียบราคาตามสภาพ ค่าอะไหล่ ค่าแรง ความเสี่ยง และมูลค่าที่คาดว่าจะเพิ่มหลังซ่อมก่อนตัดสินใจ"
  },
  {
    question: "ขายซากคอมโดยไม่รวม SSD หรือ HDD ได้ไหม?",
    answer: "สามารถแจ้งว่าไม่รวม Storage ได้ โดยเฉพาะเมื่อ Drive มีข้อมูลส่วนตัวหรือข้อมูลบริษัท ราคาจะพิจารณาจากชิ้นส่วนที่ขายจริง"
  },
  {
    question: "คอมถูกถอดการ์ดจอหรือ RAM ออกแล้วขายได้ไหม?",
    answer: "สามารถส่งมาประเมินจากอุปกรณ์ที่ยังเหลืออยู่ได้ ควรแจ้งให้ชัดว่าชิ้นส่วนใดถูกถอดออก และไม่ควรใช้สเปกเดิมของเครื่องเป็นรายการสินค้าที่ขายปัจจุบัน"
  },
  {
    question: "มีซากคอมหรืออะไหล่หลายชิ้นประเมินอย่างไร?",
    answer: "สามารถจัดเป็นรายการหรือตาราง โดยระบุรุ่น จำนวน และสถานะของแต่ละชิ้นว่าใช้งานได้ มีอาการ เสีย หรือยังไม่ได้ทดสอบ เพื่อช่วยแยกมูลค่าของแต่ละกลุ่มได้ชัดเจนขึ้น"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อซากคอมพิวเตอร์ คอมเสีย เปิดไม่ติด เช็กมูลค่าชิ้นส่วนก่อนขาย</h1>
          <p class="hero-lead-text">มีคอมพิวเตอร์เสีย เปิดไม่ติด หรือเหลือเป็นชุดอะไหล่ แต่ยังไม่แน่ใจว่ามีชิ้นส่วนอะไรที่ยังมีมูลค่า?</p>
          <p>
            คอมที่เสียทั้งเครื่องไม่ควรถูกประเมินเหมือนเครื่องที่ใช้งานได้ปกติ แต่ก็ไม่ควรสรุปว่าไม่มีมูลค่าเพียงเพราะเปิดไม่ติด
          </p>
          <p>
            มูลค่าของซากคอมพิวเตอร์อาจอยู่ใน <strong>CPU, การ์ดจอ, RAM, SSD, เมนบอร์ด, Power Supply, Case และชิ้นส่วนอื่นที่ยังตรวจสอบหรือแยกประเมินได้</strong>
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนขายควรเริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>สเปกที่ทราบ + อาการ + รูปภายนอก + รูปภายใน + ชิ้นส่วนที่ยังอยู่</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-pc-parts-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-pc-parts-500.webp" type="image/webp" />
              <source srcset="/images/hero-pc-parts.avif" type="image/avif" />
              <source srcset="/images/hero-pc-parts.webp" type="image/webp" />
              <img
                src="/images/hero-pc-parts.webp"
                alt="รับซื้อซากคอมพิวเตอร์ คอมเสีย เปิดไม่ติด เช็กมูลค่าชิ้นส่วนก่อนขาย"
                width="1200"
                height="669"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: TYPES & COMPARISON -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ซากคอมพิวเตอร์แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งข้อมูลคอมพิวเตอร์เสียหรือชุดอะไหล่หลายลักษณะมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>คอมเปิดไม่ติด</li>
              <li>กด Power แล้วไม่มีอาการ</li>
              <li>มีไฟแต่ไม่ขึ้นภาพ</li>
              <li>เปิดแล้วดับ</li>
              <li>Restart เอง</li>
              <li>จอฟ้าหรือใช้งานไม่เสถียร</li>
              <li>เมนบอร์ดมีปัญหา</li>
              <li>การ์ดจอมีอาการ</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Power Supply เสียหรือไม่แน่ใจ</li>
              <li>เครื่องโดนน้ำหรือความชื้น</li>
              <li>เครื่องตกกระแทก</li>
              <li>Case เสียหาย</li>
              <li>คอมที่ถูกถอดบางชิ้นออกแล้ว</li>
              <li>เครื่องเก่าที่ไม่ได้ใช้งาน</li>
              <li>อะไหล่คอมแยกชิ้น</li>
              <li>คอมหลายเครื่องที่มีทั้งเครื่องดีและเครื่องเสีย</li>
            </ul>
          </div>
        </div>
        <p>การประเมินต้องดูว่ามีชิ้นส่วนอะไรอยู่จริงและสามารถตรวจสอบได้มากน้อยแค่ไหน</p>
      </div>

      <div class="comm-card" style="margin-top: 1.5rem;">
        <h2>ซากคอมต่างจากคอมมือสองปกติอย่างไร</h2>
        <p>หน้า <code>/รับซื้อคอม/</code> ใช้สำหรับ Desktop, Gaming PC และคอมประกอบที่ยังอยู่ในกลุ่มเครื่องใช้งานได้หรือสามารถทดสอบสเปกหลักได้</p>
        <p>ส่วนหน้า <code>/รับซื้อซากคอมพิวเตอร์/</code> ใช้กับเครื่องที่มีความเสียหายหรือความไม่แน่นอนสูงกว่า เช่น</p>
        <ul>
          <li>เปิดไม่ติด</li>
          <li>หลายชิ้นไม่ทำงาน</li>
          <li>ไม่สามารถ Boot ได้</li>
          <li>ไม่สามารถทดสอบ Hardware ได้ครบ</li>
          <li>ถูกถอดอุปกรณ์บางส่วนออก</li>
          <li>มีความเสียหายจากน้ำหรือตกกระแทก</li>
          <li>เหลือเป็นชุดอะไหล่</li>
        </ul>
        <p>จึงต้องประเมินจาก <strong>มูลค่าคงเหลือของชิ้นส่วนและความเสี่ยงในการตรวจสอบ</strong> มากกว่าราคาเครื่องใช้งานปกติ</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: DEAD PC DOES NOT MEAN ALL DEAD & SPECS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>คอมเปิดไม่ติดไม่ได้แปลว่าทุกชิ้นเสีย</h2>
          <p>เมื่อเครื่องเปิดไม่ติด สาเหตุอาจเกี่ยวข้องกับหลายส่วน เช่น</p>
          <ul>
            <li>Power Supply</li>
            <li>Mainboard</li>
            <li>CPU</li>
            <li>RAM</li>
            <li>GPU</li>
            <li>Storage</li>
            <li>สายไฟหรือ Connector</li>
            <li>ปุ่ม Power</li>
            <li>ระบบระบายความร้อน</li>
            <li>Firmware หรือการตั้งค่าบางประเภท</li>
          </ul>
          <p>แต่ไม่ควรระบุสาเหตุจากอาการเพียงอย่างเดียวโดยยังไม่ได้ตรวจ</p>
          <p>ตัวอย่างเช่น เครื่องเปิดไม่ติดอาจยังมี RAM, SSD, CPU หรือ GPU ที่สามารถมีมูลค่าแยกจากตัวเครื่องได้</p>
          <p>ดังนั้นไม่ควรรีบสรุปว่าทั้งชุดไม่มีมูลค่า</p>
        </div>

        <div class="comm-card">
          <h2>ก่อนขายควรรู้สเปกเท่าที่ทราบ</h2>
          <p>แม้เครื่องจะเปิดไม่ได้ หากยังทราบสเปกเดิมควรแจ้ง</p>
          <p>ข้อมูลที่มีประโยชน์ เช่น</p>
          <ul>
            <li>CPU</li>
            <li>GPU</li>
            <li>RAM</li>
            <li>SSD</li>
            <li>HDD</li>
            <li>Mainboard</li>
            <li>PSU</li>
            <li>Case</li>
            <li>Cooling</li>
            <li>อุปกรณ์เสริม</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><strong>CPU:</strong> Ryzen 5 5600</p>
          <p><strong>GPU:</strong> RTX 3060</p>
          <p><strong>RAM:</strong> 16GB</p>
          <p><strong>SSD:</strong> 512GB</p>
          <p><strong>Mainboard:</strong> B550</p>
          <p><strong>PSU:</strong> 650W</p>
          <p><strong>อาการ:</strong> กดเปิดแล้วไม่มีภาพ</p>
          <p>ข้อมูลลักษณะนี้ช่วยแยกชิ้นส่วนสำคัญก่อนตรวจสินค้า</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: UNKNOWN SPECS & CPU & GPU IN SCRAP PC -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ถ้าไม่รู้สเปกเลยทำอย่างไร</h2>
          <p>สามารถเริ่มจากรูปภายใน Case</p>
          <p>ควรถ่ายให้เห็น:</p>
          <ul>
            <li>เมนบอร์ด</li>
            <li>การ์ดจอ</li>
            <li>RAM</li>
            <li>CPU Cooler</li>
            <li>SSD หรือ HDD</li>
            <li>Power Supply</li>
            <li>Sticker หรือ Model ของอุปกรณ์</li>
            <li>สายที่เชื่อมต่อ</li>
            <li>จุดที่มีรอยไหม้หรือความเสียหายถ้าเห็นได้ชัด</li>
          </ul>
          <p>ไม่จำเป็นต้องถอดทุกชิ้นออกเพื่อถามราคาเบื้องต้น</p>
          <p>หากไม่มีความชำนาญ ควรหลีกเลี่ยงการถอดอุปกรณ์ที่อาจทำให้เกิดความเสียหายเพิ่ม</p>

          <h2 style="margin-top: 1.5rem;">CPU ในเครื่องเสียยังมีมูลค่าไหม</h2>
          <p>อาจมีได้ ขึ้นอยู่กับรุ่นและสภาพ</p>
          <p>CPU ควรแจ้งรหัสรุ่นเต็ม เช่น</p>
          <ul>
            <li>Intel Core i5-12400F</li>
            <li>Intel Core i7-12700</li>
            <li>AMD Ryzen 5 5600</li>
            <li>AMD Ryzen 7 5700X</li>
            <li>หรือรุ่นอื่น</li>
          </ul>
          <p>หากยังไม่ได้ทดสอบ ควรระบุว่า:</p>
          <p><strong>ยังไม่ได้ทดสอบ</strong></p>
          <p>ไม่ควรระบุว่าชิ้นส่วนใช้งานได้เพียงเพราะไม่มีรอยเสียหายภายนอก</p>
        </div>

        <div class="comm-card">
          <h2>การ์ดจอเป็นชิ้นส่วนที่ควรแยกข้อมูลให้ชัด</h2>
          <p>ใน Gaming PC หรือ Workstation การ์ดจออาจมีมูลค่าสูงเมื่อเทียบกับชิ้นส่วนอื่น</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>Brand</li>
            <li>Model</li>
            <li>รุ่น GPU</li>
            <li>ความจุ VRAM ถ้าทราบ</li>
            <li>อาการ</li>
            <li>พัดลมหมุนหรือไม่</li>
            <li>ขึ้นภาพหรือไม่</li>
            <li>เคยซ่อมหรือไม่</li>
            <li>มีรอยไหม้หรือความเสียหายหรือไม่</li>
          </ul>
          <p>ตัวอย่างอาการ:</p>
          <ul>
            <li>ไม่ขึ้นภาพ</li>
            <li>Driver Error</li>
            <li>ภาพแตก</li>
            <li>มี Artifact</li>
            <li>จอดับเมื่อใช้งาน</li>
            <li>พัดลมไม่หมุน</li>
            <li>เครื่องไม่เห็นการ์ด</li>
            <li>ยังไม่ได้ทดสอบ</li>
          </ul>
          <p>การ์ดจอมีอาการกับการ์ดที่ยังไม่ได้ทดสอบไม่ควรระบุเป็นสถานะเดียวกัน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: RAM, STORAGE & MOTHERBOARD -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM ที่เหลืออยู่ควรแจ้งอย่างไร</h2>
          <p>หากมองเห็นข้อมูลบน RAM ควรแจ้ง:</p>
          <ul>
            <li>DDR3 / DDR4 / DDR5</li>
            <li>ความจุต่อแถว</li>
            <li>จำนวนแถว</li>
            <li>Brand</li>
            <li>ความเร็วถ้าทราบ</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><strong>DDR4 8GB × 2 = 16GB</strong></p>
          <p>หากเครื่องเปิดไม่ได้และ RAM ยังไม่ได้ทดสอบ ให้ระบุว่า <strong>ยังไม่ได้ทดสอบ</strong></p>

          <h2 style="margin-top: 1.5rem;">SSD และ HDD ต้องระวังเรื่องข้อมูลส่วนตัว</h2>
          <p>Storage แตกต่างจากชิ้นส่วนอื่นเพราะอาจมีข้อมูลส่วนตัวหรือข้อมูลธุรกิจอยู่ภายใน</p>
          <p>ก่อนตัดสินใจขาย SSD หรือ HDD ควรพิจารณาว่ามีข้อมูลที่ต้องเก็บหรือไม่</p>
          <p>หากยังไม่แน่ใจ สามารถแจ้งตั้งแต่ตอนประเมินว่า:</p>
