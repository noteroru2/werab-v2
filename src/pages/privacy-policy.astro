---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { BUSINESS_FACTS } from '../config/business';
import { resolveSeo } from '../lib/seo/resolve';
const seo = resolveSeo('/privacy-policy/');
const breadcrumbs = [{ name: 'หน้าแรก', url: '/' }, { name: 'แนวทางความเป็นส่วนตัว', url: '/privacy-policy/' }];
---
<BaseLayout title={seo.title} description={seo.description} breadcrumbs={breadcrumbs}>
  <section class="commercial-section section-white">
    <div class="container container-narrow">
      <Breadcrumb items={breadcrumbs} />
      <div class="comm-card">
        <h1>{seo.h1}</h1>
        <p>{BUSINESS_FACTS.VERIFIED.brandName} ใช้ข้อมูลที่ผู้ขายส่งมาเพื่อการติดต่อและประเมินสินค้าเท่าที่จำเป็น เนื้อหาหน้านี้อธิบายแนวทางที่ผู้ใช้ควรทราบก่อนส่งข้อมูลผ่านช่องทางติดต่อของเว็บไซต์</p>
        <h2>ข้อมูลที่มักใช้ในการประเมินเบื้องต้น</h2>
        <ul><li>ชื่อหรือช่องทางติดต่อที่ผู้ขายเลือกให้</li><li>รูปสินค้า รุ่น สเปก ความจุ และสภาพ</li><li>ข้อมูลอุปกรณ์และอาการที่เกี่ยวกับมูลค่าสินค้า</li></ul>
        <h2>ข้อมูลที่ไม่ควรส่งเพื่อขอราคา</h2>
        <p>ไม่ควรส่ง Password, PIN, OTP, Recovery Key หรือข้อมูลบัญชีที่ไม่จำเป็นต่อการระบุรุ่นและสภาพสินค้า</p>
        <h2>ข้อมูลที่อยู่ในอุปกรณ์</h2>
        <p>ผู้ขายควรสำรองข้อมูล ออกจากบัญชี และล้างข้อมูลด้วยตนเองเมื่อพร้อมส่งมอบ หากอุปกรณ์มีข้อมูลบริษัทหรือข้อมูลสำคัญ ควรวางแผนจัดการ Storage และระบบบัญชีก่อนส่งมอบจริง</p>
        <h2>การใช้รูปและรายละเอียดสินค้า</h2>
        <p>รูปและรายละเอียดที่ส่งเข้ามาใช้เพื่อทำความเข้าใจสินค้าที่กำลังประเมินและติดต่อกลับตามการสนทนา ผู้ขายควรปิดบังข้อมูลส่วนตัวที่ไม่จำเป็นก่อนส่งภาพทุกครั้ง</p>
        <p>หากมีคำถามเกี่ยวกับข้อมูลที่จำเป็นต่อการประเมิน สามารถสอบถามผ่าน <a href="/contact/">ช่องทางติดต่อ</a> ก่อนส่งข้อมูลได้</p>
      </div>
    </div>
  </section>
</BaseLayout>
