---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import TrustBar from '../components/TrustBar.astro';
import CTA from '../components/CTA.astro';

const breadcrumbs = [
  { name: 'หมวดหมู่สินค้าที่รับซื้อ', url: '/รับซื้อ/' }
];
---

<BaseLayout
  title="หมวดหมู่สินค้าที่เรารับซื้อ | เรารับซื้อ.com"
  description="รวมหมวดหมู่สินค้าไอทีมือสองที่เรารับซื้อทุกประเภท โน๊ตบุ๊ค คอมพิวเตอร์ แมคบุ๊ค ไอโฟน ไอแพด กล้อง ลำโพง เครื่องเกม เช็กรายละเอียดได้ทันที"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="section" style="padding-top: 3rem; padding-bottom: 2rem; text-align: center;">
    <div class="container container-narrow">
      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">บริการรับซื้อสินค้าไอทีมือสองทุกหมวดหมู่</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted);">
        เรารับซื้อสินค้าไอทีหลากหลายประเภท โดยเน้นการประเมินราคาตามสเปกและสภาพการใช้งานจริงของอุปกรณ์
      </p>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container">
      <ServiceGrid />
    </div>
  </section>

  <CTA />
</BaseLayout>
