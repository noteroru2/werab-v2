---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อสินค้าไอทีมือสอง มีอะไรบ้าง | เรารับซื้อ.com";
const pageDescription = "รวมสินค้าที่รับซื้อ โน๊ตบุ๊ค คอม MacBook iPhone iPad กล้อง ลำโพง ซากคอม และ Server เลือกหมวดสินค้า ดูข้อมูลที่ต้องใช้ และเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' }
];

const faqs = [
  {
    question: "รับซื้อสินค้าไอทีประเภทไหนบ้าง?",
    answer: "สามารถส่ง Notebook คอม MacBook iPhone iPad กล้อง ลำโพง Server และอุปกรณ์ไอทีหลายประเภทมาประเมินได้ โดยต้องดูรุ่น สเปก สภาพและตลาดของสินค้าแต่ละประเภท"
  },
  {
    question: "สินค้ามีตำหนิหรือเสียยังเช็กราคาได้ไหม?",
    answer: "หลายกรณีสามารถประเมินตามสภาพได้ ควรแจ้งอาการและตำหนิอย่างชัดเจน เพราะเครื่องเสียหรือเครื่องมีปัญหาจะมีความเสี่ยงและต้นทุนต่างจากเครื่องปกติ"
  },
  {
    question: "ต้องมีอุปกรณ์ครบหรือมีกล่องไหม?",
    answer: "ไม่จำเป็นต้องครบทุกกรณี ควรแจ้งว่ามี Adapter สาย Charger Box หรืออุปกรณ์ใดอยู่บ้าง เพื่อประเมินจากชุดที่ขายจริง"
  },
  {
    question: "ไม่รู้รุ่นหรือสเปกสามารถสอบถามได้ไหม?",
    answer: "สามารถเริ่มจากส่งรูปสินค้า ป้ายรุ่น หรือหน้าจอข้อมูลระบบ เพื่อช่วยระบุข้อมูลเบื้องต้นก่อนประเมิน"
  },
  {
    question: "อยู่ต่างจังหวัดสามารถเริ่มเช็กราคาได้ไหม?",
    answer: "สามารถเริ่มส่งข้อมูลและรูปเพื่อประเมินเบื้องต้นก่อนได้ จากนั้นจึงค่อยพิจารณาวิธีส่งมอบหรือนัดหมายตามความเหมาะสม"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อสินค้าไอทีมือสอง เลือกประเภทสินค้าที่ต้องการขาย</h1>
          <p class="hero-lead-text">ต้องการขายสินค้าไอทีมือสอง แต่ยังไม่แน่ใจว่าควรส่งข้อมูลอะไรเพื่อเช็กราคา?</p>
          <p>สินค้าต่างประเภทใช้ข้อมูลในการประเมินไม่เหมือนกัน</p>
          <p>Notebook และคอมควรดูสเปก ส่วน iPhone และ iPad ต้องดูรุ่น ความจุ Battery และสภาพ ขณะที่กล้องต้องแยก Body กับ Lens</p>
          <p>หน้านี้จึงใช้เป็นทางเลือกหมวดสินค้าก่อนเริ่มประเมิน</p>
          <p style="font-weight: 700; color: var(--navy-950); margin: 0.5rem 0;">
            <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
          </p>

          <div class="hero-intake-card">
            <div class="hero-cta-bar" style="margin-top: 0;">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-it-products-640.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-it-products-640.webp" type="image/webp" />
              <source srcset="/images/hero-it-products.avif" type="image/avif" />
              <source srcset="/images/hero-it-products.webp" type="image/webp" />
              <img
                src="/images/hero-it-products.webp"
                alt="รับซื้อสินค้าไอทีมือสอง เลือกประเภทสินค้าที่ต้องการขาย"
                width="1097"
                height="777"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: PRODUCT CATEGORY SELECTION -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="section-header" style="text-align: left; margin-bottom: 2rem;">
        <h2>เลือกประเภทสินค้าที่ต้องการขาย</h2>
      </div>

      <div class="grid-2">
        <div class="comm-card">
          <h3><a href="/รับซื้อโน๊ตบุ๊ค/">โน๊ตบุ๊คและ Gaming Notebook</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>รุ่น + CPU + RAM + SSD + GPU + Battery + Adapter + รูป</strong></p>
          <p>เหมาะกับ Notebook, Laptop, Gaming Notebook และเครื่องที่มีตำหนิบางประเภท</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อคอม/">คอมพิวเตอร์ Desktop และ Gaming PC</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>CPU + GPU + RAM + SSD + Mainboard + PSU + รูปเครื่อง</strong></p>
          <p>คอมประกอบควรประเมินจากชิ้นส่วนจริง ไม่ควรดูเพียงราคาที่เคยประกอบมา</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อแมคบุ๊ค/">MacBook</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>รุ่น + Chip หรือ Processor + RAM + SSD + Battery + รูป + อุปกรณ์</strong></p>
          <p>ควรแยก Intel และ Apple Silicon ให้ชัด</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อไอโฟน/">iPhone</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>รุ่น + ความจุ + Battery Health + รูป + สภาพ + อาการ</strong></p>
          <p>ควรตรวจหน้าจอ Face ID หรือ Touch ID กล้องและประวัติซ่อม</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อไอแพด/">iPad</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>รุ่น + Generation + ความจุ + Wi-Fi/Cellular + รูป + สภาพ</strong></p>
          <p>หากมี Apple Pencil หรือ Keyboard ควรแจ้งแยก</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อกล้อง/">กล้องและเลนส์</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>รุ่น Body + รุ่น Lens + รูป + สภาพ + Shutter ถ้าทราบ + อุปกรณ์</strong></p>
          <p>Body และ Lens ควรแยกประเมินก่อนรวมเป็นชุด</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อลำโพง/">ลำโพง</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>Brand + Model + รูป + Battery + การเชื่อมต่อ + สภาพ + อุปกรณ์</strong></p>
          <p>ควรแจ้งหากเสียงแตก Battery เสื่อม หรือมีอาการเชื่อมต่อผิดปกติ</p>
        </div>

        <div class="comm-card">
          <h3><a href="/รับซื้อซากคอมพิวเตอร์/">ซากคอมพิวเตอร์และอุปกรณ์เสีย</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>ประเภทสินค้า + รุ่นหรือสเปกที่ทราบ + อาการ + รูป + ชิ้นส่วนที่ยังอยู่</strong></p>
          <p>เครื่องเสียหนักควรประเมินจากมูลค่าชิ้นส่วนที่เหลือ ไม่ควรใช้ราคาเครื่องปกติเป็นฐานตรง ๆ</p>
        </div>

        <div class="comm-card" style="grid-column: 1 / -1;">
          <h3><a href="/รับซื้อ-server/">Server และอุปกรณ์องค์กร</a></h3>
          <p>ควรเตรียม:</p>
          <p><strong>Brand + Model + CPU + RAM + Storage + Controller + จำนวน + สภาพ</strong></p>
          <p>หากมีหลายเครื่องควรทำเป็นรายการหรือตาราง</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: WHY SEPARATE & CONDITION -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ทำไมต้องแยกข้อมูลตามประเภทสินค้า</h2>
          <p>สินค้าไอทีแต่ละประเภทมีจุดที่ส่งผลต่อมูลค่าแตกต่างกัน</p>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>Notebook เน้น CPU, GPU, Battery และหน้าจอ</li>
            <li>Gaming PC เน้น GPU, CPU, PSU และชิ้นส่วนภายใน</li>
            <li>iPhone เน้นรุ่น ความจุ Battery และฟังก์ชันสำคัญ</li>
            <li>iPad เน้น Generation ความจุ หน้าจอและอุปกรณ์</li>
            <li>MacBook เน้น Chip, RAM, SSD, Battery และบัญชี</li>
            <li>กล้องเน้น Body, Lens, Sensor และ Shutter</li>
          </ul>
          <p>การส่งข้อมูลให้ตรงประเภทช่วยลดการถามซ้ำและช่วยให้ประเมินได้แม่นขึ้น</p>
        </div>

        <div class="comm-card">
          <h2>สินค้ามีตำหนิยังเช็กราคาได้ไหม</h2>
          <p>หลายกรณีสามารถส่งมาประเมินตามสภาพได้</p>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>จอแตก</li>
            <li>Battery เสื่อม</li>
            <li>ไม่มี Adapter</li>
            <li>มีรอย</li>
            <li>เคยซ่อม</li>
            <li>เปิดไม่ติด</li>
            <li>บางฟังก์ชันเสีย</li>
          </ul>
          <p>ควรแจ้งตำหนิตามจริงตั้งแต่ต้น</p>
          <p>การประเมินเครื่องมีตำหนิต้องเผื่อต้นทุนและความเสี่ยงต่างจากเครื่องปกติ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: REPAIR VS AS-IS & UNKNOWN SPECS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ควรซ่อมก่อนขายหรือไม่</h2>
          <p>ไม่จำเป็นต้องซ่อมทุกกรณี</p>
          <p>ก่อนซ่อมควรเปรียบเทียบ:</p>
          <ol>
            <li>ราคาตามสภาพปัจจุบัน</li>
            <li>ค่าใช้จ่ายในการซ่อม</li>
            <li>ความเสี่ยงของการซ่อม</li>
            <li>มูลค่าที่คาดว่าจะเพิ่ม</li>
            <li>ระยะเวลาที่ต้องใช้</li>
          </ol>
          <p>บางกรณีขายตามสภาพอาจเหมาะกว่า ขณะที่บางเครื่องอาจคุ้มกับการซ่อม</p>
          <p>ควรเช็กราคาก่อนตัดสินใจ</p>
        </div>

        <div class="comm-card">
          <h2>ไม่ทราบรุ่นหรือสเปกทำอย่างไร</h2>
          <p>สามารถเริ่มจากรูปได้</p>
          <p>ควรถ่าย:</p>
          <ul>
            <li>ตัวสินค้า</li>
            <li>ป้ายรุ่น</li>
            <li>Sticker</li>
            <li>หน้าจอข้อมูลระบบ</li>
            <li>Serial หรือข้อมูลที่จำเป็นโดยปิดบังส่วนที่ไม่ต้องการเปิดเผย</li>
            <li>จุดตำหนิ</li>
          </ul>
          <p>สำหรับคอมและ Notebook สามารถใช้ Task Manager หรือ System Information ช่วยดูสเปก</p>
          <p>สำหรับอุปกรณ์ Apple สามารถดูข้อมูลจาก Settings หรือ About This Mac</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: DATA PRIVACY & PROVINCES -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ต้องส่งข้อมูลส่วนตัวเพื่อเช็กราคาไหม</h2>
          <p>ไม่ควรส่งข้อมูลส่วนตัวที่ไม่จำเป็น</p>
          <p>ไม่ต้องส่ง:</p>
          <ul>
            <li>Password</li>
            <li>Apple ID Password</li>
            <li>OTP</li>
            <li>Recovery Key</li>
            <li>รหัสผ่านธนาคาร</li>
            <li>ข้อมูลบัญชีส่วนตัว</li>
          </ul>
          <p>หากรูปหน้าจอมีข้อมูลส่วนตัว สามารถปิดบังก่อนส่งได้</p>
          <p>การเช็กราคาเบื้องต้นควรใช้ข้อมูลสินค้าเป็นหลัก</p>
        </div>

        <div class="comm-card">
          <h2>อยู่ต่างจังหวัดเริ่มอย่างไร</h2>
          <p>สามารถเริ่มด้วยการส่งข้อมูลและรูปออนไลน์ก่อนได้</p>
          <p>ไม่จำเป็นต้องเดินทางพร้อมสินค้าทันทีเพียงเพื่อขอราคาประเมิน</p>
          <p>หลังจากทราบรายละเอียดเบื้องต้นแล้วจึงค่อยตกลงวิธีส่งมอบหรือนัดหมายตามประเภทสินค้า พื้นที่ และความเหมาะสม</p>
          <p>การมีหน้าบริการระดับประเทศไม่ได้หมายความว่ามีสาขาอยู่ในทุกจังหวัด</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคาก่อนขาย</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. เลือกประเภทสินค้า</h3>
              <p>Notebook, PC, MacBook, iPhone, iPad, กล้อง หรือตัวเลือกอื่น</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>2. ส่งรุ่นหรือสเปก</h3>
              <p>ให้ละเอียดเท่าที่ทราบ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>3. ส่งรูป</h3>
              <p>ถ่ายสินค้าจริงและตำหนิ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>4. แจ้งสภาพ</h3>
              <p>เปิดติดหรือไม่ มีอาการอะไร เคยซ่อมหรือไม่</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>5. แจ้งอุปกรณ์</h3>
              <p>กล่อง Adapter สาย Charger หรืออุปกรณ์อื่น</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>6. ประเมินเบื้องต้น</h3>
              <p>พิจารณาจากข้อมูลและสภาพ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>7. ตัดสินใจ</h3>
              <p>ผู้ขายสามารถเปรียบเทียบและพิจารณาก่อนขาย</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>8. ตรวจสินค้าและซื้อขาย</h3>
              <p>เมื่อเลือกดำเนินการจึงตรวจสภาพจริงให้ตรงกับข้อมูลที่ใช้ประเมิน</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาสินค้าของคุณ</h2>
        <p style="margin-bottom: 0.5rem;">ส่ง:</p>
        <p style="font-size: 1.25rem; font-weight: 800; color: #fdba74; margin-bottom: 1.5rem;">
          <strong>ชื่อสินค้า + รุ่น + สเปก + รูป + สภาพ + อุปกรณ์</strong>
        </p>
        <p style="margin-bottom: 1.5rem; color: #cbd5e1;">หากไม่ทราบรุ่น ให้เริ่มจากรูปสินค้าและป้ายข้อมูล</p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <p style="font-size: 1.05rem; font-weight: 700;">
          <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 7: FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อย" subtitle="" />
    </div>
  </section>
</BaseLayout>
