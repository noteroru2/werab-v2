---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คอำเภอพล ขอนแก่น Notebook มือสอง เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในอำเภอพล ขอนแก่น ส่งรุ่น CPU RAM SSD GPU แบตเตอรี่ รูป สภาพและอุปกรณ์เพื่อเช็กราคาเบื้องต้นก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คขอนแก่น",
    "url": "/รับซื้อโน๊ตบุ๊ค-ขอนแก่น/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คอำเภอพล ขอนแก่น เช็กรุ่นและสภาพก่อนขาย",
    "url": "/รับซื้อ-notebook-อำเภอพล-ขอนแก่น/"
  }
];

const faqs = [
  {
    "question": "อยู่ อำเภอพล ขอนแก่น ส่งข้อมูลโน๊ตบุ๊คประเมินราคาก่อนได้ไหม?",
    "answer": "ได้ ส่งรุ่น สเปก รูปสภาพ แบตเตอรี่ และอุปกรณ์ที่มีเพื่อเช็กราคาเบื้องต้นก่อนนัดหมายหรือจัดส่ง"
  },
  {
    "question": "อยู่ในอำเภอพลต้องนำเครื่องไปให้ดูก่อนถึงจะทราบราคาไหม?",
    "answer": "สามารถเริ่มจากส่ง Model สเปก รูป Battery อาการและอุปกรณ์เพื่อประเมินเบื้องต้นก่อน แล้วจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบ"
  },
  {
    "question": "Gaming Notebook ต้องแจ้ง GPU หรือไม่?",
    "answer": "ควรแจ้งรุ่น GPU เต็ม เพราะเครื่อง Series เดียวกันอาจมีหลาย Configuration และมีมูลค่าต่างกัน"
  },
  {
    "question": "เครื่องเปิดไม่ติดต้องซ่อมก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี สามารถเช็กราคาตามสภาพก่อน แล้วจึงเปรียบเทียบต้นทุนและความเสี่ยงของการซ่อม"
  },
  {
    "question": "ไม่มี Adapter ยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งว่าไม่มี Adapter ตั้งแต่ต้น และไม่จำเป็นต้องซื้อใหม่ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คอำเภอพล ขอนแก่น เช็กรุ่นและสภาพก่อนขาย</h1>
        
        
        <p>หน้านี้ไม่ได้ใช้แทนหน้าขอนแก่นระดับจังหวัด และไม่ได้ใช้แทนหน้ารับซื้อ Notebook หลัก</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">หากมี Notebook อยู่ในอำเภอพลและกำลังคิดว่าจะขาย สามารถเริ่มจากส่งข้อมูลของเครื่องก่อน:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + รูป + Adapter + อาการ</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คอำเภอพล ขอนแก่น เช็กรุ่นและสภาพก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนเดินทางควรส่งข้อมูลเครื่องให้ครบก่อน</h2>
        <p>Notebook อาจมีมูลค่าต่างกันมากแม้ชื่อ Series เหมือนกัน</p>
        <p>การส่งรูปอย่างเดียวอาจยังไม่พอ</p>
        <p>ข้อมูลที่ช่วยแยกเครื่องได้คือ:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>CPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>GPU ถ้ามี</li>
        <li>Battery</li>
        <li>Adapter</li>
        <li>สภาพหน้าจอ</li>
        <li>ตำหนิ</li>
        <li>ประวัติซ่อมถ้าทราบ</li>
        </ul>
        <p>หลังทราบข้อมูลเบื้องต้นแล้วจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Model เต็มสำคัญกว่าชื่อบนฝาเครื่อง</h2>
        <p>คำว่า:</p>
        <p><strong>ASUS VivoBook</strong></p>
        <p><strong>Acer Aspire</strong></p>
        <p><strong>Lenovo IdeaPad</strong></p>
        <p>หรือชื่อ Series อื่น</p>
        <p>อาจครอบคลุมหลาย Generation และหลาย Configuration</p>
        <p>ควรตรวจ Model จาก:</p>
        <ul>
        <li>Sticker ใต้เครื่อง</li>
        <li>BIOS</li>
        <li>System Information</li>
        <li>About</li>
        <li>กล่องเดิม</li>
        </ul>
        <p>ถ้าอ่านรุ่นไม่ชัด สามารถถ่ายรูปป้ายใต้เครื่องประกอบได้</p>
        </div>
        <div class="comm-card">
          <h2>CPU ควรแจ้งเป็นรหัสเต็ม</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>Intel Core i5-1135G7</strong></p>
        <p><strong>Intel Core i5-12450H</strong></p>
        <p><strong>AMD Ryzen 5 5500U</strong></p>
        <p><strong>AMD Ryzen 7 7735HS</strong></p>
        <p>ข้อมูลนี้ช่วยแยก Generation ได้ดีกว่าการแจ้งเพียง Core i5 หรือ Ryzen 7</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Gaming Notebook ต้องแจ้ง GPU</h2>
        <p>หากเป็น Gaming Notebook ควรแจ้งการ์ดจอด้วย เช่น</p>
        <ul>
        <li>GTX Series</li>
        <li>RTX Series</li>
        <li>Radeon รุ่นที่ติดตั้งในเครื่อง</li>
        </ul>
        <p>ควรใช้รุ่นเต็มเท่าที่ตรวจได้</p>
        <p>Gaming Notebook Series เดียวกันอาจมี CPU และ GPU หลายแบบ จึงไม่ควรประเมินจากชื่อเครื่องเพียงอย่างเดียว</p>
        </div>
        <div class="comm-card">
          <h2>RAM และ SSD ต้องใช้ Configuration ปัจจุบัน</h2>
        <p>หากเครื่องเคยอัปเกรดควรแจ้งสิ่งที่ติดตั้งอยู่จริง</p>
        <p>ตัวอย่าง:</p>
        <p><strong>RAM 16GB / SSD 512GB</strong></p>
        <p>หากตั้งใจถอด SSD เก็บไว้ก่อนขาย ควรแจ้งว่า:</p>
        <p><strong>ไม่รวม SSD</strong></p>
        <p>ตั้งแต่ขั้นตอนเช็กราคา</p>
        <p>ราคาควรอิง Hardware ที่จะส่งมอบจริง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery เสื่อมหรือไม่เก็บไฟยังเช็กราคาได้</h2>
        <p>ควรแจ้งอาการ เช่น</p>
        <ul>
        <li>Battery ใช้งานได้ปกติ</li>
        <li>หมดเร็ว</li>
        <li>ไม่เก็บไฟ</li>
        <li>ต้องเสียบ Adapter</li>
        <li>Battery Health ต่ำ</li>
        <li>เคยเปลี่ยน Battery</li>
        <li>Battery บวม</li>
        </ul>
        <p>หาก Battery บวม ไม่ควรกดบริเวณที่นูนหรือใช้งานเครื่องหนักโดยไม่จำเป็น</p>
        </div>
        <div class="comm-card">
          <h2>หน้าจอและบานพับมีผลต่อสภาพเครื่อง</h2>
        <p>ควรถ่าย:</p>
        <ul>
        <li>หน้าจอขณะเปิด</li>
        <li>ฝาหลัง</li>
        <li>บานพับซ้ายและขวา</li>
        <li>Keyboard</li>
        <li>Palmrest</li>
        <li>ด้านล่าง</li>
        </ul>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>จอเป็นเส้น</li>
        <li>จุดดำ</li>
        <li>จอกระพริบ</li>
        <li>จอแตก</li>
        <li>บานพับหลวม</li>
        <li>ฝาแตก</li>
        <li>ตัวเครื่องแยก</li>
        </ul>
        <p>ไม่ควรสรุปสาเหตุของอาการหากยังไม่ได้ตรวจ Hardware</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ไม่มี Adapter ยังส่งมาประเมินได้</h2>
        <p>สามารถแจ้งว่าไม่มี Adapter ได้</p>
        <p>ไม่จำเป็นต้องรีบซื้อ Adapter ใหม่ก่อนทราบว่า:</p>
        <ul>
        <li>ราคาตามสภาพปัจจุบันเท่าไร</li>
        <li>Adapter มีต้นทุนเท่าไร</li>
        <li>มูลค่าที่เพิ่มขึ้นคุ้มกับต้นทุนหรือไม่</li>
        </ul>
        <p>หากมี Adapter เทียบก็ควรแจ้งตามจริง</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดควรแจ้งอาการแบบไหน</h2>
        <p>หากเปิดไม่ได้ ให้ส่งข้อมูลที่ทราบ เช่น</p>
        <ul>
        <li>Model</li>
        <li>CPU</li>
        <li>GPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>Adapter</li>
        <li>ไฟสถานะ</li>
        <li>Fan</li>
        <li>อาการก่อนเสีย</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หากมีกลิ่นไหม้ ความร้อนผิดปกติ หรือ Battery บวม ไม่ควรทดลองเปิดหรือชาร์จซ้ำหลายครั้งเพียงเพื่อเช็กราคา</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Notebook เคยซ่อมยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินตามสภาพได้</p>
        <p>ควรแจ้งหากทราบว่าเคย:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>ซ่อม Mainboard</li>
        <li>เปลี่ยน Keyboard</li>
        <li>เพิ่ม RAM</li>
        <li>เปลี่ยน SSD</li>
        <li>ซ่อมบานพับ</li>
        <li>ซ่อมระบบชาร์จ</li>
        <li>โดนน้ำ</li>
        </ul>
        <p>ประวัติซ่อมช่วยอธิบายสภาพ ไม่ได้หมายความว่าเครื่องจะไม่มีมูลค่า</p>
        </div>
        <div class="comm-card">
          <h2>ข้อมูลส่วนตัวไม่ต้องส่งเพื่อเช็กราคา</h2>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>เพื่อขอราคาประเมิน Hardware</p>
        <p>เจ้าของควรสำรองและจัดการข้อมูลของตนเองก่อนส่งมอบจริง</p>
        <p>หากต้องการเก็บ SSD สามารถแจ้งได้ตั้งแต่ต้น</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา Notebook ในอำเภอพล</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Model</h3>
              <p>ใช้ชื่อรุ่นเต็มเท่าที่ตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. ส่ง CPU</h3>
              <p>ระบุ Generation และรุ่น</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่ง RAM และ SSD</h3>
              <p>ใช้ Configuration ปัจจุบัน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. ส่ง GPU ถ้ามี</h3>
              <p>สำคัญสำหรับ Gaming Notebook</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery</h3>
              <p>Health หรืออาการ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. ส่งรูป</h3>
              <p>รวมหน้าจอ บานพับและตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้ง Adapter</h3>
              <p>เดิม เทียบ หรือไม่มี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติซ่อม</h3>
              <p>เท่าที่ทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เช็กราคาเบื้องต้น</h3>
              <p>ก่อนตัดสินใจเดินทางหรือซ่อม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้าก่อนซื้อขาย</h3>
              <p>ยืนยันรุ่น สเปก สภาพและสิ่งที่รวมขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
