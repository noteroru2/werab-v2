---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อ Server มือสอง เซิร์ฟเวอร์องค์กร เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ Server มือสองและเซิร์ฟเวอร์องค์กร ประเมินจากรุ่น CPU RAM ECC Storage RAID Controller Network PSU สภาพและอุปกรณ์ ส่งสเปกกับรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อ Server', url: '/รับซื้อ-server/' }
];

const faqs = [
  {
    question: "Server มือสองต้องส่งข้อมูลอะไรเพื่อเช็กราคา?",
    answer: "ควรส่ง Brand, Model, CPU, RAM, Storage, RAID Controller, Network Card, PSU, จำนวน และรูปเครื่อง หากมีหลาย Configuration ควรแยกข้อมูลแต่ละกลุ่ม"
  },
  {
    question: "Server ไม่มี HDD หรือ SSD ยังขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งว่าไม่รวม Storage และระบุว่า Drive Tray หรือ Caddy ยังอยู่หรือไม่ ราคาจะพิจารณาจาก Hardware ที่รวมขายจริง"
  },
  {
    question: "Server เปิดไม่ติดหรือมี Hardware Error ยังขายได้ไหม?",
    answer: "บางกรณีสามารถส่งมาประเมินตามสภาพได้ ควรแจ้ง Model, Configuration, อาการ, Error Code หรือไฟสถานะ และประวัติซ่อมเท่าที่ทราบ"
  },
  {
    question: "Server มีข้อมูลบริษัทอยู่ใน HDD ต้องทำอย่างไร?",
    answer: "ควรให้เจ้าของข้อมูลหรือผู้รับผิดชอบระบบกำหนดวิธี Backup ล้างข้อมูล หรือเก็บ Drive ไว้ก่อนขาย หากยังไม่พร้อมสามารถขอประเมิน Server โดยไม่รวม Storage ได้ และไม่ควรส่ง Password หรือข้อมูลลับเพื่อขอราคา"
  },
  {
    question: "มี Server หลายเครื่องจากบริษัทประเมินอย่างไร?",
    answer: "ควรจัดรายการตาม Model, CPU, RAM, Storage, Controller, จำนวนและสภาพ หาก Configuration ต่างกันควรแยกแต่ละกลุ่ม เพื่อให้ประเมินจากอุปกรณ์ที่มีอยู่จริงได้ชัดเจนขึ้น"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ Server มือสอง เช็กสเปก อุปกรณ์ และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">มี Server มือสองจากบริษัท สำนักงาน หรือระบบเดิมที่เลิกใช้งาน แต่ยังไม่แน่ใจว่าควรแจ้งข้อมูลอะไรเพื่อประเมินราคา?</p>
          <p>
            Server ต้องดูรายละเอียดมากกว่าชื่อรุ่นเพียงอย่างเดียว เพราะเครื่องรุ่นเดียวกันอาจติดตั้ง <strong>CPU, RAM, Storage, RAID Controller, Network Card, Power Supply และอุปกรณ์ภายใน</strong> ต่างกันมาก
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนขายควรเริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>Brand + Model + Service Tag/Serial ที่ไม่ใช่ข้อมูลลับ + CPU + RAM + Storage + Controller + รูปเครื่อง + สภาพ</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-server-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-server-500.webp" type="image/webp" />
              <source srcset="/images/hero-server.avif" type="image/avif" />
              <source srcset="/images/hero-server.webp" type="image/webp" />
              <img
                src="/images/hero-server.webp"
                alt="รับซื้อ Server มือสอง Rack Server Tower Server Dell PowerEdge HPE ProLiant เช็กสเปก อุปกรณ์ และสภาพก่อนขาย"
                width="1075"
                height="649"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: SERVER TYPES -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>Server แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งข้อมูล Server มือสองหลายประเภทมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>Rack Server</li>
              <li>Tower Server</li>
              <li>Enterprise Server</li>
              <li>Server สำหรับสำนักงาน</li>
              <li>File Server</li>
              <li>Application Server</li>
              <li>Virtualization Server</li>
              <li>Server ที่เลิกใช้งานจากระบบเดิม</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Server ที่ถอด Storage ออกแล้ว</li>
              <li>Server ที่เพิ่ม RAM หรือ Storage ภายหลัง</li>
              <li>Server ที่มีหลาย CPU</li>
              <li>Server ที่มีหลาย Power Supply</li>
              <li>Server ที่มีอุปกรณ์เสริมเฉพาะ</li>
              <li>Server หลายเครื่องจากบริษัทหรือองค์กร</li>
              <li>Server ที่มีอาการบางประเภท</li>
              <li>Server ที่ยังไม่ได้ทดสอบ</li>
            </ul>
          </div>
        </div>
        <p>การประเมินต้องดูรุ่น Configuration และสภาพจริงของแต่ละเครื่อง</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BRAND, MODEL & RACK VS TOWER -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายต้องรู้ Brand และ Model ให้ชัด</h2>
          <p>Server แต่ละตระกูลมีหลาย Generation และหลาย Configuration</p>
          <p>ข้อมูลที่ควรหา เช่น</p>
          <ul>
            <li>Brand</li>
            <li>Model</li>
            <li>Generation</li>
            <li>Form Factor</li>
            <li>Service Tag หรือ Serial Number หากใช้ตรวจรุ่นได้และไม่เกี่ยวข้องกับข้อมูลบัญชี</li>
            <li>รุ่น Chassis</li>
            <li>จำนวน Bay</li>
            <li>Configuration ปัจจุบัน</li>
          </ul>
          <p>ตัวอย่างแบรนด์ที่พบในตลาด เช่น</p>
          <ul>
            <li>Dell</li>
            <li>HPE</li>
            <li>Lenovo</li>
            <li>Cisco</li>
            <li>Supermicro</li>
            <li>Fujitsu</li>
            <li>IBM รุ่นเก่า</li>
            <li>และแบรนด์อื่น</li>
          </ul>
          <p>ไม่ควรประเมินจากคำว่า “Server Dell” หรือ “Server HP” เพียงอย่างเดียว</p>
        </div>

        <div class="comm-card">
          <h2>Rack Server กับ Tower Server ควรแยกให้ชัด</h2>
          <p>Server อาจมีรูปแบบตัวเครื่องต่างกัน</p>
          <h3>Rack Server</h3>
          <p>มักติดตั้งใน Rack และควรดูข้อมูลเพิ่ม เช่น</p>
          <ul>
            <li>ขนาด 1U, 2U หรือรูปแบบอื่น</li>
            <li>Rail</li>
            <li>Front Bezel</li>
            <li>จำนวน Drive Bay</li>
            <li>Power Supply</li>
            <li>Network Interface</li>
          </ul>
          <h3>Tower Server</h3>
          <p>รูปทรงคล้ายเครื่อง Tower แต่ Hardware และระบบภายในออกแบบสำหรับงาน Server</p>
          <p>ควรแจ้ง Model ให้ชัดเพื่อไม่ให้สับสนกับ Desktop หรือ Workstation</p>

          <h2 style="margin-top: 1.5rem;">Server ต่างจากคอมพิวเตอร์มือสองทั่วไปอย่างไร</h2>
          
          
          <ul>
            <li>Xeon หรือ CPU สำหรับ Server</li>
            <li>ECC Memory</li>
            <li>RAID Controller</li>
            <li>Hot-Swap Drive Bay</li>
            <li>Redundant Power Supply</li>
            <li>Management Interface</li>
            <li>Enterprise Network Card</li>
            <li>Rack Chassis</li>
            <li>Hardware Configuration หลายรูปแบบ</li>
          </ul>
          <p>จึงควรใช้ข้อมูลการประเมินเฉพาะสำหรับ Server แยกจากคอมพิวเตอร์ทั่วไป</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CPU & RAM -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>CPU เป็นข้อมูลสำคัญของ Server</h2>
          <p>ควรแจ้งรุ่น CPU เต็มถ้าทราบ เช่น</p>
          <ul>
            <li>Intel Xeon E Series</li>
            <li>Intel Xeon Silver</li>
            <li>Intel Xeon Gold</li>
            <li>Intel Xeon รุ่นอื่น</li>
            <li>AMD EPYC</li>
            <li>CPU สำหรับ Server รุ่นอื่น</li>
          </ul>
          <p>และควรแจ้ง:</p>
          <ul>
            <li>จำนวน CPU ที่ติดตั้ง</li>
            <li>รุ่นของแต่ละ CPU</li>
            <li>จำนวน Core ถ้าทราบ</li>
            <li>เครื่องรองรับหลาย Socket หรือไม่</li>
            <li>CPU ถูกถอดออกบางตัวหรือไม่</li>
          </ul>
          <p>Server Chassis เดียวกันอาจมี Configuration CPU ต่างกันมาก จึงไม่ควรใช้ราคา Chassis อย่างเดียวเป็นฐาน</p>

          <h2 style="margin-top: 1.5rem;">Server มี CPU สองตัวต้องแจ้งทั้งสองตัวไหม</h2>
          <p>ควรแจ้ง</p>
          <p>ตัวอย่าง:</p>
          <p><strong>CPU: Xeon Silver รุ่น... × 2</strong></p>
          <p>หากเครื่องรองรับ Dual CPU แต่ติดตั้งเพียง 1 ตัว ควรแจ้งว่า:</p>
          <p><strong>ติดตั้ง CPU 1 ตัว</strong></p>
          <p>ไม่ควรสรุปว่ามี 2 CPU เพียงเพราะ Mainboard มี 2 Socket</p>
        </div>

        <div class="comm-card">
          <h2>RAM Server ต้องดูอะไร</h2>
          <p>RAM เป็นอีกส่วนที่มีผลต่อ Configuration</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>ความจุรวม</li>
            <li>จำนวนแถว</li>
            <li>ความจุต่อแถว</li>
            <li>DDR Generation</li>
            <li>ECC หรือไม่ถ้าทราบ</li>
            <li>Registered / RDIMM / LRDIMM ถ้าทราบ</li>
            <li>ความเร็ว</li>
            <li>มี Slot ว่างหรือไม่</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><strong>RAM 128GB ECC — 32GB × 4</strong></p>
          <p>หากไม่ทราบรายละเอียดทั้งหมด ให้แจ้งความจุรวมและถ่ายรูป Label ของ RAM เท่าที่ทำได้อย่างปลอดภัย</p>

          <h2 style="margin-top: 1.5rem;">ECC RAM มีผลต่อการประเมินไหม</h2>
          <p>มีผลใน Server หลายประเภท เพราะประเภท RAM ต้องเข้ากันกับ Platform และ Configuration ของเครื่อง</p>
          <p>แต่ไม่ควรสรุปจากรูปลักษณ์เพียงอย่างเดียว</p>
          <p>หากไม่แน่ใจ ให้ส่ง:</p>
          <ul>
            <li>Model Server</li>
            <li>รูป RAM</li>
            <li>Part Number</li>
            <li>ข้อมูลจาก BIOS หรือระบบที่อ่านได้</li>
          </ul>
          <p>เพื่อใช้ประกอบการตรวจรุ่น</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: STORAGE & DATA SECURITY -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Storage ต้องแจ้งทั้งจำนวนและประเภท</h2>
          <p>Server อาจติดตั้ง Storage หลายลูก</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>SSD หรือ HDD</li>
            <li>SAS / SATA / NVMe ถ้าทราบ</li>
            <li>ความจุต่อ Drive</li>
            <li>จำนวน Drive</li>
            <li>มี Tray/Caddy หรือไม่</li>
            <li>Drive ถูกถอดออกบางส่วนหรือไม่</li>
            <li>สถานะการทำงานถ้าทราบ</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><strong>SAS 1.2TB × 4 พร้อม Caddy</strong></p>
          <p>หรือ</p>
          <p><strong>ขายเครื่องไม่รวม Drive</strong></p>
          <p>ต้องประเมินจากอุปกรณ์ที่ขายจริง</p>

          <h2 style="margin-top: 1.5rem;">Server ไม่มี HDD หรือ SSD ยังขายได้ไหม</h2>
          <p>สามารถส่งมาประเมินได้</p>
          <p>Server ที่ถอด Storage ออกแล้วควรแจ้งชัดว่า:</p>
          <p><strong>ไม่รวม Storage</strong></p>
          <p>และควรแจ้งว่า Drive Tray หรือ Caddy ยังอยู่หรือถูกถอดไปด้วย</p>
          <p>Chassis, CPU, RAM, Controller, PSU และอุปกรณ์อื่นยังสามารถเป็นส่วนหนึ่งของการประเมินได้</p>
        </div>

        <div class="comm-card">
          <h2>ข้อมูลใน Server ต้องจัดการก่อนขายอย่างไร</h2>
          <p>Server มักมีข้อมูลบริษัท ระบบงาน ฐานข้อมูล หรือข้อมูลภายในองค์กรอยู่ใน Storage</p>
          <p>ก่อนขายควรตัดสินใจให้ชัดว่า:</p>
          <ul>
            <li>จะเก็บ Drive ไว้</li>
            <li>จะ Backup ข้อมูล</li>
            <li>จะล้างข้อมูลตามนโยบายองค์กร</li>
            <li>หรือจะขาย Storage รวมด้วย</li>
          </ul>
          <p>หากยังไม่พร้อมจัดการข้อมูล สามารถขอประเมินตัว Server โดย:</p>
          <p><strong>ไม่รวม Storage</strong></p>
          <p>ได้</p>
          <p>ไม่ควรส่ง:</p>
          <ul>
            <li>Password</li>
            <li>Root Password</li>
            <li>Domain Credential</li>
            <li>Administrator Password</li>
            <li>Encryption Key</li>
            <li>Recovery Key</li>
            <li>API Key</li>
            <li>ข้อมูลลูกค้า</li>
            <li>ข้อมูลลับของบริษัท</li>
          </ul>
          <p>เพื่อขอราคาประเมินเบื้องต้น</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: RAID, NETWORK, PSU, RAIL & MANAGEMENT -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAID Controller มีผลต่อราคาไหม</h2>
          <p>มีผลใน Server หลายรุ่น</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>รุ่น Controller</li>
            <li>มี Cache หรือไม่ถ้าทราบ</li>
            <li>มี Battery/Cache Protection Module หรือไม่</li>
            <li>จำนวน Drive ที่เชื่อมต่อ</li>
            <li>Controller เดิมยังอยู่หรือถูกถอดออก</li>
            <li>มีอาการ Error หรือไม่</li>
