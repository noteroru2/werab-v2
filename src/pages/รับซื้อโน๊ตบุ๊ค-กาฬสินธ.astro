---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คกาฬสินธุ์ Notebook Laptop เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในกาฬสินธุ์ Notebook Laptop และ Gaming Notebook ประเมินจากรุ่น CPU RAM SSD GPU Battery หน้าจอ สภาพและอุปกรณ์ก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คกาฬสินธุ์ เช็กสเปก Battery และสภาพก่อนขาย",
    "url": "/รับซื้อโน๊ตบุ๊ค-กาฬสินธ/"
  }
];

const faqs = [
  {
    "question": "Notebook รุ่นเก่ายังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้ง Model สเปก Battery และสภาพปัจจุบันเพื่อประเมินก่อนว่าควรขายตามสภาพหรือซ่อม"
  },
  {
    "question": "เปลี่ยน SSD หรือเพิ่ม RAM มาแล้วต้องแจ้งไหม?",
    "answer": "ควรแจ้ง Configuration ปัจจุบัน เพราะราคาควรอิง Hardware ที่รวมขายจริง"
  },
  {
    "question": "Battery ไม่เก็บไฟยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการและ Adapter ที่ใช้ และไม่จำเป็นต้องเปลี่ยน Battery ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "เครื่องเปิดไม่ติดต้องซ่อมก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี สามารถเช็กราคาตามสภาพก่อนแล้วเปรียบเทียบกับต้นทุนและความเสี่ยงในการซ่อม"
  },
  {
    "question": "ขายโดยเก็บ SSD ไว้ได้หรือไม่?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ ราคาจะประเมินจาก Configuration ที่ขายจริง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อโน๊ตบุ๊คกาฬสินธุ์ เช็กสเปก Battery และสภาพก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค-กาฬสินธ/</code> รักษา Historical Search Intent:</p>
        <p><strong>Notebook + Kalasin</strong></p>
        <p>แม้ URL เดิมจะเป็นคำที่ถูกตัดทอน แต่ไม่ควรเปลี่ยนเส้นทางเพียงเพื่อให้ URL ดูสวยขึ้น เพราะเส้นทางเดิมมีประวัติการค้นหาของตนเอง</p>
        <p>การประเมินเริ่มจาก:</p>
        <p><strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + รูป + Adapter</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>Notebook ในกาฬสินธุ์เริ่มเช็กราคาจากข้อมูลเครื่องได้</h2>
        <p>หากยังไม่แน่ใจว่าจะขายหรือซ่อม สามารถเริ่มจากส่งข้อมูลโดยไม่จำเป็นต้องเดินทางพร้อมเครื่องเพื่อถามราคา</p>
        <p>ควรเตรียม:</p>
        <ul>
        <li>Model</li>
        <li>สเปก</li>
        <li>Battery</li>
        <li>รูป</li>
        <li>Adapter</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>แล้วค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำในทุกพื้นที่ของจังหวัดกาฬสินธุ์</p>
        <hr class="section-divider" />
        <h2>Notebook ที่ใช้งานมาหลายปีควรตรวจ Configuration ปัจจุบัน</h2>
        <p>เครื่องที่ใช้งานมานานอาจผ่านการ:</p>
        <ul>
        <li>เพิ่ม RAM</li>
        <li>เปลี่ยน SSD</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยน Keyboard</li>
        <li>ซ่อมจอ</li>
        </ul>
        <p>ดังนั้นข้อมูลปัจจุบันสำคัญกว่าสเปกในใบโฆษณาตอนซื้อใหม่</p>
        <hr class="section-divider" />
        <h2>CPU ช่วยบอก Generation ของเครื่อง</h2>
        <p>ควรแจ้งรหัสเต็ม เช่น:</p>
        <p><strong>Intel Core i5-10210U</strong></p>
        <p><strong>Intel Core i5-1235U</strong></p>
        <p><strong>AMD Ryzen 5 5500U</strong></p>
        <p>แทนการแจ้งเพียง:</p>
        <p><strong>Core i5</strong></p>
        <p>เพราะ CPU คนละ Generation อาจมีประสิทธิภาพและอายุ Platform ต่างกัน</p>
        <hr class="section-divider" />
        <h2>Gaming Notebook ควรแจ้ง GPU และ Adapter</h2>
        <p>หากมี Dedicated GPU ควรแจ้งรุ่น เช่น:</p>
        <ul>
        <li>GTX Series</li>
        <li>RTX Series</li>
        <li>Radeon</li>
        </ul>
        <p>รวมถึง Adapter ที่ใช้</p>
        <p>Gaming Notebook บาง Series มีหลาย Configuration แม้ตัวเครื่องภายนอกใกล้เคียงกัน</p>
        <hr class="section-divider" />
        <h2>Battery เก่ากับเครื่องเสียต้องแยกกัน</h2>
        <p>Battery เสื่อมไม่ได้หมายความว่า Notebook ทั้งเครื่องเสีย</p>
        <p>ควรแจ้งอาการ เช่น:</p>
        <ul>
        <li>Battery อยู่ได้ไม่นาน</li>
        <li>ต้องเสียบ Adapter</li>
        <li>Battery ไม่เก็บไฟ</li>
        <li>เครื่องชาร์จไม่เข้า</li>
        <li>Battery บวม</li>
        </ul>
        <p>หากยังไม่ทราบสาเหตุของการชาร์จไม่เข้า ไม่ควรสรุปว่าเสีย Battery หรือ Mainboard โดยไม่ได้ตรวจ</p>
        <hr class="section-divider" />
        <h2>SSD มีข้อมูลสำคัญสามารถเก็บไว้ได้</h2>
        <p>หากไม่ต้องการขาย Storage สามารถแจ้งว่า:</p>
        <p><strong>ไม่รวม SSD</strong></p>
        <p>ตั้งแต่ต้น</p>
        <p>การประเมินจะอิง Configuration ที่ขายจริง</p>
        <p>เพื่อถามราคาไม่จำเป็นต้องให้ Password หรือข้อมูลภายใน SSD</p>
        <hr class="section-divider" />
        <h2>หน้าจอควรตรวจตอนเปิดใช้งาน</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>เส้น</li>
        <li>จุด</li>
        <li>จอแตก</li>
        <li>กระพริบ</li>
        <li>สีเพี้ยน</li>
        <li>แสงผิดปกติ</li>
        <li>ไม่มีภาพ</li>
        </ul>
        <p>หากต่อจอนอกแล้วใช้งานได้ สามารถแจ้งข้อมูลนี้ประกอบโดยไม่ต้องสรุปสาเหตุเอง</p>
        <hr class="section-divider" />
        <h2>Keyboard และ Port มีผลต่อความพร้อมใช้งาน</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ปุ่มเสีย</li>
        <li>Keyboard บางปุ่มกดไม่ติด</li>
        <li>Touchpad มีปัญหา</li>
        <li>USB เสีย</li>
        <li>HDMI มีปัญหา</li>
        <li>Port ชาร์จหลวม</li>
        <li>Speaker มีเสียงผิดปกติ</li>
        </ul>
        <p>ข้อมูลเหล่านี้ช่วยอธิบายสภาพของเครื่องได้ครบขึ้น</p>
        <hr class="section-divider" />
        <h2>เครื่องเปิดไม่ติดไม่จำเป็นต้องรีบซ่อม</h2>
        <p>สามารถเริ่มจากเช็กราคาตามสภาพก่อน</p>
        <p>ส่ง:</p>
        <ul>
        <li>Model</li>
        <li>สเปกที่ทราบ</li>
        <li>Adapter</li>
        <li>รูป</li>
        <li>ไฟสถานะ</li>
        <li>อาการก่อนเสีย</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>จากนั้นจึงค่อยเปรียบเทียบว่าค่าใช้จ่ายในการซ่อมเหมาะสมหรือไม่</p>
        <p>หาก Battery บวม มีกลิ่นไหม้ หรือเครื่องร้อนผิดปกติ ไม่ควรทดลองเปิดซ้ำหลายครั้ง</p>
        <hr class="section-divider" />
        <h2>Notebook หลายเครื่องควรแยกเป็นกลุ่ม</h2>
        <p>หากมีหลายเครื่องจากสำนักงานหรือองค์กร สามารถจัดข้อมูลเช่น:</p>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>รุ่น</th>
                <th>CPU</th>
                <th>RAM</th>
                <th>SSD</th>
                <th>จำนวน</th>
                <th>สภาพ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>รุ่น...</td>
                <td>i5-...</td>
                <td>8GB</td>
                <td>256GB</td>
                <td>5</td>
                <td>ปกติ</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>i5-...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>4</td>
                <td>Battery เสื่อม</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>2</td>
                <td>ไม่ได้ทดสอบ</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>หากสภาพหรือ Configuration ต่างกัน ควรแยกกลุ่มให้ชัด</p>
        <hr class="section-divider" />
        <h2>ข้อมูลส่วนตัวควรจัดการก่อนส่งมอบ</h2>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>เพื่อขอราคา</p>
        <p>เจ้าของควรสำรองข้อมูลและจัดการบัญชีของตนเองก่อนการส่งมอบจริง</p>
        <hr class="section-divider" />
        <h2>หน้ากาฬสินธุ์ต่างจากหน้ารับซื้อ Notebook หลัก</h2>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค/</code> เป็นเจ้าของ Broad Notebook Intent</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อโน๊ตบุ๊ค-กาฬสินธ/</code></p>
        <p>เป็น:</p>
        <p><strong>Notebook + Kalasin</strong></p>
        <p>จึงรักษาความเป็น Local Historical URL และไม่ควรเพิ่มเนื้อหาทั่วประเทศเพื่อแข่งขันกับ Parent</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคา Notebook ในกาฬสินธุ์</h2>
        <h3>1. แจ้ง Model</h3>
        <p>ชื่อรุ่นเต็ม</p>
        <h3>2. แจ้ง CPU</h3>
        <p>ใช้รหัสเต็ม</p>
        <h3>3. แจ้ง RAM และ SSD</h3>
        <p>Configuration ปัจจุบัน</p>
        <h3>4. แจ้ง GPU</h3>
        <p>ถ้ามี</p>
        <h3>5. แจ้ง Battery</h3>
        <p>Health หรืออาการ</p>
        <h3>6. ส่งรูป</h3>
        <p>หน้าจอ ตัวเครื่อง บานพับและตำหนิ</p>
        <h3>7. แจ้ง Adapter</h3>
        <p>เดิม เทียบ หรือไม่มี</p>
        <h3>8. แจ้งประวัติซ่อม</h3>
        <p>ถ้าทราบ</p>
        <h3>9. เช็กราคาก่อนซ่อม</h3>
        <p>หากเครื่องมีอาการ</p>
        <h3>10. ตรวจสินค้า</h3>
        <p>ยืนยันสเปกและสภาพก่อนซื้อขาย</p>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคาโน๊ตบุ๊คในกาฬสินธุ์</h2>
        <p>ส่ง:</p>
        <p><strong>Model + CPU + RAM + SSD + GPU + Battery + รูป + Adapter</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <hr class="section-divider" />
      </article>
    </div>
  </main>

  <section class="section section-muted">
    <div class="container container-narrow">
      <FAQ
        items={faqs}
        title="คำถามที่พบบ่อยเกี่ยวกับการขาย Notebook ในกาฬสินธุ์"
      />
    </div>
  </section>

</BaseLayout>

<style>
  .content-container {
    padding: 2.5rem 0 4rem 0;
  }

  .prose-content {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 640px) {
    .prose-content {
      padding: 1.75rem 1.25rem;
    }
  }

  .prose-content h1 {
    font-size: 2.15rem;
    color: var(--color-primary);
    line-height: 1.3;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .prose-content h2 {
    font-size: 1.55rem;
    color: var(--color-primary);
    line-height: 1.35;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    line-height: 1.4;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-main);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .prose-content ul,
  .prose-content ol {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .prose-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 0.4rem;
  }

  .prose-content strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .prose-content a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .prose-content a:hover {
    color: var(--color-accent-hover);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--color-border);
    margin: 2.5rem 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .table th,
  .table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .table th {
    background-color: var(--color-bg-subtle);
    color: var(--color-primary);
    font-weight: 600;
  }

  .table tr:nth-child(even) {
    background-color: #fafbfc;
  }
</style>
