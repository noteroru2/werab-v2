---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คกาฬสินธุ์ Notebook Laptop เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในกาฬสินธุ์ Notebook Laptop และ Gaming Notebook ประเมินจากรุ่น CPU RAM SSD GPU Battery หน้าจอ สภาพและอุปกรณ์ก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คกาฬสินธุ์ เช็กสเปก Battery และสภาพก่อนขาย",
    "url": "/รับซื้อโน๊ตบุ๊ค-กาฬสินธ/"
  }
];

const faqs = [
  {
    "question": "Notebook รุ่นเก่ายังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้ง Model สเปก Battery และสภาพปัจจุบันเพื่อประเมินก่อนว่าควรขายตามสภาพหรือซ่อม"
  },
  {
    "question": "เปลี่ยน SSD หรือเพิ่ม RAM มาแล้วต้องแจ้งไหม?",
    "answer": "ควรแจ้ง Configuration ปัจจุบัน เพราะราคาควรอิง Hardware ที่รวมขายจริง"
  },
  {
    "question": "Battery ไม่เก็บไฟยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการและ Adapter ที่ใช้ และไม่จำเป็นต้องเปลี่ยน Battery ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "เครื่องเปิดไม่ติดต้องซ่อมก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี สามารถเช็กราคาตามสภาพก่อนแล้วเปรียบเทียบกับต้นทุนและความเสี่ยงในการซ่อม"
  },
  {
    "question": "ขายโดยเก็บ SSD ไว้ได้หรือไม่?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ ราคาจะประเมินจาก Configuration ที่ขายจริง"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คกาฬสินธุ์ เช็กสเปก Battery และสภาพก่อนขาย</h1>
        
        
        <p>ผู้ขายในกาฬสินธุ์สามารถเริ่มจากส่งรุ่น สเปก รูป และสภาพของโน๊ตบุ๊คเพื่อเช็กราคาเบื้องต้นก่อน แล้วจึงค่อยตกลงขั้นตอนตรวจและส่งมอบตามพื้นที่จริง</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">การประเมินเริ่มจาก:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + รูป + Adapter</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คกาฬสินธุ์ เช็กสเปก Battery และสภาพก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Notebook ในกาฬสินธุ์เริ่มเช็กราคาจากข้อมูลเครื่องได้</h2>
        <p>หากยังไม่แน่ใจว่าจะขายหรือซ่อม สามารถเริ่มจากส่งข้อมูลโดยไม่จำเป็นต้องเดินทางพร้อมเครื่องเพื่อถามราคา</p>
        <p>ควรเตรียม:</p>
        <ul>
        <li>Model</li>
        <li>สเปก</li>
        <li>Battery</li>
        <li>รูป</li>
        <li>Adapter</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>แล้วค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำในทุกพื้นที่ของจังหวัดกาฬสินธุ์</p>
        </div>
        <div class="comm-card">
          <h2>Notebook ที่ใช้งานมาหลายปีควรตรวจ Configuration ปัจจุบัน</h2>
        <p>เครื่องที่ใช้งานมานานอาจผ่านการ:</p>
        <ul>
        <li>เพิ่ม RAM</li>
        <li>เปลี่ยน SSD</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยน Keyboard</li>
        <li>ซ่อมจอ</li>
        </ul>
        <p>ดังนั้นข้อมูลปัจจุบันสำคัญกว่าสเปกในใบโฆษณาตอนซื้อใหม่</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>CPU ช่วยบอก Generation ของเครื่อง</h2>
        <p>ควรแจ้งรหัสเต็ม เช่น:</p>
        <p><strong>Intel Core i5-10210U</strong></p>
        <p><strong>Intel Core i5-1235U</strong></p>
        <p><strong>AMD Ryzen 5 5500U</strong></p>
        <p>แทนการแจ้งเพียง:</p>
        <p><strong>Core i5</strong></p>
        <p>เพราะ CPU คนละ Generation อาจมีประสิทธิภาพและอายุ Platform ต่างกัน</p>
        </div>
        <div class="comm-card">
          <h2>Gaming Notebook ควรแจ้ง GPU และ Adapter</h2>
        <p>หากมี Dedicated GPU ควรแจ้งรุ่น เช่น:</p>
        <ul>
        <li>GTX Series</li>
        <li>RTX Series</li>
        <li>Radeon</li>
        </ul>
        <p>รวมถึง Adapter ที่ใช้</p>
        <p>Gaming Notebook บาง Series มีหลาย Configuration แม้ตัวเครื่องภายนอกใกล้เคียงกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery เก่ากับเครื่องเสียต้องแยกกัน</h2>
        <p>Battery เสื่อมไม่ได้หมายความว่า Notebook ทั้งเครื่องเสีย</p>
        <p>ควรแจ้งอาการ เช่น:</p>
        <ul>
        <li>Battery อยู่ได้ไม่นาน</li>
        <li>ต้องเสียบ Adapter</li>
        <li>Battery ไม่เก็บไฟ</li>
        <li>เครื่องชาร์จไม่เข้า</li>
        <li>Battery บวม</li>
        </ul>
        <p>หากยังไม่ทราบสาเหตุของการชาร์จไม่เข้า ไม่ควรสรุปว่าเสีย Battery หรือ Mainboard โดยไม่ได้ตรวจ</p>
        </div>
        <div class="comm-card">
          <h2>SSD มีข้อมูลสำคัญสามารถเก็บไว้ได้</h2>
        <p>หากไม่ต้องการขาย Storage สามารถแจ้งว่า:</p>
        <p><strong>ไม่รวม SSD</strong></p>
        <p>ตั้งแต่ต้น</p>
        <p>การประเมินจะอิง Configuration ที่ขายจริง</p>
        <p>เพื่อถามราคาไม่จำเป็นต้องให้ Password หรือข้อมูลภายใน SSD</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอควรตรวจตอนเปิดใช้งาน</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>เส้น</li>
        <li>จุด</li>
        <li>จอแตก</li>
        <li>กระพริบ</li>
        <li>สีเพี้ยน</li>
        <li>แสงผิดปกติ</li>
        <li>ไม่มีภาพ</li>
        </ul>
        <p>หากต่อจอนอกแล้วใช้งานได้ สามารถแจ้งข้อมูลนี้ประกอบโดยไม่ต้องสรุปสาเหตุเอง</p>
        </div>
        <div class="comm-card">
          <h2>Keyboard และ Port มีผลต่อความพร้อมใช้งาน</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ปุ่มเสีย</li>
        <li>Keyboard บางปุ่มกดไม่ติด</li>
        <li>Touchpad มีปัญหา</li>
        <li>USB เสีย</li>
        <li>HDMI มีปัญหา</li>
        <li>Port ชาร์จหลวม</li>
        <li>Speaker มีเสียงผิดปกติ</li>
        </ul>
        <p>ข้อมูลเหล่านี้ช่วยอธิบายสภาพของเครื่องได้ครบขึ้น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดไม่จำเป็นต้องรีบซ่อม</h2>
        <p>สามารถเริ่มจากเช็กราคาตามสภาพก่อน</p>
        <p>ส่ง:</p>
        <ul>
        <li>Model</li>
        <li>สเปกที่ทราบ</li>
        <li>Adapter</li>
        <li>รูป</li>
        <li>ไฟสถานะ</li>
        <li>อาการก่อนเสีย</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>จากนั้นจึงค่อยเปรียบเทียบว่าค่าใช้จ่ายในการซ่อมเหมาะสมหรือไม่</p>
        <p>หาก Battery บวม มีกลิ่นไหม้ หรือเครื่องร้อนผิดปกติ ไม่ควรทดลองเปิดซ้ำหลายครั้ง</p>
        </div>
        <div class="comm-card">
          <h2>Notebook หลายเครื่องควรแยกเป็นกลุ่ม</h2>
        <p>หากมีหลายเครื่องจากสำนักงานหรือองค์กร สามารถจัดข้อมูลเช่น:</p>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>รุ่น</th>
                <th>CPU</th>
                <th>RAM</th>
                <th>SSD</th>
                <th>จำนวน</th>
                <th>สภาพ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>รุ่น...</td>
                <td>i5-...</td>
                <td>8GB</td>
                <td>256GB</td>
                <td>5</td>
                <td>ปกติ</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>i5-...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>4</td>
                <td>Battery เสื่อม</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>2</td>
                <td>ไม่ได้ทดสอบ</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>หากสภาพหรือ Configuration ต่างกัน ควรแยกกลุ่มให้ชัด</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ข้อมูลส่วนตัวควรจัดการก่อนส่งมอบ</h2>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>เพื่อขอราคา</p>
        <p>เจ้าของควรสำรองข้อมูลและจัดการบัญชีของตนเองก่อนการส่งมอบจริง</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา Notebook ในกาฬสินธุ์</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้ง Model</h3>
              <p>ชื่อรุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้ง CPU</h3>
              <p>ใช้รหัสเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง RAM และ SSD</h3>
              <p>Configuration ปัจจุบัน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง GPU</h3>
              <p>ถ้ามี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery</h3>
              <p>Health หรืออาการ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. ส่งรูป</h3>
              <p>หน้าจอ ตัวเครื่อง บานพับและตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้ง Adapter</h3>
              <p>เดิม เทียบ หรือไม่มี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติซ่อม</h3>
              <p>ถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เช็กราคาก่อนซ่อม</h3>
              <p>หากเครื่องมีอาการ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันสเปกและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาโน๊ตบุ๊คในกาฬสินธุ์</h2>
        <p>ส่ง:</p>
        <p><strong>Model + CPU + RAM + SSD + GPU + Battery + รูป + Adapter</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
