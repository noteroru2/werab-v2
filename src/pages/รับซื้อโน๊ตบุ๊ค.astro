---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อโน๊ตบุ๊คมือสอง Gaming Notebook เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสอง Notebook Laptop และ Gaming Notebook เช็กราคาจากรุ่น CPU RAM SSD การ์ดจอ แบตเตอรี่ สภาพและอุปกรณ์ ส่งข้อมูลประเมินก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อโน๊ตบุ๊ค', url: '/รับซื้อโน๊ตบุ๊ค/' }
];

const faqs = [
  {
    question: "รับซื้อโน๊ตบุ๊คมือสองยี่ห้ออะไรบ้าง?",
    answer: "สามารถส่งโน๊ตบุ๊คหลายยี่ห้อมาประเมินได้ เช่น ASUS, Acer, Lenovo, HP, Dell, MSI, Gigabyte, Microsoft Surface และแบรนด์อื่น โดยราคาจะพิจารณาจากรุ่น สเปก สภาพ และอุปกรณ์ของเครื่องจริง"
  },
  {
    question: "โน๊ตบุ๊คแบตเสื่อมหรือไม่มี Adapter ขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการแบตเตอรี่และระบุว่ามี Adapter หรือไม่ เนื่องจากต้นทุน Adapter และ Battery แตกต่างกันตามรุ่น"
  },
  {
    question: "Gaming Notebook ต้องส่งสเปกอะไรบ้าง?",
    answer: "อย่างน้อยควรส่งรุ่น CPU, RAM, SSD และ GPU โดยเฉพาะรุ่นการ์ดจอเต็ม เช่น RTX 3050, RTX 4060 หรือรุ่นอื่น พร้อมแจ้งสภาพหน้าจอ แบตเตอรี่ และ Adapter"
  },
  {
    question: "โน๊ตบุ๊คเปิดไม่ติดยังขายได้ไหม?",
    answer: "บางกรณียังสามารถประเมินตามสภาพได้ ควรส่งรุ่น สเปกที่ทราบ อาการก่อนเสีย และข้อมูลว่ามีไฟเข้าหรือเคยซ่อมหรือไม่ เพื่อพิจารณามูลค่าของเครื่องและชิ้นส่วนที่เหลือ"
  },
  {
    question: "ต้องล้างข้อมูลก่อนส่งรูปเช็กราคาหรือไม่?",
    answer: "ไม่จำเป็นต้องล้างข้อมูลเพียงเพื่อเช็กราคา ควรสำรองข้อมูลและล้างข้อมูลส่วนตัวเมื่อพร้อมส่งมอบเครื่องจริง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <!-- HERO SECTION -->
  <section class="section hero-hub">
    <div class="container">
      <div class="hero-content text-center">
        <h1>รับซื้อโน๊ตบุ๊คมือสอง เช็กรุ่น สเปก และสภาพก่อนขาย</h1>
        <p class="hero-lead">ต้องการขายโน๊ตบุ๊คมือสอง แต่ไม่แน่ใจว่าเครื่องของคุณควรประเมินจากอะไร?</p>
        <p class="hero-subtext">
          Notebook รุ่นเดียวกันอาจมีราคาต่างกันมากจาก <strong>CPU, RAM, SSD, การ์ดจอ, หน้าจอ, แบตเตอรี่ สภาพ และอุปกรณ์</strong> ดังนั้นการดูเพียงชื่อยี่ห้อหรืออายุเครื่องยังไม่เพียงพอ
        </p>
        <p class="hero-subtext">
          เรารับซื้อ.com ใช้แนวทางให้ผู้ขายส่งข้อมูลเครื่องก่อน เพื่อช่วยตรวจรุ่นและสเปก แล้วจึงพิจารณาราคาจากสภาพจริง
        </p>

        <div class="intake-hero-box card" style="max-width: 680px; margin: 1.5rem auto; text-align: left; background-color: #1e293b; border: 1px solid #334155;">
          <p style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem;">เริ่มจากส่ง:</p>
          <p style="font-size: 1.15rem; color: #fbbf24; font-weight: 700; margin-bottom: 1rem;">
            รุ่น + สเปก + รูป + สภาพ + อุปกรณ์
          </p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
              LINE: <strong>{getDisplayLine()}</strong>
            </a>
            <a href={getPhoneUrl()} class="btn btn-primary" style="background-color: #334155; color: #f8fafc;">
              โทร: <strong>{getDisplayPhone()}</strong>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: TYPES & BRANDS -->
  <section class="section section-muted">
    <div class="container" style="max-width: 900px;">
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>โน๊ตบุ๊คแบบไหนส่งมาประเมินได้</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">สามารถส่ง Notebook และ Laptop หลายกลุ่มมาสอบถามได้ เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1.5rem;">
          <li>โน๊ตบุ๊คใช้งานทั่วไป</li>
          <li>โน๊ตบุ๊คสำหรับเรียน</li>
          <li>โน๊ตบุ๊คทำงาน</li>
          <li>Business Notebook</li>
          <li>Ultrabook</li>
          <li>Gaming Notebook</li>
          <li>Mobile Workstation</li>
          <li>Notebook สำหรับงานกราฟิก</li>
          <li>เครื่องที่มีตำหนิ</li>
          <li>เครื่องที่แบตเตอรี่เสื่อม</li>
          <li>เครื่องไม่มี Adapter</li>
          <li>เครื่องที่เคยซ่อม</li>
          <li>เครื่องเปิดไม่ติดบางกรณี</li>
        </ul>

        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">ยี่ห้อที่พบได้บ่อย เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>ASUS</li>
          <li>Acer</li>
          <li>Lenovo</li>
          <li>HP</li>
          <li>Dell</li>
          <li>MSI</li>
          <li>Gigabyte</li>
          <li>Microsoft Surface</li>
          <li>และแบรนด์อื่น</li>
        </ul>

        <p style="margin-top: 1rem; color: #94a3b8;">
          ราคาของแต่ละเครื่องต้องดูจากรุ่นและสเปกจริง ไม่ใช่ดูจากยี่ห้อเพียงอย่างเดียว
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MODEL IDENTIFICATION -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="card">
        <h2>ก่อนขายต้องรู้รุ่นโน๊ตบุ๊คให้ชัด</h2>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">ชื่อบนฝาเครื่อง เช่น ASUS, Lenovo หรือ HP ยังไม่ใช่รุ่นเต็มที่ใช้ประเมินราคา</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ตัวอย่างข้อมูลที่ช่วยระบุรุ่น ได้แก่</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>Model Name</li>
          <li>Model Number</li>
          <li>Product Number</li>
          <li>Serial Number</li>
          <li>Sticker ใต้เครื่อง</li>
          <li>ข้อมูลใน System Information</li>
          <li>ข้อมูลจากเว็บไซต์ผู้ผลิต</li>
        </ul>
        <p style="color: #94a3b8; margin-bottom: 1rem;">
          บางรุ่นใช้ชื่อใกล้กัน แต่ต่าง Generation หรือสเปกภายใน
        </p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">หากไม่ทราบรุ่น สามารถถ่ายรูป:</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>ด้านหน้า</li>
          <li>Keyboard</li>
          <li>ใต้เครื่อง</li>
          <li>Sticker รุ่น</li>
          <li>หน้าจอ System Information</li>
        </ul>
        <p style="color: #94a3b8;">
          ส่งมาช่วยตรวจสอบก่อนได้
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SPEC FACTORS (CPU, RAM, SSD, GPU, SCREEN) -->
  <section class="section section-muted">
    <div class="container" style="max-width: 900px;">
      <!-- CPU -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>CPU มีผลต่อราคาอย่างไร</h2>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">CPU เป็นหนึ่งในข้อมูลสำคัญของ Notebook</p>
        <p style="margin-bottom: 1rem; color: #cbd5e1;">ตัวอย่างกลุ่มที่พบได้ เช่น</p>

        <div class="grid grid-2" style="gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <h3 style="font-size: 1.1rem; color: #38bdf8; margin-bottom: 0.5rem;">Intel</h3>
            <ul class="custom-list">
              <li>Core i3</li>
              <li>Core i5</li>
              <li>Core i7</li>
              <li>Core i9</li>
              <li>Core Ultra</li>
              <li>รุ่นประหยัดพลังงานหรือรุ่นประสิทธิภาพสูง</li>
            </ul>
          </div>

          <div>
            <h3 style="font-size: 1.1rem; color: #38bdf8; margin-bottom: 0.5rem;">AMD</h3>
            <ul class="custom-list">
              <li>Ryzen 3</li>
              <li>Ryzen 5</li>
              <li>Ryzen 7</li>
              <li>Ryzen 9</li>
              <li>Ryzen AI และรุ่นอื่น</li>
            </ul>
          </div>
        </div>

        <p style="margin-bottom: 0.5rem; font-weight: 600;">สิ่งสำคัญไม่ใช่ดูเพียงคำว่า i7 หรือ Ryzen 7</p>
        <p style="margin-bottom: 0.5rem;">ต้องดู <strong>Generation และรหัสรุ่นเต็ม</strong> ด้วย</p>
        <p style="margin-bottom: 0.5rem; color: #94a3b8;">ตัวอย่างเช่น Core i7 ต่าง Generation อาจมีอายุ ประสิทธิภาพ และตลาดมือสองแตกต่างกันมาก</p>
        <p style="margin-bottom: 0.5rem;">ดังนั้นควรส่งรหัส CPU เต็ม เช่น</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">i5-12450H</code></p>
        <p style="margin-bottom: 0.5rem;">หรือ</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">Ryzen 7 7735HS</code></p>
        <p style="color: #94a3b8;">แทนการแจ้งเพียงว่า “i5” หรือ “Ryzen 7”</p>
      </div>

      <!-- RAM & SSD -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>RAM และ SSD มีผลต่อมูลค่าเครื่อง</h2>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">Notebook รุ่นเดียวกันอาจติดตั้ง RAM และ Storage ไม่เท่ากัน</p>
        <p style="font-weight: 600; margin-bottom: 0.5rem;">ข้อมูลที่ควรแจ้ง เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>RAM 8GB / 16GB / 32GB</li>
          <li>DDR4 / DDR5</li>
          <li>SSD 256GB / 512GB / 1TB</li>
          <li>NVMe หรือ SATA</li>
          <li>มี HDD เพิ่มหรือไม่</li>
        </ul>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">หากมีการอัปเกรดภายหลังควรแจ้งด้วย</p>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">อย่างไรก็ตาม ราคาที่เพิ่มขึ้นจากการอัปเกรดไม่ได้จำเป็นต้องเท่ากับราคาที่เคยซื้อ RAM หรือ SSD มา</p>
        <p style="color: #94a3b8;">ต้องพิจารณาร่วมกับรุ่นเครื่องและตลาดของเครื่องนั้น</p>
      </div>

      <!-- Gaming GPU -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>Gaming Notebook ต้องดูการ์ดจอ</h2>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">สำหรับ Gaming Notebook การ์ดจอมักเป็นหนึ่งในส่วนที่มีผลต่อราคามาก</p>
        <p style="font-weight: 600; margin-bottom: 0.5rem;">ควรแจ้ง GPU เต็ม เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>GTX 1650</li>
          <li>GTX 1660 Ti</li>
          <li>RTX 3050</li>
          <li>RTX 3060</li>
          <li>RTX 4050</li>
          <li>RTX 4060</li>
          <li>RTX 4070</li>
          <li>หรือรุ่นอื่น</li>
        </ul>
        <p style="color: #f87171; margin-bottom: 0.5rem;">ไม่ควรแจ้งเพียงว่า “การ์ดจอ NVIDIA”</p>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">เพราะมูลค่าและประสิทธิภาพของแต่ละรุ่นต่างกันมาก</p>
        <p style="color: #94a3b8;">Gaming Notebook ที่ใช้ CPU ใกล้เคียงกัน แต่ GPU ต่างกัน สามารถมีราคามือสองแตกต่างกันได้อย่างชัดเจน</p>
      </div>

      <!-- Screen -->
      <div class="card">
        <h2>หน้าจอต้องตรวจอะไรบ้าง</h2>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">ก่อนขายควรเปิดจอและตรวจพื้นฐาน เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>จอติดปกติหรือไม่</li>
          <li>มีเส้นหรือไม่</li>
          <li>มีจุดดำหรือจุดสว่างหรือไม่</li>
          <li>สีผิดปกติหรือไม่</li>
          <li>มีอาการกะพริบหรือไม่</li>
          <li>บานพับหลวมหรือแตกหรือไม่</li>
          <li>ฝาหลังจอมีรอยหรือไม่</li>
        </ul>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">สำหรับ Gaming Notebook ควรแจ้ง Refresh Rate หากทราบ เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>120Hz</li>
          <li>144Hz</li>
          <li>165Hz</li>
          <li>240Hz</li>
        </ul>
        <p style="color: #94a3b8;">รวมถึงความละเอียด เช่น FHD, QHD หรือ 4K หากเป็นจุดสำคัญของรุ่น</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: CONDITIONS, BATTERY, ADAPTER, REPAIRS, DEFECTS -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <!-- Battery -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>แบตเตอรี่เสื่อมยังขายได้ไหม</h2>
        <p style="font-weight: 700; color: #10b981; margin-bottom: 0.5rem;">ได้</p>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">
          แบตเตอรี่เป็นชิ้นส่วนที่เสื่อมตามการใช้งาน และ Notebook หลายเครื่องยังสามารถประเมินได้แม้ Battery ไม่สมบูรณ์
        </p>
        <p style="font-weight: 600; margin-bottom: 0.5rem;">ควรแจ้งอาการตามจริง เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>แบตอยู่ได้กี่ชั่วโมงโดยประมาณ</li>
          <li>ต้องเสียบ Adapter ตลอดหรือไม่</li>
          <li>Battery ไม่ชาร์จ</li>
          <li>เปอร์เซ็นต์แบตลดเร็ว</li>
          <li>เครื่องดับเมื่อถอดสาย</li>
          <li>Battery บวม</li>
        </ul>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">หากระบบแสดง Battery Health หรือ Cycle Count สามารถส่งข้อมูลประกอบได้</p>
        <p style="color: #cbd5e1;">ไม่จำเป็นต้องเปลี่ยน Battery ก่อนสอบถามราคา</p>
      </div>

      <!-- Adapter & Box -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>ไม่มี Adapter หรือกล่องยังขายได้ไหม</h2>
        <p style="font-weight: 700; color: #10b981; margin-bottom: 0.5rem;">สามารถส่งมาประเมินได้</p>
        <p style="font-weight: 600; margin-bottom: 0.5rem;">ควรแจ้งว่ามีอะไรอยู่กับเครื่องบ้าง เช่น</p>
        <ul class="custom-list" style="margin-bottom: 0.75rem;">
          <li>Adapter</li>
          <li>สายไฟ</li>
          <li>กล่อง</li>
          <li>คู่มือ</li>
          <li>กระเป๋า</li>
          <li>ใบเสร็จ</li>
          <li>อุปกรณ์เสริม</li>
        </ul>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">
          Adapter ของบางรุ่นมีราคาทดแทนไม่สูงมาก แต่บาง Gaming Notebook หรือ Workstation ใช้ Adapter กำลังสูงและมีต้นทุนมากกว่า
        </p>
        <p style="color: #94a3b8; margin-bottom: 0.5rem;">ดังนั้นผลต่อราคาจะแตกต่างกันตามรุ่น</p>
        <p style="color: #cbd5e1;">ก่อนซื้อ Adapter ใหม่เพื่อเตรียมขาย ควรเปรียบเทียบต้นทุนก่อน</p>
      </div>

      <!-- Repair History -->
      <div class="card" style="margin-bottom: 1.5rem;">
