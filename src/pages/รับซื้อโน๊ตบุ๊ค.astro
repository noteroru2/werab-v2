---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อโน๊ตบุ๊คมือสอง Gaming Notebook เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสอง Notebook Laptop และ Gaming Notebook เช็กราคาจากรุ่น CPU RAM SSD การ์ดจอ แบตเตอรี่ สภาพและอุปกรณ์ ส่งข้อมูลประเมินก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อโน๊ตบุ๊ค', url: '/รับซื้อโน๊ตบุ๊ค/' }
];

const faqs = [
  {
    question: "รับซื้อโน๊ตบุ๊คมือสองยี่ห้ออะไรบ้าง?",
    answer: "สามารถส่งโน๊ตบุ๊คหลายยี่ห้อมาประเมินได้ เช่น ASUS, Acer, Lenovo, HP, Dell, MSI, Gigabyte, Microsoft Surface และแบรนด์อื่น โดยราคาจะพิจารณาจากรุ่น สเปก สภาพ และอุปกรณ์ของเครื่องจริง"
  },
  {
    question: "โน๊ตบุ๊คแบตเสื่อมหรือไม่มี Adapter ขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการแบตเตอรี่และระบุว่ามี Adapter หรือไม่ เนื่องจากต้นทุน Adapter และ Battery แตกต่างกันตามรุ่น"
  },
  {
    question: "Gaming Notebook ต้องส่งสเปกอะไรบ้าง?",
    answer: "อย่างน้อยควรส่งรุ่น CPU, RAM, SSD และ GPU โดยเฉพาะรุ่นการ์ดจอเต็ม เช่น RTX 3050, RTX 4060 หรือรุ่นอื่น พร้อมแจ้งสภาพหน้าจอ แบตเตอรี่ และ Adapter"
  },
  {
    question: "โน๊ตบุ๊คเปิดไม่ติดยังขายได้ไหม?",
    answer: "บางกรณียังสามารถประเมินตามสภาพได้ ควรส่งรุ่น สเปกที่ทราบ อาการก่อนเสีย และข้อมูลว่ามีไฟเข้าหรือเคยซ่อมหรือไม่ เพื่อพิจารณามูลค่าของเครื่องและชิ้นส่วนที่เหลือ"
  },
  {
    question: "ต้องล้างข้อมูลก่อนส่งรูปเช็กราคาหรือไม่?",
    answer: "ไม่จำเป็นต้องล้างข้อมูลเพียงเพื่อเช็กราคา ควรสำรองข้อมูลและล้างข้อมูลส่วนตัวเมื่อพร้อมส่งมอบเครื่องจริง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คมือสอง เช็กรุ่น สเปก และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขายโน๊ตบุ๊คมือสอง แต่ไม่แน่ใจว่าเครื่องของคุณควรประเมินจากอะไร?</p>
          <p>
            Notebook รุ่นเดียวกันอาจมีราคาต่างกันมากจาก <strong>CPU, RAM, SSD, การ์ดจอ, หน้าจอ, แบตเตอรี่ สภาพ และอุปกรณ์</strong> ดังนั้นการดูเพียงชื่อยี่ห้อหรืออายุเครื่องยังไม่เพียงพอ
          </p>
          <p>
            เรารับซื้อ.com ใช้แนวทางให้ผู้ขายส่งข้อมูลเครื่องก่อน เพื่อช่วยตรวจรุ่นและสเปก แล้วจึงพิจารณาราคาจากสภาพจริง
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>รุ่น + สเปก + รูป + สภาพ + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คมือสอง Gaming Notebook เช็กรุ่น สเปก และสภาพก่อนขาย"
                width="1200"
                height="755"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: TYPES & BRANDS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>โน๊ตบุ๊คแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่ง Notebook และ Laptop หลายกลุ่มมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>โน๊ตบุ๊คใช้งานทั่วไป</li>
              <li>โน๊ตบุ๊คสำหรับเรียน</li>
              <li>โน๊ตบุ๊คทำงาน</li>
              <li>Business Notebook</li>
              <li>Ultrabook</li>
              <li>Gaming Notebook</li>
              <li>Mobile Workstation</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Notebook สำหรับงานกราฟิก</li>
              <li>เครื่องที่มีตำหนิ</li>
              <li>เครื่องที่แบตเตอรี่เสื่อม</li>
              <li>เครื่องไม่มี Adapter</li>
              <li>เครื่องที่เคยซ่อม</li>
              <li>เครื่องเปิดไม่ติดบางกรณี</li>
            </ul>
          </div>
        </div>

        <p>ยี่ห้อที่พบได้บ่อย เช่น</p>
        <ul>
          <li>ASUS</li>
          <li>Acer</li>
          <li>Lenovo</li>
          <li>HP</li>
          <li>Dell</li>
          <li>MSI</li>
          <li>Gigabyte</li>
          <li>Microsoft Surface</li>
          <li>และแบรนด์อื่น</li>
        </ul>

        <p>ราคาของแต่ละเครื่องต้องดูจากรุ่นและสเปกจริง ไม่ใช่ดูจากยี่ห้อเพียงอย่างเดียว</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MODEL IDENTIFICATION -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ก่อนขายต้องรู้รุ่นโน๊ตบุ๊คให้ชัด</h2>
        <p>ชื่อบนฝาเครื่อง เช่น ASUS, Lenovo หรือ HP ยังไม่ใช่รุ่นเต็มที่ใช้ประเมินราคา</p>
        <p>ตัวอย่างข้อมูลที่ช่วยระบุรุ่น ได้แก่</p>
        <ul>
          <li>Model Name</li>
          <li>Model Number</li>
          <li>Product Number</li>
          <li>Serial Number</li>
          <li>Sticker ใต้เครื่อง</li>
          <li>ข้อมูลใน System Information</li>
          <li>ข้อมูลจากเว็บไซต์ผู้ผลิต</li>
        </ul>
        <p>บางรุ่นใช้ชื่อใกล้กัน แต่ต่าง Generation หรือสเปกภายใน</p>
        <p>หากไม่ทราบรุ่น สามารถถ่ายรูป:</p>
        <ul>
          <li>ด้านหน้า</li>
          <li>Keyboard</li>
          <li>ใต้เครื่อง</li>
          <li>Sticker รุ่น</li>
          <li>หน้าจอ System Information</li>
        </ul>
        <p>ส่งมาช่วยตรวจสอบก่อนได้</p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CPU SPEC -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>CPU มีผลต่อราคาอย่างไร</h2>
        <p>CPU เป็นหนึ่งในข้อมูลสำคัญของ Notebook</p>
        <p>ตัวอย่างกลุ่มที่พบได้ เช่น</p>

        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div style="background-color: var(--surface); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
            <h3>Intel</h3>
            <ul>
              <li>Core i3</li>
              <li>Core i5</li>
              <li>Core i7</li>
              <li>Core i9</li>
              <li>Core Ultra</li>
              <li>รุ่นประหยัดพลังงานหรือรุ่นประสิทธิภาพสูง</li>
            </ul>
          </div>

          <div style="background-color: var(--surface); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
            <h3>AMD</h3>
            <ul>
              <li>Ryzen 3</li>
              <li>Ryzen 5</li>
              <li>Ryzen 7</li>
              <li>Ryzen 9</li>
              <li>Ryzen AI และรุ่นอื่น</li>
            </ul>
          </div>
        </div>

        <p>สิ่งสำคัญไม่ใช่ดูเพียงคำว่า i7 หรือ Ryzen 7</p>
        <p>ต้องดู <strong>Generation และรหัสรุ่นเต็ม</strong> ด้วย</p>
        <p>ตัวอย่างเช่น Core i7 ต่าง Generation อาจมีอายุ ประสิทธิภาพ และตลาดมือสองแตกต่างกันมาก</p>
        <p>ดังนั้นควรส่งรหัส CPU เต็ม เช่น</p>
        <p><code>i5-12450H</code></p>
        <p>หรือ</p>
        <p><code>Ryzen 7 7735HS</code></p>
        <p>แทนการแจ้งเพียงว่า “i5” หรือ “Ryzen 7”</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: RAM, SSD & GPU -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM และ SSD มีผลต่อมูลค่าเครื่อง</h2>
          <p>Notebook รุ่นเดียวกันอาจติดตั้ง RAM และ Storage ไม่เท่ากัน</p>
          <p>ข้อมูลที่ควรแจ้ง เช่น</p>
          <ul>
            <li>RAM 8GB / 16GB / 32GB</li>
            <li>DDR4 / DDR5</li>
            <li>SSD 256GB / 512GB / 1TB</li>
            <li>NVMe หรือ SATA</li>
            <li>มี HDD เพิ่มหรือไม่</li>
          </ul>
          <p>หากมีการอัปเกรดภายหลังควรแจ้งด้วย</p>
          <p>อย่างไรก็ตาม ราคาที่เพิ่มขึ้นจากการอัปเกรดไม่ได้จำเป็นต้องเท่ากับราคาที่เคยซื้อ RAM หรือ SSD มา</p>
          <p>ต้องพิจารณาร่วมกับรุ่นเครื่องและตลาดของเครื่องนั้น</p>
        </div>

        <div class="comm-card">
          <h2>Gaming Notebook ต้องดูการ์ดจอ</h2>
          <p>สำหรับ Gaming Notebook การ์ดจอมักเป็นหนึ่งในส่วนที่มีผลต่อราคามาก</p>
          <p>ควรแจ้ง GPU เต็ม เช่น</p>
          <ul>
            <li>GTX 1650</li>
            <li>GTX 1660 Ti</li>
            <li>RTX 3050</li>
            <li>RTX 3060</li>
            <li>RTX 4050</li>
            <li>RTX 4060</li>
            <li>RTX 4070</li>
            <li>หรือรุ่นอื่น</li>
          </ul>
          <p>ไม่ควรแจ้งเพียงว่า “การ์ดจอ NVIDIA”</p>
          <p>เพราะมูลค่าและประสิทธิภาพของแต่ละรุ่นต่างกันมาก</p>
          <p>Gaming Notebook ที่ใช้ CPU ใกล้เคียงกัน แต่ GPU ต่างกัน สามารถมีราคามือสองแตกต่างกันได้อย่างชัดเจน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: SCREEN & BATTERY & ADAPTER -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-3">
        <div class="comm-card">
          <h2>หน้าจอต้องตรวจอะไรบ้าง</h2>
          <p>ก่อนขายควรเปิดจอและตรวจพื้นฐาน เช่น</p>
          <ul>
            <li>จอติดปกติหรือไม่</li>
            <li>มีเส้นหรือไม่</li>
            <li>มีจุดดำหรือจุดสว่างหรือไม่</li>
            <li>สีผิดปกติหรือไม่</li>
            <li>มีอาการกะพริบหรือไม่</li>
            <li>บานพับหลวมหรือแตกหรือไม่</li>
            <li>ฝาหลังจอมีรอยหรือไม่</li>
          </ul>
          <p>สำหรับ Gaming Notebook ควรแจ้ง Refresh Rate หากทราบ เช่น</p>
          <ul>
            <li>120Hz</li>
            <li>144Hz</li>
            <li>165Hz</li>
            <li>240Hz</li>
          </ul>
          <p>รวมถึงความละเอียด เช่น FHD, QHD หรือ 4K หากเป็นจุดสำคัญของรุ่น</p>
        </div>

        <div class="comm-card">
          <h2>แบตเตอรี่เสื่อมยังขายได้ไหม</h2>
          <p>ได้</p>
          <p>แบตเตอรี่เป็นชิ้นส่วนที่เสื่อมตามการใช้งาน และ Notebook หลายเครื่องยังสามารถประเมินได้แม้ Battery ไม่สมบูรณ์</p>
          <p>ควรแจ้งอาการตามจริง เช่น</p>
          <ul>
            <li>แบตอยู่ได้กี่ชั่วโมงโดยประมาณ</li>
            <li>ต้องเสียบ Adapter ตลอดหรือไม่</li>
            <li>Battery ไม่ชาร์จ</li>
            <li>เปอร์เซ็นต์แบตลดเร็ว</li>
            <li>เครื่องดับเมื่อถอดสาย</li>
            <li>Battery บวม</li>
          </ul>
          <p>หากระบบแสดง Battery Health หรือ Cycle Count สามารถส่งข้อมูลประกอบได้</p>
          <p>ไม่จำเป็นต้องเปลี่ยน Battery ก่อนสอบถามราคา</p>
        </div>

        <div class="comm-card">
          <h2>ไม่มี Adapter หรือกล่องยังขายได้ไหม</h2>
          <p>สามารถส่งมาประเมินได้</p>
          <p>ควรแจ้งว่ามีอะไรอยู่กับเครื่องบ้าง เช่น</p>
          <ul>
            <li>Adapter</li>
            <li>สายไฟ</li>
            <li>กล่อง</li>
            <li>คู่มือ</li>
            <li>กระเป๋า</li>
            <li>ใบเสร็จ</li>
            <li>อุปกรณ์เสริม</li>
          </ul>
          <p>Adapter ของบางรุ่นมีราคาทดแทนไม่สูงมาก แต่บาง Gaming Notebook หรือ Workstation ใช้ Adapter กำลังสูงและมีต้นทุนมากกว่า</p>
          <p>ดังนั้นผลต่อราคาจะแตกต่างกันตามรุ่น</p>
          <p>ก่อนซื้อ Adapter ใหม่เพื่อเตรียมขาย ควรเปรียบเทียบต้นทุนก่อน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: REPAIRS, DEAD LAPTOPS & SPEC INSPECTION -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเคยซ่อมต้องแจ้งไหม</h2>
          <p>ควรแจ้งหากทราบ</p>
          <p>ตัวอย่างเช่น</p>
          <ul>
            <li>เคยเปลี่ยนจอ</li>
            <li>เคยเปลี่ยน Keyboard</li>
            <li>เคยเปลี่ยน Battery</li>
            <li>เคยซ่อม Mainboard</li>
