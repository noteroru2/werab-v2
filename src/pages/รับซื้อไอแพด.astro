---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';

const seo = resolveSeo('/รับซื้อไอแพด/');
const breadcrumbs = [
  { name: 'หมวดหมู่รับซื้อ', url: '/รับซื้อ/' },
  { name: 'รับซื้อ iPad', url: '/รับซื้อไอแพด/' }
];
const internalLinks = getInternalLinks(seo);

const faqs = [
  {
    question: 'รับซื้อ iPad รุ่นใดบ้าง?',
    answer: 'เรารับซื้อ iPad Pro (ชิป M1, M2, M4), iPad Air, iPad Mini และ iPad Gen ทุกรุ่น ทั้งรุ่น Wi-Fi และ Wi-Fi + Cellular'
  },
  {
    question: 'รับซื้ออุปกรณ์เสริม Apple Pencil และคีย์บอร์ดพร้อมกันไหม?',
    answer: 'รับซื้อทั้งพร้อมตัวเครื่องและรับซื้อแยกชิ้น ได้แก่ Apple Pencil (Gen 1, 2, Pro, USB-C), Magic Keyboard และ Smart Keyboard Folio'
  }
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="section" style="padding-top: 3rem; padding-bottom: 2rem; text-align: center;">
    <div class="container container-narrow">
      <span class="badge badge-accent" style="margin-bottom: 0.75rem;">IPAD BUYBACK</span>
      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">{seo.h1}</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted);">
        รับซื้อ iPad ทุกซีรีส์ Pro, Air, Mini, Gen มือสอง พร้อมอุปกรณ์เสริมครบชุด ตีราคาตามสภาพจริง
      </p>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container container-narrow">
      <div class="card" style="padding: 2.5rem 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">ข้อแนะนำในการเตรียม iPad ก่อนส่งประเมินราคา</h2>
        <ul>
          <li><strong>ตรวจสอบหน้าจอและระบบทัชสกรีน</strong>: ตรวจสอบว่าหน้าจอไม่มีเส้น สีไม่เพี้ยน และสามารถเขียน/สัมผัสได้ลื่นไหลทุกจุด</li>
          <li><strong>ออกจากบัญชี Apple ID / iCloud</strong>: ปิดการค้นหา Find My iPad และทำการล้างข้อมูลเครื่อง</li>
          <li><strong>รวบรวมอุปกรณ์เสริม</strong>: นำสายชาร์จ อะแดปเตอร์ กล่อง ปากกา และคีย์บอร์ดมาตรวจเช็กพร้อมกันเพื่อเพิ่มมูลค่าราคาประเมิน</li>
        </ul>
      </div>

      <ProcessSteps />

      <div style="margin-top: 3.5rem;">
        <FAQ items={faqs} />
      </div>

      <RelatedLinks
        clusterLinks={internalLinks.clusterLinks}
        parentLink={internalLinks.parentLink}
        guideLinks={internalLinks.guideLinks}
      />
    </div>
  </section>

  <CTA />
</BaseLayout>
