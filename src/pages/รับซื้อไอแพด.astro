---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoreMoneyAuthority from '../components/CoreMoneyAuthority.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RealProductGallery from '../components/RealProductGallery.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อ iPad มือสอง เช็กรุ่น ความจุ แบตเตอรี่และสภาพ | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPad มือสอง iPad Air Pro mini ประเมินจากรุ่น ความจุ Wi-Fi หรือ Cellular หน้าจอ แบตเตอรี่ สภาพ ประวัติซ่อมและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อ iPad', url: '/รับซื้อไอแพด/' }
];

const faqs = [
  {
    question: "รับซื้อ iPad มือสองรุ่นอะไรบ้าง?",
    answer: "สามารถส่ง iPad, iPad Air, iPad Pro และ iPad mini หลายรุ่นมาประเมินได้ โดยควรแจ้ง Generation ความจุ Wi-Fi หรือ Cellular สภาพ และอุปกรณ์"
  },
  {
    question: "iPad แบตเสื่อมหรือเครื่องมีรอยขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการ Battery รอยแตก รอยบุบ หน้าจอและ Touch เพื่อพิจารณาจากสภาพจริง"
  },
  {
    question: "iPad ไม่มีกล่องหรือ Adapter ขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งอุปกรณ์ที่มีจริง โดยราคาจะพิจารณาร่วมกับรุ่น สเปกและสภาพของเครื่อง"
  },
  {
    question: "ขาย iPad พร้อม Apple Pencil ได้ไหม?",
    answer: "สามารถแจ้ง Pencil พร้อมเครื่องได้ ควรระบุรุ่น สภาพ และการทำงานของ Pencil เพื่อประเมินเป็นอุปกรณ์แยกก่อนรวมกับชุด"
  },
  {
    question: "ต้อง Reset และออกจาก Apple ID ก่อนเช็กราคาไหม?",
    answer: "ไม่จำเป็นต้อง Reset หรือออกจากบัญชีเพียงเพื่อเช็กราคา และไม่ควรส่งข้อมูลบัญชีหรือรหัสผ่านให้ผู้อื่น เมื่อพร้อมส่งมอบจริงจึงค่อย Backup จัดการ Find My และล้างข้อมูลด้วยตนเอง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ iPad มือสอง เช็กรุ่น ความจุ และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขาย iPad มือสอง แต่ยังไม่แน่ใจว่าเป็นรุ่นอะไรหรือควรแจ้งข้อมูลอะไรเพื่อเช็กราคา?</p>
          <p>
            iPad ชื่อใกล้กันอาจต่างกันทั้ง <strong>Generation, ชิป, ความจุ, ขนาดหน้าจอ, Wi-Fi หรือ Cellular, สภาพ Battery, หน้าจอ และอุปกรณ์</strong>
          </p>
          <p>
            ดังนั้นควรเริ่มจากระบุรุ่นและสเปกให้ชัดก่อนประเมิน
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">ส่งข้อมูล:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>รุ่น + ความจุ + Wi-Fi/Cellular + รูป + สภาพ + Battery + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-tablet-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-tablet-500.webp" type="image/webp" />
              <source srcset="/images/hero-tablet.avif" type="image/avif" />
              <source srcset="/images/hero-tablet.webp" type="image/webp" />
              <img
                src="/images/hero-tablet.webp"
                alt="รับซื้อ iPad มือสอง iPad Pro Air Mini เช็กรุ่น ความจุ และสภาพก่อนขาย"
                width="1026"
                height="543"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <RealProductGallery
    category="tablet"
    title="ภาพ iPad Pro M1 และ iPad Gen 10 จากเครื่องจริง"
    description="ภาพตัวเครื่อง หน้าจอ กล่อง และหน้าข้อมูลระบบที่ใช้ตรวจรุ่นกับความจุ โดยปกปิดข้อมูลระบุตัวเครื่องก่อนเผยแพร่แล้ว"
  />

  <CoreMoneyAuthority
    categoryName='iPad มือสอง'
    valuationFactors={[
      'รุ่น Generation ความจุ และ Wi‑Fi/Cellular',
      'หน้าจอ Touch ID/Face ID กล้อง ลำโพง และพอร์ต',
      'แบตเตอรี่ สภาพตัวเครื่อง และการโก่งของบอดี้',
      'Apple Pencil/Keyboard/กล่องและอุปกรณ์ที่รวมขาย'
    ]}
    supportLinks={[
      { name: 'iPad Pro', path: '/รับซื้อ-ipad-pro/' },
      { name: 'iPad Air', path: '/รับซื้อ-ipad-air/' },
      { name: 'แบตเสื่อม', path: '/สภาพสินค้า/แบตเสื่อม/' },
      { name: 'จอแตก/Touch มีปัญหา', path: '/สภาพสินค้า/จอแตก/' },
      { name: 'ไม่มีอุปกรณ์', path: '/สภาพสินค้า/ไม่มีอุปกรณ์/' }
    ]}
  />

  <!-- SECTION 1: IPAD TYPES & GROUPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>iPad แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียด iPad หลายกลุ่มมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>iPad</li>
              <li>iPad Air</li>
              <li>iPad Pro</li>
              <li>iPad mini</li>
              <li>Wi-Fi</li>
              <li>Wi-Fi + Cellular</li>
              <li>เครื่องมีรอย</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Battery เสื่อม</li>
              <li>จอมีตำหนิ</li>
              <li>Touch มีปัญหา</li>
              <li>ไม่มี Box</li>
              <li>ไม่มี Adapter</li>
              <li>ไม่มีสาย</li>
              <li>เครื่องเคยซ่อม</li>
              <li>เครื่องเปิดไม่ติดบางกรณี</li>
            </ul>
          </div>
        </div>
        <p>การประเมินต้องดูรุ่นและสภาพจริงของเครื่อง</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MODEL, GENERATION & STORAGE -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายต้องรู้รุ่นและ Generation</h2>
          <p>คำว่า iPad Air หรือ iPad Pro เพียงอย่างเดียวยังไม่เพียงพอ</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>รุ่น</li>
            <li>Generation หรือปีหากทราบ</li>
            <li>ขนาดหน้าจอ</li>
            <li>ความจุ</li>
            <li>Wi-Fi หรือ Cellular</li>
            <li>ชิปหากทราบ</li>
          </ul>
          <p>หากเครื่องเปิดได้ สามารถดูข้อมูลจาก:</p>
          <p><strong>Settings → General → About</strong></p>
          <p>ไม่จำเป็นต้องส่งข้อมูลบัญชีส่วนตัวเพื่อเช็กราคา</p>
        </div>

        <div class="comm-card">
          <h2>ความจุมีผลต่อราคา</h2>
          <p>iPad รุ่นเดียวกันอาจมี Storage แตกต่างกัน เช่น</p>
          <ul>
            <li>64GB</li>
            <li>128GB</li>
            <li>256GB</li>
            <li>512GB</li>
            <li>1TB</li>
            <li>หรือความจุอื่นตามรุ่น</li>
          </ul>
          <p>ความจุเป็นหนึ่งในข้อมูลสำคัญ แต่ต้องดูร่วมกับรุ่น สภาพ หน้าจอ Battery และอุปกรณ์</p>

          <h2 style="margin-top: 1.5rem;">Wi-Fi กับ Cellular ต้องแยกให้ชัด</h2>
          <p>iPad บางรุ่นมีทั้ง:</p>
          <ul>
            <li>Wi-Fi</li>
            <li>Wi-Fi + Cellular</li>
          </ul>
          <p>ควรแจ้งประเภทให้ถูกต้อง เพราะสเปกและตลาดมือสองต่างกัน</p>
          <p>หากไม่แน่ใจ สามารถส่งข้อมูลจาก Settings หรือรูปบริเวณตัวเครื่องมาช่วยตรวจได้</p>
          <p>ไม่ควรส่งข้อมูลบัญชีเครือข่าย รหัสผ่าน หรือข้อมูลส่วนตัวที่ไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SCREEN, TOUCH & BATTERY -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอและ Touch ต้องตรวจ</h2>
          <p>ควรตรวจ:</p>
          <ul>
            <li>ภาพขึ้น</li>
            <li>Touch ใช้งานได้ทั่วจอ</li>
            <li>ไม่มีเส้น</li>
            <li>ไม่มีจุดผิดปกติชัดเจน</li>
            <li>ไม่กะพริบ</li>
            <li>กระจกไม่แตก</li>
            <li>ไม่มีรอยกดหนัก</li>
            <li>ความสว่างปกติ</li>
          </ul>
          <p>หากมีบางพื้นที่ Touch ไม่ตอบสนองหรือหน้าจอมีตำหนิควรแจ้ง</p>
        </div>

        <div class="comm-card">
          <h2>Battery มีผลไหม</h2>
          <p>มีผลต่อความพร้อมใช้งาน</p>
          <p>iPad บางรุ่นหรือบางเวอร์ชันระบบอาจไม่ได้แสดงข้อมูล Battery แบบเดียวกับ iPhone จึงไม่จำเป็นต้องมีตัวเลข Battery Health ทุกเครื่องเพื่อขอราคาประเมิน</p>
          <p>สามารถแจ้งอาการใช้งานจริง เช่น</p>
          <ul>
            <li>แบตหมดเร็ว</li>
            <li>ชาร์จไม่เข้า</li>
            <li>ใช้งานได้ไม่นาน</li>
            <li>เครื่องดับ</li>
            <li>Battery เคยเปลี่ยน</li>
            <li>เครื่องร้อนผิดปกติ</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: BUTTONS, PORTS, CAMERA, AUDIO & ACCESSORIES -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ปุ่มและพอร์ตควรตรวจ</h2>
          <p>ควรตรวจตามรุ่น เช่น</p>
          <ul>
            <li>Power</li>
            <li>Volume</li>
            <li>Home Button ถ้ามี</li>
            <li>Touch ID ถ้ามี</li>
            <li>USB-C</li>
            <li>Lightning</li>
            <li>Smart Connector</li>
          </ul>
          <p>หากปุ่มหรือพอร์ตใดมีปัญหาควรแจ้งตามจริง</p>

          <h2 style="margin-top: 1.5rem;">กล้อง ลำโพง และไมโครโฟน</h2>
          <p>ควรทดลอง:</p>
          <ul>
            <li>กล้องหน้า</li>
            <li>กล้องหลัง</li>
            <li>Video</li>
            <li>Speaker</li>
            <li>Microphone</li>
          </ul>
          <p>โดยเฉพาะเครื่องที่ใช้ประชุม เรียน หรือทำงาน</p>
          <p>หากฟังก์ชันใดผิดปกติให้แจ้งประกอบการประเมิน</p>
        </div>

        <div class="comm-card">
          <h2>Apple Pencil ขายพร้อม iPad ได้ไหม</h2>
          <p>สามารถแจ้ง Apple Pencil หรือ Stylus ที่มีพร้อมเครื่องได้</p>
          <p>ควรระบุ:</p>
          <ul>
            <li>รุ่นของ Pencil หากทราบ</li>
            <li>ใช้งานได้หรือไม่</li>
            <li>ชาร์จได้หรือไม่</li>
            <li>มีรอยหรือความเสียหายหรือไม่</li>
            <li>มีหัวสำรองหรืออุปกรณ์อื่นหรือไม่</li>
          </ul>
          <p>อุปกรณ์ควรประเมินแยกจากตัว iPad ก่อนรวมเป็นชุด</p>

          <h2 style="margin-top: 1.5rem;">Keyboard และอุปกรณ์เสริม</h2>
          <p>หากมี:</p>
          <ul>
            <li>Keyboard</li>
            <li>Keyboard Case</li>
            <li>Smart Keyboard</li>
            <li>Trackpad Keyboard</li>
            <li>Case</li>
            <li>Adapter</li>
            <li>Cable</li>
          </ul>
          <p>ควรแจ้งรุ่นและสภาพเท่าที่ทราบ</p>
          <p>ไม่ควรแจ้งเพียงว่า “ครบชุด” เพราะอุปกรณ์แต่ละชิ้นมีมูลค่าแตกต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: REPAIRS, DEAD IPAD, ACTIVATION LOCK & RESET -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>iPad เคยซ่อมยังขายได้ไหม</h2>
          <p>สามารถส่งมาประเมินได้</p>
          <p>ควรแจ้งหากทราบว่าเคย:</p>
          <ul>
            <li>เปลี่ยนจอ</li>
            <li>เปลี่ยน Battery</li>
            <li>ซ่อมพอร์ต</li>
            <li>ซ่อม Mainboard</li>
            <li>เปลี่ยนกล้อง</li>
            <li>เปลี่ยนปุ่ม</li>
            <li>โดนน้ำ</li>
            <li>ตกกระแทก</li>
          </ul>
          <p>ประวัติซ่อมช่วยให้พิจารณาความเสี่ยงได้ตรงขึ้น</p>

          <h2 style="margin-top: 1.5rem;">iPad เปิดไม่ติดยังประเมินได้ไหม</h2>
          <p>บางกรณีสามารถประเมินตามสภาพได้</p>
          <p>ควรส่ง:</p>
          <ul>
            <li>รุ่น</li>
            <li>ความจุ</li>
            <li>Wi-Fi หรือ Cellular</li>
            <li>อาการก่อนเสีย</li>
            <li>ชาร์จเข้าหรือไม่</li>
            <li>เคยตกหรือโดนน้ำหรือไม่</li>
            <li>เคยซ่อมหรือไม่</li>
            <li>อุปกรณ์ที่มี</li>
          </ul>
          <p>เครื่องที่ทดสอบไม่ได้จะมีความไม่แน่นอนสูงกว่าเครื่องปกติ</p>
        </div>

        <div class="comm-card">
          <h2>Activation Lock และ Find My</h2>
          <p>ไม่จำเป็นต้องจัดการบัญชีเพียงเพื่อส่งข้อมูลเช็กราคา</p>
          <p>เมื่อพร้อมส่งมอบจริง เจ้าของควรจัดการบัญชีด้วยตนเอง</p>
          <p>ไม่ควรส่ง:</p>
          <ul>
            <li>Apple ID Password</li>
            <li>รหัสผ่าน</li>
            <li>OTP</li>
            <li>Recovery Key</li>
