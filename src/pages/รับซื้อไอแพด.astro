---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อ iPad มือสอง เช็กรุ่น ความจุ แบตเตอรี่และสภาพ | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPad มือสอง iPad Air Pro mini ประเมินจากรุ่น ความจุ Wi-Fi หรือ Cellular หน้าจอ แบตเตอรี่ สภาพ ประวัติซ่อมและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อ iPad', url: '/รับซื้อไอแพด/' }
];

const ipadFaqs = [
  {
    question: "รับซื้อ iPad มือสองรุ่นอะไรบ้าง?",
    answer: "สามารถส่ง iPad, iPad Air, iPad Pro และ iPad mini หลายรุ่นมาประเมินได้ โดยควรแจ้งรุ่น ความจุ Wi-Fi หรือ Cellular สภาพหน้าจอ แบตเตอรี่ ประวัติซ่อม และอุปกรณ์ที่มี"
  },
  {
    question: "iPad แบตเสื่อมหรือเครื่องมีรอยขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการแบตเตอรี่ รอย ตัวเครื่องงอ หรือความเสียหายที่มี ไม่จำเป็นต้องซ่อมหรือเปลี่ยนแบตก่อนทุกกรณี"
  },
  {
    question: "iPad ไม่มีกล่องหรือ Adapter ขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ โดยควรแจ้งอุปกรณ์ที่มีจริง เช่น Adapter, Cable, Apple Pencil หรือ Keyboard เพราะอุปกรณ์บางรายการมีมูลค่าแยกจากตัวเครื่อง"
  },
  {
    question: "ขาย iPad พร้อม Apple Pencil ได้ไหม?",
    answer: "สามารถแจ้ง Apple Pencil เป็นอุปกรณ์ร่วมได้ ควรระบุรุ่นและสภาพของ Pencil แยกจาก iPad เนื่องจากความเข้ากันได้และมูลค่าขึ้นอยู่กับรุ่นของอุปกรณ์"
  },
  {
    question: "ต้อง Reset และออกจาก Apple ID ก่อนเช็กราคาไหม?",
    answer: "ไม่จำเป็นต้อง Reset หรือ Sign out เพียงเพื่อขอประเมินราคา ควร Backup และจัดการ Apple ID, Find My และข้อมูลส่วนตัวเมื่อพร้อมส่งมอบเครื่องจริง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={ipadFaqs}
>
  <Breadcrumb items={breadcrumbs} />

  <!-- 1. HERO SECTION -->
  <section class="section pad-hero-section">
    <div class="container container-narrow">
      <span class="badge badge-accent pad-badge">IPAD BUYBACK</span>
      <h1 class="pad-title">รับซื้อ iPad มือสอง เช็กรุ่น ความจุ และสภาพก่อนขาย</h1>
      <p class="pad-subtitle">
        ประเมินราคาตามรุ่น ความจุ Wi-Fi/Cellular สุขภาพแบตเตอรี่ สภาพตัวเครื่อง และอุปกรณ์เสริมแท้
      </p>
    </div>
  </section>

  <!-- 2. PROCESS / VALUATION STEPS (STEPS 3-9) -->
  <section class="section" style="padding-top: 1rem;">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-accent" style="margin-bottom: 0.75rem;">แนวทางการประเมิน</span>
        <h2>ขั้นตอนเช็กราคา iPad ก่อนขาย</h2>
        <p>ตรวจสอบสเปก สภาพหน้าจอ ตัวเครื่อง และความพร้อมของอุปกรณ์เสริม</p>
      </div>

      <div class="pad-steps-grid">
        <div class="card pad-step-card">
          <div class="pad-step-num">3</div>
          <h3>ส่งรูป</h3>
          <p>ถ่ายรูปประกอบการประเมิน:</p>
          <ul class="pad-step-list">
            <li>หน้าจอ</li>
            <li>ฝาหลัง</li>
            <li>ขอบ</li>
            <li>มุม</li>
            <li>กล้อง</li>
            <li>พอร์ต</li>
            <li>ตำหนิ</li>
          </ul>
        </div>

        <div class="card pad-step-card">
          <div class="pad-step-num">4</div>
          <h3>แจ้งสภาพ</h3>
          <p>ระบุการใช้งาน เช่น:</p>
          <ul class="pad-step-list">
            <li>Touch ปกติ</li>
            <li>Battery เสื่อม</li>
            <li>มีรอย</li>
            <li>ตัวเครื่องงอ</li>
            <li>กล้องมีปัญหา</li>
            <li>เคยซ่อม</li>
          </ul>
        </div>

        <div class="card pad-step-card">
          <div class="pad-step-num">5</div>
          <h3>แจ้งอุปกรณ์</h3>
          <p>อุปกรณ์ร่วม เช่น:</p>
          <ul class="pad-step-list">
            <li>Apple Pencil</li>
            <li>Keyboard</li>
            <li>Adapter</li>
            <li>Cable</li>
            <li>Box</li>
          </ul>
        </div>

        <div class="card pad-step-card">
          <div class="pad-step-num">6</div>
          <h3>ประเมินเบื้องต้น</h3>
          <p>พิจารณารุ่น Configuration สภาพ และอุปกรณ์ร่วมกัน</p>
        </div>

        <div class="card pad-step-card">
          <div class="pad-step-num">7</div>
          <h3>ตัดสินใจ</h3>
          <p>ผู้ขายสามารถเปรียบเทียบก่อนว่าจะขายหรือเก็บเครื่องไว้</p>
        </div>

        <div class="card pad-step-card">
          <div class="pad-step-num">8</div>
          <h3>Backup และจัดการบัญชี</h3>
          <p>เมื่อพร้อมขายจึงจัดการข้อมูล Apple ID และ Find My</p>
        </div>

        <div class="card pad-step-card" style="grid-column: 1 / -1; max-width: 600px; margin: 0 auto; width: 100%;">
          <div class="pad-step-num">9</div>
          <h3>ตรวจเครื่องจริงและซื้อขาย</h3>
          <p>ตรวจข้อมูลและสภาพให้ตรงกับรายละเอียดที่ใช้ประเมินก่อนดำเนินการซื้อขาย</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROVINCIAL / REMOTE VALUATION SECTION -->
  <section class="section section-muted">
    <div class="container container-narrow">
      <div class="card provincial-card">
        <h2>อยู่ต่างจังหวัดเริ่มเช็กราคา iPad ได้อย่างไร</h2>
        <p>ไม่จำเป็นต้องเดินทางพร้อมเครื่องเพียงเพื่อถามราคาเบื้องต้น</p>
        <p>เริ่มจากส่ง:</p>

        <div class="provincial-formula">
          <strong>รุ่น + ความจุ + Wi-Fi/Cellular + รูป + สภาพ + อุปกรณ์</strong>
        </div>

        <p>จากนั้นจึงค่อยพิจารณาวิธีส่งมอบหรือนัดหมายตามพื้นที่และความเหมาะสม</p>
        <p class="provincial-note">
          หน้า <code>/รับซื้อไอแพด/</code> เป็นข้อมูลบริการภาพรวม ไม่ได้ใช้เพื่ออ้างว่ามีสาขาในทุกจังหวัด
          หน้ารับซื้อ iPad รายพื้นที่ที่มี Historical Search Equity จะเชื่อมเข้ากับหมวดนี้ภายหลังเมื่อผ่าน Content QA และ Index Release ของแต่ละหน้า
        </p>
      </div>
    </div>
  </section>

  <!-- 4. INTAKE & CONTACT CTA SECTION -->
  <section class="section">
    <div class="container container-narrow">
      <div class="card intake-card">
        <h2>เริ่มเช็กราคา iPad ของคุณ</h2>
        <p>ส่งข้อมูล:</p>

        <div class="intake-spec-box">
          <strong>รุ่น + ความจุ + Wi-Fi/Cellular + รูปเครื่อง + สภาพ + อุปกรณ์</strong>
        </div>

        <p class="intake-helper">
          หากไม่แน่ใจว่ารุ่นอะไร ให้ส่งรูปหน้า About หรือ Model Number มาได้
        </p>

        <div class="cta-buttons-row">
          <a
            href={getLineUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-line btn-lg"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>

          <a href={getPhoneUrl()} class="btn btn-outline btn-lg intake-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div class="intake-links-footer">
          <p>
            ดูขั้นตอนภาพรวมได้ที่ <a href="/เช็กราคาก่อนขาย/">เช็กราคาก่อนขาย</a> และ วิธีขาย
          </p>
          <div class="intake-motto">
            <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ SECTION -->
  <section class="section section-muted">
    <div class="container">
      <FAQ
        items={ipadFaqs}
        title="คำถามที่พบบ่อยเกี่ยวกับการรับซื้อ iPad"
        subtitle="ข้อสงสัยเกี่ยวกับรุ่น หน้าจอ อาการงอ Apple Pencil และ Apple ID"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .pad-hero-section {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    text-align: center;
  }

  .pad-badge {
    margin-bottom: 1rem;
  }

  .pad-title {
    font-size: 2.15rem;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .pad-title {
      font-size: 2.65rem;
    }
  }

  .pad-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Steps Grid (3-9) */
  .pad-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .pad-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pad-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pad-step-card {
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .pad-step-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .pad-step-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .pad-step-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .pad-step-list {
    margin: 0.5rem 0 0 1.25rem;
    padding: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .pad-step-list li {
    margin-bottom: 0.25rem;
  }

  /* Provincial Card */
  .provincial-card {
    padding: 2.5rem 2rem;
    background-color: #ffffff;
  }

  .provincial-card h2 {
    font-size: 1.65rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .provincial-formula {
    font-size: 1.2rem;
    color: var(--color-primary);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    margin: 1rem 0 1.25rem 0;
    text-align: center;
  }

  .provincial-note {
    background-color: var(--color-bg-subtle);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-top: 1.25rem;
    margin-bottom: 0;
  }

  /* Intake Card */
  .intake-card {
    padding: 2.75rem 2rem;
    text-align: center;
    background-color: #ffffff;
  }

  .intake-card h2 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .intake-spec-box {
    font-size: 1.15rem;
    color: var(--color-primary);
    background-color: var(--color-accent-light);
    border: 1px solid #fde68a;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    margin: 1rem auto 1.25rem auto;
    max-width: 680px;
  }

  .cta-buttons-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .intake-phone {
    border-color: var(--color-border);
  }

  .intake-helper {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 620px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.6;
  }

  .intake-links-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .intake-links-footer a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .intake-motto {
    font-size: 1.15rem;
    color: var(--color-accent-hover);
    background-color: var(--color-accent-light);
    border: 1px solid #fde68a;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    max-width: 480px;
    margin: 1.25rem auto 0 auto;
  }
</style>
