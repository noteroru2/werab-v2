---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';

const seo = resolveSeo('/รับซื้อเครื่องเกม/');
const breadcrumbs = [
  { name: 'หมวดหมู่รับซื้อ', url: '/รับซื้อ/' },
  { name: 'รับซื้อเครื่องเล่นเกม', url: '/รับซื้อเครื่องเกม/' }
];
const internalLinks = getInternalLinks(seo);

const faqs = [
  {
    question: 'รับซื้อเครื่องเล่นเกมคอนโซลรุ่นใดบ้าง?',
    answer: 'เรารับซื้อ PlayStation 5 (PS5 Standard / Digital / Slim / Pro), PlayStation 4 (PS4 Pro / Slim), Nintendo Switch (OLED, V2, Lite), Xbox Series X/S และ Handheld PC (Steam Deck, ROG Ally, Legion Go)'
  },
  {
    question: 'รับซื้อแผ่นเกมและจอยเสริมด้วยไหม?',
    answer: 'รับซื้ออุปกรณ์เสริมครบชุด จอย DualSense, Pro Controller, แท่นชาร์จ และแผ่นเกมแท้'
  }
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="section" style="padding-top: 3rem; padding-bottom: 2rem; text-align: center;">
    <div class="container container-narrow">
      <span class="badge badge-accent" style="margin-bottom: 0.75rem;">GAMING CONSOLE BUYBACK</span>
      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">{seo.h1}</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted);">
        รับซื้อเครื่องเล่นเกมคอนโซลและพกพา PS5, PS4, Nintendo Switch, Steam Deck พร้อมอุปกรณ์เสริม ตีราคาโปร่งใส
      </p>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container container-narrow">
      <div class="card" style="padding: 2.5rem 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">เกณฑ์การประเมินราคาเครื่องเกมคอนโซล</h2>
        <ul>
          <li><strong>โมเดลและช่องอ่านแผ่น</strong>: รุ่น Standard (มีช่องใส่แผ่น) หรือรุ่น Digital Edition และความจุ SSD ภายใน</li>
          <li><strong>สภาพจอยคอนโทรลเลอร์</strong>: การตอบสนองของก้านอนาล็อก (ไม่ดริฟต์) ปุ่มกดทุกปุ่ม และแบตเตอรี่จอย</li>
          <li><strong>ระบบระบายความร้อนและเสียงพัดลม</strong>: ตัวเครื่องทำงานเงียบ ไม่มีเสียงหวีดผิดปกติ</li>
          <li><strong>อุปกรณ์เชื่อมต่อ</strong>: สาย HDMI, สายไฟ AC, ขาตั้งเครื่อง และกล่องเดิม</li>
        </ul>
      </div>

      <ProcessSteps />

      <div style="margin-top: 3.5rem;">
        <FAQ items={faqs} />
      </div>

      <RelatedLinks
        clusterLinks={internalLinks.clusterLinks}
        parentLink={internalLinks.parentLink}
        guideLinks={internalLinks.guideLinks}
      />
    </div>
  </section>

  <CTA />
</BaseLayout>
