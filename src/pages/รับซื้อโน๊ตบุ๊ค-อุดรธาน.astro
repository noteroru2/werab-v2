---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คอุดรธานี Notebook บริษัท Gaming เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในอุดรธานี ทั้ง Notebook สำนักงาน Business Laptop และ Gaming Notebook ประเมินจากรุ่น สเปก Battery สภาพ อุปกรณ์และจำนวนเครื่อง";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คอุดรธานี เช็กสเปก เครื่องเดี่ยวหรือหลายเครื่องก่อนขาย",
    "url": "/รับซื้อโน๊ตบุ๊ค-อุดรธาน/"
  }
];

const faqs = [
  {
    "question": "มี Notebook หลายเครื่องจากสำนักงานส่งรายการมาก่อนได้ไหม?",
    "answer": "ได้ ควรแบ่งตาม Model, CPU, RAM, SSD, จำนวนและสภาพ หาก Configuration ต่างกันควรแยกเป็นคนละกลุ่ม"
  },
  {
    "question": "เครื่องรุ่นเดียวกันแต่ RAM ต่างกันควรรวมกันไหม?",
    "answer": "ควรแยก Configuration เพราะ Hardware ที่ติดตั้งจริงต่างกันและไม่ควรใช้เครื่องหนึ่งแทนทั้งหมด"
  },
  {
    "question": "ขายเครื่องบริษัทโดยไม่รวม SSD ได้ไหม?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ และไม่จำเป็นต้องเปิดเผยข้อมูลภายในเพื่อประเมิน Hardware"
  },
  {
    "question": "Notebook ที่เปิดไม่ติดรวมอยู่ในล็อตได้ไหม?",
    "answer": "ได้ แต่ควรแยกสถานะจากเครื่องปกติและแจ้ง Model สเปกที่ทราบ รวมถึงอาการก่อนเสีย"
  },
  {
    "question": "Adapter มีไม่ครบทุกเครื่องยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งจำนวน Adapter ที่มีจริง ไม่จำเป็นต้องซื้อเพิ่มให้ครบก่อนเช็กราคา"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คอุดรธานี เช็กสเปก เครื่องเดี่ยวหรือหลายเครื่องก่อนขาย</h1>
        
        
        <p>โดยครอบคลุมการประเมินทั้ง Notebook ส่วนตัว เครื่องสำนักงาน Business Laptop และ Gaming Notebook ตามรุ่น สเปกและสภาพจริง</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">สามารถเริ่มจาก:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + จำนวนเครื่อง + รูป</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คอุดรธานี เช็กสเปก เครื่องเดี่ยวหรือหลายเครื่องก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Notebook เครื่องเดียวและหลายเครื่องควรเตรียมข้อมูลต่างกัน</h2>
        <p>หากมีเพียงเครื่องเดียว สามารถส่ง:</p>
        <ul>
        <li>Model</li>
        <li>CPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>GPU</li>
        <li>Battery</li>
        <li>รูป</li>
        <li>Adapter</li>
        <li>ตำหนิ</li>
        </ul>
        <p>แต่หากเป็น Notebook หลายเครื่องจากบริษัท สำนักงาน หรือการเปลี่ยนอุปกรณ์ ควรจัดรายการแยกตามรุ่นและ Configuration</p>
        <p>ไม่ควรใช้ข้อมูลของเครื่องหนึ่งแทนทั้งล็อตหากสภาพต่างกัน</p>
        </div>
        <div class="comm-card">
          <h2>ตัวอย่างการส่งรายการ Notebook หลายเครื่อง</h2>
        <p>สามารถจัดข้อมูลลักษณะนี้:</p>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>รุ่น</th>
                <th>CPU</th>
                <th>RAM</th>
                <th>SSD</th>
                <th>จำนวน</th>
                <th>สภาพ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>รุ่น...</td>
                <td>Core i5-...</td>
                <td>8GB</td>
                <td>256GB</td>
                <td>6</td>
                <td>ใช้งานได้</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>Core i5-...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>4</td>
                <td>Battery เสื่อม</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>Core i7-...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>2</td>
                <td>มีตำหนิ</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>1</td>
                <td>เปิดไม่ติด</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>การแยกกลุ่มช่วยให้ไม่ใช้ราคาเฉลี่ยแบบผิด Configuration</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Business Laptop ควรดูสภาพ Port และ Keyboard ด้วย</h2>
        <p>Notebook สำหรับสำนักงานหรือธุรกิจอาจมีการใช้งาน Port และ Keyboard มากกว่าเครื่องทั่วไป</p>
        <p>ควรตรวจ:</p>
        <ul>
        <li>USB</li>
        <li>USB-C</li>
        <li>HDMI</li>
        <li>LAN ถ้ามี</li>
        <li>Keyboard</li>
        <li>Touchpad</li>
        <li>Webcam</li>
        <li>Wi-Fi</li>
        <li>Speaker</li>
        <li>ระบบชาร์จ</li>
        </ul>
        <p>หากบางส่วนมีปัญหา สามารถแจ้งตามอาการจริงโดยไม่ต้องวินิจฉัยสาเหตุเอง</p>
        </div>
        <div class="comm-card">
          <h2>CPU Generation มีผลต่อการแยกเครื่องสำนักงาน</h2>
        <p>คำว่า:</p>
        <p><strong>Core i5</strong></p>
        <p>ไม่เพียงพอสำหรับแยก Notebook หลาย Generation</p>
        <p>ควรระบุเช่น:</p>
        <p><strong>Core i5-8250U</strong></p>
        <p><strong>Core i5-10210U</strong></p>
        <p><strong>Core i5-1135G7</strong></p>
        <p><strong>Core i5-1235U</strong></p>
        <p>เพื่อช่วยบอก Platform และช่วงอายุของเครื่องได้ชัดขึ้น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Gaming Notebook ต้องแยก GPU และ Adapter</h2>
        <p>หากเป็น Gaming Notebook ให้ส่งเพิ่ม:</p>
        <ul>
        <li>GPU</li>
        <li>Adapter</li>
        <li>สเปกจอถ้าทราบ</li>
        </ul>
        <p>ตัวอย่าง:</p>
        <p><strong>RTX 3050 Laptop GPU</strong></p>
        <p><strong>RTX 3060 Laptop GPU</strong></p>
        <p><strong>RTX 4060 Laptop GPU</strong></p>
        <p>เครื่อง Series เดียวกันอาจมี GPU ต่างกัน จึงควรตรวจ Configuration เต็มก่อนประเมิน</p>
        </div>
        <div class="comm-card">
          <h2>RAM และ SSD ของเครื่ององค์กรอาจไม่เหมือนกันทุกเครื่อง</h2>
        <p>แม้ Notebook จะเป็น Model เดียวกัน แต่อาจถูกอัปเกรดคนละช่วงเวลา</p>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>บางเครื่อง RAM 8GB</li>
        <li>บางเครื่อง RAM 16GB</li>
        <li>บางเครื่อง SSD 256GB</li>
        <li>บางเครื่อง SSD 512GB</li>
        </ul>
        <p>หากเป็นล็อตใหญ่ ควรแบ่งกลุ่มตาม Configuration ที่ตรวจได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ข้อมูลใน SSD ของบริษัทไม่จำเป็นสำหรับการประเมินราคา</h2>
        <p>เพื่อเช็กราคา Hardware ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>ข้อมูลลูกค้า</li>
        <li>ข้อมูลภายในบริษัท</li>
        <li>Email Password</li>
        </ul>
        <p>หากองค์กรต้องเก็บ Storage ไว้ สามารถแจ้งว่า:</p>
        <p><strong>ขายเครื่องโดยไม่รวม SSD</strong></p>
        <p>และประเมินจาก Hardware ที่เหลือจริง</p>
        </div>
        <div class="comm-card">
          <h2>Battery ของหลายเครื่องควรแบ่งกลุ่มตามสภาพ</h2>
        <p>หากตรวจ Health ได้ สามารถแบ่ง เช่น:</p>
        <ul>
        <li>Battery ปกติ</li>
        <li>Battery เสื่อม</li>
        <li>ไม่เก็บไฟ</li>
        <li>ต้องเสียบ Adapter</li>
        <li>Battery บวม</li>
        <li>ยังไม่ได้ทดสอบ</li>
        </ul>
        <p>ไม่ควรถือว่า Battery ของทุกเครื่องอยู่ในสภาพเดียวกันเพียงเพราะเป็นรุ่นเดียวกัน</p>
        <p>หาก Battery บวมควรหยุดใช้งานหนักและหลีกเลี่ยงการกดตัวเครื่องบริเวณที่นูน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Notebook ที่มีตำหนิยังสามารถอยู่ในรายการได้</h2>
        <p>ไม่จำเป็นต้องคัดออกเพราะมี:</p>
        <ul>
        <li>รอย</li>
        <li>จอมีปัญหา</li>
        <li>Keyboard เสีย</li>
        <li>บานพับแตก</li>
        <li>Battery เสื่อม</li>
        <li>ไม่มี Adapter</li>
        <li>เปิดไม่ติด</li>
        </ul>
        <p>ควรแยกสภาพของเครื่องนั้นออกจากกลุ่มปกติ เพื่อให้การประเมินไม่ปะปนกัน</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดควรติดป้ายหรือระบุให้ชัดเมื่อมีหลายเครื่อง</h2>
        <p>หากเป็นล็อตหลายเครื่อง สามารถแบ่งเป็น:</p>
        <p><strong>ใช้งานได้</strong></p>
        <p><strong>มีอาการ</strong></p>
        <p><strong>เปิดไม่ติด</strong></p>
        <p><strong>ยังไม่ได้ทดสอบ</strong></p>
        <p>เครื่องเปิดไม่ติดสามารถส่ง Model และสเปกที่ทราบประกอบได้</p>
        <p>หากมีกลิ่นไหม้ Battery บวม หรือความร้อนผิดปกติ ไม่ควรเปิดซ้ำหลายครั้ง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Adapter ควรนับตามสิ่งที่มีจริง</h2>
        <p>หากมี 10 เครื่องแต่มี Adapter เพียง 7 ตัว ควรแจ้งตามจริง</p>
        <p>ไม่ควรระบุว่าครบชุดหากอุปกรณ์มีไม่ครบทุกเครื่อง</p>
        <p>สำหรับเครื่องเดี่ยวก็ใช้หลักเดียวกัน:</p>
        <ul>
        <li>Adapter เดิม</li>
        <li>Adapter เทียบ</li>
        <li>ไม่มี Adapter</li>
        </ul>
        </div>
        <div class="comm-card">
          <h2>ผู้ขายในอุดรธานีสามารถเริ่มจากรายการก่อน</h2>
        <p>สามารถส่งข้อมูลเบื้องต้นก่อนตัดสินใจขั้นตอนตรวจสินค้าและส่งมอบ</p>
        <p>การเช็กราคาเบื้องต้นเริ่มจากส่งข้อมูลออนไลน์ก่อน และขั้นตอนตรวจหรือส่งมอบจะนัดหมายตามพื้นที่จริงโดยไม่ได้ระบุว่ามีสาขา พนักงาน หรือจุดรับซื้อประจำในทุกอำเภอของอุดรธานี</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนส่ง Notebook เครื่องเดียวหรือหลายเครื่อง</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แยก Model</h3>
              <p>อย่ารวมหลายรุ่นเป็นรายการเดียว</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แยก CPU</h3>
              <p>ใช้รหัสรุ่นเต็มถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แยก RAM และ SSD</h3>
              <p>ตาม Configuration ปัจจุบัน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง GPU</h3>
              <p>สำหรับเครื่องที่มี Dedicated GPU</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แบ่งสภาพ</h3>
              <p>ปกติ มีอาการ เปิดไม่ติด หรือยังไม่ทดสอบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง Battery</h3>
              <p>เท่าที่ตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. นับ Adapter</h3>
              <p>ตามจำนวนจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. ส่งรูป</h3>
              <p>ทั้งภาพรวมและตำหนิสำคัญ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. ประเมินตามแต่ละกลุ่ม</h3>
              <p>ไม่ใช้เครื่องเดียวแทนทั้งล็อต</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้าก่อนซื้อขาย</h3>
              <p>ยืนยันจำนวน Configuration และสภาพจริง</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

