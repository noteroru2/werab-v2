---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อมือถืออุบลราชธานี iPhone Android เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อมือถือมือสองในอุบลราชธานี ทั้ง iPhone และ Android ประเมินจากรุ่น ความจุ แบตเตอรี่ หน้าจอ สภาพ อุปกรณ์และประวัติซ่อม ส่งรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอโฟน",
    "url": "/รับซื้อไอโฟน/"
  },
  {
    "name": "รับซื้อมือถืออุบลราชธานี เช็กรุ่น แบตเตอรี่ และสภาพก่อนขาย",
    "url": "/รับซื้อมือถือ-อุบล/"
  }
];

const faqs = [
  {
    "question": "อยู่ต่างอำเภอในอุบลสามารถเช็กราคาก่อนได้ไหม?",
    "answer": "สามารถส่งรุ่น ความจุ รูป Battery และสภาพเพื่อประเมินเบื้องต้นก่อน แล้วจึงพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่จริง"
  },
  {
    "question": "Battery Health ต่ำต้องเปลี่ยนก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี ควรเช็กราคาตามสภาพก่อนแล้วเปรียบเทียบค่าเปลี่ยน Battery กับมูลค่าที่คาดว่าจะเพิ่ม"
  },
  {
    "question": "มือถือเคยเปลี่ยนจอยังขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินได้ ควรแจ้งประวัติที่ทราบและสภาพจอ Touch รวมถึงฟังก์ชันอื่นตามจริง"
  },
  {
    "question": "ไม่มีเครื่องชาร์จหรือกล่องขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินได้ โดยแจ้งอุปกรณ์ที่มีจริง ไม่จำเป็นต้องซื้อใหม่เพื่อเติมชุดก่อนเช็กราคา"
  },
  {
    "question": "เครื่องเปิดไม่ติดเช็กราคาได้หรือไม่?",
    "answer": "สามารถเริ่มจากรุ่น ความจุ รูป อาการ และประวัติความเสียหายได้ แต่เครื่องที่ไม่สามารถทดสอบได้จะมีความไม่แน่นอนมากกว่าเครื่องปกติ"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อมือถืออุบลราชธานี เช็กรุ่น แบตเตอรี่ และสภาพก่อนขาย</h1>
        <p>หากมีมือถือมือสองอยู่ในอุบลราชธานี การประเมินก่อนขายควรเริ่มจากข้อมูลของเครื่องจริง ไม่ใช่ใช้เพียงราคาตอนซื้อหรือชื่อแบรนด์</p>
        <p>หน้า <code>/รับซื้อมือถือ-อุบล/</code> รักษา Historical Intent ของผู้ค้นหาที่ต้องการขายโทรศัพท์มือถือในอุบลราชธานี ทั้ง iPhone และสมาร์ทโฟนระบบอื่น</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ส่งก่อน:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>รุ่น + ความจุ + สี + Battery + รูปด้านหน้า/หลัง + ตำหนิ + ประวัติซ่อมถ้ามี</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.webp" type="image/webp" />
              <source srcset="/images/hero-smartphone.avif" type="image/avif" />
              <source srcset="/images/hero-smartphone.webp" type="image/webp" />
              <img
                src="/images/hero-smartphone.webp"
                alt="รับซื้อมือถืออุบลราชธานี เช็กรุ่น แบตเตอรี่ และสภาพก่อนขาย"
                width="668"
                height="717"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ในอุบลราชธานีส่งรูปเช็กราคาก่อนได้</h2>
        <p>ผู้ขายที่อยู่ในอำเภอเมือง วารินชำราบ หรือพื้นที่อื่นของจังหวัด สามารถเริ่มจากข้อมูลเครื่องก่อน</p>
        <p>ไม่จำเป็นต้องเดินทางพร้อมโทรศัพท์เพียงเพื่อถามราคาเบื้องต้น</p>
        <p>หลังประเมินแล้วจึงค่อยตกลงขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ในทุกอำเภอ</p>
        </div>
        <div class="comm-card">
          <h2>iPhone ควรแจ้งรุ่นและความจุให้ครบ</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>iPhone 15 Pro 256GB</strong></p>
        <p>ข้อมูลนี้มีประโยชน์กว่าการแจ้งเพียง:</p>
        <p><strong>iPhone 15</strong></p>
        <p>เพราะ Series เดียวกันอาจมีหลายรุ่นย่อยและหลายความจุ</p>
        <p>หากมี Battery Health สามารถส่งประกอบได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Android ควรแจ้งชื่อรุ่นเต็มเช่นกัน</h2>
        <p>สมาร์ทโฟน Android แต่ละ Brand มีหลาย Series และหลาย Configuration</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>RAM ถ้าทราบ</li>
        <li>Storage</li>
        <li>สี</li>
        <li>สภาพ</li>
        </ul>
        <p>หากมี Box สามารถใช้ข้อมูลบนกล่องช่วยตรวจรุ่นได้</p>
        </div>
        <div class="comm-card">
          <h2>หน้าจอเป็นจุดที่ควรถ่ายอย่างละเอียด</h2>
        <p>ควรถ่ายขณะ:</p>
        <ul>
        <li>เปิดจอพื้นสว่าง</li>
        <li>เปิดจอพื้นมืดถ้าจำเป็น</li>
        <li>แสดงขอบจอ</li>
        <li>แสดงจุดแตกหรือรอย</li>
        </ul>
        <p>แจ้งหาก:</p>
        <ul>
        <li>Touch ไม่ครบ</li>
        <li>จอเป็นเส้น</li>
        <li>Burn-in</li>
        <li>กระจกแตก</li>
        <li>มีจุดดำ</li>
        <li>สีเพี้ยน</li>
        <li>จอกระพริบ</li>
        </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery ต่ำต้องเปลี่ยนก่อนขายหรือไม่</h2>
        <p>ไม่จำเป็นทุกกรณี</p>
        <p>ควรเช็กราคาตามสภาพก่อน แล้วเปรียบเทียบ:</p>
        <ul>
        <li>ค่า Battery</li>
        <li>ค่าแรง</li>
        <li>ความเสี่ยงจากการแกะเครื่อง</li>
        <li>มูลค่าที่คาดว่าจะเพิ่ม</li>
        </ul>
        <p>สำหรับ iPhone สามารถแจ้ง Battery Health ที่ระบบแสดงได้หากมี</p>
        </div>
        <div class="comm-card">
          <h2>เคยเปลี่ยนจอควรแจ้งไหม</h2>
        <p>ควรแจ้งหากทราบ</p>
        <p>รวมถึง:</p>
        <ul>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อม Port</li>
        <li>ซ่อม Board</li>
        <li>เคยโดนน้ำ</li>
        </ul>
        <p>ข้อมูลเหล่านี้ช่วยลดความคลาดเคลื่อนเมื่อตรวจเครื่องจริง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Face ID ลายนิ้วมือ หรือกล้องมีปัญหาควรแจ้ง</h2>
        <p>ฟังก์ชันที่ไม่สมบูรณ์อาจมีผลต่อการประเมิน</p>
        <p>ควรแจ้งตามอาการจริง เช่น</p>
        <ul>
        <li>Face ID ใช้ไม่ได้</li>
        <li>Fingerprint ใช้ไม่ได้</li>
        <li>กล้องสั่น</li>
        <li>กล้องไม่โฟกัส</li>
        <li>Speaker มีเสียงแตก</li>
        <li>Microphone มีปัญหา</li>
        <li>Port ชาร์จหลวม</li>
        </ul>
        <p>ไม่ควรสรุปว่าเกิดจากอะไหล่ใดหากยังไม่ได้ตรวจ</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องติดบัญชีควรจัดการก่อนส่งมอบ</h2>
        <p>ก่อนซื้อขายจริง เจ้าของควรสามารถจัดการบัญชีที่ผูกกับเครื่องของตนเองได้</p>
        <p>แต่เพื่อขอราคา ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Apple ID Password</li>
        <li>Google Password</li>
        <li>Recovery Code</li>
        </ul>
        <p>การประเมินเบื้องต้นไม่จำเป็นต้องใช้รหัสเหล่านี้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องไม่มีอุปกรณ์ยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินได้แม้ไม่มี:</p>
        <ul>
        <li>กล่อง</li>
        <li>สาย</li>
        <li>Adapter</li>
        <li>เคส</li>
        </ul>
        <p>ควรแจ้งเพียงว่าอะไรมีและอะไรไม่มี</p>
        <p>ไม่จำเป็นต้องซื้อของใหม่มาเติมชุดก่อนรู้ว่าคุ้มค่าหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>มือถือเปิดไม่ติดหรือโดนน้ำควรทำอย่างไร</h2>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>เกิดอาการเมื่อไร</li>
        <li>ชาร์จแล้วมีอาการหรือไม่</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>เคยซ่อมหรือไม่</li>
        </ul>
        <p>หาก Battery บวม เครื่องร้อน หรือมีกลิ่นผิดปกติ ไม่ควรชาร์จหรือเปิดซ้ำหลายครั้งโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ขายหลายเครื่องพร้อมกันควรส่งข้อมูลแบบไหน</h2>
        <p>หากมีหลายเครื่องจากร้าน บริษัท หรือการเปลี่ยนอุปกรณ์ภายในองค์กร สามารถจัดเป็นตาราง:</p>
        <div class="table-responsive"><table class="table table-bordered">
          <thead><tr><th>รุ่น</th><th>ความจุ</th><th>จำนวน</th><th>Battery</th><th>สภาพ</th></tr></thead>
          <tbody>
          <tr><td>รุ่น...</td><td>128GB</td><td>4</td><td>ปกติ</td><td>มีรอย</td></tr>
          <tr><td>รุ่น...</td><td>256GB</td><td>3</td><td>Health ...</td><td>ปกติ</td></tr>
          <tr><td>รุ่น...</td><td>128GB</td><td>2</td><td>ไม่ทราบ</td><td>เปิดไม่ติด</td></tr>
          </tbody></table></div>
        <p>ไม่ควรใช้ข้อมูลเครื่องหนึ่งแทนทั้งล็อตหากสภาพแตกต่างกัน</p>
        </div>
        <div class="comm-card">
          <h2>หน้าอุบลนี้ต่างจากหน้ารับซื้อ iPhone หลักอย่างไร</h2>
        <p>หน้า <a href="/รับซื้อไอโฟน/"><code>/รับซื้อไอโฟน/</code></a> ดูแล Broad iPhone Intent</p>
        <p>ส่วนหน้า <code>/รับซื้อมือถือ-อุบล/</code> รักษา Historical Local Search Intent สำหรับมือถือในพื้นที่อุบลราชธานี</p>
        <p>หน้านี้จึงไม่ควรถูกขยายให้กลายเป็นหน้า National Smartphone Hub อีกหน้า</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคามือถือในอุบลราชธานี</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งรุ่น</h3>
              <p>ใช้ชื่อเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้งความจุ</h3>
              <p>ตามเครื่องจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่งรูป</h3>
              <p>หน้า หลัง กรอบ และตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง Battery</h3>
              <p>ข้อมูลที่ตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้งฟังก์ชันที่มีอาการ</h3>
              <p>กล้อง Touch Face ID หรือลายนิ้วมือ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้งประวัติซ่อม</h3>
              <p>เท่าที่ทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งอุปกรณ์</h3>
              <p>ตามของที่รวมขาย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. ประเมินเบื้องต้น</h3>
              <p>จากรุ่นและสภาพร่วมกัน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. ตัดสินใจก่อนขาย</h3>
              <p>เช็กข้อมูลก่อนโดยยังไม่จำเป็นต้องตกลงทันที</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจเครื่องจริง</h3>
              <p>ยืนยันรุ่น สภาพและสิ่งที่รวมขายก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคามือถือในอุบลราชธานี</h2>
        <p>ส่ง:</p>
        <p><strong>รุ่น + ความจุ + Battery + รูป + ตำหนิ + อุปกรณ์</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายมือถือมือสองในอุบลราชธานี" subtitle="" />
    </div>
  </section>
</BaseLayout>
