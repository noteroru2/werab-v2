---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อกล้องอุบล DSLR Mirrorless Canon Nikon เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อกล้องมือสองในอุบลราชธานี ทั้ง DSLR Mirrorless และชุดกล้องพร้อมเลนส์ ประเมินจากรุ่น Mount Sensor Shutter AF จอ EVF เลนส์ สภาพและอุปกรณ์";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อกล้อง",
    "url": "/รับซื้อกล้อง/"
  },
  {
    "name": "รับซื้อกล้องอุบล เช็กรุ่น Body Lens Shutter และระบบโฟกัสก่อนขาย",
    "url": "/รับซื้อกล้องอุบล-กล้องcanon-niko/"
  }
];

const faqs = [
  {
    "question": "รับเฉพาะ Canon หรือ Nikon ตามชื่อ URL หรือไม่?",
    "answer": "ไม่ใช่ ชื่อ URL เป็น Historical Path เดิม ส่วนหน้านี้รักษา Intent กล้องมือสองในอุบลราชธานี และชื่อแบรนด์ใช้เพื่อจำแนกสินค้าเท่านั้น"
  },
  {
    "question": "Shutter Count สูงยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรดูร่วมกับ Body Sensor AF จอ EVF Lens และประวัติซ่อม ไม่ควรใช้ Shutter Count เพียงอย่างเดียว"
  },
  {
    "question": "กล้องมีจุดในภาพต้องทำความสะอาด Sensor ก่อนหรือไม่?",
    "answer": "ไม่จำเป็นทุกกรณี ควรตรวจว่าอาการอาจมาจาก Sensor หรือ Lens ก่อน และไม่ควรใช้วิธีทำความสะอาดที่เสี่ยงเพียงเพื่อเตรียมขาย"
  },
  {
    "question": "Auto Focus มีอาการยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการและ Lens ที่ใช้ทดสอบ เพื่อให้เข้าใจว่าปัญหาอาจเกี่ยวข้องกับ Body หรือ Lens"
  },
  {
    "question": "ไม่มีกล่องหรือ Charger ยังส่งมาประเมินได้หรือไม่?",
    "answer": "ได้ ควรแจ้งอุปกรณ์ที่มีจริง ไม่จำเป็นต้องซื้อของใหม่มาเติมชุดก่อนเช็กราคา"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อกล้องอุบล เช็กรุ่น Body Lens Shutter และระบบโฟกัสก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อกล้องอุบล-กล้องcanon-niko/</code> เป็น Historical URL ที่รักษา Search Intent:</p>
        <p><strong>Camera + Ubon Ratchathani</strong></p>
        <p>คำว่า Canon และ <code>niko</code> ที่อยู่ใน URL เดิมเป็นส่วนหนึ่งของ Historical Search Path เท่านั้น</p>
        <p>เนื้อหา V2 ไม่ได้กำหนดหน้านี้เป็นหน้าเฉพาะ Canon หรือ Nikon และไม่ได้หมายความว่าเว็บไซต์เป็นตัวแทน ศูนย์บริการ หรือมีความเกี่ยวข้องอย่างเป็นทางการกับผู้ผลิต</p>
        <p>เริ่มเช็กราคาจาก:</p>
        <p><strong>Brand + Model + Body + Lens + Shutter Count ถ้าทราบ + รูป + อาการ + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>อยู่ในอุบลราชธานีสามารถส่งข้อมูล Body และ Lens มาก่อนได้</h2>
        <p>ก่อนตัดสินใจนำกล้องไปตรวจ สามารถเริ่มจากส่งข้อมูลและรูปได้</p>
        <p>ควรระบุ:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>Body</li>
        <li>Lens</li>
        <li>Mount ถ้าทราบ</li>
        <li>Shutter Count</li>
        <li>Battery</li>
        <li>Charger</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หลังทราบข้อมูลเบื้องต้นแล้วจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>หน้า Local นี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ของอุบลราชธานี</p>
        <hr class="section-divider" />
        <h2>DSLR และ Mirrorless ต้องระบุรุ่นเต็ม</h2>
        <p>คำว่า:</p>
        <p><strong>Canon DSLR</strong></p>
        <p><strong>Nikon DSLR</strong></p>
        <p>หรือ:</p>
        <p><strong>Mirrorless</strong></p>
        <p>ยังไม่เพียงพอ</p>
        <p>ควรแจ้ง Model เต็มของ Body</p>
        <p>ตัวอย่าง:</p>
        <p><strong>EOS ...</strong></p>
        <p><strong>Z ...</strong></p>
        <p><strong>Alpha ...</strong></p>
        <p><strong>X-...</strong></p>
        <p>หรือรุ่นอื่นตามเครื่องจริง</p>
        <p>การกล่าวถึงชื่อแบรนด์เป็นการจำแนกสินค้าเท่านั้น</p>
        <hr class="section-divider" />
        <h2>Mount มีความสำคัญเมื่อประเมินกล้องพร้อมเลนส์</h2>
        <p>หากทราบควรแจ้ง Mount หรือระบบ Lens ที่ใช้</p>
        <p>เพราะเลนส์ที่ชื่อหรือระยะใกล้กันอาจเป็นคนละ Mount และใช้กับ Body ต่างระบบ</p>
        <p>หากไม่แน่ใจ ไม่จำเป็นต้องคาดเดา สามารถส่งรูปหน้าและท้าย Lens ประกอบได้</p>
        <hr class="section-divider" />
        <h2>Shutter Count เป็นข้อมูลประกอบของ Body</h2>
        <p>หากตรวจได้สามารถแจ้ง Shutter Count</p>
        <p>แต่ไม่ควรใช้ Shutter Count เป็นข้อมูลเดียวในการสรุปสภาพ</p>
        <p>ควรดูร่วมกับ:</p>
        <ul>
        <li>Sensor</li>
        <li>Shutter</li>
        <li>AF</li>
        <li>ปุ่ม</li>
        <li>Dial</li>
        <li>จอ</li>
        <li>EVF</li>
        <li>Port</li>
        <li>Battery</li>
        <li>รอย</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <hr class="section-divider" />
        <h2>Auto Focus ควรทดสอบทั้ง Body และ Lens เท่าที่ทำได้</h2>
        <p>หากกล้องมีอาการ:</p>
        <ul>
        <li>Focus ช้า</li>
        <li>Focus หลุด</li>
        <li>Focus ไม่เข้า</li>
        <li>Hunting</li>
        <li>Motor Lens มีเสียง</li>
        <li>AF บางจุดมีปัญหา</li>
        </ul>
        <p>ควรแจ้งตามที่สังเกต</p>
        <p>ไม่ควรสรุปทันทีว่าเป็น Body หรือ Lens หากยังไม่ได้แยกทดสอบ</p>
        <hr class="section-divider" />
        <h2>Sensor มีฝุ่นไม่เหมือน Sensor เสีย</h2>
        <p>หากภาพมีจุด อาจเกิดจากหลายสาเหตุ เช่น:</p>
        <ul>
        <li>ฝุ่นที่ Sensor</li>
        <li>ฝุ่นหรือคราบบน Lens</li>
        <li>สิ่งสกปรกในระบบ Optical</li>
        <li>ปัญหาอื่น</li>
        </ul>
        <p>ไม่ควรขัด Sensor ด้วยแรงหรือใช้สารที่ไม่เหมาะสมเพียงเพื่อเตรียมขาย</p>
        <p>หากไม่แน่ใจสามารถแจ้งอาการและส่งภาพตัวอย่างแทน</p>
        <hr class="section-divider" />
        <h2>Lens ควรประเมินเป็นชิ้นแยกจาก Body</h2>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>รุ่นเต็ม</li>
        <li>Focal Length</li>
        <li>Aperture</li>
        <li>Mount</li>
        <li>AF</li>
        <li>Zoom</li>
        <li>Stabilization ถ้ามี</li>
        <li>หน้า Lens</li>
        <li>ท้าย Lens</li>
        <li>สภาพภายในเท่าที่มองเห็น</li>
        </ul>
        <p>หากพบ:</p>
        <ul>
        <li>ฝุ่น</li>
        <li>ฝ้า</li>
        <li>รา</li>
        <li>คราบ</li>
        <li>รอย</li>
        </ul>
        <p>ควรแจ้งตามที่เห็นโดยไม่แกะ Lens เองหากไม่มีความชำนาญ</p>
        <hr class="section-divider" />
        <h2>จอหลังและ EVF ควรตรวจแยกกัน</h2>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>จอหลังปกติ</li>
        <li>Touch ใช้งานได้</li>
        <li>จอเป็นเส้น</li>
        <li>จอกระพริบ</li>
        <li>EVF ใช้งานได้</li>
        <li>EVF ไม่ขึ้น</li>
        <li>มีจุดหรือคราบ</li>
        </ul>
        <p>กล้องบางรุ่นอาจยังถ่ายได้แม้จอส่วนใดส่วนหนึ่งมีอาการ จึงควรแยกข้อมูลให้ชัด</p>
        <hr class="section-divider" />
        <h2>Memory Card Slot และ Port ก็ควรตรวจ</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>Card Error</li>
        <li>อ่าน Memory Card ไม่ได้</li>
        <li>Slot หลวม</li>
        <li>USB มีปัญหา</li>
        <li>HDMI มีปัญหา</li>
        <li>Microphone Port มีอาการ</li>
        </ul>
        <p>ไม่จำเป็นต้องซ่อมก่อนเช็กราคาทุกกรณี</p>
        <hr class="section-divider" />
        <h2>Battery และ Charger ควรแจ้งจำนวนจริง</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>Battery เดิม 1 ก้อน + Charger</strong></p>
        <p>หรือ:</p>
        <p><strong>Battery เทียบ 2 ก้อน / ไม่มี Charger</strong></p>
        <p>Battery เสื่อมหรือบวมควรแจ้ง</p>
        <p>หาก Battery บวม ไม่ควรฝืนใส่กลับเข้า Body หรือชาร์จซ้ำ</p>
        <hr class="section-divider" />
        <h2>กล้องเคยซ่อมหรือโดนน้ำควรแจ้ง</h2>
        <p>เช่น:</p>
        <ul>
        <li>เปลี่ยน Shutter</li>
        <li>เปลี่ยนจอ</li>
        <li>ซ่อม Board</li>
        <li>ซ่อม Mount</li>
        <li>ซ่อม Card Slot</li>
        <li>ทำความสะอาด Sensor</li>
        <li>เคยตก</li>
        <li>เคยโดนน้ำ</li>
        <li>เคยมีความชื้น</li>
        </ul>
        <p>ประวัติซ่อมช่วยอธิบายสภาพได้ตรงขึ้น</p>
        <hr class="section-divider" />
        <h2>Serial ไม่จำเป็นต้องโพสต์เพื่อถามราคา</h2>
        <p>สามารถเริ่มจาก:</p>
        <p><strong>Brand + Model + Lens + Shutter + รูป</strong></p>
        <p>ก่อน</p>
        <p>หากต้องใช้ Serial เพื่อยืนยันรุ่นในขั้นตอนตรวจสอบเพิ่มเติม ควรส่งผ่านช่องทางที่เหมาะสม</p>
        <hr class="section-divider" />
        <h2>หน้าอุบลนี้ไม่ใช่หน้า Canon/Nikon โดยเฉพาะ</h2>
        <p>แม้ Historical URL มีคำเกี่ยวกับ Canon และ Nikon แต่ Intent ที่กำหนดสำหรับ V2 คือ:</p>
        <p><strong>Camera + Ubon Ratchathani</strong></p>
        <p>หน้า <a href="/รับซื้อกล้อง/">รับซื้อกล้อง</a> ยังคงเป็น Broad Camera Money Hub</p>
        <p>หน้านี้จึงไม่ควรกลายเป็น:</p>
        <ul>
        <li>Canon national page</li>
        <li>Nikon national page</li>
        <li>หน้าเปรียบเทียบแบรนด์</li>
        <li>ศูนย์บริการกล้อง</li>
        </ul>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคากล้องในอุบลราชธานี</h2>
        <h3>1. ส่ง Brand และ Model</h3>
        <p>ใช้รุ่น Body เต็ม</p>
        <h3>2. ระบุระบบและ Mount</h3>
        <p>ถ้าทราบ</p>
        <h3>3. แยก Body กับ Lens</h3>
        <p>แจ้งสิ่งที่รวมขาย</p>
        <h3>4. ส่ง Shutter Count</h3>
        <p>ถ้าตรวจได้</p>
        <h3>5. ตรวจ AF</h3>
        <p>แจ้งอาการตามที่พบ</p>
        <h3>6. ส่งรูป Sensor หรือภาพตัวอย่าง</h3>
        <p>เฉพาะเมื่อทำได้อย่างปลอดภัย</p>
        <h3>7. ตรวจจอและ EVF</h3>
        <p>แยกอาการให้ชัด</p>
        <h3>8. แจ้ง Battery และ Charger</h3>
        <p>จำนวนและสภาพ</p>
        <h3>9. แจ้งประวัติซ่อม</h3>
        <p>ตก น้ำ ความชื้น หรือซ่อมถ้าทราบ</p>
        <h3>10. ตรวจสินค้า</h3>
        <p>ยืนยัน Body Lens Serial ฟังก์ชันและสภาพก่อนซื้อขาย</p>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคากล้องในอุบลราชธานี</h2>
        <p>ส่ง:</p>
        <p><strong>Brand + Model + Lens + Shutter + รูป + อาการ + Battery + Charger</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <hr class="section-divider" />
      </article>
    </div>
  </main>

  <section class="section section-muted">
    <div class="container container-narrow">
      <FAQ
        items={faqs}
        title="คำถามที่พบบ่อยเกี่ยวกับการขายกล้องในอุบลราชธานี"
      />
    </div>
  </section>

</BaseLayout>

<style>
  .content-container {
    padding: 2.5rem 0 4rem 0;
  }

  .prose-content {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 640px) {
    .prose-content {
      padding: 1.75rem 1.25rem;
    }
  }

  .prose-content h1 {
    font-size: 2.15rem;
    color: var(--color-primary);
    line-height: 1.3;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .prose-content h2 {
    font-size: 1.55rem;
    color: var(--color-primary);
    line-height: 1.35;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    line-height: 1.4;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-main);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .prose-content ul,
  .prose-content ol {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .prose-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 0.4rem;
  }

  .prose-content strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .prose-content a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .prose-content a:hover {
    color: var(--color-accent-hover);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--color-border);
    margin: 2.5rem 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .table th,
  .table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .table th {
    background-color: var(--color-bg-subtle);
    color: var(--color-primary);
    font-weight: 600;
  }

  .table tr:nth-child(even) {
    background-color: #fafbfc;
  }
</style>
