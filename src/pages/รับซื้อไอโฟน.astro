---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อ iPhone มือสอง เช็กรุ่น แบตเตอรี่และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPhone มือสองหลายรุ่น ประเมินจากรุ่น ความจุ สุขภาพแบตเตอรี่ หน้าจอ Face ID กล้อง สภาพเครื่อง ประวัติซ่อมและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อ iPhone",
    "url": "/รับซื้อไอโฟน/"
  }
];

const faqs = [
  {
    "question": "รับซื้อ iPhone มือสองรุ่นอะไรบ้าง?",
    "answer": "สามารถส่ง iPhone หลายรุ่นมาประเมินได้ โดยควรแจ้งรุ่น ความจุ Battery Health สภาพเครื่อง การทำงาน และอุปกรณ์ที่มี เพื่อพิจารณาจากเครื่องจริง"
  },
  {
    "question": "iPhone แบตเสื่อมหรือหน้าจอมีตำหนิขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้ง Battery Health อาการแบตเตอรี่และตำหนิของหน้าจอให้ชัด เพื่อพิจารณาต้นทุนและสภาพการใช้งานจริง"
  },
  {
    "question": "Face ID เสียหรือเครื่องเคยซ่อมยังขายได้ไหม?",
    "answer": "สามารถส่งข้อมูลมาประเมินได้ ควรแจ้งฟังก์ชันที่มีปัญหาและประวัติซ่อมที่ทราบ เพราะมีผลต่อความเสี่ยงและมูลค่าของเครื่อง"
  },
  {
    "question": "ต้องออกจาก Apple ID ก่อนส่งรูปเช็กราคาไหม?",
    "answer": "ไม่จำเป็นต้องออกจากบัญชีเพื่อสอบถามราคา และไม่ควรส่ง Apple ID Password หรือรหัสยืนยันให้ผู้อื่น เมื่อพร้อมส่งมอบจริงเจ้าของจึงค่อยจัดการ Find My และบัญชีของตนเอง"
  },
  {
    "question": "ไม่มีกล่องหรือสายชาร์จขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินได้ ควรแจ้งอุปกรณ์ที่มีจริง โดยราคาจะพิจารณาร่วมกับรุ่น ความจุ สภาพและการทำงานของเครื่อง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อ iPhone มือสอง เช็กรุ่น ความจุ แบตเตอรี่และสภาพก่อนขาย</h1>
        <p>ต้องการขาย iPhone มือสอง แต่ยังไม่แน่ใจว่าเครื่องของคุณควรดูข้อมูลอะไรบ้างก่อนเช็กราคา?</p>
        <p>iPhone รุ่นเดียวกันอาจมีมูลค่าต่างกันจาก <strong>ความจุ สุขภาพแบตเตอรี่ หน้าจอ Face ID หรือ Touch ID กล้อง สภาพตัวเครื่อง ประวัติการซ่อม และอุปกรณ์ที่มี</strong></p>
        <p>ดังนั้นการแจ้งเพียงว่า “iPhone รุ่น...” ยังไม่เพียงพอสำหรับการประเมินเบื้องต้น</p>
        <p>เริ่มจากส่ง:</p>
        <p><strong>รุ่น + ความจุ + Battery Health + รูป + สภาพ + อาการ + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>iPhone แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียด iPhone มือสองหลายสภาพมาสอบถามได้ เช่น</p>
        <ul>
        <li>เครื่องใช้งานปกติ</li>
        <li>เครื่องมีรอย</li>
        <li>แบตเตอรี่เสื่อม</li>
        <li>หน้าจอมีตำหนิ</li>
        <li>Face ID หรือ Touch ID มีปัญหา</li>
        <li>กล้องมีอาการ</li>
        <li>ลำโพงหรือไมโครโฟนผิดปกติ</li>
        <li>พอร์ตชาร์จมีปัญหา</li>
        <li>ไม่มี Box</li>
        <li>ไม่มีสายหรือ Adapter</li>
        <li>เครื่องเคยซ่อม</li>
        <li>เครื่องเคยเปลี่ยนอะไหล่</li>
        <li>เครื่องเปิดไม่ติดบางกรณี</li>
        </ul>
        <p>การประเมินต้องดูรุ่นและสภาพของเครื่องจริง</p>
        <p>ไม่ควรใช้เพียงอายุเครื่องหรือราคาที่เคยซื้อมาเป็นตัวกำหนดราคามือสอง</p>
        <hr class="section-divider" />
        <h2>ก่อนขายต้องรู้รุ่นและความจุให้ชัด</h2>
        <p>ข้อมูลพื้นฐานที่ควรแจ้ง ได้แก่</p>
        <ul>
        <li>รุ่น iPhone</li>
        <li>ความจุ Storage</li>
        <li>สี</li>
        <li>Battery Health หากตรวจได้</li>
        <li>สภาพหน้าจอ</li>
        <li>สภาพตัวเครื่อง</li>
        <li>Face ID หรือ Touch ID</li>
        <li>กล้อง</li>
        <li>ประวัติซ่อม</li>
        <li>อุปกรณ์ที่มี</li>
        </ul>
        <p>ความจุ เช่น</p>
        <ul>
        <li>64GB</li>
        <li>128GB</li>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        <li>หรือความจุอื่นตามรุ่น</li>
        </ul>
        <p>iPhone รุ่นเดียวกันแต่ความจุต่างกันอาจมีมูลค่าไม่เท่ากัน</p>
        <hr class="section-divider" />
        <h2>วิธีดูข้อมูลรุ่นและความจุ</h2>
        <p>หากเครื่องยังใช้งานได้ สามารถเริ่มจาก:</p>
        <p><strong>Settings → General → About</strong></p>
        <p>ข้อมูลที่พบอาจช่วยตรวจ:</p>
        <ul>
        <li>Model Name</li>
        <li>Capacity</li>
        <li>iOS Version</li>
        <li>ข้อมูลเครื่องอื่นที่เกี่ยวข้อง</li>
        </ul>
        <p>ไม่จำเป็นต้องส่งข้อมูลบัญชีส่วนตัวเพื่อเช็กราคา</p>
        <p>หากมีข้อมูลที่อาจระบุตัวเครื่องหรือเจ้าของโดยไม่จำเป็น สามารถปิดบังก่อนส่งรูปได้</p>
        <hr class="section-divider" />
        <h2>Battery Health มีผลต่อราคาไหม</h2>
        <p>มีผลต่อความพร้อมใช้งานของเครื่อง</p>
        <p>ควรแจ้ง Maximum Capacity หากตรวจสอบได้จากระบบ</p>
        <p>ตัวอย่างอาการที่ควรแจ้งเพิ่มเติม:</p>
        <ul>
        <li>แบตหมดเร็ว</li>
        <li>เครื่องดับเอง</li>
        <li>ชาร์จไม่เข้า</li>
        <li>ชาร์จช้า</li>
        <li>Battery มีข้อความแจ้งเตือน</li>
        <li>Battery เคยเปลี่ยน</li>
        <li>เครื่องร้อนผิดปกติขณะใช้งานหรือชาร์จ</li>
        </ul>
        <p>เปอร์เซ็นต์ Battery Health เป็นเพียงหนึ่งในปัจจัย ไม่ควรใช้เพียงตัวเลขนี้กำหนดมูลค่าทั้งเครื่อง</p>
        <p>ต้องดูรุ่น ความจุ สภาพ และการทำงานอื่นร่วมด้วย</p>
        <hr class="section-divider" />
        <h2>หน้าจอควรตรวจอะไรบ้าง</h2>
        <p>หน้าจอมีผลต่อมูลค่าของ iPhone อย่างมาก</p>
        <p>ควรตรวจ:</p>
        <ul>
        <li>ภาพขึ้นปกติ</li>
        <li>Touch ใช้งานได้</li>
        <li>ไม่มีเส้น</li>
        <li>ไม่มีจุดดำขนาดใหญ่</li>
        <li>ไม่มีอาการกะพริบ</li>
        <li>ไม่มีสีผิดปกติชัดเจน</li>
        <li>กระจกไม่แตก</li>
        <li>ไม่มีรอยกดหนัก</li>
        <li>ความสว่างใช้งานได้</li>
        </ul>
        <p>หากมีตำหนิ ควรถ่ายรูปหน้าจอตอนเปิดและตอนปิดให้เห็นชัด</p>
        <p>รอยขนแมวเล็กน้อยกับหน้าจอแตกหรือ Panel เสียไม่ควรประเมินเหมือนกัน</p>
        <hr class="section-divider" />
        <h2>Face ID หรือ Touch ID ต้องทดสอบ</h2>
        <p>ถ้ารุ่นรองรับ Face ID ควรตรวจว่าสามารถใช้งานได้ตามปกติ</p>
        <p>หากเป็นรุ่นที่ใช้ Touch ID ควรตรวจการทำงานของปุ่มและระบบสแกนนิ้ว</p>
        <p>หากระบบใดใช้งานไม่ได้ควรแจ้งตามจริง</p>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>รหัสผ่านเครื่อง</li>
        <li>Apple ID Password</li>
        <li>รหัสยืนยันตัวตน</li>
        <li>Recovery Key</li>
        </ul>
        <p>เพื่อใช้ในการเช็กราคา</p>
        <p>เจ้าของเครื่องสามารถทดสอบฟังก์ชันเหล่านี้ด้วยตนเองได้</p>
        <hr class="section-divider" />
        <h2>กล้องหน้าและกล้องหลังควรตรวจ</h2>
        <p>ทดลองเปิด Camera และสลับเลนส์หรือโหมดที่มีในรุ่นนั้น</p>
        <p>สังเกต:</p>
        <ul>
        <li>ภาพขึ้น</li>
        <li>Focus ทำงาน</li>
        <li>ไม่สั่นผิดปกติ</li>
        <li>ไม่มีจุดหรือคราบที่เห็นชัด</li>
        <li>กล้องหน้าใช้งานได้</li>
        <li>Video บันทึกได้</li>
        </ul>
        <p>หากกระจกเลนส์แตก กล้องสั่น Focus ไม่เข้า หรือมีอาการอื่น ควรแจ้ง</p>
        <hr class="section-divider" />
        <h2>ลำโพงและไมโครโฟนมีผลหรือไม่</h2>
        <p>ควรตรวจเพราะเป็นฟังก์ชันพื้นฐานของโทรศัพท์</p>
        <p>สามารถทดลอง:</p>
        <ul>
        <li>เปิดเพลงหรือวิดีโอ</li>
        <li>โทรทดสอบ</li>
        <li>บันทึกเสียง</li>
        <li>เปิด Speakerphone</li>
        </ul>
        <p>หากเสียงเบาผิดปกติ เสียงแตก หรือ Microphone บางตัวมีปัญหาควรแจ้งตามจริง</p>
        <hr class="section-divider" />
        <h2>พอร์ตชาร์จและการชาร์จ</h2>
        <p>ควรตรวจว่า:</p>
        <ul>
        <li>เสียบสายแล้วชาร์จเข้า</li>
        <li>พอร์ตไม่หลวมผิดปกติ</li>
        <li>ไม่มีอาการตัดต่อการชาร์จ</li>
        <li>Wireless Charging ใช้งานได้ถ้ารุ่นรองรับและสามารถทดสอบได้</li>
        </ul>
        <p>หากต้องขยับสายจึงจะชาร์จ หรือพอร์ตมีอาการควรแจ้ง</p>
        <hr class="section-divider" />
        <h2>สภาพตัวเครื่องควรถ่ายอะไรบ้าง</h2>
        <p>ควรถ่ายให้เห็น:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านหลัง</li>
        <li>ขอบซ้าย</li>
        <li>ขอบขวา</li>
        <li>ด้านบน</li>
        <li>ด้านล่าง</li>
        <li>มุมทั้งสี่</li>
        <li>กล้อง</li>
        <li>จุดตำหนิ</li>
        </ul>
        <p>ควรแจ้งเป็นพิเศษหากพบ:</p>
        <ul>
        <li>รอยตก</li>
        <li>กรอบบุบ</li>
        <li>ฝาหลังแตก</li>
        <li>กระจกกล้องแตก</li>
        <li>เครื่องงอ</li>
        <li>ปุ่มเสีย</li>
        <li>มีร่องรอยแกะเครื่อง</li>
        </ul>
        <p>การส่งรูปตรงกับสภาพจริงช่วยลดความคลาดเคลื่อนของการประเมินเบื้องต้น</p>
        <hr class="section-divider" />
        <h2>iPhone เคยซ่อมยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินได้</p>
        <p>หากทราบ ควรแจ้งว่าเคย:</p>
        <ul>
        <li>เปลี่ยนหน้าจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อมพอร์ตชาร์จ</li>
        <li>ซ่อม Mainboard</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกรอบ</li>
        <li>ซ่อม Face ID</li>
        <li>โดนน้ำ</li>
        </ul>
        <p>ประวัติการซ่อมไม่ได้หมายความว่าเครื่องจะประเมินไม่ได้</p>
        <p>แต่ช่วยให้ตรวจความเสี่ยงและสภาพจริงได้ตรงขึ้น</p>
        <hr class="section-divider" />
        <h2>Parts and Service History ควรดูไหม</h2>
        <p>iPhone บางรุ่นและบางเวอร์ชันระบบสามารถแสดงข้อมูลเกี่ยวกับชิ้นส่วนหรือประวัติบริการได้</p>
        <p>หากเครื่องแสดงข้อมูลดังกล่าว สามารถแจ้งประกอบการประเมินได้</p>
        <p>ข้อมูลนี้ควรใช้ร่วมกับการตรวจสภาพจริง ไม่ใช่ใช้เพียงอย่างเดียวตัดสินว่าเครื่องดีหรือเสีย</p>
        <p>หากไม่แน่ใจไม่จำเป็นต้องคาดเดา</p>
        <hr class="section-divider" />
        <h2>True Tone หรือฟังก์ชันหน้าจอมีปัญหาต้องแจ้งไหม</h2>
        <p>ควรแจ้งถ้าพบว่าฟังก์ชันของหน้าจอหรือระบบแสดงผลผิดปกติ</p>
        <p>แต่การประเมินไม่ควรใช้เพียง True Tone เป็นตัวชี้วัดว่าหน้าจอเดิมหรือเคยซ่อมหรือไม่</p>
        <p>ควรดูร่วมกับ:</p>
        <ul>
        <li>ประวัติที่เจ้าของทราบ</li>
        <li>การทำงานของหน้าจอ</li>
        <li>ข้อมูลระบบที่ตรวจสอบได้</li>
        <li>สภาพจริงของเครื่อง</li>
        </ul>
        <hr class="section-divider" />
        <h2>เครื่องเคยโดนน้ำต้องแจ้งไหม</h2>
        <p>ควรแจ้ง</p>
        <p>ความเสียหายจากของเหลวอาจมีผลต่ออุปกรณ์หลายส่วน แม้ปัจจุบันเครื่องยังเปิดได้</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>เกิดขึ้นเมื่อไรโดยประมาณ</li>
        <li>เคยดับหรือไม่</li>
        <li>เคยซ่อมหรือไม่</li>
        <li>ปัจจุบันมีอาการอะไร</li>
        </ul>
        <p>ข้อมูลนี้ช่วยให้ประเมินความเสี่ยงได้ตรงขึ้น</p>
        <hr class="section-divider" />
        <h2>iPhone เปิดไม่ติดยังประเมินได้ไหม</h2>
        <p>บางกรณีสามารถส่งมาประเมินตามสภาพได้</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>อาการก่อนเสีย</li>
        <li>ชาร์จเข้าหรือไม่</li>
        <li>มีภาพหรือเสียงตอบสนองหรือไม่</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>เคยซ่อมหรือไม่</li>
        <li>มีอุปกรณ์อะไรอยู่บ้าง</li>
        </ul>
        <p>เครื่องที่ไม่สามารถทดสอบได้มีความไม่แน่นอนสูงกว่าเครื่องปกติ จึงต้องพิจารณาความเสี่ยงเพิ่ม</p>
        <hr class="section-divider" />
        <h2>Activation Lock และ Find My ต้องจัดการเมื่อไร</h2>
        <p>ไม่จำเป็นต้องปิด Find My เพียงเพื่อส่งข้อมูลเช็กราคา</p>
        <p>เมื่อพร้อมส่งมอบเครื่องจริง เจ้าของควรเป็นผู้จัดการบัญชีของตนเอง</p>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>รหัสผ่านเครื่อง</li>
        <li>รหัส OTP</li>
        <li>Recovery Key</li>
        <li>รหัสยืนยันตัวตน</li>
        </ul>
        <p>ให้ผู้อื่นผ่านข้อความ</p>
        <p>ก่อนซื้อขายจริงควรสามารถส่งมอบเครื่องโดยไม่มีข้อจำกัดจากบัญชีเจ้าของเดิม</p>
        <hr class="section-divider" />
        <h2>ต้อง Reset ก่อนส่งรูปเช็กราคาไหม</h2>
        <p>ไม่จำเป็น</p>
        <p>หากยังอยู่ในขั้นตอนประเมินเบื้องต้น สามารถส่งรุ่น ความจุ Battery Health รูปและสภาพก่อนได้</p>
        <p>ก่อน Reset ควร:</p>
        <ol>
        <li>Backup ข้อมูลสำคัญ</li>
        <li>ตรวจรูปและวิดีโอ</li>
        <li>ตรวจไฟล์</li>
        <li>ตรวจข้อมูลในแอป</li>
        <li>ตรวจว่าข้อมูลที่ต้องการเก็บถูกสำรองแล้ว</li>
        <li>จัดการบัญชีเมื่อพร้อมส่งมอบ</li>
        <li>Reset เมื่อมั่นใจว่าไม่ต้องใช้ข้อมูลในเครื่องแล้ว</li>
        </ol>
        <hr class="section-divider" />
        <h2>SIM และ eSIM ต้องทำอย่างไร</h2>
        <p>ก่อนส่งมอบควรตรวจว่าข้อมูลการเชื่อมต่อของผู้ใช้อยู่ในสถานะที่เหมาะสม</p>
        <p>SIM แบบถอดได้ควรถอดออกก่อนส่งเครื่อง</p>
        <p>สำหรับ eSIM ควรตรวจการตั้งค่าของผู้ให้บริการและดำเนินการตามความเหมาะสมก่อนส่งมอบ</p>
        <p>ไม่ควรส่งข้อมูลบัญชีผู้ให้บริการ รหัสผ่าน หรือรหัสยืนยันที่ไม่จำเป็นให้ผู้รับซื้อ</p>
        <hr class="section-divider" />
        <h2>ไม่มีกล่องหรือสายยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินได้</p>
        <p>ควรแจ้งของที่มีจริง เช่น</p>
        <ul>
        <li>ตัวเครื่อง</li>
        <li>Box</li>
        <li>สาย</li>
        <li>Adapter</li>
        <li>เคส</li>
        <li>ใบเสร็จ</li>
        <li>เอกสาร</li>
        <li>อุปกรณ์เสริม</li>
        </ul>
        <p>อุปกรณ์มีผลต่อความครบของชุด แต่รุ่น ความจุ สภาพและการทำงานของเครื่องยังเป็นปัจจัยหลัก</p>
        <hr class="section-divider" />
        <h2>ประกันเหลือควรแจ้งไหม</h2>
        <p>ควรแจ้งหากสามารถตรวจสอบได้</p>
        <p>ข้อมูลที่ใช้ประกอบ เช่น</p>
        <ul>
        <li>วันที่ซื้อ</li>
        <li>ใบเสร็จ</li>
        <li>หลักฐานการซื้อ</li>
        <li>สถานะประกันที่ตรวจสอบได้</li>
        </ul>
        <p>ไม่ควรคาดเดาว่าประกันยังเหลือหากไม่มีข้อมูลรองรับ</p>
        <hr class="section-divider" />
        <h2>iPhone หลายเครื่องหรือเครื่องบริษัท</h2>
        <p>หากมีหลายเครื่อง สามารถจัดข้อมูลเป็นตาราง</p>
        <div class="table-responsive">
        <table class="data-table">
        <thead><tr><th>รุ่น</th><th>ความจุ</th><th>Battery</th><th>จำนวน</th><th>สภาพ</th></tr></thead>
        <tbody>
        <tr><td>iPhone รุ่น...</td><td>128GB</td><td>...</td><td>5</td><td>ใช้งานได้</td></tr>
        <tr><td>iPhone รุ่น...</td><td>256GB</td><td>...</td><td>3</td><td>มีตำหนิ</td></tr>
        </tbody></table></div>
        <p>ควรแยกเครื่องที่มี:</p>
        <ul>
        <li>จอแตก</li>
        <li>Face ID เสีย</li>
        <li>เปิดไม่ติด</li>
        <li>Battery ผิดปกติ</li>
        <li>เคยโดนน้ำ</li>
        <li>มีประวัติซ่อม</li>
        </ul>
        <p>ไม่ควรรวมเครื่องทุกสภาพเป็นกลุ่มเดียวหากความเสียหายต่างกันมาก</p>
        <hr class="section-divider" />
        <h2>ปัจจัยหลักที่ใช้ประเมินราคา iPhone</h2>
        <h3>รุ่น</h3>
        <p>เป็นจุดเริ่มต้นของการประเมิน</p>
        <h3>ความจุ</h3>
        <p>Storage ต่างกันอาจมีมูลค่าต่างกัน</p>
        <h3>Battery</h3>
        <p>ดู Battery Health และอาการใช้งานจริง</p>
        <h3>หน้าจอ</h3>
        <p>ดู Touch, Panel, กระจกและการแสดงผล</p>
        <h3>Face ID หรือ Touch ID</h3>
        <p>ตรวจตามฟังก์ชันของรุ่น</p>
        <h3>กล้อง</h3>
        <p>ตรวจกล้องหน้า กล้องหลัง Focus และ Video</p>
        <h3>ลำโพงและไมโครโฟน</h3>
        <p>มีผลต่อความพร้อมใช้งาน</p>
        <h3>การชาร์จ</h3>
        <p>ดูพอร์ตและระบบชาร์จ</p>
        <h3>สภาพตัวเครื่อง</h3>
        <p>รอยตก แตก บุบ และสภาพโครงสร้างมีผล</p>
        <h3>ประวัติซ่อม</h3>
        <p>ใช้ประกอบการประเมินความเสี่ยง</p>
        <h3>บัญชีและ Activation Lock</h3>
        <p>ก่อนซื้อขายจริงต้องสามารถส่งมอบโดยไม่มีข้อจำกัดจากบัญชีเจ้าของเดิม</p>
        <h3>อุปกรณ์</h3>
        <p>กล่อง สาย และเอกสารช่วยเพิ่มความครบของชุด</p>
        <h3>ประกัน</h3>
        <p>สถานะที่ตรวจสอบได้ใช้ประกอบการประเมิน</p>
        <h3>ตลาดของรุ่น</h3>
        <p>ความต้องการของแต่ละรุ่นเปลี่ยนแปลงได้ตามเวลา</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคา iPhone ก่อนขาย</h2>
        <h3>1. ส่งรุ่นและความจุ</h3>
        <p>แจ้งรุ่นพร้อม Storage</p>
        <h3>2. ส่ง Battery Health</h3>
        <p>หากตรวจได้</p>
        <h3>3. ส่งรูป</h3>
        <p>ถ่ายทุกด้านและจุดตำหนิ</p>
        <h3>4. แจ้งการทำงาน</h3>
        <p>เช่น:</p>
        <ul>
        <li>Face ID ปกติ</li>
        <li>กล้องปกติ</li>
        <li>ชาร์จเข้า</li>
        <li>หน้าจอปกติ</li>
        <li>มีอาการอะไร</li>
        </ul>
        <h3>5. แจ้งประวัติ</h3>
        <p>เคยซ่อม ตก หรือโดนน้ำหรือไม่</p>
        <h3>6. แจ้งอุปกรณ์</h3>
        <p>Box สาย ใบเสร็จ หรืออุปกรณ์อื่น</p>
        <h3>7. ประเมินเบื้องต้น</h3>
        <p>พิจารณารุ่น ความจุ Battery สภาพและการทำงานร่วมกัน</p>
        <h3>8. ตัดสินใจ</h3>
        <p>ผู้ขายสามารถพิจารณาก่อนว่าจะขายหรือเก็บเครื่องไว้</p>
        <h3>9. Backup และจัดการบัญชี</h3>
        <p>ดำเนินการเมื่อพร้อมขายจริง</p>
        <h3>10. ตรวจเครื่องและซื้อขาย</h3>
        <p>ตรวจสภาพและข้อมูลให้ตรงกับที่ใช้ประเมินก่อนดำเนินการซื้อขาย</p>
        <hr class="section-divider" />
        <h2>อยู่ต่างจังหวัดเริ่มเช็กราคา iPhone ได้อย่างไร</h2>
        <p>ไม่จำเป็นต้องเดินทางพร้อมเครื่องเพียงเพื่อขอราคาประเมินเบื้องต้น</p>
        <p>สามารถเริ่มจากส่ง:</p>
        <p><strong>รุ่น + ความจุ + Battery Health + รูป + สภาพ + อาการ + อุปกรณ์</strong></p>
        <p>จากนั้นจึงพิจารณาวิธีส่งมอบหรือนัดหมายตามพื้นที่และความเหมาะสม</p>
        <p>หน้า <code>/รับซื้อไอโฟน/</code> เป็นข้อมูลบริการภาพรวม ไม่ได้ใช้เพื่ออ้างว่ามีสาขาในทุกจังหวัด</p>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคา iPhone ของคุณ</h2>
        <p>ส่งข้อมูล:</p>
        <p><strong>รุ่น + ความจุ + Battery Health + รูปทุกด้าน + สภาพ + อาการ + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p>ดูขั้นตอนภาพรวมได้ที่ <strong>เช็กราคาก่อนขาย</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <hr class="section-divider" />
        <h2>หน้าข้อมูลรับซื้อมือถือและไอโฟนตามพื้นที่</h2>
        <p>สำหรับพื้นที่หรือภูมิภาคที่มีหน้าข้อมูลเฉพาะ สามารถดูรายละเอียดการเช็กราคาและการเตรียมข้อมูลก่อนขายได้ตามพื้นที่:</p>
        <ul>
          <li><a href="/รับซื้อโทรศัพท์มือถือ-จ/">รับซื้อโทรศัพท์มือถือภาคอีสาน</a></li>
