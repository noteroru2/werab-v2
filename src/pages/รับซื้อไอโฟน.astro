---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อ iPhone มือสอง เช็กรุ่น แบตเตอรี่และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPhone มือสองหลายรุ่น ประเมินจากรุ่น ความจุ สุขภาพแบตเตอรี่ หน้าจอ Face ID กล้อง สภาพเครื่อง ประวัติซ่อมและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อ iPhone', url: '/รับซื้อไอโฟน/' }
];

const faqs = [
  {
    question: "รับซื้อ iPhone มือสองรุ่นอะไรบ้าง?",
    answer: "สามารถส่ง iPhone หลายรุ่นมาประเมินได้ โดยควรแจ้งรุ่น ความจุ Battery Health สภาพเครื่อง การทำงาน และอุปกรณ์ที่มี เพื่อพิจารณาจากเครื่องจริง"
  },
  {
    question: "iPhone แบตเสื่อมหรือหน้าจอมีตำหนิขายได้ไหม?",
    answer: "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้ง Battery Health อาการแบตเตอรี่และตำหนิของหน้าจอให้ชัด เพื่อพิจารณาต้นทุนและสภาพการใช้งานจริง"
  },
  {
    question: "Face ID เสียหรือเครื่องเคยซ่อมยังขายได้ไหม?",
    answer: "สามารถส่งข้อมูลมาประเมินได้ ควรแจ้งฟังก์ชันที่มีปัญหาและประวัติซ่อมที่ทราบ เพราะมีผลต่อความเสี่ยงและมูลค่าของเครื่อง"
  },
  {
    question: "ต้องออกจาก Apple ID ก่อนส่งรูปเช็กราคาไหม?",
    answer: "ไม่จำเป็นต้องออกจากบัญชีเพื่อสอบถามราคา และไม่ควรส่ง Apple ID Password หรือรหัสยืนยันให้ผู้อื่น เมื่อพร้อมส่งมอบจริงเจ้าของจึงค่อยจัดการ Find My และบัญชีของตนเอง"
  },
  {
    question: "ไม่มีกล่องหรือสายชาร์จขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งอุปกรณ์ที่มีจริง โดยราคาจะพิจารณาร่วมกับรุ่น ความจุ สภาพและการทำงานของเครื่อง"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ iPhone มือสอง เช็กรุ่น ความจุ แบตเตอรี่และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขาย iPhone มือสอง แต่ยังไม่แน่ใจว่าเครื่องของคุณควรดูข้อมูลอะไรบ้างก่อนเช็กราคา?</p>
          <p>
            iPhone รุ่นเดียวกันอาจมีมูลค่าต่างกันจาก <strong>ความจุ สุขภาพแบตเตอรี่ หน้าจอ Face ID หรือ Touch ID กล้อง สภาพตัวเครื่อง ประวัติการซ่อม และอุปกรณ์ที่มี</strong>
          </p>
          <p>
            ดังนั้นการแจ้งเพียงว่า “iPhone รุ่น...” ยังไม่เพียงพอสำหรับการประเมินเบื้องต้น
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>รุ่น + ความจุ + Battery Health + รูป + สภาพ + อาการ + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.webp" type="image/webp" />
              <source srcset="/images/hero-smartphone.avif" type="image/avif" />
              <source srcset="/images/hero-smartphone.webp" type="image/webp" />
              <img
                src="/images/hero-smartphone.webp"
                alt="รับซื้อ iPhone มือสอง iPhone Pro Pro Max Plus เช็กรุ่น ความจุ แบตเตอรี่และสภาพก่อนขาย"
                width="668"
                height="717"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: IPHONE TYPES -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>iPhone แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียด iPhone มือสองหลายสภาพมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>เครื่องใช้งานปกติ</li>
              <li>เครื่องมีรอย</li>
              <li>แบตเตอรี่เสื่อม</li>
              <li>หน้าจอมีตำหนิ</li>
              <li>Face ID หรือ Touch ID มีปัญหา</li>
              <li>กล้องมีอาการ</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>ลำโพงหรือไมโครโฟนผิดปกติ</li>
              <li>พอร์ตชาร์จมีปัญหา</li>
              <li>ไม่มี Box</li>
              <li>ไม่มีสายหรือ Adapter</li>
              <li>เครื่องเคยซ่อม</li>
              <li>เครื่องเคยเปลี่ยนอะไหล่</li>
              <li>เครื่องเปิดไม่ติดบางกรณี</li>
            </ul>
          </div>
        </div>
        <p>การประเมินต้องดูรุ่นและสภาพของเครื่องจริง</p>
        <p>ไม่ควรใช้เพียงอายุเครื่องหรือราคาที่เคยซื้อมาเป็นตัวกำหนดราคามือสอง</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MODEL & STORAGE -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายต้องรู้รุ่นและความจุให้ชัด</h2>
          <p>ข้อมูลพื้นฐานที่ควรแจ้ง ได้แก่</p>
          <ul>
            <li>รุ่น iPhone</li>
            <li>ความจุ Storage</li>
            <li>สี</li>
            <li>Battery Health หากตรวจได้</li>
            <li>สภาพหน้าจอ</li>
            <li>สภาพตัวเครื่อง</li>
            <li>Face ID หรือ Touch ID</li>
            <li>กล้อง</li>
            <li>ประวัติซ่อม</li>
            <li>อุปกรณ์ที่มี</li>
          </ul>
          <p>ความจุ เช่น</p>
          <ul>
            <li>64GB</li>
            <li>128GB</li>
            <li>256GB</li>
            <li>512GB</li>
            <li>1TB</li>
            <li>หรือความจุอื่นตามรุ่น</li>
          </ul>
          <p>iPhone รุ่นเดียวกันแต่ความจุต่างกันอาจมีมูลค่าไม่เท่ากัน</p>
        </div>

        <div class="comm-card">
          <h2>วิธีดูข้อมูลรุ่นและความจุ</h2>
          <p>หากเครื่องยังใช้งานได้ สามารถเริ่มจาก:</p>
          <p><strong>Settings → General → About</strong></p>
          <p>ข้อมูลที่พบอาจช่วยตรวจ:</p>
          <ul>
            <li>Model Name</li>
            <li>Capacity</li>
            <li>iOS Version</li>
            <li>ข้อมูลเครื่องอื่นที่เกี่ยวข้อง</li>
          </ul>
          <p>ไม่จำเป็นต้องส่งข้อมูลบัญชีส่วนตัวเพื่อเช็กราคา</p>
          <p>หากมีข้อมูลที่อาจระบุตัวเครื่องหรือเจ้าของโดยไม่จำเป็น สามารถปิดบังก่อนส่งรูปได้</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: BATTERY & SCREEN -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery Health มีผลต่อราคาไหม</h2>
          <p>มีผลต่อความพร้อมใช้งานของเครื่อง</p>
          <p>ควรแจ้ง Maximum Capacity หากตรวจสอบได้จากระบบ</p>
          <p>ตัวอย่างอาการที่ควรแจ้งเพิ่มเติม:</p>
          <ul>
            <li>แบตหมดเร็ว</li>
            <li>เครื่องดับเอง</li>
            <li>ชาร์จไม่เข้า</li>
            <li>ชาร์จช้า</li>
            <li>Battery มีข้อความแจ้งเตือน</li>
            <li>Battery เคยเปลี่ยน</li>
            <li>เครื่องร้อนผิดปกติขณะใช้งานหรือชาร์จ</li>
          </ul>
          <p>เปอร์เซ็นต์ Battery Health เป็นเพียงหนึ่งในปัจจัย ไม่ควรใช้เพียงตัวเลขนี้กำหนดมูลค่าทั้งเครื่อง</p>
          <p>ต้องดูรุ่น ความจุ สภาพ และการทำงานอื่นร่วมด้วย</p>
        </div>

        <div class="comm-card">
          <h2>หน้าจอควรตรวจอะไรบ้าง</h2>
          <p>หน้าจอมีผลต่อมูลค่าของ iPhone อย่างมาก</p>
          <p>ควรตรวจ:</p>
          <ul>
            <li>ภาพขึ้นปกติ</li>
            <li>Touch ใช้งานได้</li>
            <li>ไม่มีเส้น</li>
            <li>ไม่มีจุดดำขนาดใหญ่</li>
            <li>ไม่มีอาการกะพริบ</li>
            <li>ไม่มีสีผิดปกติชัดเจน</li>
            <li>กระจกไม่แตก</li>
            <li>ไม่มีรอยกดหนัก</li>
            <li>ความสว่างใช้งานได้</li>
          </ul>
          <p>หากมีตำหนิ ควรถ่ายรูปหน้าจอตอนเปิดและตอนปิดให้เห็นชัด</p>
          <p>รอยขนแมวเล็กน้อยกับหน้าจอแตกหรือ Panel เสียไม่ควรประเมินเหมือนกัน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: BIOMETRICS, CAMERAS, AUDIO & PORTS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Face ID หรือ Touch ID ต้องทดสอบ</h2>
          <p>ถ้ารุ่นรองรับ Face ID ควรตรวจว่าสามารถใช้งานได้ตามปกติ</p>
          <p>หากเป็นรุ่นที่ใช้ Touch ID ควรตรวจการทำงานของปุ่มและระบบสแกนนิ้ว</p>
          <p>หากระบบใดใช้งานไม่ได้ควรแจ้งตามจริง</p>
          <p>ไม่ควรส่ง:</p>
          <ul>
            <li>รหัสผ่านเครื่อง</li>
            <li>Apple ID Password</li>
            <li>รหัสยืนยันตัวตน</li>
            <li>Recovery Key</li>
          </ul>
          <p>เพื่อใช้ในการเช็กราคา</p>
          <p>เจ้าของเครื่องสามารถทดสอบฟังก์ชันเหล่านี้ด้วยตนเองได้</p>

          <h2 style="margin-top: 1.5rem;">กล้องหน้าและกล้องหลังควรตรวจ</h2>
          <p>ทดลองเปิด Camera และสลับเลนส์หรือโหมดที่มีในรุ่นนั้น</p>
          <p>สังเกต:</p>
          <ul>
            <li>ภาพขึ้น</li>
            <li>Focus ทำงาน</li>
            <li>ไม่สั่นผิดปกติ</li>
            <li>ไม่มีจุดหรือคราบที่เห็นชัด</li>
            <li>กล้องหน้าใช้งานได้</li>
            <li>Video บันทึกได้</li>
          </ul>
          <p>หากกระจกเลนส์แตก กล้องสั่น Focus ไม่เข้า หรือมีอาการอื่น ควรแจ้ง</p>
        </div>

        <div class="comm-card">
          <h2>ลำโพงและไมโครโฟนมีผลหรือไม่</h2>
          <p>ควรตรวจเพราะเป็นฟังก์ชันพื้นฐานของโทรศัพท์</p>
          <p>สามารถทดลอง:</p>
          <ul>
            <li>เปิดเพลงหรือวิดีโอ</li>
            <li>โทรทดสอบ</li>
            <li>บันทึกเสียง</li>
            <li>เปิด Speakerphone</li>
          </ul>
          <p>หากเสียงเบาผิดปกติ เสียงแตก หรือ Microphone บางตัวมีปัญหาควรแจ้งตามจริง</p>

          <h2 style="margin-top: 1.5rem;">พอร์ตชาร์จและการชาร์จ</h2>
          <p>ควรตรวจว่า:</p>
          <ul>
            <li>เสียบสายแล้วชาร์จเข้า</li>
            <li>พอร์ตไม่หลวมผิดปกติ</li>
            <li>ไม่มีอาการตัดต่อการชาร์จ</li>
            <li>Wireless Charging ใช้งานได้ถ้ารุ่นรองรับและสามารถทดสอบได้</li>
          </ul>
          <p>หากต้องขยับสายจึงจะชาร์จ หรือพอร์ตมีอาการควรแจ้ง</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: BODY CONDITION, REPAIRS, TRUE TONE, WATER DAMAGE & DEAD IPHONES -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>สภาพตัวเครื่องควรถ่ายอะไรบ้าง</h2>
          <p>ควรถ่ายให้เห็น:</p>
          <ul>
            <li>ด้านหน้า</li>
            <li>ด้านหลัง</li>
            <li>ขอบซ้าย</li>
            <li>ขอบขวา</li>
            <li>ด้านบน</li>
            <li>ด้านล่าง</li>
            <li>มุมทั้งสี่</li>
            <li>กล้อง</li>
            <li>จุดตำหนิ</li>
          </ul>
          <p>ควรแจ้งเป็นพิเศษหากพบ:</p>
          <ul>
            <li>รอยตก</li>
            <li>กรอบบุบ</li>
            <li>ฝาหลังแตก</li>
            <li>กระจกกล้องแตก</li>
            <li>เครื่องงอ</li>
            <li>ปุ่มเสีย</li>
            <li>มีร่องรอยแกะเครื่อง</li>
          </ul>
          <p>การส่งรูปตรงกับสภาพจริงช่วยลดความคลาดเคลื่อนของการประเมินเบื้องต้น</p>

          <h2 style="margin-top: 1.5rem;">iPhone เคยซ่อมยังขายได้ไหม</h2>
          <p>สามารถส่งมาประเมินได้</p>
          <p>หากทราบ ควรแจ้งว่าเคย:</p>
          <ul>
            <li>เปลี่ยนหน้าจอ</li>
            <li>เปลี่ยน Battery</li>
            <li>เปลี่ยนกล้อง</li>
            <li>ซ่อมพอร์ตชาร์จ</li>
            <li>ซ่อม Mainboard</li>
            <li>เปลี่ยนฝาหลัง</li>
            <li>เปลี่ยนกรอบ</li>
            <li>ซ่อม Face ID</li>
