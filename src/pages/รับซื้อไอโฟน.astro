---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';

const seo = resolveSeo('/รับซื้อไอโฟน/');
const breadcrumbs = [
  { name: 'หมวดหมู่รับซื้อ', url: '/รับซื้อ/' },
  { name: 'รับซื้อ iPhone', url: '/รับซื้อไอโฟน/' }
];
const internalLinks = getInternalLinks(seo);

const faqs = [
  {
    question: 'รับซื้อ iPhone รุ่นใดบ้าง?',
    answer: 'เรารับซื้อ iPhone ทุกรุ่น ตั้งแต่ iPhone 11, 12, 13, 14, 15 จนถึง 16 Pro Max ทุกความจุและทุกโมเดลศูนย์ไทย (TH) หรือโมเดลนอก'
  },
  {
    question: 'iPhone หน้าจอแตก หรือแบตเตอรี่เสื่อม รับซื้อหรือไม่?',
    answer: 'รับซื้อตามสภาพจริง สามารถส่งรูปตัวเครื่องเพื่อเช็กการทำงานของระบบสัมผัส Face ID และบอดี้ เพื่อให้ทีมงานช่วยประเมินราคาได้'
  }
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="section" style="padding-top: 3rem; padding-bottom: 2rem; text-align: center;">
    <div class="container container-narrow">
      <span class="badge badge-accent" style="margin-bottom: 0.75rem;">IPHONE BUYBACK</span>
      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">{seo.h1}</h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted);">
        รับซื้อ iPhone มือสอง ทุกรุ่น ทุกสภาพ ตรวจสอบฟังก์ชันครบถ้วน ประเมินราคายุติธรรม
      </p>
    </div>
  </section>

  <TrustBar />

  <section class="section">
    <div class="container container-narrow">
      <div class="card" style="padding: 2.5rem 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">เกณฑ์การประเมินราคา iPhone มือสอง</h2>
        <ul>
          <li><strong>โมเดลและความจุ</strong>: รุ่นเครื่อง (Standard / Plus / Pro / Pro Max) และความจุ (128GB - 1TB)</li>
          <li><strong>สุขภาพแบตเตอรี่ (Battery Health)</strong>: สุขภาพแบต % ดั้งเดิมจากโรงงาน</li>
          <li><strong>ฟังก์ชันฮาร์ดแวร์</strong>: การสแกนใบหน้า Face ID, กล้องหน้า-หลังทุกระยะ, ลำโพง, ไมโครโฟน และระบบชาร์จ True Tone</li>
          <li><strong>สถานะเครื่อง</strong>: เครื่องไม่ติดล็อคเครือข่าย ปลดล็อค iCloud / Apple ID เรียบร้อย</li>
        </ul>
      </div>

      <ProcessSteps />

      <div style="margin-top: 3.5rem;">
        <FAQ items={faqs} />
      </div>

      <RelatedLinks
        clusterLinks={internalLinks.clusterLinks}
        parentLink={internalLinks.parentLink}
        guideLinks={internalLinks.guideLinks}
      />
    </div>
  </section>

  <CTA />
</BaseLayout>
