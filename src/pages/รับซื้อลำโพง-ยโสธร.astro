---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อลำโพงยโสธร Bluetooth JBL Marshall มือสอง เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อลำโพงมือสองในยโสธร ทั้ง Bluetooth และ Portable Speaker ประเมินจากรุ่น Battery เสียง Driver Passive Radiator การเชื่อมต่อ Port สภาพและอุปกรณ์";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อลำโพง",
    "url": "/รับซื้อลำโพง/"
  },
  {
    "name": "รับซื้อลำโพงยโสธร เช็ก Battery เสียง Driver และสภาพก่อนขาย",
    "url": "/รับซื้อลำโพง-ยโสธร/"
  }
];

const faqs = [
  {
    question: "Battery หมดเร็วต้องเปลี่ยนก่อนขายไหม?",
    answer: "ไม่จำเป็นทุกกรณี ควรเช็กราคาตามสภาพก่อน แล้วค่อยเปรียบเทียบต้นทุน Battery ใหม่กับมูลค่าที่อาจเพิ่มขึ้น"
  },
  {
    question: "ลำโพงเสียงแตกยังประเมินได้หรือไม่?",
    answer: "ได้ ควรแจ้งว่าอาการเกิดที่ระดับเสียงใดหรือช่วงเสียงใดเท่าที่สังเกตได้ และไม่จำเป็นต้องเปิดเสียงสูงสุดซ้ำเป็นเวลานาน"
  },
  {
    question: "Bluetooth เชื่อมไม่ได้ต้องซ่อมก่อนขายไหม?",
    answer: "ไม่จำเป็นทุกกรณี สามารถส่ง Model รูปและอาการมาประเมินตามสภาพก่อน โดยไม่ต้องวินิจฉัยสาเหตุเอง"
  },
  {
    question: "ไม่มี Charger หรือกล่องยังขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งสิ่งที่รวมขายจริง ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนเช็กราคา"
  },
  {
    question: "ต้องส่ง Serial Number สาธารณะเพื่อเช็กราคาไหม?",
    answer: "ไม่ต้อง สามารถเริ่มจาก Brand Model รูป Battery และสภาพก่อน หากจำเป็นต้องตรวจ Serial เพิ่มเติมควรส่งผ่านช่องทางที่เหมาะสม"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อลำโพงยโสธร เช็ก Battery เสียง Driver และสภาพก่อนขาย</h1>
          
          
          <p>
            สำหรับลำโพง Bluetooth หรือ Portable Speaker การประเมินควรดูทั้งรุ่น Battery ระบบชาร์จ เสียง Driver การเชื่อมต่อ Port และสภาพภายนอก ไม่ควรอิงเพียงราคาซื้อใหม่
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">ส่งข้อมูลเริ่มต้น:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>Brand + Model + Battery + Bluetooth + เสียง + รูป + Charger/Adapter + อาการ</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.webp" type="image/webp" />
              <source srcset="/images/hero-speaker.avif" type="image/avif" />
              <source srcset="/images/hero-speaker.webp" type="image/webp" />
              <img
                src="/images/hero-speaker.webp"
                alt="รับซื้อลำโพงยโสธร เช็ก Battery เสียง Driver และสภาพก่อนขาย"
                width="979"
                height="667"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: YASOTHON SERVICE INTAKE -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>อยู่ยโสธรสามารถส่งรุ่นและอาการมาก่อนได้</h2>
        <p>ก่อนนำลำโพงไปตรวจ สามารถเริ่มจากส่ง:</p>
        <div class="grid-2" style="margin-bottom: 1.25rem;">
          <div>
            <ul>
              <li>Brand</li>
              <li>Model</li>
              <li>รูป</li>
              <li>Battery</li>
              <li>การเชื่อมต่อ</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>คุณภาพเสียง</li>
              <li>Port</li>
              <li>Charger หรือ Adapter</li>
              <li>ประวัติซ่อม</li>
            </ul>
          </div>
        </div>
        <p>หลังทราบข้อมูลเบื้องต้นจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>การเช็กราคาเบื้องต้นเริ่มจากส่งข้อมูลออนไลน์ก่อน และขั้นตอนตรวจหรือส่งมอบจะนัดหมายตามพื้นที่จริงโดยไม่ได้ระบุว่ามีสาขาประจำในทุกอำเภอของยโสธร</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BRAND & HARDWARE DIFFERENCES -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ชื่อรุ่นสำคัญกว่าชื่อแบรนด์อย่างเดียว</h2>
          <p>คำว่า:</p>
          <p><strong>JBL</strong></p>
          <p><strong>Marshall</strong></p>
          <p><strong>Harman Kardon</strong></p>
          <p>หรือแบรนด์อื่น</p>
          <p>ยังไม่สามารถระบุรุ่นและ Generation ได้</p>
          <p>ควรส่งชื่อ Model เต็มหรือรูปป้ายรุ่น</p>
          <p>ชื่อแบรนด์ใช้เพื่อจำแนกประเภทสินค้าเท่านั้น ไม่ได้หมายความว่าเว็บไซต์เป็นตัวแทน ผู้ซื้อที่ได้รับแต่งตั้ง หรือศูนย์บริการของผู้ผลิต</p>
        </div>

        <div class="comm-card">
          <h2>ลำโพงรุ่นใกล้กันอาจใช้ Battery และ Hardware ต่างกัน</h2>
          <p>แม้รูปลักษณ์คล้ายกัน แต่อาจต่างกันใน:</p>
          <ul>
            <li>ขนาด Driver</li>
            <li>Battery</li>
            <li>Port ชาร์จ</li>
            <li>Bluetooth Version</li>
            <li>ระบบเชื่อมต่อหลายตัว</li>
            <li>App Support</li>
            <li>กำลังขับ</li>
            <li>Generation</li>
          </ul>
          <p>จึงควรตรวจ Model ก่อนประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: BATTERY & SOUND QUALITY -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery เสื่อมควรแจ้งจากอาการใช้งานจริง</h2>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>Battery ใช้งานได้ปกติ</li>
            <li>หมดเร็ว</li>
            <li>เปิดได้ไม่นาน</li>
            <li>เปิดได้เฉพาะเสียบไฟ</li>
            <li>ชาร์จไม่เข้า</li>
            <li>ชาร์จติดบางครั้ง</li>
            <li>เคยเปลี่ยน Battery</li>
            <li>Battery บวม</li>
          </ul>
          <p>หาก Battery บวม ไม่ควรชาร์จซ้ำหรือกดตัวเครื่องบริเวณที่ผิดรูป</p>
        </div>

        <div class="comm-card">
          <h2>เสียงแตกควรสังเกตว่าเกิดช่วงไหน</h2>
          <p>ถ้าทดสอบได้อย่างปลอดภัย สามารถแจ้งว่า:</p>
          <ul>
            <li>เสียงปกติ</li>
            <li>แตกเฉพาะเสียงเบส</li>
            <li>แตกเมื่อเปิดดัง</li>
            <li>เสียงขาด</li>
            <li>Driver ฝั่งหนึ่งไม่ทำงาน</li>
            <li>เสียงเบากว่าปกติ</li>
            <li>มีเสียงสั่นผิดปกติ</li>
          </ul>
          <p>ไม่จำเป็นต้องเปิด Volume สูงสุดเป็นเวลานานเพื่อตรวจอาการ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: DRIVERS, BLUETOOTH & PORTS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Driver และ Passive Radiator ควรตรวจจากอาการและสภาพ</h2>
          <p>ลำโพงบางรุ่นมี:</p>
          <ul>
            <li>Driver หลายตัว</li>
            <li>Woofer</li>
            <li>Tweeter</li>
            <li>Passive Radiator</li>
          </ul>
          <p>ควรดูว่ามี:</p>
          <ul>
            <li>ตะแกรงบุบ</li>
            <li>ยางฉีก</li>
            <li>ชิ้นส่วนขยับผิดปกติ</li>
            <li>เสียงสั่น</li>
            <li>เสียงผิดปกติ</li>
          </ul>
          <p>ไม่ควรแกะตัวเครื่องเพียงเพื่อดู Driver ภายในก่อนขาย</p>

          <h2 style="margin-top: 1.5rem;">Bluetooth ควรทดสอบการ Pair ตามปกติ</h2>
          <p>ควรแจ้งว่า:</p>
          <ul>
            <li>ค้นหาเจอ</li>
            <li>Pair ได้</li>
            <li>เชื่อมติดยาก</li>
            <li>หลุดเอง</li>
            <li>เสียงขาด</li>
            <li>ปุ่ม Bluetooth ไม่ทำงาน</li>
          </ul>
          <p>หากเชื่อมไม่ได้ ไม่จำเป็นต้องสรุปว่า Board หรือ Bluetooth Module เสียโดยยังไม่ได้ตรวจ</p>
        </div>

        <div class="comm-card">
          <h2>Port ชาร์จและสายมีผลต่อการใช้งาน</h2>
          <p>ควรตรวจ:</p>
          <ul>
            <li>USB-C</li>
            <li>Micro USB</li>
            <li>AC input</li>
            <li>AUX</li>
            <li>Port อื่นตามรุ่น</li>
          </ul>
          <p>แจ้งหาก:</p>
          <ul>
            <li>Port หลวม</li>
            <li>ต้องขยับสาย</li>
            <li>ชาร์จไม่เข้า</li>
            <li>มีรอยไหม้</li>
            <li>Connector ผิดรูป</li>
          </ul>
          <p>หากพบความร้อนหรือกลิ่นผิดปกติไม่ควรชาร์จซ้ำหลายครั้ง</p>

          <h2 style="margin-top: 1.5rem;">ปุ่มและระบบควบคุมควรทดสอบ</h2>
          <p>เช่น:</p>
          <ul>
            <li>Power</li>
            <li>Volume</li>
            <li>Bluetooth</li>
            <li>Play/Pause</li>
            <li>Mode</li>
            <li>Battery indicator</li>
            <li>App control ตามรุ่น</li>
          </ul>
          <p>ควรแจ้งตามอาการจริง</p>
          <p>ไม่จำเป็นต้องแกะปุ่มหรือแผงวงจรเพื่อตรวจเอง</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: DROPS, WATER, REPAIRS, AUTHENTICITY & CHARGER -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ลำโพงตกหรือมีรอยภายนอกควรถ่ายชัด</h2>
          <p>ควรถ่าย:</p>
          <ul>
            <li>ด้านหน้า</li>
            <li>ด้านหลัง</li>
            <li>ด้านข้าง</li>
            <li>ฐาน</li>
            <li>ตะแกรง</li>
            <li>Port</li>
            <li>ปุ่ม</li>
            <li>ป้าย Model</li>
          </ul>
          <p>และแจ้งหาก:</p>
          <ul>
            <li>ตัวถังแตก</li>
            <li>ตะแกรงบุบ</li>
            <li>ยางเสื่อม</li>
            <li>มีรอยตก</li>
            <li>มีรอยน้ำ</li>
            <li>ชิ้นส่วนหลวม</li>
          </ul>

          <h2 style="margin-top: 1.5rem;">ลำโพงโดนน้ำควรแจ้งแม้รุ่นนั้นมีคุณสมบัติกันน้ำ</h2>
          <p>ระดับการป้องกันน้ำของสินค้าไม่ได้หมายความว่าอุปกรณ์ทุกเครื่องจะไม่มีความเสียหายหลังสัมผัสน้ำ</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>เกิดเหตุเมื่อใดโดยประมาณ</li>
            <li>หลังจากนั้นเปิดได้หรือไม่</li>
            <li>เสียงผิดปกติหรือไม่</li>
            <li>ชาร์จได้หรือไม่</li>
          </ul>
          <p>หากสงสัยว่ายังมีความชื้นภายในและเครื่องมีอาการ ไม่ควรชาร์จซ้ำหลายครั้ง</p>
        </div>

        <div class="comm-card">
          <h2>เคยซ่อมหรือเปลี่ยน Battery ยังประเมินได้</h2>
          <p>ควรแจ้งถ้าทราบว่าเคย:</p>
          <ul>
            <li>เปลี่ยน Battery</li>
            <li>ซ่อม Port</li>
            <li>ซ่อม Board</li>
            <li>เปลี่ยน Driver</li>
            <li>ซ่อมปุ่ม</li>
            <li>เปิดเครื่อง</li>
            <li>โดนน้ำ</li>
          </ul>
          <p>ประวัติซ่อมช่วยให้เข้าใจสภาพปัจจุบันมากขึ้น</p>

          <h2 style="margin-top: 1.5rem;">เรื่องของแท้หรือของเลียนแบบควรใช้ข้อมูลที่ตรวจสอบได้</h2>
          <p>หากมี:</p>
          <ul>
            <li>กล่อง</li>
            <li>Serial</li>
            <li>ใบเสร็จ</li>
            <li>ข้อมูลใน App</li>
            <li>รายละเอียด Model</li>
            <li>อุปกรณ์เดิม</li>
          </ul>
          <p>สามารถใช้ประกอบการตรวจสอบสินค้าในขั้นตอนที่เหมาะสมได้</p>
          <p>ไม่ควรสรุปความแท้หรือความไม่แท้จากรูปเพียงมุมเดียว</p>
          <p>และไม่จำเป็นต้องโพสต์ Serial Number สาธารณะเพื่อถามราคาเบื้องต้น</p>

          <h2 style="margin-top: 1.5rem;">ไม่มี Charger หรือกล่องยังส่งมาประเมินได้</h2>
          <p>ควรแจ้งตามจริงว่า:</p>
          <ul>
            <li>มีกล่อง</li>
            <li>มี Charger</li>
            <li>มี Adapter</li>
            <li>มีสาย</li>
            <li>ไม่มีอุปกรณ์บางอย่าง</li>
          </ul>
          <p>ไม่จำเป็นต้องซื้อของใหม่มาเติมชุดก่อนรู้ว่าคุ้มกับมูลค่าที่อาจเพิ่มหรือไม่</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: YASOTHON VS SPEAKER HUB -->
  <section class="commercial-section section-surface">
    <div class="container">
    </div>
  </section>

  <!-- SECTION 7: 10-STEP PROCESS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคาลำโพงในยโสธร</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Brand และ Model</h3>
              <p>ใช้รุ่นเต็ม</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>2. ส่งรูป</h3>
              <p>ทุกด้านและป้ายรุ่น</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง Battery</h3>
              <p>อาการและระยะเวลาการใช้งานเท่าที่ทราบ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>4. ทดสอบ Bluetooth</h3>
              <p>แจ้งผลตามจริง</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>5. ฟังเสียงในระดับเหมาะสม</h3>
              <p>แจ้งเสียงแตกหรืออาการผิดปกติ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>6. ตรวจ Port</h3>
              <p>ชาร์จและช่องสัญญาณ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>7. ตรวจปุ่ม</h3>
              <p>Power Volume และ Control</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>8. แจ้งอุปกรณ์</h3>
              <p>Charger Adapter สายและกล่อง</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>9. แจ้งประวัติ</h3>
              <p>ตก น้ำ หรือซ่อมถ้าทราบ</p>
            </div>
          </div>

          <div class="process-step-item" style="grid-column: 1 / -1;">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น ฟังก์ชันและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 8: FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาลำโพงในยโสธร</h2>
        <p style="margin-bottom: 0.5rem;">ส่ง:</p>
        <p style="font-size: 1.25rem; font-weight: 800; color: #fdba74; margin-bottom: 1.5rem;">
          <strong>Brand + Model + Battery + Bluetooth + เสียง + รูป + อุปกรณ์</strong>
        </p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <p style="font-size: 1.05rem; font-weight: 700;">
          <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 9: FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายลำโพงในยโสธร" subtitle="" />
    </div>
  </section>
</BaseLayout>
