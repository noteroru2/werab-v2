---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คเลย Notebook Laptop เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในจังหวัดเลย Notebook Laptop และ Gaming Notebook ส่งรุ่น สเปก รูป แบตเตอรี่ อาการและอุปกรณ์เพื่อเช็กราคาเบื้องต้นก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คเลย เช็กราคาจากรุ่น สเปก และสภาพก่อนเดินทาง",
    "url": "/รับซื้อโน๊ตบุ๊ค-เลย/"
  }
];

const faqs = [
  {
    "question": "อยู่ต่างอำเภอในจังหวัดเลยเช็กราคาก่อนได้ไหม?",
    "answer": "สามารถส่ง Model สเปก รูป Battery และอาการเพื่อประเมินเบื้องต้นก่อน แล้วจึงพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม"
  },
  {
    "question": "Gaming Notebook ต้องแจ้งอะไรเพิ่ม?",
    "answer": "ควรแจ้ง GPU และ Adapter เพิ่มจาก CPU, RAM และ SSD เพราะ Gaming Notebook Series เดียวกันอาจมีหลาย GPU Configuration"
  },
  {
    "question": "เครื่องเก่า Battery เสื่อมยังขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้ง Battery และอาการอื่นตามจริง ไม่จำเป็นต้องเปลี่ยน Battery ก่อนรู้ว่าค่าใช้จ่ายคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "Notebook เปิดไม่ติดต้องเดินทางมาให้ตรวจก่อนหรือไม่?",
    "answer": "สามารถเริ่มจากส่งรุ่น สเปกที่ทราบ รูป Adapter และอาการก่อน เพื่อประเมินข้อมูลเบื้องต้นโดยไม่จำเป็นต้องเดินทางเพียงเพื่อถามราคา"
  },
  {
    "question": "ขาย Notebook โดยไม่รวม SSD ได้ไหม?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ ราคาจะประเมินจาก Configuration ที่ขายจริง และเป็นทางเลือกหนึ่งหากผู้ขายต้องการเก็บข้อมูลหรือ Drive ไว้"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อโน๊ตบุ๊คเลย เช็กราคาจากรุ่น สเปก และสภาพก่อนเดินทาง</h1>
        <p>หากมี Notebook อยู่ในจังหวัดเลย การรู้ราคาเบื้องต้นจากข้อมูลเครื่องก่อนช่วยลดการเดินทางที่ยังไม่จำเป็น โดยเฉพาะเมื่อยังไม่แน่ใจว่าจะขาย ซ่อม หรือเก็บเครื่องไว้ใช้งานต่อ</p>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค-เลย/</code> รักษา Historical Search Intent สำหรับผู้ขาย Notebook ในจังหวัดเลย</p>
        <p>เริ่มจาก:</p>
        <p><strong>Brand + Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + รูป</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>อยู่ต่างพื้นที่ในจังหวัดเลยสามารถส่งข้อมูลมาก่อนได้</h2>
        <p>เช่นผู้ขายที่อยู่ใน:</p>
        <ul>
        <li>อำเภอเมืองเลย</li>
        <li>วังสะพุง</li>
        <li>เชียงคาน</li>
        <li>ด่านซ้าย</li>
        <li>ภูเรือ</li>
        <li>ปากชม</li>
        <li>และพื้นที่อื่นในจังหวัดเลย</li>
        </ul>
        <p>สามารถเริ่มจากส่งข้อมูลผ่านช่องทางติดต่อเพื่อประเมินเบื้องต้นก่อน</p>
        <p>จากนั้นจึงพิจารณาวิธีตรวจสินค้าและส่งมอบตามระยะทาง พื้นที่ และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำในทุกอำเภอ</p>
        <hr class="section-divider" />
        <h2>การรู้ Model ก่อนช่วยลดความคลาดเคลื่อน</h2>
        <p>ชื่อที่อยู่บนฝา เช่น IdeaPad, Aspire, VivoBook หรือ Gaming Series อาจมีหลายรุ่นย่อย</p>
        <p>ควรส่ง:</p>
        <ul>
        <li>Model เต็ม</li>
        <li>Sticker ใต้เครื่อง</li>
        <li>ข้อมูล BIOS</li>
        <li>System Information</li>
        </ul>
        <p>อย่างใดอย่างหนึ่ง</p>
        <p>หากไม่ทราบสามารถเริ่มจากรูปป้ายใต้เครื่อง</p>
        <hr class="section-divider" />
        <h2>CPU และ Generation ต้องดูพร้อมกัน</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>Core i5-8250U</strong></p>
        <p>กับ</p>
        <p><strong>Core i5-13420H</strong></p>
        <p>แม้เป็น Core i5 เหมือนกันแต่เป็นคนละ Platform และระดับการใช้งาน</p>
        <p>จึงควรแจ้งรหัสรุ่นเต็ม</p>
        <hr class="section-divider" />
        <h2>RAM และ SSD ที่อัปเกรดควรแจ้งของปัจจุบัน</h2>
        <p>หากมีการเพิ่ม RAM หรือเปลี่ยน SSD ควรแจ้งสเปกหลังอัปเกรด</p>
        <p>ตัวอย่าง:</p>
        <p><strong>RAM 16GB / SSD 1TB</strong></p>
        <p>หากต้องการถอด SSD เก็บไว้ ให้แจ้งว่าไม่รวม SSD ตั้งแต่ก่อนประเมิน</p>
        <hr class="section-divider" />
        <h2>Gaming Notebook ต้องส่ง GPU</h2>
        <p>หากเป็นเครื่อง Gaming ควรส่ง:</p>
        <ul>
        <li>CPU</li>
        <li>GPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>Display ถ้าทราบ</li>
        <li>Adapter</li>
        </ul>
        <p>GPU เป็นข้อมูลที่ช่วยแยก Configuration สำคัญ</p>
        <p>เครื่อง Series เดียวกันอาจใช้ GPU คนละรุ่น</p>
        <hr class="section-divider" />
        <h2>Battery มีผลมากกับ Notebook ที่ต้องพกพา</h2>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>ใช้ Battery ได้หรือไม่</li>
        <li>หมดเร็วหรือไม่</li>
        <li>ต้องเสียบ Adapter หรือไม่</li>
        <li>Battery Health ถ้ามี</li>
        <li>Battery เคยเปลี่ยนหรือไม่</li>
        <li>มีอาการบวมหรือไม่</li>
        </ul>
        <p>หากบวมควรลดการใช้งานและหลีกเลี่ยงการกดส่วนที่นูน</p>
        <hr class="section-divider" />
        <h2>Adapter ควรถ่าย Label มาด้วยถ้าทำได้</h2>
        <p>Adapter ของ Notebook โดยเฉพาะ Gaming Notebook อาจมีกำลังไฟต่างกัน</p>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>Adapter เดิม</li>
        <li>Adapter เทียบ</li>
        <li>ไม่มี Adapter</li>
        <li>Adapter มีอาการ</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้อใหม่เพื่อถามราคาก่อน</p>
        <hr class="section-divider" />
        <h2>จอและบานพับควรตรวจด้วยรูป</h2>
        <p>ควรถ่าย:</p>
        <ul>
        <li>จอขณะเปิด</li>
        <li>ฝาหลัง</li>
        <li>บานพับ</li>
        <li>Keyboard</li>
        <li>Palmrest</li>
        <li>ด้านล่าง</li>
        </ul>
        <p>หากมีอาการ:</p>
        <ul>
        <li>จอเป็นเส้น</li>
        <li>จอกระพริบ</li>
        <li>จอแตก</li>
        <li>บานพับแตก</li>
        <li>ฝาแยก</li>
        </ul>
        <p>ควรแจ้งให้เห็นตรงกับสภาพจริง</p>
        <hr class="section-divider" />
        <h2>เครื่องเคยตกหรือโดนน้ำต้องแจ้ง</h2>
        <p>ควรแจ้งหากทราบ เพราะอาการภายในบางอย่างอาจเกิดภายหลัง</p>
        <p>ข้อมูลที่มีประโยชน์:</p>
        <ul>
        <li>เกิดเมื่อไรโดยประมาณ</li>
        <li>โดนบริเวณไหน</li>
        <li>เปิดต่อหลังเกิดเหตุหรือไม่</li>
        <li>ปัจจุบันมีอาการอะไร</li>
        <li>เคยซ่อมหรือไม่</li>
        </ul>
        <p>ไม่ควรปิดบังประวัติเพื่อให้เครื่องดูเป็นสภาพปกติ</p>
        <hr class="section-divider" />
        <h2>เครื่องเปิดไม่ติดยังเริ่มประเมินได้</h2>
        <p>ควรส่ง:</p>
        <p><strong>Model + สเปกที่ทราบ + รูป + Adapter + อาการ</strong></p>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>ไฟชาร์จขึ้นแต่ไม่เปิด</li>
        <li>เปิดแล้วดับ</li>
        <li>Fan หมุนแต่ไม่มีภาพ</li>
        <li>ไม่มีไฟ</li>
        <li>มีเสียงแต่จอไม่ขึ้น</li>
        </ul>
        <p>อาการไม่สามารถยืนยันสาเหตุได้โดยไม่ตรวจ จึงควรรายงานตามสิ่งที่เกิดขึ้นจริง</p>
        <hr class="section-divider" />
        <h2>เครื่องเก่าควรซ่อมก่อนขายหรือไม่</h2>
        <p>ขึ้นอยู่กับ:</p>
        <ul>
        <li>อายุเครื่อง</li>
        <li>รุ่น</li>
        <li>ค่าอะไหล่</li>
        <li>ค่าแรง</li>
        <li>ความเสียหาย</li>
        <li>มูลค่าที่คาดว่าจะเพิ่ม</li>
        </ul>
        <p>เครื่องเก่าที่ต้องเปลี่ยนหลายชิ้นอาจไม่คุ้มกับการซ่อมเพื่อขาย</p>
        <p>ควรเช็กราคาตามสภาพก่อน</p>
        <hr class="section-divider" />
        <h2>ข้อมูลส่วนตัวต้องแยกจากการประเมิน Hardware</h2>
        <p>เพื่อประเมินเบื้องต้นไม่ต้องส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Account Password</li>
        </ul>
        <p>ก่อนส่งมอบจริงเจ้าของควรสำรองข้อมูลและออกจากบัญชีที่เกี่ยวข้อง</p>
        <p>หากต้องการเก็บ Drive ไว้สามารถแจ้งตั้งแต่ต้น</p>
        <hr class="section-divider" />
        <h2>มี Notebook หลายเครื่องในจังหวัดเลย</h2>
        <p>หากเป็นเครื่องจากสำนักงานหรือหน่วยงานหลายเครื่อง สามารถส่งเป็นตาราง:</p>
        <table class="table table-bordered">
          <thead><tr><th>รุ่น</th><th>CPU</th><th>RAM</th><th>SSD</th><th>จำนวน</th><th>สภาพ</th></tr></thead>
          <tbody>
          <tr><td>รุ่น...</td><td>i5-...</td><td>8GB</td><td>256GB</td><td>4</td><td>ใช้งานได้</td></tr>
          <tr><td>รุ่น...</td><td>i5-...</td><td>8GB</td><td>512GB</td><td>3</td><td>Battery เสื่อม</td></tr>
          <tr><td>รุ่น...</td><td>ไม่ทราบ</td><td>ไม่ทราบ</td><td>ไม่ทราบ</td><td>2</td><td>ไม่ได้ทดสอบ</td></tr>
          </tbody></table>
        <p>ไม่จำเป็นต้องส่งข้อมูลภายในองค์กรที่ไม่เกี่ยวข้องกับ Hardware</p>
        <hr class="section-divider" />
        <h2>ทำไมหน้าเลยต้องแยกจากหน้ารับซื้อโน๊ตบุ๊คหลัก</h2>
        <p>หน้า:</p>
        <p><a href="/รับซื้อโน๊ตบุ๊ค/"><code>/รับซื้อโน๊ตบุ๊ค/</code></a></p>
        <p>เป็น Broad Notebook Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อโน๊ตบุ๊ค-เลย/</code></p>
        <p>เป็น Historical Local URL ที่รักษา Intent:</p>
        <p><strong>Notebook + Loei</strong></p>
        <p>เนื้อหาจึงเน้นการเช็กราคาก่อนเดินทางและการส่งข้อมูลจากพื้นที่จังหวัดเลย ไม่ใช่การสร้าง Broad Notebook Hub ซ้ำ</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคา Notebook ในจังหวัดเลย</h2>
        <h3>1. ส่ง Model</h3>
        <p>ใช้รุ่นเต็ม</p>
        <h3>2. ส่ง CPU</h3>
        <p>ระบุรหัสเต็ม</p>
        <h3>3. ส่ง RAM และ SSD</h3>
        <p>ใช้ Configuration ปัจจุบัน</p>
        <h3>4. ส่ง GPU</h3>
        <p>ถ้าเป็น Gaming Notebook</p>
        <h3>5. ส่ง Battery</h3>
        <p>Health หรืออาการ</p>
        <h3>6. ส่งรูป</h3>
        <p>จอ บานพับ Keyboard และตำหนิ</p>
        <h3>7. แจ้ง Adapter</h3>
        <p>เดิม เทียบ หรือไม่มี</p>
        <h3>8. แจ้งอาการและประวัติ</h3>
        <p>เช่น ซ่อม ตก หรือโดนน้ำ</p>
        <h3>9. ประเมินเบื้องต้นก่อนเดินทาง</h3>
        <p>พิจารณาก่อนว่าจะขายหรือไม่</p>
        <h3>10. ตรวจสินค้า</h3>
        <p>ตรวจสเปกและสภาพให้ตรงกับข้อมูลก่อนซื้อขาย</p>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคาโน๊ตบุ๊คในจังหวัดเลย</h2>
        <p>ส่ง:</p>
        <p><strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery</strong></p>
        <p>พร้อม:</p>
        <p><strong>รูป + Adapter + อาการ + จุดตำหนิ</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <hr class="section-divider" />
        <hr class="section-divider" />
        <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายโน๊ตบุ๊คมือสองในจังหวัดเลย" />
      </article>
    </div>
  </main>
</BaseLayout>
