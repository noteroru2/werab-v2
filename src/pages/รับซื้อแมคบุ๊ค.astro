---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อ MacBook มือสอง MacBook Air Pro เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ MacBook มือสอง MacBook Air และ MacBook Pro ประเมินจากรุ่น ชิป M1 M2 M3 M4 RAM SSD แบตเตอรี่ สภาพจอและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อ MacBook",
    "url": "/รับซื้อแมคบุ๊ค/"
  }
];

const faqs = [
  {
    "question": "รับซื้อ MacBook Air และ MacBook Pro มือสองไหม?",
    "answer": "สามารถส่ง MacBook Air และ MacBook Pro หลายรุ่นมาประเมินได้ ทั้งรุ่น Intel และ Apple Silicon โดยควรแจ้งรุ่น ชิปหรือ Processor, RAM, SSD, Battery สภาพเครื่องและอุปกรณ์ที่มี"
  },
  {
    "question": "MacBook แบตเสื่อมหรือไม่มี Adapter ขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการ Battery, Battery Health หรือ Cycle Count หากตรวจได้ และระบุว่ามี Adapter กับสายชาร์จหรือไม่"
  },
  {
    "question": "MacBook เคยซ่อมหรือเคยโดนน้ำยังขายได้ไหม?",
    "answer": "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบ เช่น เคยเปลี่ยนจอ Battery Keyboard ซ่อม Mainboard หรือเคยโดนน้ำ เพื่อให้ประเมินความเสี่ยงและสภาพได้ตรงขึ้น"
  },
  {
    "question": "ต้องออกจาก Apple ID ก่อนส่งรูปเช็กราคาไหม?",
    "answer": "ไม่จำเป็นต้องออกจากบัญชีเพียงเพื่อส่งข้อมูลเช็กราคา และไม่ควรส่ง Apple ID Password หรือรหัสยืนยันตัวตนให้ผู้อื่น เมื่อพร้อมส่งมอบเครื่องจริง เจ้าของบัญชีจึงค่อยดำเนินการออกจากระบบและจัดการ Find My ด้วยตนเอง"
  },
  {
    "question": "MacBook เปิดไม่ติดยังประเมินได้ไหม?",
    "answer": "บางกรณีสามารถประเมินตามสภาพได้ ควรส่งรุ่น สเปกที่ทราบ อาการก่อนเสีย Adapter และประวัติการซ่อมหรือการตกน้ำหากมี เนื่องจากเครื่องที่ไม่สามารถทดสอบได้ต้องพิจารณาความเสี่ยงเพิ่มเติม"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อ MacBook มือสอง เช็กรุ่น ชิป แบตเตอรี่และสภาพก่อนขาย</h1>
        <p>ต้องการขาย MacBook มือสอง แต่ยังไม่แน่ใจว่าควรดูข้อมูลอะไรบ้างก่อนเช็กราคา?</p>
        <p>MacBook ชื่อรุ่นใกล้กันอาจมีสเปกและมูลค่าต่างกันจาก <strong>ปี รุ่น ชิป หน่วยความจำ SSD ขนาดหน้าจอ Battery สภาพเครื่อง และอุปกรณ์ที่มี</strong></p>
        <p>การบอกเพียงว่า “MacBook Air” หรือ “MacBook Pro” จึงยังไม่เพียงพอสำหรับการประเมินเบื้องต้น</p>
        <p>เริ่มจากส่ง:</p>
        <p><strong>รุ่น + ปีหรือชิป + RAM + SSD + รูป + Battery + สภาพ + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>MacBook แบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียด MacBook หลายกลุ่มมาสอบถามได้ เช่น</p>
        <ul>
        <li>MacBook Air</li>
        <li>MacBook Pro</li>
        <li>รุ่น Intel</li>
        <li>รุ่น Apple Silicon</li>
        <li>เครื่องใช้งานทั่วไป</li>
        <li>เครื่องสำหรับทำงาน</li>
        <li>เครื่องสำหรับงานกราฟิก</li>
        <li>เครื่องที่มีรอย</li>
        <li>เครื่องแบตเตอรี่เสื่อม</li>
        <li>เครื่องไม่มี Adapter</li>
        <li>เครื่องไม่มี Box</li>
        <li>เครื่องเคยซ่อม</li>
        <li>เครื่องมีปัญหาบางฟังก์ชัน</li>
        <li>เครื่องเปิดไม่ติดบางกรณี</li>
        </ul>
        <p>ราคาต้องพิจารณาจากรุ่นและสภาพของเครื่องจริง</p>
        <p>ไม่ควรประเมินจากคำว่า Air หรือ Pro เพียงอย่างเดียว เพราะแต่ละ Generation มีสเปกและตลาดมือสองแตกต่างกัน</p>
        <hr class="section-divider" />
        <h2>ก่อนขายต้องรู้ว่าเป็น MacBook รุ่นไหน</h2>
        <p>ข้อมูลที่ช่วยระบุเครื่องได้ เช่น</p>
        <ul>
        <li>MacBook Air หรือ MacBook Pro</li>
        <li>ขนาดหน้าจอ</li>
        <li>ปีหรือ Generation</li>
        <li>ชิป</li>
        <li>RAM หรือ Unified Memory</li>
        <li>SSD</li>
        <li>Model Identifier</li>
        <li>Model Number</li>
        <li>ข้อมูลจาก About This Mac</li>
        </ul>
        <p>หากเครื่องเปิดได้ สามารถเริ่มจากเมนู:</p>
        <p><strong>Apple Menu → About This Mac</strong></p>
        <p>แล้วถ่ายรูปหน้าข้อมูลเครื่องส่งมาประกอบการประเมินได้</p>
        <p>หากเปิดเครื่องไม่ได้ สามารถส่งรูปตัวเครื่อง รุ่นที่ทราบ และข้อมูลจากกล่องหรือเอกสารที่มีแทนได้</p>
        <p>ไม่จำเป็นต้องส่ง Apple ID, Password หรือข้อมูลบัญชีส่วนตัวเพื่อเช็กราคา</p>
        <hr class="section-divider" />
        <h2>MacBook Intel กับ Apple Silicon ควรแยกให้ชัด</h2>
        <p>MacBook มีทั้งรุ่นที่ใช้ Intel Processor และรุ่นที่ใช้ Apple Silicon</p>
        <p>ตัวอย่างกลุ่ม Apple Silicon เช่น</p>
        <ul>
        <li>M1</li>
        <li>M2</li>
        <li>M3</li>
        <li>M4</li>
        </ul>
        <p>การประเมินควรดูชื่อชิปเต็มร่วมกับรุ่นของเครื่อง</p>
        <p>ไม่ควรแจ้งเพียงว่า “MacBook Pro” เพราะ MacBook Pro มีหลาย Generation และหลายระดับสเปก</p>
        <p>สำหรับรุ่น Intel ควรแจ้ง Processor และปีของเครื่องหากทราบ</p>
        <p>สำหรับ Apple Silicon ควรแจ้งชิปและหน่วยความจำให้ชัด</p>
        <hr class="section-divider" />
        <h2>RAM หรือ Unified Memory มีผลต่อราคาอย่างไร</h2>
        <p>MacBook แต่ละรุ่นอาจมีหน่วยความจำไม่เท่ากัน</p>
        <p>เช่น</p>
        <ul>
        <li>8GB</li>
        <li>16GB</li>
        <li>24GB</li>
        <li>32GB</li>
        <li>หรือความจุอื่นตามรุ่น</li>
        </ul>
        <p>ใน MacBook หลายรุ่น หน่วยความจำไม่สามารถอัปเกรดภายหลังได้เหมือน Notebook บางประเภท</p>
        <p>ดังนั้นสเปกที่ติดตั้งมากับเครื่องจึงเป็นข้อมูลสำคัญในการประเมิน</p>
        <p>ควรแจ้งความจุจริงจากข้อมูลระบบ ไม่ควรเดาจากชื่อรุ่นหรือรูปลักษณ์ภายนอก</p>
        <hr class="section-divider" />
        <h2>SSD และความจุเครื่องต้องแจ้ง</h2>
        <p>ควรแจ้ง Storage เช่น</p>
        <ul>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        <li>2TB</li>
        <li>หรือความจุอื่น</li>
        </ul>
        <p>MacBook รุ่นเดียวกันแต่ SSD ต่างกันอาจมีมูลค่าต่างกัน</p>
        <p>อย่างไรก็ตาม มูลค่ามือสองไม่ได้เพิ่มตามราคาค่าอัปเกรดตอนซื้อใหม่แบบหนึ่งต่อหนึ่ง</p>
        <p>ต้องดูร่วมกับอายุเครื่อง รุ่น ชิป RAM สภาพ และตลาดปัจจุบัน</p>
        <hr class="section-divider" />
        <h2>Battery มีผลต่อการประเมิน MacBook</h2>
        <p>Battery เป็นชิ้นส่วนที่เสื่อมตามการใช้งาน</p>
        <p>ข้อมูลที่เป็นประโยชน์ เช่น</p>
        <ul>
        <li>Battery Health</li>
        <li>Maximum Capacity หากระบบแสดง</li>
        <li>Cycle Count</li>
        <li>อาการใช้งานจริง</li>
        <li>ชาร์จเข้าหรือไม่</li>
        <li>ใช้งานโดยไม่เสียบ Adapter ได้หรือไม่</li>
        <li>Battery มีอาการบวมหรือไม่</li>
        </ul>
        <p>Battery ที่เสื่อมไม่ได้หมายความว่าเครื่องจะประเมินไม่ได้</p>
        <p>แต่ควรแจ้งตามสภาพจริง เพราะมีผลต่อความพร้อมใช้งานและต้นทุนที่อาจเกิดขึ้นภายหลัง</p>
        <hr class="section-divider" />
        <h2>วิธีดู Cycle Count ของ MacBook</h2>
        <p>หากเครื่องยังเปิดใช้งานได้ สามารถดูข้อมูล Battery เพิ่มเติมจาก System Information ได้</p>
        <p>ข้อมูลที่พบอาจรวมถึง:</p>
        <ul>
        <li>Cycle Count</li>
        <li>Condition</li>
        <li>Battery Information</li>
        </ul>
        <p>ตำแหน่งเมนูอาจแตกต่างกันตามเวอร์ชันของ macOS</p>
        <p>ถ้าไม่แน่ใจ สามารถถ่ายรูปหน้าข้อมูล Battery ส่งมาประกอบได้</p>
        <p>Cycle Count เป็นเพียงหนึ่งในข้อมูลที่ใช้พิจารณา ไม่ควรใช้จำนวน Cycle เพียงอย่างเดียวในการกำหนดราคาของเครื่องทั้งหมด</p>
        <hr class="section-divider" />
        <h2>หน้าจอ MacBook ต้องตรวจอะไรบ้าง</h2>
        <p>หน้าจอเป็นชิ้นส่วนสำคัญและมีผลต่อมูลค่าของเครื่อง</p>
        <p>ควรตรวจ:</p>
        <ul>
        <li>ภาพขึ้นปกติหรือไม่</li>
        <li>มีเส้นหรือไม่</li>
        <li>มีจุดผิดปกติหรือไม่</li>
        <li>สีผิดปกติหรือไม่</li>
        <li>ความสว่างปกติหรือไม่</li>
        <li>มีอาการกะพริบหรือไม่</li>
        <li>กระจกแตกหรือไม่</li>
        <li>มีรอยกดหรือไม่</li>
        <li>มีคราบหรือความเสียหายที่เห็นชัดหรือไม่</li>
        </ul>
        <p>ควรถ่ายรูปหน้าจอทั้งตอนเปิดและตอนปิด หากมีตำหนิ</p>
        <p>รอยใช้งานเล็กน้อยกับจอแตกหรือ Panel มีปัญหาควรประเมินต่างกัน</p>
        <hr class="section-divider" />
        <h2>ฝาหลัง ขอบเครื่อง และสภาพตัวถัง</h2>
        <p>ควรถ่ายรูป MacBook ให้เห็น:</p>
        <ul>
        <li>ฝาหลังจอ</li>
        <li>ด้านหน้า</li>
        <li>Keyboard</li>
        <li>Palm Rest</li>
        <li>Trackpad</li>
        <li>ด้านซ้าย</li>
        <li>ด้านขวา</li>
        <li>ใต้เครื่อง</li>
        <li>มุมทั้งสี่</li>
        <li>จุดตกหรือบุบ</li>
        </ul>
        <p>จุดที่ควรแจ้งเป็นพิเศษ เช่น</p>
        <ul>
        <li>รอยตก</li>
        <li>ตัวเครื่องบุบ</li>
        <li>ฝาเบี้ยว</li>
        <li>บานพับผิดปกติ</li>
        <li>ขอบแตก</li>
        <li>น็อตหาย</li>
        <li>มีร่องรอยแกะเครื่อง</li>
        </ul>
        <p>การส่งรูปตำหนิตรง ๆ ช่วยให้ราคาประเมินเบื้องต้นใกล้กับสภาพจริงมากขึ้น</p>
        <hr class="section-divider" />
        <h2>Keyboard และ Trackpad ควรตรวจ</h2>
        <p>ก่อนขายควรลองใช้งาน Keyboard และ Trackpad</p>
        <p>ตรวจว่า:</p>
        <ul>
        <li>ปุ่มกดได้</li>
        <li>ไม่มีปุ่มค้าง</li>
        <li>ไม่มีปุ่มหลุด</li>
        <li>Backlight ทำงานถ้ารุ่นรองรับ</li>
        <li>Trackpad คลิกและลากได้</li>
        <li>Multi-touch ทำงานตามปกติ</li>
        <li>Cursor ไม่ขยับผิดปกติ</li>
        </ul>
        <p>หากมีบางปุ่มเสียหรือ Trackpad มีอาการควรแจ้งตามจริง</p>
        <hr class="section-divider" />
        <h2>Touch ID ต้องทดสอบไหม</h2>
        <p>ถ้ารุ่นมี Touch ID ควรตรวจว่าระบบมองเห็นและสามารถใช้งานได้ตามปกติ</p>
        <p>หาก Touch ID ใช้งานไม่ได้ ควรแจ้งประกอบการประเมิน</p>
        <p>ไม่ควรส่งลายนิ้วมือ รหัสผ่าน หรือข้อมูลยืนยันตัวตนให้ร้านเพื่อถามราคา</p>
        <p>ผู้ขายสามารถทดสอบฟังก์ชันด้วยตนเองก่อนส่งข้อมูลได้</p>
        <hr class="section-divider" />
        <h2>กล้อง ลำโพง และไมโครโฟนควรตรวจ</h2>
        <p>MacBook ถูกใช้งานทั้งประชุม เรียน และทำงาน จึงควรตรวจฟังก์ชันพื้นฐาน เช่น</p>
        <h3>Camera</h3>
        <p>เปิดกล้องและดูว่าภาพขึ้นหรือไม่</p>
        <h3>Speaker</h3>
        <p>ลองเปิดเสียงและฟังว่ามีอาการแตกหรือผิดปกติหรือไม่</p>
        <h3>Microphone</h3>
        <p>ลองบันทึกเสียงหรือใช้งานผ่านแอปที่เหมาะสม</p>
        <p>หากส่วนใดไม่ทำงานควรแจ้งตามสภาพจริง</p>
        <hr class="section-divider" />
        <h2>พอร์ตต่าง ๆ มีผลต่อสภาพเครื่อง</h2>
        <p>พอร์ตที่ควรตรวจขึ้นอยู่กับรุ่น เช่น</p>
        <ul>
        <li>USB-C</li>
        <li>Thunderbolt</li>
        <li>MagSafe</li>
        <li>HDMI</li>
        <li>SD Card</li>
        <li>Headphone</li>
        <li>USB-A ในรุ่นเก่า</li>
        </ul>
        <p>ควรสังเกตว่า:</p>
        <ul>
        <li>ชาร์จได้</li>
        <li>เสียบอุปกรณ์แล้วระบบมองเห็น</li>
        <li>พอร์ตไม่หลวมผิดปกติ</li>
        <li>ไม่มีร่องรอยความเสียหายชัดเจน</li>
        </ul>
        <p>ไม่จำเป็นต้องมีอุปกรณ์ครบทุกชนิดเพื่อถามราคาเบื้องต้น แต่ถ้าทราบว่าพอร์ตใดมีปัญหาควรแจ้ง</p>
