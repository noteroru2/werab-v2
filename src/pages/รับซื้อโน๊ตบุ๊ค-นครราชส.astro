---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คโคราช นครราชสีมา Gaming Notebook เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในโคราช นครราชสีมา ทั้ง Notebook Laptop และ Gaming Notebook ประเมินจากรุ่น CPU GPU RAM SSD แบตเตอรี่ จอ สภาพและอุปกรณ์ก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คโคราช นครราชสีมา เช็กสเปกและสภาพก่อนขาย",
    "url": "/รับซื้อโน๊ตบุ๊ค-นครราชส/"
  }
];

const faqs = [
  {
    "question": "Gaming Notebook ต้องส่งสเปกอะไรบ้าง?",
    "answer": "ควรส่ง Model, CPU, GPU, RAM, SSD, Battery และ Adapter เพราะ Gaming Series เดียวกันอาจมีหลาย Configuration"
  },
  {
    "question": "ไม่มี Adapter ยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งว่าไม่มี Adapter ตั้งแต่ต้น ไม่จำเป็นต้องซื้อใหม่ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "Notebook ดับเวลาเล่นเกมยังประเมินได้หรือไม่?",
    "answer": "สามารถส่งข้อมูลตามสภาพได้ ควรแจ้งอาการและประวัติซ่อม ไม่จำเป็นต้อง Stress Test หนักซ้ำเพื่อขอราคา"
  },
  {
    "question": "เครื่องเคยเพิ่ม RAM และ SSD ต้องแจ้งสเปกเดิมหรือปัจจุบัน?",
    "answer": "ควรแจ้ง Configuration ปัจจุบันและระบุสิ่งที่รวมขายจริง"
  },
  {
    "question": "ขายเครื่องโดยเก็บ SSD ไว้ได้ไหม?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ โดยราคาต้องประเมินจาก Hardware ที่ขายจริง"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คโคราช นครราชสีมา เช็กสเปกและสภาพก่อนขาย</h1>
        <p>Notebook ในโคราชที่ชื่อรุ่นใกล้กันอาจมีมูลค่าต่างกันจาก CPU, GPU, RAM, SSD และหน้าจอ โดยเฉพาะ Gaming Notebook ที่แต่ละ Configuration แตกต่างกันมาก</p>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค-นครราชส/</code> รักษา Historical Search Intent:</p>
        <p><strong>Notebook + Nakhon Ratchasima / Korat</strong></p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจาก:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Model + CPU + GPU ถ้ามี + RAM + SSD + Battery + รูป + Adapter</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คโคราช นครราชสีมา เช็กสเปกและสภาพก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่โคราชสามารถส่งสเปกและรูปเพื่อเช็กราคาก่อนได้</h2>
        <p>ก่อนตัดสินใจเดินทางหรือส่งมอบ สามารถส่งข้อมูลเครื่องมาก่อนได้</p>
        <p>ควรเตรียม:</p>
        <ul>
        <li>รุ่น</li>
        <li>CPU</li>
        <li>GPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>Battery</li>
        <li>รูป</li>
        <li>Adapter</li>
        <li>อาการ</li>
        </ul>
        <p>จากนั้นจึงค่อยพิจารณาขั้นตอนถัดไปตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ของนครราชสีมา</p>
        </div>
        <div class="comm-card">
          <h2>Gaming Notebook ควรเริ่มจาก CPU และ GPU</h2>
        <p>เครื่อง Gaming Series เดียวกันสามารถมีหลายสเปก</p>
        <p>ตัวอย่างข้อมูลที่ควรแจ้ง:</p>
        <p><strong>CPU: Ryzen 7 7840HS</strong></p>
        <p><strong>GPU: RTX 4060 Laptop GPU</strong></p>
        <p><strong>RAM: 16GB</strong></p>
        <p><strong>SSD: 1TB</strong></p>
        <p>ดีกว่าการแจ้งเพียงชื่อ Series</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอ Gaming มีรายละเอียดมากกว่าแค่ขนาด</h2>
        <p>หากทราบสามารถแจ้ง:</p>
        <ul>
        <li>Resolution</li>
        <li>Refresh Rate</li>
        <li>ขนาดจอ</li>
        </ul>
        <p>พร้อมสภาพ:</p>
        <ul>
        <li>จุด</li>
        <li>เส้น</li>
        <li>กระพริบ</li>
        <li>Dead Pixel</li>
        <li>รอย</li>
        <li>Panel แตก</li>
        </ul>
        <p>ไม่ควรคาดเดาสเปกจอหากยังไม่ได้ตรวจรุ่นเต็ม</p>
        </div>
        <div class="comm-card">
          <h2>Adapter ของ Gaming Notebook ควรแจ้งด้วย</h2>
        <p>Adapter อาจมีกำลังไฟต่างกันตาม Configuration</p>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>Adapter เดิม</li>
        <li>Adapter เทียบ</li>
        <li>ไม่มี Adapter</li>
        <li>สายมีตำหนิ</li>
        <li>ชาร์จไม่ปกติ</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้อ Adapter ใหม่ก่อนเช็กราคา</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องทำงานและ Mobile Workstation ประเมินต่างจาก Gaming บางกรณี</h2>
        <p>หากเป็นเครื่องสำหรับงาน:</p>
        <ul>
        <li>CAD</li>
        <li>3D</li>
        <li>Video</li>
        <li>Engineering</li>
        <li>Workstation</li>
        </ul>
        <p>ควรแจ้ง Configuration เต็มโดยเฉพาะ CPU, GPU, RAM และ Storage</p>
        <p>ไม่ควรใช้เพียงรูปลักษณ์หรือขนาดตัวเครื่องเป็นฐานประเมิน</p>
        </div>
        <div class="comm-card">
          <h2>RAM และ SSD ที่เพิ่มภายหลังควรแจ้งปัจจุบัน</h2>
        <p>หากเครื่องเดิมมี RAM 16GB แต่เพิ่มเป็น 32GB ให้แจ้ง 32GB</p>
        <p>ถ้า SSD เดิมถูกเปลี่ยน ให้แจ้ง Drive ที่รวมขายจริง</p>
        <p>หากจะเก็บ SSD ไว้ควรแจ้งก่อนประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery และระบบชาร์จต้องแยกอาการ</h2>
        <p>Battery หมดเร็วไม่เหมือนกับชาร์จไม่เข้า</p>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>Battery Health</li>
        <li>ใช้งานได้กี่นาทีหรือชั่วโมงโดยประมาณ</li>
        <li>ชาร์จเข้าไหม</li>
        <li>Port หลวมหรือไม่</li>
        <li>Adapter มีอาการหรือไม่</li>
        </ul>
        <p>ไม่ควรวินิจฉัยว่าเป็น Mainboard หรือ Battery หากยังไม่ได้ตรวจ</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องมีอาการตอนเล่นเกมควรแจ้ง</h2>
        <p>เช่น</p>
        <ul>
        <li>ดับ</li>
        <li>Restart</li>
        <li>GPU Error</li>
        <li>ภาพแตก</li>
        <li>จอฟ้า</li>
        <li>พัดลมดัง</li>
        <li>ร้อนผิดปกติ</li>
        </ul>
        <p>ไม่จำเป็นต้อง Stress Test หนักซ้ำเพื่อถามราคา หากเครื่องแสดงอาการไม่เสถียรอยู่แล้ว</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Notebook เคยซ่อมควรแจ้ง</h2>
        <p>เช่น</p>
        <ul>
        <li>ซ่อม Mainboard</li>
        <li>เปลี่ยน GPU Board ในรุ่นที่เกี่ยวข้อง</li>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Keyboard</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนพัดลม</li>
        <li>ซ่อมระบบชาร์จ</li>
        <li>เคยโดนน้ำ</li>
        </ul>
        <p>ช่วยให้ประเมินสภาพได้ตรงขึ้น</p>
        </div>
        <div class="comm-card">
          <h2>ข้อมูลใน SSD ควรจัดการก่อนส่งมอบจริง</h2>
        <p>เพื่อสอบถามราคาไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>ข้อมูลบริษัท</li>
        </ul>
        <p>หากต้องการเก็บ SSD สามารถแจ้งตั้งแต่ตอนประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>มี Notebook หลายเครื่องจากบริษัทในโคราช</h2>
        <p>ควรจัดเป็นกลุ่ม:</p>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>รุ่น</th>
                <th>CPU</th>
                <th>GPU</th>
                <th>RAM</th>
                <th>SSD</th>
                <th>จำนวน</th>
                <th>สภาพ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>รุ่น...</td>
                <td>i5-...</td>
                <td>Integrated</td>
                <td>8GB</td>
                <td>256GB</td>
                <td>5</td>
                <td>ปกติ</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>i7-...</td>
                <td>RTX...</td>
                <td>16GB</td>
                <td>512GB</td>
                <td>3</td>
                <td>มีรอย</td>
              </tr>
              <tr>
                <td>รุ่น...</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>ไม่ทราบ</td>
                <td>2</td>
                <td>ไม่ได้ทดสอบ</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>Configuration ที่ต่างกันควรแยกออกจากกัน</p>
        </div>
        <div class="comm-card">
          <h2>หน้าโคราชต่างจาก Notebook Money Hub</h2>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค/</code> รับผิดชอบ Broad Notebook Intent</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อโน๊ตบุ๊ค-นครราชส/</code></p>
        <p>รักษา:</p>
        <p><strong>Notebook + Nakhon Ratchasima / Korat</strong></p>
        <p>จึงไม่ควรเปลี่ยนเป็นหน้า Notebook ระดับประเทศอีกหน้า</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา Notebook ในโคราช</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Model</h3>
              <p>ชื่อรุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. ส่ง CPU และ GPU</h3>
              <p>โดยเฉพาะ Gaming Notebook</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่ง RAM และ SSD</h3>
              <p>Configuration ปัจจุบัน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้งหน้าจอ</h3>
              <p>ถ้าทราบ Resolution และ Refresh Rate</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery</h3>
              <p>Health หรืออาการ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง Adapter</h3>
              <p>เดิม เทียบ หรือไม่มี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. ส่งรูปและตำหนิ</h3>
              <p>รวมจอ บานพับและตัวเครื่อง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติซ่อม</h3>
              <p>หากทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. ประเมินก่อนตัดสินใจ</h3>
              <p>ไม่จำเป็นต้องซ่อมทุกกรณีก่อนขาย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยัน Configuration และสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคา Notebook ในโคราช</h2>
        <p>ส่ง:</p>
        <p><strong>Model + CPU + GPU + RAM + SSD + Battery + รูป + Adapter</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายโน๊ตบุ๊คมือสองในโคราช" subtitle="" />
    </div>
  </section>
</BaseLayout>
