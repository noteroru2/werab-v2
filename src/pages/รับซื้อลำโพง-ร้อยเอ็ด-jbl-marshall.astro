---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อลำโพงร้อยเอ็ด JBL Marshall Bluetooth มือสอง เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อลำโพงมือสองในร้อยเอ็ด รวมลำโพง Bluetooth และรุ่นพกพาหลายแบรนด์ ประเมินจากรุ่น Battery เสียง การเชื่อมต่อ สภาพ อุปกรณ์และประวัติซ่อม";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อลำโพง",
    "url": "/รับซื้อลำโพง/"
  },
  {
    "name": "รับซื้อลำโพงร้อยเอ็ด เช็กรุ่น Battery เสียง และการเชื่อมต่อก่อนขาย",
    "url": "/รับซื้อลำโพง-ร้อยเอ็ด-jbl-marshall/"
  }
];

const faqs = [
  {
    "question": "ลำโพง JBL หรือ Marshall มือสองส่งมาเช็กราคาได้ไหม?",
    "answer": "สามารถส่ง Brand รุ่น รูป Battery การเชื่อมต่อและสภาพเพื่อประเมินเบื้องต้นได้ การกล่าวถึงแบรนด์ไม่ได้หมายถึงความเกี่ยวข้องอย่างเป็นทางการกับผู้ผลิต"
  },
  {
    "question": "Battery เสื่อมยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการจริง เช่น หมดเร็ว เปิดได้เฉพาะเสียบไฟ หรือชาร์จไม่เข้า และไม่จำเป็นต้องเปลี่ยน Battery ก่อนเช็กราคา"
  },
  {
    "question": "Bluetooth เชื่อมไม่ได้ยังขายได้หรือไม่?",
    "answer": "สามารถส่งข้อมูลตามสภาพได้ ควรแจ้งอาการและฟังก์ชันอื่นที่ยังใช้งานได้โดยไม่ต้องวินิจฉัยสาเหตุเอง"
  },
  {
    "question": "ไม่มี Charger หรือ Adapter ยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งอุปกรณ์ที่มีจริง ไม่จำเป็นต้องซื้อใหม่มาเติมชุดก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "ลำโพงเคยโดนน้ำควรเปิดทดสอบไหม?",
    "answer": "หากมีอาการผิดปกติ ความร้อน กลิ่นไหม้ หรือสงสัยว่ามีของเหลวภายใน ไม่ควรเปิดหรือชาร์จซ้ำหลายครั้งเพียงเพื่อทดสอบก่อนขาย"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อลำโพงร้อยเอ็ด เช็กรุ่น Battery เสียง และการเชื่อมต่อก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อลำโพง-ร้อยเอ็ด-jbl-marshall/</code> รักษา Historical Search Intent:</p>
        <p><strong>Speaker + Roi Et</strong></p>
        <p>รวมถึงคำค้นเดิมที่เกี่ยวข้องกับลำโพงอย่าง JBL และ Marshall โดยการกล่าวถึงชื่อแบรนด์มีไว้เพื่อระบุประเภทสินค้าเท่านั้น ไม่ได้หมายความว่าเว็บไซต์เป็นตัวแทน ศูนย์บริการ หรือมีความเกี่ยวข้องอย่างเป็นทางการกับผู้ผลิต</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนประเมินสามารถส่ง:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Brand + Model + รูป + Battery + การเชื่อมต่อ + อาการเสียง + อุปกรณ์</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.webp" type="image/webp" />
              <source srcset="/images/hero-speaker.avif" type="image/avif" />
              <source srcset="/images/hero-speaker.webp" type="image/webp" />
              <img
                src="/images/hero-speaker.webp"
                alt="รับซื้อลำโพงร้อยเอ็ด เช็กรุ่น Battery เสียง และการเชื่อมต่อก่อนขาย"
                width="979"
                height="667"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>รุ่นลำโพงต้องระบุให้ชัด</h2>
        <p>ลำโพงหน้าตาใกล้กันอาจเป็นคนละ Generation</p>
        <p>ควรตรวจ:</p>
        <ul>
        <li>ชื่อรุ่น</li>
        <li>Model Number</li>
        <li>รุ่นย่อย</li>
        <li>ขนาด</li>
        <li>สี</li>
        </ul>
        <p>หากไม่แน่ใจ สามารถถ่ายรูป:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านหลัง</li>
        <li>ป้าย Model</li>
        <li>Port</li>
        <li>ปุ่มควบคุม</li>
        </ul>
        <p>เพื่อช่วยแยกรุ่น</p>
        </div>
        <div class="comm-card">
          <h2>ลำโพง Bluetooth ควรทดสอบการเชื่อมต่อ</h2>
        <p>หากอุปกรณ์ยังใช้งานได้ ควรแจ้งว่า:</p>
        <ul>
        <li>Bluetooth เชื่อมได้</li>
        <li>เชื่อมติดยาก</li>
        <li>หลุดเอง</li>
        <li>ไม่พบอุปกรณ์</li>
        <li>ปุ่ม Pairing มีปัญหา</li>
        <li>เคย Reset แล้วหรือไม่</li>
        </ul>
        <p>ไม่ควรสรุปว่าเป็นปัญหาจาก Board หรือชิป Bluetooth หากยังไม่ได้ตรวจ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery มีผลกับลำโพงพกพา</h2>
        <p>ควรแจ้งอาการจริง เช่น:</p>
        <ul>
        <li>ใช้งาน Battery ได้ปกติ</li>
        <li>Battery หมดเร็ว</li>
        <li>เปิดได้เฉพาะตอนเสียบไฟ</li>
        <li>ชาร์จไม่เข้า</li>
        <li>Battery บวม</li>
        <li>เคยเปลี่ยน Battery</li>
        </ul>
        <p>หากพบ Battery บวม ความร้อนผิดปกติ หรือกลิ่นไหม้ ไม่ควรชาร์จหรือใช้งานซ้ำโดยไม่จำเป็น</p>
        </div>
        <div class="comm-card">
          <h2>คุณภาพเสียงควรทดสอบในระดับเสียงที่เหมาะสม</h2>
        <p>สามารถแจ้งว่า:</p>
        <ul>
        <li>เสียงปกติ</li>
        <li>เสียงแตก</li>
        <li>เสียงเบากว่าปกติ</li>
        <li>Woofer มีอาการ</li>
        <li>Tweeter มีอาการ</li>
        <li>เสียงขาดบางช่วง</li>
        <li>เปิดดังแล้วดับ</li>
        </ul>
        <p>ไม่จำเป็นต้องเปิดระดับเสียงสูงสุดเป็นเวลานานเพียงเพื่อทดสอบก่อนขาย โดยเฉพาะเครื่องที่มีอาการอยู่แล้ว</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ปุ่ม Volume และระบบควบคุมควรตรวจ</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>Volume เพิ่มลดไม่ได้</li>
        <li>Power กดยาก</li>
        <li>Bluetooth Button เสีย</li>
        <li>ปุ่มค้าง</li>
        <li>Indicator ผิดปกติ</li>
        <li>App ควบคุมไม่ได้</li>
        <li>Firmware มีอาการที่สังเกตได้</li>
        </ul>
        <p>ควรบอกตามอาการโดยไม่ต้องวินิจฉัยอะไหล่ภายในเอง</p>
        </div>
        <div class="comm-card">
          <h2>Port ชาร์จและช่องต่อสัญญาณควรถ่ายให้เห็น</h2>
        <p>ลำโพงบางรุ่นอาจมี:</p>
        <ul>
        <li>USB-C</li>
        <li>Micro USB</li>
        <li>AUX</li>
        <li>USB</li>
        <li>ช่องไฟ AC</li>
        <li>Port อื่นตามรุ่น</li>
        </ul>
        <p>หาก Port หลวม ชาร์จติดบางครั้ง หรือมีรอยเสียหาย ควรแจ้งก่อนประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Charger หรือ Adapter มีผลตามรุ่น</h2>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>มี Charger เดิม</li>
        <li>มี Adapter เดิม</li>
        <li>ใช้ของเทียบ</li>
        <li>มีเฉพาะสาย</li>
        <li>ไม่มีอุปกรณ์ชาร์จ</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนรู้ว่ามูลค่าที่เพิ่มขึ้นคุ้มกับต้นทุนหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>สภาพภายนอกควรถ่ายหลายมุม</h2>
        <p>ลำโพงควรถ่าย:</p>
        <ul>
        <li>ตะแกรง</li>
        <li>ตัวถัง</li>
        <li>มุม</li>
        <li>ด้านหลัง</li>
        <li>ฐาน</li>
        <li>Port</li>
        <li>ป้าย Model</li>
        </ul>
        <p>และแจ้งหากมี:</p>
        <ul>
        <li>รอยตก</li>
        <li>ตะแกรงบุบ</li>
        <li>ตัวถังแตก</li>
        <li>ยางเสื่อม</li>
        <li>คราบ</li>
        <li>รอยน้ำ</li>
        <li>ชิ้นส่วนหลุด</li>
        </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ลำโพงเคยโดนน้ำหรือความชื้นควรแจ้ง</h2>
        <p>แม้บางรุ่นจะมีระดับการป้องกันน้ำ แต่ความเสียหายจริงต้องดูจากสภาพและเหตุการณ์ที่เกิดขึ้น</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>โดนน้ำหรือไม่</li>
        <li>หลังจากนั้นเปิดได้หรือไม่</li>
        <li>มีเสียงผิดปกติหรือไม่</li>
        <li>เคยแกะหรือซ่อมหรือไม่</li>
        </ul>
        <p>หากมีความชื้นหรือของเหลวเข้าเครื่อง ไม่ควรทดลองชาร์จซ้ำหลายครั้งหากมีอาการผิดปกติ</p>
        </div>
        <div class="comm-card">
          <h2>เคยซ่อมยังส่งมาประเมินได้</h2>
        <p>ควรแจ้งเท่าที่ทราบ เช่น:</p>
        <ul>
        <li>เปลี่ยน Battery</li>
        <li>ซ่อม Port</li>
        <li>ซ่อม Board</li>
        <li>เปลี่ยน Driver</li>
        <li>เปลี่ยนปุ่ม</li>
        <li>เคยเปิดเครื่อง</li>
        <li>เคยโดนน้ำ</li>
        </ul>
        <p>ประวัติซ่อมเป็นข้อมูลประกอบสภาพ ไม่ได้หมายความว่าลำโพงจะไม่มีมูลค่า</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Serial Number ไม่จำเป็นต้องโพสต์สาธารณะเพื่อถามราคา</h2>
        <p>สามารถเริ่มจาก:</p>
        <p><strong>Brand + Model + รูป + สภาพ</strong></p>
        <p>ก่อน</p>
        <p>หากภายหลังจำเป็นต้องใช้ Serial หรือข้อมูลระบุตัวสินค้าเพื่อการตรวจสอบ ควรส่งผ่านช่องทางที่เหมาะสม ไม่จำเป็นต้องโพสต์สาธารณะ</p>
        </div>
        <div class="comm-card">
          <h2>หน้าร้อยเอ็ดต่างจากหน้ารับซื้อลำโพงหลัก</h2>
        <p>หน้า <a href="/รับซื้อลำโพง/">รับซื้อลำโพง</a> เป็น Broad Speaker Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อลำโพง-ร้อยเอ็ด-jbl-marshall/</code></p>
        <p>รักษา:</p>
        <p><strong>Speaker + Roi Et</strong></p>
        <p>ชื่อ JBL และ Marshall ที่อยู่ใน Historical URL ไม่ได้ทำให้หน้านี้เป็นหน้าเฉพาะแบรนด์หรือแสดงความเกี่ยวข้องกับผู้ผลิต</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคาลำโพงในร้อยเอ็ด</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Brand และ Model</h3>
              <p>ใช้รุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. ส่งรูป</h3>
              <p>ทุกด้านและป้าย Model</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง Battery</h3>
              <p>สำหรับรุ่นพกพา</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง Bluetooth</h3>
              <p>เชื่อมต่อได้หรือมีอาการ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้งคุณภาพเสียง</h3>
              <p>ตามที่ทดสอบได้อย่างปลอดภัย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง Port</h3>
              <p>ชาร์จและช่องสัญญาณ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งอุปกรณ์</h3>
              <p>สาย Charger หรือ Adapter</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติ</h3>
              <p>ซ่อม ตก หรือโดนน้ำถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เช็กราคาเบื้องต้น</h3>
              <p>ก่อนซื้ออุปกรณ์หรือซ่อมเพิ่ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น ฟังก์ชันและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาลำโพงในร้อยเอ็ด</h2>
        <p>ส่ง:</p>
        <p><strong>Brand + Model + Battery + รูป + อาการ + อุปกรณ์</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายลำโพงในร้อยเอ็ด" subtitle="" />
    </div>
  </section>
</BaseLayout>
