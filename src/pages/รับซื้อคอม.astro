---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อคอมมือสอง Gaming PC และคอมประกอบ เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อคอมพิวเตอร์มือสอง Gaming PC และคอมประกอบ ประเมินจาก CPU การ์ดจอ RAM SSD เมนบอร์ด PSU และสภาพเครื่อง ส่งสเปกและรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อคอม', url: '/รับซื้อคอม/' }
];

const faqs = [
  {
    question: "รับซื้อคอมประกอบและ Gaming PC ไหม?",
    answer: "สามารถส่งคอมประกอบ Desktop PC และ Gaming PC มาประเมินได้ โดยควรแจ้ง CPU, GPU, RAM, SSD, Mainboard, PSU และสภาพเครื่อง เพื่อพิจารณามูลค่าจากชิ้นส่วนที่ติดตั้งจริง"
  },
  {
    question: "ขายคอมยกชุดหรือแยกชิ้นดีกว่ากัน?",
    answer: "ขึ้นอยู่กับสเปกและมูลค่าของชิ้นส่วนแต่ละตัว การขายยกชุดสะดวกกว่า ส่วนการแยกชิ้นอาจเหมาะกับบางเครื่องที่มีอุปกรณ์มูลค่าสูง ควรเปรียบเทียบมูลค่าทั้งสองแบบก่อนถอดเครื่อง"
  },
  {
    question: "คอมมีปัญหาหรือเปิดไม่ติดขายได้ไหม?",
    answer: "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งสเปกที่ทราบ อาการที่พบ และประวัติการซ่อมหากมี เครื่องที่เสียหนักอาจต้องประเมินจากมูลค่าชิ้นส่วนที่ยังเหลืออยู่"
  },
  {
    question: "ขายคอมโดยไม่รวม SSD หรือ HDD ได้ไหม?",
    answer: "สามารถแจ้งตั้งแต่ตอนประเมินว่าไม่รวม Storage ได้ โดยราคาจะพิจารณาจากอุปกรณ์ที่ขายจริง และช่วยให้เจ้าของสามารถเก็บ Drive ที่มีข้อมูลส่วนตัวไว้ได้"
  },
  {
    question: "ต้องส่งสเปกอะไรเพื่อเช็กราคาคอม?",
    answer: "อย่างน้อยควรมี CPU, GPU, RAM และ SSD หากทราบควรเพิ่ม Mainboard, PSU พร้อมรูปภายใน Case สภาพเครื่อง และรายการอุปกรณ์ที่ขายรวม"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อคอมมือสอง Gaming PC เช็กสเปกและราคาก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขายคอมพิวเตอร์มือสอง Gaming PC หรือคอมประกอบ แต่ไม่แน่ใจว่าเครื่องของคุณมีมูลค่าประมาณไหน?</p>
          <p>
            คอมพิวเตอร์ประกอบต่างจากอุปกรณ์ที่มีรุ่นสำเร็จเพียงรุ่นเดียว เพราะราคาของเครื่องขึ้นอยู่กับ <strong>CPU, การ์ดจอ, RAM, SSD, เมนบอร์ด, Power Supply และชิ้นส่วนอื่นภายในเครื่อง</strong>
          </p>
          <p>
            ดังนั้นก่อนประเมินควรแยกดูสเปกแต่ละชิ้น ไม่ควรดูเพียงว่าเครื่องซื้อมาเมื่อไรหรือเคยประกอบมาราคาเท่าไร
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>CPU + GPU + RAM + SSD + Mainboard + PSU + รูปเครื่อง + สภาพ</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-desktop-pc-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-desktop-pc-500.webp" type="image/webp" />
              <source srcset="/images/hero-desktop-pc.avif" type="image/avif" />
              <source srcset="/images/hero-desktop-pc.webp" type="image/webp" />
              <img
                src="/images/hero-desktop-pc.webp"
                alt="รับซื้อคอมมือสอง Gaming PC คอมประกอบ เช็กสเปกและราคาก่อนขาย"
                width="688"
                height="784"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: TYPES OF COMPUTERS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>คอมแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียดคอมพิวเตอร์หลายกลุ่มมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>Desktop PC</li>
              <li>Gaming PC</li>
              <li>คอมประกอบ</li>
              <li>คอมทำงาน</li>
              <li>Workstation</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Mini PC บางประเภท</li>
              <li>ชุดคอมพร้อมจอ</li>
              <li>เครื่องที่มีการอัปเกรดภายหลัง</li>
              <li>เครื่องมีตำหนิ</li>
              <li>เครื่องที่บางชิ้นมีปัญหา</li>
            </ul>
          </div>
        </div>
        <p>แต่ละเครื่องควรดูจากชิ้นส่วนจริงที่ติดตั้งอยู่</p>
        <p>คอมที่ใช้ Case เหมือนกันไม่ได้หมายความว่าจะมีมูลค่าใกล้เคียงกัน เพราะสเปกภายในอาจต่างกันมาก</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CPU & GPU -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายคอมต้องรู้สเปกอะไรบ้าง</h2>
          <p>ข้อมูลพื้นฐานที่ช่วยประเมินได้มากที่สุดคือ</p>
          <h3>CPU</h3>
          <p>เช่น</p>
          <ul>
            <li>Intel Core i3</li>
            <li>Core i5</li>
            <li>Core i7</li>
            <li>Core i9</li>
            <li>AMD Ryzen 3</li>
            <li>Ryzen 5</li>
            <li>Ryzen 7</li>
            <li>Ryzen 9</li>
          </ul>
          <p>ควรแจ้งรหัสรุ่นเต็ม เช่น</p>
          <p><code>Intel Core i5-12400F</code></p>
          <p>หรือ</p>
          <p><code>AMD Ryzen 5 5600</code></p>
          <p>ไม่ควรแจ้งเพียงว่า “i5” หรือ “Ryzen 5”</p>
          <p>เพราะ CPU ต่าง Generation มีมูลค่าและประสิทธิภาพต่างกันมาก</p>
        </div>

        <div class="comm-card">
          <h2>การ์ดจอเป็นหนึ่งในชิ้นส่วนสำคัญของ Gaming PC</h2>
          <p>สำหรับ Gaming PC การ์ดจออาจเป็นชิ้นส่วนที่มีมูลค่าสูงที่สุดตัวหนึ่งในเครื่อง</p>
          <p>ควรแจ้งรุ่นเต็ม เช่น</p>
          <ul>
            <li>GTX 1660 Super</li>
            <li>RTX 2060</li>
            <li>RTX 3060</li>
            <li>RTX 3070</li>
            <li>RTX 4060</li>
            <li>RTX 4070</li>
            <li>RX 6600</li>
            <li>RX 6700 XT</li>
            <li>RX 7600</li>
            <li>หรือรุ่นอื่น</li>
          </ul>
          <p>ถ้าทราบยี่ห้อและรุ่นย่อยของการ์ด เช่น ASUS, MSI, Gigabyte, GALAX หรือ Sapphire สามารถแจ้งเพิ่มได้</p>
          <p>การบอกเพียงว่า “RTX” หรือ “การ์ดจอ 8GB” ยังไม่เพียงพอสำหรับการประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: RAM, SSD, MAINBOARD & PSU -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM ต้องดูทั้งความจุและประเภท</h2>
          <p>ข้อมูลที่ควรแจ้ง เช่น</p>
          <ul>
            <li>RAM 8GB</li>
            <li>RAM 16GB</li>
            <li>RAM 32GB</li>
            <li>RAM 64GB</li>
            <li>DDR4</li>
            <li>DDR5</li>
            <li>Bus หรือความเร็วถ้าทราบ</li>
            <li>จำนวนแถว</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><code>DDR4 16GB (8GB × 2) 3200MHz</code></p>
          <p>หรือ</p>
          <p><code>DDR5 32GB (16GB × 2)</code></p>
          <p>การเพิ่ม RAM มีผลต่อความพร้อมใช้งานของเครื่อง แต่ราคามือสองที่เพิ่มขึ้นไม่ได้จำเป็นต้องเท่ากับราคาที่ซื้อ RAM ใหม่มา</p>

          <h2 style="margin-top: 1.5rem;">SSD และพื้นที่เก็บข้อมูล</h2>
          <p>ควรแจ้งทั้งประเภทและความจุ เช่น</p>
          <ul>
            <li>NVMe 500GB</li>
            <li>NVMe 1TB</li>
            <li>SATA SSD 512GB</li>
            <li>HDD 1TB</li>
            <li>SSD + HDD</li>
          </ul>
          <p>หากมี Storage หลายลูกควรแจ้งแยก</p>
          <p>สำหรับ SSD ที่ใช้งานมานาน หากมีข้อมูลสุขภาพของ Drive ก็สามารถส่งประกอบได้ แต่ไม่จำเป็นสำหรับการถามราคาเบื้องต้นทุกกรณี</p>
          <p>ก่อนส่งมอบเครื่องจริงควรสำรองและล้างข้อมูลส่วนตัวออกจาก Storage ที่ขายไปพร้อมเครื่อง</p>
        </div>

        <div class="comm-card">
          <h2>เมนบอร์ดมีผลต่อราคาไหม</h2>
          <p>มีผล โดยเฉพาะเครื่องประกอบ</p>
          <p>ควรแจ้งรุ่น Mainboard เช่น</p>
          <ul>
            <li>A520</li>
            <li>B450</li>
            <li>B550</li>
            <li>B650</li>
            <li>H610</li>
            <li>B660</li>
            <li>B760</li>
            <li>Z690</li>
            <li>Z790</li>
          </ul>
          <p>แต่ควรมีชื่อผู้ผลิตและรุ่นเต็มถ้าทราบ เช่น</p>
          <p><code>ASUS PRIME B660M-A D4</code></p>
          <p>หรือ</p>
          <p><code>MSI B550M PRO-VDH</code></p>
          <p>เพราะเมนบอร์ด Chipset เดียวกันยังมีระดับสินค้าและฟังก์ชันต่างกัน</p>

          <h2 style="margin-top: 1.5rem;">Power Supply ไม่ควรมองข้าม</h2>
          <p>PSU เป็นชิ้นส่วนที่มีผลต่อความสมบูรณ์และความน่าเชื่อถือของเครื่อง</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>Brand</li>
            <li>Model</li>
            <li>Watt</li>
            <li>80 PLUS Rating ถ้ามี</li>
            <li>อายุโดยประมาณ</li>
            <li>ประกันถ้ายังเหลือ</li>
          </ul>
          <p>ตัวอย่าง:</p>
          <p><code>750W 80+ Bronze</code></p>
          <p>ข้อมูลเพียง “750W” อาจยังไม่พอ เพราะ Power Supply ต่างแบรนด์และต่างระดับมีต้นทุนไม่เท่ากัน</p>
        </div>
      </div>

      <div class="comm-card" style="margin-top: 1.5rem;">
        <h2>Case และระบบระบายความร้อนมีผลแค่ไหน</h2>
        <p>Case และชุดระบายความร้อนมีผลต่อความครบของชุด แต่โดยทั่วไปควรประเมินหลังชิ้นส่วนหลักอย่าง CPU และ GPU</p>
        <p>ข้อมูลที่แจ้งเพิ่มได้ เช่น</p>
        <ul>
          <li>Case รุ่นอะไร</li>
          <li>พัดลมกี่ตัว</li>
          <li>Air Cooler</li>
          <li>Liquid Cooler</li>
          <li>ขนาดหม้อน้ำ</li>
          <li>RGB Controller</li>
          <li>Tempered Glass</li>
          <li>สภาพกระจกและตัว Case</li>
        </ul>
        <p>Case ที่มีรอยใช้งานกับ Case ที่กระจกแตกหรือโครงสร้างเสียหายควรแจ้งต่างกัน</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: MARKET DYNAMICS & WHOLE VS PARTS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>คอมซื้อมาแพง ทำไมราคามือสองไม่เท่าราคาที่เคยจ่าย</h2>
          <p>ราคาที่ซื้อใหม่ในอดีตเป็นข้อมูลหนึ่ง แต่ไม่ใช่ตัวกำหนดราคามือสองปัจจุบัน</p>
          <p>ต้องดูร่วมกับ:</p>
          <ul>
            <li>อายุของชิ้นส่วน</li>
            <li>รุ่นใหม่ที่ออกมาทดแทน</li>
            <li>ประสิทธิภาพ</li>
            <li>ราคาตลาดมือสอง</li>
            <li>ประกันที่เหลือ</li>
            <li>สภาพ</li>
            <li>ความต้องการของผู้ซื้อ</li>
            <li>ความเสี่ยงของอุปกรณ์</li>
          </ul>
          <p>ตัวอย่างเช่น การ์ดจอที่เคยมีราคาใหม่สูงในช่วงหนึ่ง อาจมีราคามือสองลดลงมากเมื่อมี Generation ใหม่หรือราคาตลาดเปลี่ยน</p>
          <p>ดังนั้นควรประเมินจากมูลค่าปัจจุบันของชิ้นส่วน ไม่ใช่รวมราคาซื้อเดิมทั้งหมด</p>
        </div>

        <div class="comm-card">
          <h2>ควรขายยกเครื่องหรือแยกชิ้น</h2>
          <p>ไม่มีคำตอบเดียวสำหรับทุกเครื่อง</p>
          <h3>ขายยกเครื่อง</h3>
          <p>ข้อดีคือ</p>
          <ul>
            <li>สะดวก</li>
            <li>จัดการครั้งเดียว</li>
            <li>ไม่ต้องถอดอุปกรณ์</li>
            <li>ไม่เหลือชิ้นส่วนที่ขายยาก</li>
          </ul>
          <h3>แยกชิ้น</h3>
          <p>บางเครื่องอาจมีชิ้นส่วนบางตัวที่มีตลาดแยกชัด เช่น</p>
          <ul>
            <li>GPU</li>
            <li>CPU</li>
            <li>RAM</li>
            <li>SSD</li>
          </ul>
          <p>แต่ต้องพิจารณาด้วยว่าชิ้นส่วนที่เหลือหลังจากแยกของมูลค่าสูงออกแล้วขายต่อได้ง่ายหรือไม่</p>
