---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อคอมมือสอง Gaming PC และคอมประกอบ เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อคอมพิวเตอร์มือสอง Gaming PC และคอมประกอบ ประเมินจาก CPU การ์ดจอ RAM SSD เมนบอร์ด PSU และสภาพเครื่อง ส่งสเปกและรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อคอม', url: '/รับซื้อคอม/' }
];

const faqs = [
  {
    question: "รับซื้อคอมประกอบและ Gaming PC ไหม?",
    answer: "สามารถส่งคอมประกอบ Desktop PC และ Gaming PC มาประเมินได้ โดยควรแจ้ง CPU, GPU, RAM, SSD, Mainboard, PSU และสภาพเครื่อง เพื่อพิจารณามูลค่าจากชิ้นส่วนที่ติดตั้งจริง"
  },
  {
    question: "ขายคอมยกชุดหรือแยกชิ้นดีกว่ากัน?",
    answer: "ขึ้นอยู่กับสเปกและมูลค่าของชิ้นส่วนแต่ละตัว การขายยกชุดสะดวกกว่า ส่วนการแยกชิ้นอาจเหมาะกับบางเครื่องที่มีอุปกรณ์มูลค่าสูง ควรเปรียบเทียบมูลค่าทั้งสองแบบก่อนถอดเครื่อง"
  },
  {
    question: "คอมมีปัญหาหรือเปิดไม่ติดขายได้ไหม?",
    answer: "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งสเปกที่ทราบ อาการที่พบ และประวัติการซ่อมหากมี เครื่องที่เสียหนักอาจต้องประเมินจากมูลค่าชิ้นส่วนที่ยังเหลืออยู่"
  },
  {
    question: "ขายคอมโดยไม่รวม SSD หรือ HDD ได้ไหม?",
    answer: "สามารถแจ้งตั้งแต่ตอนประเมินว่าไม่รวม Storage ได้ โดยราคาจะพิจารณาจากอุปกรณ์ที่ขายจริง และช่วยให้เจ้าของสามารถเก็บ Drive ที่มีข้อมูลส่วนตัวไว้ได้"
  },
  {
    question: "ต้องส่งสเปกอะไรเพื่อเช็กราคาคอม?",
    answer: "อย่างน้อยควรมี CPU, GPU, RAM และ SSD หากทราบควรเพิ่ม Mainboard, PSU พร้อมรูปภายใน Case สภาพเครื่อง และรายการอุปกรณ์ที่ขายรวม"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <!-- HERO SECTION -->
  <section class="section hero-hub">
    <div class="container">
      <div class="hero-content text-center">
        <h1>รับซื้อคอมมือสอง Gaming PC เช็กสเปกและราคาก่อนขาย</h1>
        <p class="hero-lead">ต้องการขายคอมพิวเตอร์มือสอง Gaming PC หรือคอมประกอบ แต่ไม่แน่ใจว่าเครื่องของคุณมีมูลค่าประมาณไหน?</p>
        <p class="hero-subtext">
          คอมพิวเตอร์ประกอบต่างจากอุปกรณ์ที่มีรุ่นสำเร็จเพียงรุ่นเดียว เพราะราคาของเครื่องขึ้นอยู่กับ <strong>CPU, การ์ดจอ, RAM, SSD, เมนบอร์ด, Power Supply และชิ้นส่วนอื่นภายในเครื่อง</strong>
        </p>
        <p class="hero-subtext">
          ดังนั้นก่อนประเมินควรแยกดูสเปกแต่ละชิ้น ไม่ควรดูเพียงว่าเครื่องซื้อมาเมื่อไรหรือเคยประกอบมาราคาเท่าไร
        </p>

        <div class="intake-hero-box card" style="max-width: 680px; margin: 1.5rem auto; text-align: left; background-color: #1e293b; border: 1px solid #334155;">
          <p style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem;">เริ่มจากส่ง:</p>
          <p style="font-size: 1.15rem; color: #fbbf24; font-weight: 700; margin-bottom: 1rem;">
            CPU + GPU + RAM + SSD + Mainboard + PSU + รูปเครื่อง + สภาพ
          </p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
              LINE: <strong>{getDisplayLine()}</strong>
            </a>
            <a href={getPhoneUrl()} class="btn btn-primary" style="background-color: #334155; color: #f8fafc;">
              โทร: <strong>{getDisplayPhone()}</strong>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: TYPES -->
  <section class="section section-muted">
    <div class="container" style="max-width: 900px;">
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>คอมแบบไหนส่งมาประเมินได้</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">สามารถส่งรายละเอียดคอมพิวเตอร์หลายกลุ่มมาสอบถามได้ เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1.5rem;">
          <li>Desktop PC</li>
          <li>Gaming PC</li>
          <li>คอมประกอบ</li>
          <li>คอมทำงาน</li>
          <li>Workstation</li>
          <li>Mini PC บางประเภท</li>
          <li>ชุดคอมพร้อมจอ</li>
          <li>เครื่องที่มีการอัปเกรดภายหลัง</li>
          <li>เครื่องมีตำหนิ</li>
          <li>เครื่องที่บางชิ้นมีปัญหา</li>
        </ul>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">แต่ละเครื่องควรดูจากชิ้นส่วนจริงที่ติดตั้งอยู่</p>
        <p style="color: #94a3b8;">
          คอมที่ใช้ Case เหมือนกันไม่ได้หมายความว่าจะมีมูลค่าใกล้เคียงกัน เพราะสเปกภายในอาจต่างกันมาก
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BASIC SPECS / CPU -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>ก่อนขายคอมต้องรู้สเปกอะไรบ้าง</h2>
        <p style="margin-bottom: 1rem; color: #cbd5e1;">ข้อมูลพื้นฐานที่ช่วยประเมินได้มากที่สุดคือ</p>

        <h3 style="font-size: 1.15rem; color: #38bdf8; margin-bottom: 0.5rem;">CPU</h3>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>Intel Core i3</li>
          <li>Core i5</li>
          <li>Core i7</li>
          <li>Core i9</li>
          <li>AMD Ryzen 3</li>
          <li>Ryzen 5</li>
          <li>Ryzen 7</li>
          <li>Ryzen 9</li>
        </ul>

        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ควรแจ้งรหัสรุ่นเต็ม เช่น</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">Intel Core i5-12400F</code></p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">หรือ</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">AMD Ryzen 5 5600</code></p>
        <p style="margin-bottom: 0.5rem; color: #f87171;">ไม่ควรแจ้งเพียงว่า “i5” หรือ “Ryzen 5”</p>
        <p style="color: #94a3b8;">เพราะ CPU ต่าง Generation มีมูลค่าและประสิทธิภาพต่างกันมาก</p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: GPU, RAM, SSD, MAINBOARD, PSU, CASE/COOLING -->
  <section class="section section-muted">
    <div class="container" style="max-width: 900px;">
      <!-- GPU -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>การ์ดจอเป็นหนึ่งในชิ้นส่วนสำคัญของ Gaming PC</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">สำหรับ Gaming PC การ์ดจออาจเป็นชิ้นส่วนที่มีมูลค่าสูงที่สุดตัวหนึ่งในเครื่อง</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ควรแจ้งรุ่นเต็ม เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>GTX 1660 Super</li>
          <li>RTX 2060</li>
          <li>RTX 3060</li>
          <li>RTX 3070</li>
          <li>RTX 4060</li>
          <li>RTX 4070</li>
          <li>RX 6600</li>
          <li>RX 6700 XT</li>
          <li>RX 7600</li>
          <li>หรือรุ่นอื่น</li>
        </ul>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">ถ้าทราบยี่ห้อและรุ่นย่อยของการ์ด เช่น ASUS, MSI, Gigabyte, GALAX หรือ Sapphire สามารถแจ้งเพิ่มได้</p>
        <p style="color: #f87171;">การบอกเพียงว่า “RTX” หรือ “การ์ดจอ 8GB” ยังไม่เพียงพอสำหรับการประเมิน</p>
      </div>

      <!-- RAM -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>RAM ต้องดูทั้งความจุและประเภท</h2>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ข้อมูลที่ควรแจ้ง เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>RAM 8GB</li>
          <li>RAM 16GB</li>
          <li>RAM 32GB</li>
          <li>RAM 64GB</li>
          <li>DDR4</li>
          <li>DDR5</li>
          <li>Bus หรือความเร็วถ้าทราบ</li>
          <li>จำนวนแถว</li>
        </ul>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ตัวอย่าง:</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">DDR4 16GB (8GB × 2) 3200MHz</code></p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">หรือ</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">DDR5 32GB (16GB × 2)</code></p>
        <p style="color: #94a3b8;">การเพิ่ม RAM มีผลต่อความพร้อมใช้งานของเครื่อง แต่ราคามือสองที่เพิ่มขึ้นไม่ได้จำเป็นต้องเท่ากับราคาที่ซื้อ RAM ใหม่มา</p>
      </div>

      <!-- SSD -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>SSD และพื้นที่เก็บข้อมูล</h2>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ควรแจ้งทั้งประเภทและความจุ เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>NVMe 500GB</li>
          <li>NVMe 1TB</li>
          <li>SATA SSD 512GB</li>
          <li>HDD 1TB</li>
          <li>SSD + HDD</li>
        </ul>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">หากมี Storage หลายลูกควรแจ้งแยก</p>
        <p style="margin-bottom: 0.75rem; color: #94a3b8;">สำหรับ SSD ที่ใช้งานมานาน หากมีข้อมูลสุขภาพของ Drive ก็สามารถส่งประกอบได้ แต่ไม่จำเป็นสำหรับการถามราคาเบื้องต้นทุกกรณี</p>
        <p style="color: #cbd5e1;">ก่อนส่งมอบเครื่องจริงควรสำรองและล้างข้อมูลส่วนตัวออกจาก Storage ที่ขายไปพร้อมเครื่อง</p>
      </div>

      <!-- MAINBOARD -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>เมนบอร์ดมีผลต่อราคาไหม</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">มีผล โดยเฉพาะเครื่องประกอบ</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ควรแจ้งรุ่น Mainboard เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>A520</li>
          <li>B450</li>
          <li>B550</li>
          <li>B650</li>
          <li>H610</li>
          <li>B660</li>
          <li>B760</li>
          <li>Z690</li>
          <li>Z790</li>
        </ul>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">แต่ควรมีชื่อผู้ผลิตและรุ่นเต็มถ้าทราบ เช่น</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">ASUS PRIME B660M-A D4</code></p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">หรือ</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">MSI B550M PRO-VDH</code></p>
        <p style="color: #94a3b8;">เพราะเมนบอร์ด Chipset เดียวกันยังมีระดับสินค้าและฟังก์ชันต่างกัน</p>
      </div>

      <!-- PSU -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>Power Supply ไม่ควรมองข้าม</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">PSU เป็นชิ้นส่วนที่มีผลต่อความสมบูรณ์และความน่าเชื่อถือของเครื่อง</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ควรแจ้ง:</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>Brand</li>
          <li>Model</li>
          <li>Watt</li>
          <li>80 PLUS Rating ถ้ามี</li>
          <li>อายุโดยประมาณ</li>
          <li>ประกันถ้ายังเหลือ</li>
        </ul>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ตัวอย่าง:</p>
        <p style="margin-bottom: 0.5rem;"><code style="background: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; color: #fbbf24;">750W 80+ Bronze</code></p>
        <p style="color: #94a3b8;">ข้อมูลเพียง “750W” อาจยังไม่พอ เพราะ Power Supply ต่างแบรนด์และต่างระดับมีต้นทุนไม่เท่ากัน</p>
      </div>

      <!-- CASE & COOLING -->
      <div class="card">
        <h2>Case และระบบระบายความร้อนมีผลแค่ไหน</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">Case และชุดระบายความร้อนมีผลต่อความครบของชุด แต่โดยทั่วไปควรประเมินหลังชิ้นส่วนหลักอย่าง CPU และ GPU</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ข้อมูลที่แจ้งเพิ่มได้ เช่น</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>Case รุ่นอะไร</li>
          <li>พัดลมกี่ตัว</li>
          <li>Air Cooler</li>
          <li>Liquid Cooler</li>
          <li>ขนาดหม้อน้ำ</li>
          <li>RGB Controller</li>
          <li>Tempered Glass</li>
          <li>สภาพกระจกและตัว Case</li>
        </ul>
        <p style="color: #94a3b8;">Case ที่มีรอยใช้งานกับ Case ที่กระจกแตกหรือโครงสร้างเสียหายควรแจ้งต่างกัน</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: MARKET DYNAMICS & WHOLE VS PARTS -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <!-- Depreciation / Valuation -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>คอมซื้อมาแพง ทำไมราคามือสองไม่เท่าราคาที่เคยจ่าย</h2>
        <p style="margin-bottom: 0.75rem; color: #cbd5e1;">ราคาที่ซื้อใหม่ในอดีตเป็นข้อมูลหนึ่ง แต่ไม่ใช่ตัวกำหนดราคามือสองปัจจุบัน</p>
        <p style="margin-bottom: 0.5rem; color: #cbd5e1;">ต้องดูร่วมกับ:</p>
        <ul class="custom-list" style="margin-bottom: 1rem;">
          <li>อายุของชิ้นส่วน</li>
          <li>รุ่นใหม่ที่ออกมาทดแทน</li>
          <li>ประสิทธิภาพ</li>
          <li>ราคาตลาดมือสอง</li>
          <li>ประกันที่เหลือ</li>
          <li>สภาพ</li>
          <li>ความต้องการของผู้ซื้อ</li>
          <li>ความเสี่ยงของอุปกรณ์</li>
        </ul>
        <p style="margin-bottom: 0.75rem; color: #94a3b8;">ตัวอย่างเช่น การ์ดจอที่เคยมีราคาใหม่สูงในช่วงหนึ่ง อาจมีราคามือสองลดลงมากเมื่อมี Generation ใหม่หรือราคาตลาดเปลี่ยน</p>
        <p style="color: #cbd5e1;">ดังนั้นควรประเมินจากมูลค่าปัจจุบันของชิ้นส่วน ไม่ใช่รวมราคาซื้อเดิมทั้งหมด</p>
      </div>

      <!-- Whole vs Parts -->
      <div class="card">
        <h2>ควรขายยกเครื่องหรือแยกชิ้น</h2>
        <p style="margin-bottom: 1rem; color: #cbd5e1;">ไม่มีคำตอบเดียวสำหรับทุกเครื่อง</p>

