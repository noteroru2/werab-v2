---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อคอมอุดรธานี Gaming PC คอมประกอบ เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อคอมมือสองในอุดรธานี Desktop Gaming PC และคอมประกอบ ประเมินจาก CPU การ์ดจอ RAM SSD เมนบอร์ด PSU สภาพและอุปกรณ์ ส่งสเปกกับรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อคอม",
    "url": "/รับซื้อคอม/"
  },
  {
    "name": "รับซื้อคอมอุดรธานี เช็กสเปก Gaming PC และคอมประกอบก่อนขาย",
    "url": "/รับซื้อคอม-อุดรธานี/"
  }
];

const faqs = [
  {
    "question": "Gaming PC ในอุดรธานีต้องส่งสเปกอะไร?",
    "answer": "ควรแจ้ง CPU, GPU, RAM, SSD, Mainboard และ PSU พร้อมรูป Case และภายในเครื่อง หากมี Monitor หรืออุปกรณ์อื่นรวมขายควรแยกข้อมูลให้ชัด"
  },
  {
    "question": "ขายคอมเฉพาะ Case ไม่รวมจอได้ไหม?",
    "answer": "สามารถแจ้งว่าขายเฉพาะ Case ได้ ราคาจะพิจารณาจาก Hardware ที่รวมขายจริง และไม่ควรรวมมูลค่าจอหรืออุปกรณ์ที่ไม่ได้ขาย"
  },
  {
    "question": "คอมเคยอัปเกรดต้องใช้สเปกเดิมหรือสเปกปัจจุบัน?",
    "answer": "ควรใช้สเปกปัจจุบัน เพราะ CPU, GPU, RAM, SSD หรือ PSU อาจถูกเปลี่ยนจากตอนซื้อใหม่แล้ว"
  },
  {
    "question": "คอมมีอาการดับหรือจอฟ้ายังประเมินได้ไหม?",
    "answer": "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งว่าอาการเกิดเมื่อใด มี Hardware ใดเปลี่ยนก่อนเกิดอาการหรือไม่ และไม่จำเป็นต้อง Stress Test หนักเพื่อขอราคาเบื้องต้น"
  },
  {
    "question": "มีคอมสำนักงานหลายเครื่องในอุดรธานีควรส่งอย่างไร?",
    "answer": "ควรจัดเป็นตารางแยกตาม CPU, RAM, Storage, จำนวนและสภาพ หากแต่ละกลุ่มมีสเปกต่างกันควรแยกออกจากกัน"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อคอมอุดรธานี เช็กสเปก Gaming PC และคอมประกอบก่อนขาย</h1>
        <p>มีคอมพิวเตอร์มือสองอยู่ในอุดรธานีและกำลังคิดว่าจะขาย แต่ไม่แน่ใจว่าเครื่องที่ประกอบไว้มีมูลค่าจากชิ้นส่วนใดบ้าง?</p>
        <p>คอมตั้งโต๊ะต่างจากอุปกรณ์ที่มี Configuration ตายตัว เพราะเครื่องเดียวกันอาจถูกเปลี่ยน CPU, การ์ดจอ, RAM, SSD, เมนบอร์ด หรือ Power Supply ภายหลังได้</p>
        <p>หน้าอุดรธานีนี้จึงใช้สำหรับ <strong>Desktop PC, Gaming PC, Workstation และคอมประกอบมือสองที่ผู้ขายอยู่ในพื้นที่อุดรธานี</strong></p>
        <p>ก่อนขายควรเริ่มจากส่ง:</p>
        <p><strong>CPU + GPU + RAM + SSD + Mainboard + PSU + รูปเครื่อง + สภาพ</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>อยู่ในอุดรธานีเริ่มเช็กราคาคอมจากสเปกก่อนได้</h2>
        <p>หากยังต้องการรู้ราคาเบื้องต้น ไม่จำเป็นต้องยก Case หรือชุดคอมออกเดินทางก่อน</p>
        <p>ผู้ขายที่อยู่ในพื้นที่ เช่น</p>
        <ul>
        <li>อำเภอเมืองอุดรธานี</li>
        <li>กุมภวาปี</li>
        <li>หนองหาน</li>
        <li>บ้านดุง</li>
        <li>เพ็ญ</li>
        <li>กุดจับ</li>
        <li>หนองวัวซอ</li>
        <li>และพื้นที่อื่นในจังหวัดอุดรธานี</li>
        </ul>
        <p>สามารถเริ่มจากส่งสเปกและรูปก่อน แล้วจึงพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามความเหมาะสม</p>
        <p>การกล่าวถึงพื้นที่ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกอำเภอ</p>
        <hr class="section-divider" />
        <h2>คอมแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียดเครื่องหลายประเภทมาสอบถามได้ เช่น</p>
        <ul>
        <li>Desktop PC</li>
        <li>Gaming PC</li>
        <li>คอมประกอบ</li>
        <li>Workstation</li>
        <li>คอมสำนักงาน</li>
        <li>คอมสำหรับงานกราฟิก</li>
        <li>เครื่องที่อัปเกรดภายหลัง</li>
        <li>เครื่องขายพร้อมจอ</li>
        <li>เครื่องขายเฉพาะ Case</li>
        <li>เครื่องที่มีรอย</li>
        <li>เครื่องมีอาการบางประเภท</li>
        </ul>
        <p>หากเครื่องเสียหนัก เปิดไม่ติด หรือเหลือเป็นชุดอะไหล่ Intent หลักจะต่างจากคอมใช้งานปกติ และควรพิจารณาผ่านข้อมูลของหน้า <strong>รับซื้อซากคอมพิวเตอร์</strong></p>
        <hr class="section-divider" />
        <h2>สิ่งแรกที่ควรส่งคือสเปกปัจจุบัน ไม่ใช่สเปกตอนซื้อ</h2>
        <p>คอมประกอบสามารถเปลี่ยนอุปกรณ์ได้หลายครั้ง</p>
        <p>เครื่องที่เดิมซื้อพร้อม RTX รุ่นหนึ่ง อาจถูกถอดการ์ดจอออกหรือเปลี่ยนเป็นรุ่นอื่นแล้ว</p>
        <p>ดังนั้นควรแจ้งสิ่งที่อยู่ในเครื่องปัจจุบัน เช่น</p>
        <p><strong>CPU:</strong> Ryzen 5 5600</p>
        <p><strong>GPU:</strong> RTX 3060 12GB</p>
        <p><strong>RAM:</strong> 16GB</p>
        <p><strong>SSD:</strong> 1TB</p>
        <p><strong>Mainboard:</strong> B550</p>
        <p><strong>PSU:</strong> 650W</p>
        <p>หากชิ้นส่วนใดไม่รวมขายควรระบุตั้งแต่ต้น</p>
        <hr class="section-divider" />
        <h2>CPU ควรแจ้งรุ่นเต็ม</h2>
        <p>ข้อมูลอย่าง “Core i5” หรือ “Ryzen 5” ยังไม่เพียงพอ</p>
        <p>ควรแจ้งรุ่น เช่น</p>
        <ul>
        <li>Intel Core i5-12400F</li>
        <li>Intel Core i5-14400F</li>
        <li>Intel Core i7-12700</li>
        <li>AMD Ryzen 5 5600</li>
        <li>AMD Ryzen 7 5700X</li>
        <li>หรือรุ่นอื่น</li>
        </ul>
        <p>Generation และรุ่นย่อยมีผลต่อ Platform และตลาดของเครื่อง</p>
        <hr class="section-divider" />
        <h2>Gaming PC ควรแจ้งการ์ดจอเป็นลำดับต้น ๆ</h2>
        <p>สำหรับ Gaming PC การ์ดจอมักเป็นหนึ่งในชิ้นส่วนที่มีผลต่อมูลค่าของชุดมาก</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>Brand</li>
        <li>GPU Model</li>
        <li>VRAM ถ้าทราบ</li>
        <li>สภาพ</li>
        <li>เคยซ่อมหรือไม่</li>
        <li>มีอาการหรือไม่</li>
        </ul>
        <p>ตัวอย่าง:</p>
        <p><strong>GALAX RTX 3060 12GB</strong></p>
        <p>ดีกว่าการแจ้งเพียงว่า:</p>
        <p><strong>RTX</strong></p>
        <p>หากขาย Case โดยไม่รวม GPU ต้องแจ้งอย่างชัดเจน</p>
        <hr class="section-divider" />
        <h2>RAM และ SSD ต้องดู Configuration ปัจจุบัน</h2>
        <p>ควรแจ้งทั้งความจุและจำนวนถ้าทราบ</p>
        <p>ตัวอย่าง:</p>
        <p><strong>RAM DDR4 8GB × 2 = 16GB</strong></p>
        <p>และ</p>
        <p><strong>NVMe SSD 1TB</strong></p>
        <p>หากมี Storage หลายลูกควรระบุว่ารวมขายทั้งหมดหรือไม่</p>
        <p>ข้อมูลใน SSD หรือ HDD เป็นเรื่องที่เจ้าของควรจัดการก่อนส่งมอบจริง</p>
        <p>ไม่ควรส่ง Password, PIN, Recovery Key หรือข้อมูลบัญชีเพื่อขอราคาประเมิน</p>
        <hr class="section-divider" />
        <h2>เมนบอร์ดมีผลต่อการประเมินอย่างไร</h2>
        <p>ควรแจ้ง Brand และ Model ถ้าทราบ เช่น</p>
        <ul>
        <li>ASUS</li>
        <li>MSI</li>
        <li>Gigabyte</li>
        <li>ASRock</li>
        <li>หรือแบรนด์อื่น</li>
        </ul>
        <p>พร้อม Model หรือ Chipset</p>
        <p>เมนบอร์ดช่วยบอก Platform, Expansion และความเข้ากันได้ของชิ้นส่วน</p>
        <p>ไม่ควรประเมินจาก CPU กับ GPU โดยละเลยว่าเครื่องใช้ Board รุ่นใด</p>
        <hr class="section-divider" />
        <h2>Power Supply ควรแจ้ง Brand และ Watt</h2>
        <p>PSU มีผลต่อความครบและความเสี่ยงของเครื่อง</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>Watt</li>
        <li>Rating ถ้ามี</li>
        <li>อายุโดยประมาณถ้าทราบ</li>
        <li>มีอาการหรือไม่</li>
        </ul>
        <p>หากมีเสียงผิดปกติ กลิ่นไหม้ หรือร่องรอยความเสียหาย ควรหยุดทดลองเปิดซ้ำโดยไม่จำเป็นและแจ้งอาการตามจริง</p>
        <hr class="section-divider" />
        <h2>Case และระบบระบายความร้อนมีผลไหม</h2>
        <p>มีผล แต่ไม่ควรใช้รูปลักษณ์ของ Case แทนสเปกภายใน</p>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>กระจกแตก</li>
        <li>ฝาข้างหาย</li>
        <li>USB หน้า Case เสีย</li>
        <li>พัดลมเสีย</li>
        <li>RGB Controller มีปัญหา</li>
        <li>Air Cooler</li>
        <li>AIO Liquid Cooler</li>
        <li>Fan เพิ่มเติม</li>
        </ul>
        <p>Gaming PC ที่ Case สวยแต่ Hardware เก่ากับเครื่อง Case ธรรมดาแต่ Hardware ใหม่ไม่ควรถูกประเมินด้วยวิธีเดียวกัน</p>
        <hr class="section-divider" />
        <h2>คอมขายพร้อมจอควรแยกข้อมูลจอ</h2>
        <p>ถ้าต้องการขายเป็นชุด ควรแจ้งจอแยก เช่น</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>ขนาด</li>
        <li>Resolution</li>
        <li>Refresh Rate</li>
        <li>สภาพ Panel</li>
        <li>Port</li>
        <li>Adapter หรือสายไฟ</li>
        </ul>
        <p>จากนั้นระบุให้ชัดว่า:</p>
        <p><strong>ขายพร้อมจอ</strong></p>
        <p>หรือ</p>
        <p><strong>ขายเฉพาะ Case</strong></p>
        <p>เพื่อไม่ให้สับสนกับมูลค่าของตัวเครื่อง</p>
        <hr class="section-divider" />
        <h2>Gaming PC มีอาการควรแจ้งอะไร</h2>
        <p>หากเครื่องยังเปิดได้แต่มีอาการ เช่น</p>
        <ul>
        <li>จอฟ้า</li>
        <li>Restart</li>
        <li>ดับเวลาเล่นเกม</li>
        <li>ภาพแตก</li>
        <li>GPU Error</li>
        <li>เครื่องร้อน</li>
        <li>พัดลมดัง</li>
        <li>Windows ค้าง</li>
        </ul>
        <p>ควรแจ้งตามอาการจริง</p>
        <p>ไม่จำเป็นต้อง Stress Test หนักเพื่อขอราคาเบื้องต้น โดยเฉพาะหากเครื่องมีอาการไม่เสถียรอยู่แล้ว</p>
        <hr class="section-divider" />
        <h2>คอมสำนักงานหลายเครื่องในอุดรธานีควรจัดข้อมูลอย่างไร</h2>
        <p>หากเป็นเครื่องจากสำนักงานหรือบริษัทหลายเครื่อง ควรจัดเป็นกลุ่ม</p>
        <table class="table table-bordered">
          <thead><tr><th>รุ่นหรือกลุ่ม</th><th>CPU</th><th>RAM</th><th>SSD</th><th>จำนวน</th><th>สภาพ</th></tr></thead>
          <tbody>
          <tr><td>ชุด A</td><td>i5-...</td><td>8GB</td><td>256GB</td><td>8</td><td>ใช้งานได้</td></tr>
          <tr><td>ชุด B</td><td>i5-...</td><td>16GB</td><td>512GB</td><td>4</td><td>มีตำหนิ</td></tr>
          <tr><td>ชุด C</td><td>ไม่ทราบ</td><td>ไม่ทราบ</td><td>ไม่มี</td><td>2</td><td>ยังไม่ได้ทดสอบ</td></tr>
          </tbody></table>
        <p>หาก Configuration ต่างกันควรแยก ไม่ควรใช้สเปกเครื่องเดียวแทนทั้งล็อต</p>
        <hr class="section-divider" />
        <h2>ควรขายทั้งเครื่องหรือถอดการ์ดจอขายแยก</h2>
        <p>ขึ้นอยู่กับมูลค่าและความสะดวก</p>
        <p>ก่อนถอดควรเปรียบเทียบ:</p>
        <ol>
        <li>มูลค่าทั้งชุด</li>
        <li>มูลค่าของ GPU แยก</li>
        <li>มูลค่าเครื่องที่เหลือหลังถอด GPU</li>
        <li>เวลาและความเสี่ยงในการแยกขาย</li>
        <li>อุปกรณ์ที่ต้องการเก็บไว้</li>
        </ol>
        <p>ไม่ควรรีบถอดชิ้นส่วนที่มีมูลค่าสูงก่อนรู้ว่าทั้งชุดมีมูลค่าเท่าไร</p>
        <hr class="section-divider" />
        <h2>เครื่องเคยซ่อมหรืออัปเกรดควรแจ้งไหม</h2>
        <p>ควรแจ้งหากทราบ เช่น</p>
        <ul>
        <li>เปลี่ยน PSU</li>
        <li>เปลี่ยน GPU</li>
        <li>เปลี่ยน Mainboard</li>
        <li>เพิ่ม RAM</li>
        <li>เปลี่ยน SSD</li>
        <li>เปลี่ยน Cooler</li>
        <li>ซ่อม Board</li>
        <li>ซ่อมจากไฟกระชากหรือของเหลว</li>
        </ul>
        <p>ประวัติซ่อมช่วยอธิบายสภาพ ไม่ได้หมายความว่าเครื่องจะขายไม่ได้เสมอไป</p>
        <hr class="section-divider" />
        <h2>หน้าอุดรธานีต่างจากหน้ารับซื้อคอมหลักอย่างไร</h2>
        <p>หน้า <a href="/รับซื้อคอม/"><code>/รับซื้อคอม/</code></a> เป็น Money Hub สำหรับ Desktop, Gaming PC และคอมประกอบโดยรวม</p>
        <p>ส่วน <code>/รับซื้อคอม-อุดรธานี/</code> รักษา Historical Search Intent สำหรับผู้ค้นหาที่ระบุพื้นที่อุดรธานี</p>
        <p>Intent ของหน้านี้คือ:</p>
