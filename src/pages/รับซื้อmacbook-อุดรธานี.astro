---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อ MacBook อุดรธานี Air Pro เช็ก Battery Cycle ก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ MacBook มือสองในอุดรธานี ทั้ง MacBook Air และ MacBook Pro ประเมินจากรุ่น ชิป RAM Storage Battery Cycle จอ Keyboard Port อุปกรณ์และประวัติซ่อม";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อ MacBook",
    "url": "/รับซื้อแมคบุ๊ค/"
  },
  {
    "name": "รับซื้อ MacBook อุดรธานี เช็กรุ่น ชิป Battery Cycle และสภาพก่อนขาย",
    "url": "/รับซื้อmacbook-อุดรธานี/"
  }
];

const faqs = [
  {
    "question": "MacBook Air หรือ Pro ต้องบอกปีหรือชิปไหม?",
    "answer": "ควรแจ้ง Generation ปีหรือชิปเท่าที่ตรวจได้ เพราะชื่อ Air หรือ Pro ครอบคลุมหลายรุ่นและหลาย Configuration"
  },
  {
    "question": "Battery Cycle สูงยังประเมินได้ไหม?",
    "answer": "ได้ Cycle Count เป็นข้อมูลประกอบ ควรดูร่วมกับ Maximum Capacity อาการใช้งานจริงและสภาพเครื่อง"
  },
  {
    "question": "MacBook เคยเปลี่ยน Battery หรือจอยังขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบและสภาพปัจจุบัน"
  },
  {
    "question": "ไม่มี Charger ยังเช็กราคาได้หรือไม่?",
    "answer": "ได้ ควรแจ้งว่าไม่มี Charger ตั้งแต่ต้น ไม่จำเป็นต้องซื้อใหม่ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่"
  },
  {
    "question": "ต้องส่ง Apple ID Password เพื่อถามราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Mac Login Password, PIN, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ MacBook อุดรธานี เช็กรุ่น ชิป Battery Cycle และสภาพก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อmacbook-อุดรธานี/</code> รักษา Historical Search Intent:</p>
        <p><strong>MacBook + Udon Thani</strong></p>
        <p>MacBook ชื่อ Air หรือ Pro เหมือนกันอาจเป็นคนละ Generation และ Configuration จึงควรแยกรุ่น ชิป RAM Storage และ Battery ให้ถูกก่อนประเมิน</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ข้อมูลเริ่มต้น:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>รุ่น + ชิป/CPU + RAM + Storage + Battery + Cycle + รูป + Charger</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-macbook-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-macbook-500.webp" type="image/webp" />
              <source srcset="/images/hero-macbook.avif" type="image/avif" />
              <source srcset="/images/hero-macbook.webp" type="image/webp" />
              <img
                src="/images/hero-macbook.webp"
                alt="รับซื้อ MacBook อุดรธานี เช็กรุ่น ชิป Battery Cycle และสภาพก่อนขาย"
                width="982"
                height="677"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ในอุดรธานีสามารถส่งข้อมูล MacBook มาเช็กราคาก่อนได้</h2>
        <p>สามารถเริ่มจากข้อมูลเครื่องและรูปก่อน โดยไม่จำเป็นต้องเดินทางพร้อม MacBook เพียงเพื่อถามราคาเบื้องต้น</p>
        <p>หลังทราบรุ่นและสภาพแล้วจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>หน้านี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ในจังหวัดอุดรธานี</p>
        </div>
        <div class="comm-card">
          <h2>MacBook Air และ Pro ต้องระบุ Generation</h2>
        <p>ควรแจ้งให้ชัดว่าเป็นรุ่นใด เช่น:</p>
        <ul>
        <li>Intel MacBook Air</li>
        <li>Intel MacBook Pro</li>
        <li>MacBook Air M1</li>
        <li>MacBook Air M2</li>
        <li>MacBook Pro M1</li>
        <li>MacBook Pro M2</li>
        <li>M3</li>
        <li>M4</li>
        <li>หรือ Generation อื่น</li>
        </ul>
        <p>ไม่ควรใช้เพียงคำว่า:</p>
        <p><strong>MacBook Air</strong></p>
        <p>หรือ:</p>
        <p><strong>MacBook Pro</strong></p>
        <p>เพราะมีหลายปีและหลาย Platform</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Apple Silicon กับ Intel ต้องแยกให้ถูก</h2>
        <p>MacBook Intel และ Apple Silicon มี Hardware Architecture ต่างกัน</p>
        <p>หากไม่แน่ใจสามารถดูจาก:</p>
        <p><strong>About This Mac</strong></p>
        <p>หรือส่งรูปข้อมูล Model</p>
        <p>ไม่จำเป็นต้องส่งรหัสผ่านของเครื่องเพื่อแจ้งข้อมูล Hardware</p>
        </div>
        <div class="comm-card">
          <h2>RAM และ Storage เป็นส่วนสำคัญของ Configuration</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>MacBook Air M2 / RAM 8GB / SSD 256GB</strong></p>
        <p>กับ:</p>
        <p><strong>MacBook Air M2 / RAM 16GB / SSD 512GB</strong></p>
        <p>เป็นคนละ Configuration</p>
        <p>ควรแจ้ง RAM และ Storage ตามเครื่องจริง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery Health และ Cycle Count ควรส่งถ้าตรวจได้</h2>
        <p>ข้อมูลที่ช่วยประกอบ เช่น:</p>
        <ul>
        <li>Maximum Capacity</li>
        <li>Cycle Count</li>
        <li>Battery Condition</li>
        <li>Service Recommended</li>
        <li>อาการใช้งานจริง</li>
        </ul>
        <p>Battery Cycle ไม่ใช่ข้อมูลเดียวที่ใช้ประเมิน แต่ช่วยอธิบายการใช้งานที่ผ่านมา</p>
        <p>หาก Battery บวม ไม่ควรกด Trackpad ฝาล่าง หรือใช้งานหนักโดยไม่จำเป็น</p>
        </div>
        <div class="comm-card">
          <h2>จอ MacBook ควรตรวจขณะเปิดเครื่อง</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>เส้น</li>
        <li>จุด</li>
        <li>สีผิดปกติ</li>
        <li>จอกระพริบ</li>
        <li>Backlight ผิดปกติ</li>
        <li>กระจกแตก</li>
        <li>Panel แตก</li>
        <li>รอยกด</li>
        </ul>
        <p>ควรถ่ายทั้งพื้นหลังสว่างและภาพใช้งานทั่วไปถ้าสามารถทำได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Keyboard และ Trackpad ควรทดสอบแยก</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ปุ่มบางปุ่มกดไม่ได้</li>
        <li>Keyboard พิมพ์ซ้ำ</li>
        <li>Trackpad กดไม่ได้</li>
        <li>Trackpad มีอาการจาก Battery บวม</li>
        <li>Touch Bar มีปัญหาในรุ่นที่มี</li>
        <li>Backlight Keyboard มีอาการ</li>
        </ul>
        <p>ไม่ควรสรุปสาเหตุเองหากยังไม่ได้ตรวจเครื่อง</p>
        </div>
        <div class="comm-card">
          <h2>USB-C, MagSafe และ Port อื่นควรแจ้ง</h2>
        <p>ตามรุ่นอาจมี:</p>
        <ul>
        <li>USB-C / Thunderbolt</li>
        <li>MagSafe</li>
        <li>HDMI</li>
        <li>SD Card</li>
        <li>Headphone</li>
        </ul>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ชาร์จไม่เข้า</li>
        <li>Port หลวม</li>
        <li>Port ใช้งานไม่ได้</li>
        <li>ต่อจอนอกไม่ได้</li>
        <li>MagSafe มีอาการ</li>
        </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Charger ต้องแจ้งตามที่มีจริง</h2>
        <p>ควรระบุว่า:</p>
        <ul>
        <li>Charger เดิม</li>
        <li>Charger เทียบ</li>
        <li>มีเฉพาะหัว</li>
        <li>มีเฉพาะสาย</li>
        <li>ไม่มี Charger</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้อ Charger ใหม่ก่อนเช็กราคา</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเคยซ่อมหรือเปลี่ยนอะไหล่ควรแจ้ง</h2>
        <p>เช่น:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยน Keyboard</li>
        <li>เปลี่ยน Top Case</li>
        <li>ซ่อม Logic Board</li>
        <li>ซ่อม Port</li>
        <li>เคยโดนน้ำ</li>
        <li>เคยตก</li>
        </ul>
        <p>ประวัติซ่อมเป็นข้อมูลประกอบ ไม่ได้หมายความว่า MacBook ที่เคยซ่อมจะไม่มีมูลค่า</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Find My และบัญชี Apple ต้องจัดการโดยเจ้าของ</h2>
        <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชีและสถานะ Activation ของเครื่องของตนเองได้</p>
        <p>แต่ในการสอบถามราคาไม่ต้องส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>Mac Login Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>ข้อมูลเหล่านี้ไม่จำเป็นสำหรับการประเมิน Hardware เบื้องต้น</p>
        </div>
        <div class="comm-card">
          <h2>Serial Number ไม่จำเป็นต้องโพสต์สาธารณะ</h2>
        <p>สามารถเริ่มจาก:</p>
        <p><strong>รุ่น + ชิป + RAM + Storage + Battery + รูป</strong></p>
        <p>ก่อน</p>
        <p>หากภายหลังต้องใช้ Serial เพื่อยืนยันข้อมูลเครื่อง ควรส่งผ่านช่องทางที่เหมาะสม ไม่จำเป็นต้องโพสต์สาธารณะ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>MacBook เปิดไม่ติดยังประเมินได้ไหม</h2>
        <p>สามารถส่ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>ชิปหรือ CPU ถ้าทราบ</li>
        <li>RAM</li>
        <li>Storage</li>
        <li>Charger</li>
        <li>รูป</li>
        <li>อาการก่อนเสีย</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หากมี Battery บวม กลิ่นไหม้ ของเหลว หรือความร้อนผิดปกติ ไม่ควรทดลองเปิดหรือชาร์จซ้ำหลายครั้ง</p>
        </div>
        <div class="comm-card">
          <h2>หน้านี้ต่างจาก MacBook Money Hub อย่างไร</h2>
        <p>หน้า <a href="/รับซื้อแมคบุ๊ค/">รับซื้อ MacBook</a> เป็น Broad MacBook Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อmacbook-อุดรธานี/</code></p>
        <p>รักษา:</p>
        <p><strong>MacBook + Udon Thani</strong></p>
        <p>จึงไม่ควรขยายไปเป็นหน้า Apple ทุกประเภท หรือแข่งขันกับ Parent สำหรับ Broad MacBook Intent</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา MacBook ในอุดรธานี</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งรุ่น</h3>
              <p>Air หรือ Pro พร้อม Generation</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้งชิปหรือ CPU</h3>
              <p>Intel หรือ Apple Silicon</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง RAM</h3>
              <p>ตาม Configuration จริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง Storage</h3>
              <p>ตามเครื่องจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery</h3>
              <p>Health และ Cycle ถ้าตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. ส่งรูป</h3>
              <p>จอ ฝา Keyboard Trackpad และด้านล่าง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้ง Charger</h3>
              <p>เดิม เทียบ หรือไม่มี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งอาการ</h3>
              <p>Port จอ Keyboard Battery หรือส่วนอื่น</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. แจ้งประวัติซ่อม</h3>
              <p>ถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น Configuration สถานะบัญชีและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคา MacBook ในอุดรธานี</h2>
        <p>ส่ง:</p>
