---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อ iPad ยโสธร Pro Air mini มือสอง เช็ก Battery และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPad มือสองในยโสธร ทั้ง iPad Pro Air mini และรุ่นมาตรฐาน ประเมินจากรุ่น ชิป ความจุ Wi-Fi Cellular Battery จอ Touch อุปกรณ์และประวัติซ่อม";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอแพด",
    "url": "/รับซื้อไอแพด/"
  },
  {
    "name": "รับซื้อ iPad ยโสธร เช็กรุ่น ความจุ Battery จอ และอุปกรณ์ก่อนขาย",
    "url": "/รับซื้อไอแพด-ยโสธร-ipad/"
  }
];

const faqs = [
  {
    question: "iPad Air, mini และ Pro ต้องแจ้ง Generation หรือไม่?",
    answer: "ควรแจ้ง Generation ชิปหรือ Model เท่าที่ตรวจได้ เพราะชื่อรุ่นแต่ละตระกูลมีหลาย Generation และ Configuration"
  },
  {
    question: "Battery เสื่อมต้องเปลี่ยนก่อนขายไหม?",
    answer: "ไม่จำเป็นทุกกรณี สามารถแจ้งข้อมูล Battery หรืออาการใช้งานแล้วเช็กราคาตามสภาพก่อนตัดสินใจเปลี่ยน"
  },
  {
    question: "Cellular iPad ต้องส่ง IMEI เพื่อถามราคาไหม?",
    answer: "ไม่จำเป็นสำหรับการสอบถามราคาเบื้องต้น เริ่มจากรุ่น ความจุ Wi-Fi/Cellular รูปและสภาพก่อน และไม่ควรโพสต์ IMEI สาธารณะโดยไม่จำเป็น"
  },
  {
    question: "Apple Pencil หรือ Keyboard มีผลไหม?",
    answer: "ควรแจ้งรุ่นและอุปกรณ์ที่รวมขายจริง เพราะ Pencil และ Keyboard มีหลาย Generation และรองรับ iPad ต่างรุ่นกัน"
  },
  {
    question: "ต้องส่ง Apple ID Password หรือ OTP เพื่อเช็กราคาไหม?",
    answer: "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Passcode, PIN, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ iPad ยโสธร เช็กรุ่น ความจุ Battery จอ และอุปกรณ์ก่อนขาย</h1>
          <p class="hero-lead-text">หน้า <code>/รับซื้อไอแพด-ยโสธร-ipad/</code> รักษา Historical Search Intent:</p>
          <p style="font-size: 1.05rem; font-weight: 800; color: #c2410c; margin-bottom: 0.75rem;">
            <strong>iPad + Yasothon</strong>
          </p>
          <p>
            iPad รุ่นชื่อคล้ายกันอาจเป็นคนละ Generation ชิป ความจุ หรือระบบเชื่อมต่อ จึงควรระบุรุ่นให้ชัดก่อนประเมิน
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>รุ่น + Generation/ชิปถ้าทราบ + ความจุ + Wi-Fi/Cellular + Battery + รูป + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-tablet-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-tablet-500.webp" type="image/webp" />
              <source srcset="/images/hero-tablet.avif" type="image/avif" />
              <source srcset="/images/hero-tablet.webp" type="image/webp" />
              <img
                src="/images/hero-tablet.webp"
                alt="รับซื้อ iPad ยโสธร เช็กรุ่น ความจุ Battery จอ และอุปกรณ์ก่อนขาย"
                width="1026"
                height="543"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: YASOTHON SERVICE INTAKE -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>อยู่ยโสธรสามารถส่งข้อมูล iPad มาเช็กราคาก่อนได้</h2>
        <p>สามารถเริ่มจากข้อมูลและรูปเครื่องก่อน โดยไม่จำเป็นต้องเดินทางพร้อมอุปกรณ์เพียงเพื่อถามราคาเบื้องต้น</p>
        <p>ข้อมูลที่ช่วยประเมิน ได้แก่:</p>
        <div class="grid-2" style="margin-bottom: 1.25rem;">
          <div>
            <ul>
              <li>รุ่น</li>
              <li>Generation</li>
              <li>ชิป</li>
              <li>ความจุ</li>
              <li>Wi-Fi หรือ Cellular</li>
              <li>Battery</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>จอ</li>
              <li>Touch</li>
              <li>กล้อง</li>
              <li>Port</li>
              <li>อุปกรณ์</li>
              <li>ประวัติซ่อม</li>
            </ul>
          </div>
        </div>
        <p>หลังจากนั้นจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>หน้า Local นี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ของจังหวัดยโสธร</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: PRODUCT FAMILIES & CHIPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>iPad, iPad Air, iPad mini และ iPad Pro ต้องแยกรุ่นให้ชัด</h2>
          <p>ไม่ควรแจ้งเพียงว่า:</p>
          <p style="font-size: 1.1rem; font-weight: 800; color: var(--navy-950); margin: 0.5rem 0;">
            <strong>iPad</strong>
          </p>
          <p>เพราะมีหลายตระกูล เช่น:</p>
          <ul>
            <li>iPad รุ่นมาตรฐาน</li>
            <li>iPad Air</li>
            <li>iPad mini</li>
            <li>iPad Pro</li>
          </ul>
          <p>และแต่ละตระกูลมีหลาย Generation</p>
          <p>ควรดู Model หรือข้อมูลจาก Settings เท่าที่ทำได้</p>
        </div>

        <div class="comm-card">
          <h2>ชิปและ Generation ช่วยแยกเครื่องที่ชื่อใกล้กัน</h2>
          <p>iPad บางรุ่นใช้:</p>
          <ul>
            <li>A-Series</li>
            <li>M-Series</li>
            <li>ชิปอื่นตาม Generation</li>
          </ul>
          <p>การรู้ชิปช่วยแยกช่วงรุ่นได้ แต่ไม่ควรใช้ชิปเพียงอย่างเดียว</p>
          <p>ควรดูร่วมกับ:</p>
          <ul>
            <li>ขนาดจอ</li>
            <li>Generation</li>
            <li>ความจุ</li>
            <li>Wi-Fi / Cellular</li>
            <li>Model Number</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: STORAGE & WI-FI VS CELLULAR -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ความจุควรตรวจจากเครื่องจริง</h2>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>64GB</li>
            <li>128GB</li>
            <li>256GB</li>
            <li>512GB</li>
            <li>1TB</li>
            <li>ความจุอื่นตามรุ่น</li>
          </ul>
          <p>ไม่ควรคาดเดาจากกล่องเก่าหรือความจำถ้าเครื่องยังสามารถตรวจข้อมูลได้</p>
          <p>ความจุเป็นส่วนหนึ่งของ Configuration ที่มีผลต่อการแยกรุ่นและมูลค่า</p>
        </div>

        <div class="comm-card">
          <h2>Wi-Fi กับ Cellular ต้องระบุให้ถูก</h2>
          <p>iPad รุ่นเดียวกันอาจมี:</p>
          <p style="font-size: 1.05rem; font-weight: 700; color: var(--navy-950); margin: 0.35rem 0;">
            <strong>Wi-Fi</strong>
          </p>
          <p>หรือ:</p>
          <p style="font-size: 1.05rem; font-weight: 700; color: var(--navy-950); margin: 0.35rem 0;">
            <strong>Wi-Fi + Cellular</strong>
          </p>
          <p>หากเป็น Cellular ควรแจ้งตามที่ตรวจได้</p>
          <p>ไม่จำเป็นต้องเผยแพร่ IMEI ต่อสาธารณะเพื่อถามราคาเบื้องต้น</p>
          <p>เริ่มจากรุ่น ความจุ ระบบเชื่อมต่อ รูปและสภาพก่อนก็ได้</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: BATTERY & SCREEN -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery ของ iPad ควรดูทั้งข้อมูลและอาการใช้งาน</h2>
          <p>iPad บางรุ่นหรือบางเวอร์ชันอาจไม่แสดงข้อมูล Battery ในรูปแบบเดียวกับ iPhone</p>
          <p>สามารถแจ้งจาก:</p>
          <ul>
            <li>ค่า Battery ที่ระบบแสดง หากมี</li>
            <li>ระยะเวลาการใช้งานจริง</li>
            <li>หมดเร็ว</li>
            <li>ดับเอง</li>
            <li>ชาร์จช้า</li>
            <li>ชาร์จไม่เข้า</li>
            <li>เคยเปลี่ยน Battery</li>
            <li>Battery บวม</li>
          </ul>
          <p>หาก Battery บวม ไม่ควรกดหน้าจอหรือฝาหลังบริเวณที่นูน และไม่ควรชาร์จซ้ำโดยไม่จำเป็น</p>
        </div>

        <div class="comm-card">
          <h2>จอ iPad ควรตรวจทั้งภาพและ Touch</h2>
          <p>ควรแจ้งหากมี:</p>
          <ul>
            <li>กระจกแตก</li>
            <li>Panel แตก</li>
            <li>เส้น</li>
            <li>จุดดำ</li>
            <li>สีผิดปกติ</li>
            <li>Touch ไม่ครบ</li>
            <li>Touch กระโดด</li>
            <li>จอกระพริบ</li>
            <li>Backlight มีอาการ</li>
          </ul>
          <p>ควรถ่ายจอขณะเปิดใช้งานถ้าเครื่องยังใช้งานได้</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: BODY, PENCIL, KEYBOARD & PORTS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องงอหรือฝาหลังผิดรูปควรแจ้ง</h2>
          <p>iPad มีพื้นที่ตัวเครื่องขนาดใหญ่ จึงควรถ่าย:</p>
          <ul>
            <li>ด้านหน้า</li>
            <li>ด้านหลัง</li>
            <li>ขอบด้านบน</li>
            <li>ขอบด้านล่าง</li>
            <li>ด้านข้าง</li>
            <li>Port</li>
          </ul>
          <p>หากตัวเครื่อง:</p>
          <ul>
            <li>งอ</li>
            <li>มีรอยกระแทก</li>
            <li>ฝาหลังบุบ</li>
            <li>จอเผยอ</li>
            <li>ขอบแยก</li>
          </ul>
          <p>ควรแจ้งตามสภาพ</p>
          <p>หากจอเผยอเพราะสงสัย Battery บวม ไม่ควรกดจอกลับเข้าที่</p>

          <h2 style="margin-top: 1.5rem;">Apple Pencil ต้องระบุ Generation หรือรุ่นที่ใช้ร่วมกัน</h2>
          <p>หากมี Apple Pencil รวมขาย ควรแจ้งว่าเป็นรุ่นใดเท่าที่ทราบ</p>
          <p>iPad แต่ละ Generation รองรับ Pencil ต่างกัน</p>
          <p>จึงไม่ควรเขียนเพียงว่า:</p>
          <p style="font-size: 1.05rem; font-weight: 700; color: var(--navy-950); margin: 0.35rem 0;">
            <strong>มีปากกา</strong>
          </p>
          <p>หากไม่แน่ใจสามารถส่งรูป Pencil และ Model ของ iPad ประกอบ</p>
        </div>

        <div class="comm-card">
          <h2>Keyboard และอุปกรณ์เสริมควรแยกให้ชัด</h2>
          <p>หากมี:</p>
          <ul>
            <li>Magic Keyboard</li>
            <li>Smart Keyboard</li>
            <li>Keyboard Case</li>
            <li>Apple Pencil</li>
            <li>Charger</li>
            <li>Cable</li>
            <li>Case</li>
            <li>กล่อง</li>
          </ul>
          <p>ควรแจ้งว่าอะไร <strong>รวมขายจริง</strong></p>
          <p>อุปกรณ์บางรายการอาจเป็นคนละ Generation กับตัวเครื่อง จึงควรแยกข้อมูล</p>

          <h2 style="margin-top: 1.5rem;">Port ชาร์จและระบบเชื่อมต่อควรทดสอบ</h2>
          <p>ตามรุ่นอาจใช้:</p>
          <ul>
            <li>Lightning</li>
            <li>USB-C</li>
            <li>ระบบอื่นตาม Generation</li>
          </ul>
          <p>ควรแจ้งหาก:</p>
          <ul>
            <li>ชาร์จไม่เข้า</li>
            <li>ต้องขยับสาย</li>
            <li>Port หลวม</li>
            <li>ต่อคอมไม่ได้</li>
            <li>อุปกรณ์เสริมไม่เชื่อมต่อ</li>
            <li>USB-C มีอาการ</li>
          </ul>
          <p>ไม่จำเป็นต้องซ่อมก่อนเช็กราคาทุกกรณี</p>

          <h2 style="margin-top: 1.5rem;">กล้อง Speaker และ Microphone ก็ควรแจ้งเมื่อมีปัญหา</h2>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>กล้องไม่ขึ้น</li>
            <li>Focus มีอาการ</li>
            <li>Speaker แตก</li>
            <li>เสียงข้างหนึ่งมีปัญหา</li>
            <li>Microphone เบา</li>
            <li>ปุ่ม Volume ใช้ไม่ได้</li>
            <li>Power Button มีอาการ</li>
          </ul>
          <p>ควรแจ้งตามสิ่งที่พบโดยไม่จำเป็นต้องวินิจฉัยอะไหล่ภายใน</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: REPAIRS, APPLE ID, ACCESSORIES & DEAD IPADS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเคยซ่อมหรือเปลี่ยนอะไหล่ควรแจ้ง</h2>
          <p>เช่น:</p>
          <ul>
            <li>เปลี่ยนจอ</li>
            <li>เปลี่ยน Battery</li>
            <li>ซ่อม Port</li>
            <li>ซ่อม Board</li>
            <li>เปลี่ยนกล้อง</li>
            <li>เคยแกะเครื่อง</li>
            <li>เคยตก</li>
            <li>เคยโดนน้ำ</li>
          </ul>
          <p>ประวัติซ่อมเป็นข้อมูลประกอบสภาพ ไม่ได้หมายความว่าเครื่องจะไม่มีมูลค่า</p>

          <h2 style="margin-top: 1.5rem;">Apple ID และ Activation ต้องจัดการโดยเจ้าของ</h2>
          <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชี Apple และสถานะ Find My ของเครื่องของตนเองได้</p>
          <p>แต่เพื่อสอบถามราคาไม่ต้องส่ง:</p>
          <ul>
            <li>Apple ID Password</li>
            <li>Passcode</li>
            <li>PIN</li>
            <li>OTP</li>
            <li>Recovery Key</li>
            <li>Email Password</li>
          </ul>
          <p>ข้อมูลเหล่านี้ไม่ควรถูกส่งเพื่อขอราคาประเมิน</p>
        </div>

        <div class="comm-card">
          <h2>iCloud หรือบัญชีที่ติดเครื่องไม่ใช่เรื่องที่ควรแก้ด้วยการขอรหัสจากผู้อื่น</h2>
          <p>หากเครื่องยังผูกกับบัญชี เจ้าของบัญชีควรเป็นผู้จัดการสถานะด้วยตนเอง</p>
          <p>ไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่นเพื่อข้ามการยืนยันบัญชี</p>
          <p>การประเมิน Hardware เบื้องต้นไม่จำเป็นต้องได้รับข้อมูลดังกล่าว</p>

          <h2 style="margin-top: 1.5rem;">ไม่มีกล่องหรือ Charger ยังเช็กราคาได้</h2>
          <p>สามารถแจ้งตามจริงว่า:</p>
          <ul>
            <li>มีกล่อง</li>
            <li>มี Charger</li>
            <li>มีสาย</li>
            <li>มี Pencil</li>
            <li>มี Keyboard</li>
            <li>ไม่มีอุปกรณ์บางรายการ</li>
          </ul>
          <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่</p>

          <h2 style="margin-top: 1.5rem;">iPad เปิดไม่ติดยังส่งข้อมูลได้</h2>
          <p>สามารถส่ง:</p>
          <ul>
            <li>รุ่น</li>
            <li>Generation</li>
            <li>ความจุ</li>
            <li>Wi-Fi / Cellular</li>
            <li>สี</li>
            <li>รูป</li>
            <li>Charger</li>
            <li>อาการก่อนเสีย</li>
            <li>ประวัติซ่อม</li>
          </ul>
          <p>หาก Battery บวม เครื่องร้อนผิดปกติ มีกลิ่นไหม้ หรือมีร่องรอยของเหลว ไม่ควรเปิดหรือชาร์จซ้ำหลายครั้งเพียงเพื่อทดสอบก่อนขาย</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: YASOTHON VS IPAD HUB -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>หน้ายโสธรต่างจากหน้ารับซื้อ iPad หลัก</h2>
        <p>หน้า <a href="/รับซื้อไอแพด/">รับซื้อไอแพด</a> เป็น Broad iPad Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อไอแพด-ยโสธร-ipad/</code></p>
        <p>รักษา:</p>
        <p style="font-size: 1.1rem; font-weight: 800; color: var(--navy-950); margin: 0.5rem 0;">
          <strong>iPad + Yasothon</strong>
        </p>
        <p>ไม่ได้เป็นหน้า iPhone หรือ Smartphone และไม่ควรขยายไปแข่งขันกับ <code>/รับซื้อไอแพด/</code> สำหรับ Broad iPad Intent</p>
      </div>
    </div>
  </section>

  <!-- SECTION 8: 10-STEP PROCESS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา iPad ในยโสธร</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งตระกูล</h3>
              <p>iPad / Air / mini / Pro</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>2. แจ้ง Generation หรือชิป</h3>
              <p>เท่าที่ตรวจได้</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>3. แจ้งความจุ</h3>
              <p>ตามเครื่องจริง</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>4. แจ้งระบบเชื่อมต่อ</h3>
              <p>Wi-Fi หรือ Cellular</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery</h3>
              <p>ข้อมูลหรืออาการใช้งาน</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>6. ส่งรูป</h3>
              <p>จอ หลัง ขอบและตำหนิ</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>7. ตรวจ Touch และ Port</h3>
              <p>แจ้งอาการถ้ามี</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>8. แจ้งอุปกรณ์</h3>
              <p>Pencil Keyboard Charger และกล่อง</p>
            </div>
          </div>

          <div class="process-step-item">
            <div>
              <h3>9. แจ้งประวัติซ่อม</h3>
              <p>ถ้าทราบ</p>
            </div>
          </div>

          <div class="process-step-item" style="grid-column: 1 / -1;">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยัน Model Configuration บัญชีและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 9: FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคา iPad ในยโสธร</h2>
        <p style="margin-bottom: 0.5rem;">ส่ง:</p>
        <p style="font-size: 1.25rem; font-weight: 800; color: #fdba74; margin-bottom: 1.5rem;">
          <strong>รุ่น + Generation + ความจุ + Wi-Fi/Cellular + Battery + รูป + อุปกรณ์</strong>
        </p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem;">
