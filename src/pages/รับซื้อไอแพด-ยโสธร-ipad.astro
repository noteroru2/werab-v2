---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อ iPad ยโสธร Pro Air mini มือสอง เช็ก Battery และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPad มือสองในยโสธร ทั้ง iPad Pro Air mini และรุ่นมาตรฐาน ประเมินจากรุ่น ชิป ความจุ Wi-Fi Cellular Battery จอ Touch อุปกรณ์และประวัติซ่อม";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอแพด",
    "url": "/รับซื้อไอแพด/"
  },
  {
    "name": "รับซื้อ iPad ยโสธร เช็กรุ่น ความจุ Battery จอ และอุปกรณ์ก่อนขาย",
    "url": "/รับซื้อไอแพด-ยโสธร-ipad/"
  }
];

const faqs = [
  {
    "question": "iPad Air, mini และ Pro ต้องแจ้ง Generation หรือไม่?",
    "answer": "ควรแจ้ง Generation ชิปหรือ Model เท่าที่ตรวจได้ เพราะชื่อรุ่นแต่ละตระกูลมีหลาย Generation และ Configuration"
  },
  {
    "question": "Battery เสื่อมต้องเปลี่ยนก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี สามารถแจ้งข้อมูล Battery หรืออาการใช้งานแล้วเช็กราคาตามสภาพก่อนตัดสินใจเปลี่ยน"
  },
  {
    "question": "Cellular iPad ต้องส่ง IMEI เพื่อถามราคาไหม?",
    "answer": "ไม่จำเป็นสำหรับการสอบถามราคาเบื้องต้น เริ่มจากรุ่น ความจุ Wi-Fi/Cellular รูปและสภาพก่อน และไม่ควรโพสต์ IMEI สาธารณะโดยไม่จำเป็น"
  },
  {
    "question": "Apple Pencil หรือ Keyboard มีผลไหม?",
    "answer": "ควรแจ้งรุ่นและอุปกรณ์ที่รวมขายจริง เพราะ Pencil และ Keyboard มีหลาย Generation และรองรับ iPad ต่างรุ่นกัน"
  },
  {
    "question": "ต้องส่ง Apple ID Password หรือ OTP เพื่อเช็กราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Passcode, PIN, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อ iPad ยโสธร เช็กรุ่น ความจุ Battery จอ และอุปกรณ์ก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อไอแพด-ยโสธร-ipad/</code> รักษา Historical Search Intent:</p>
        <p><strong>iPad + Yasothon</strong></p>
        <p>iPad รุ่นชื่อคล้ายกันอาจเป็นคนละ Generation ชิป ความจุ หรือระบบเชื่อมต่อ จึงควรระบุรุ่นให้ชัดก่อนประเมิน</p>
        <p>เริ่มจากส่ง:</p>
        <p><strong>รุ่น + Generation/ชิปถ้าทราบ + ความจุ + Wi-Fi/Cellular + Battery + รูป + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>อยู่ยโสธรสามารถส่งข้อมูล iPad มาเช็กราคาก่อนได้</h2>
        <p>สามารถเริ่มจากข้อมูลและรูปเครื่องก่อน โดยไม่จำเป็นต้องเดินทางพร้อมอุปกรณ์เพียงเพื่อถามราคาเบื้องต้น</p>
        <p>ข้อมูลที่ช่วยประเมิน ได้แก่:</p>
        <ul>
        <li>รุ่น</li>
        <li>Generation</li>
        <li>ชิป</li>
        <li>ความจุ</li>
        <li>Wi-Fi หรือ Cellular</li>
        <li>Battery</li>
        <li>จอ</li>
        <li>Touch</li>
        <li>กล้อง</li>
        <li>Port</li>
        <li>อุปกรณ์</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หลังจากนั้นจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>หน้า Local นี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ของจังหวัดยโสธร</p>
        <hr class="section-divider" />
        <h2>iPad, iPad Air, iPad mini และ iPad Pro ต้องแยกรุ่นให้ชัด</h2>
        <p>ไม่ควรแจ้งเพียงว่า:</p>
        <p><strong>iPad</strong></p>
        <p>เพราะมีหลายตระกูล เช่น:</p>
        <ul>
        <li>iPad รุ่นมาตรฐาน</li>
        <li>iPad Air</li>
        <li>iPad mini</li>
        <li>iPad Pro</li>
        </ul>
        <p>และแต่ละตระกูลมีหลาย Generation</p>
        <p>ควรดู Model หรือข้อมูลจาก Settings เท่าที่ทำได้</p>
        <hr class="section-divider" />
        <h2>ชิปและ Generation ช่วยแยกเครื่องที่ชื่อใกล้กัน</h2>
        <p>iPad บางรุ่นใช้:</p>
        <ul>
        <li>A-Series</li>
        <li>M-Series</li>
        <li>ชิปอื่นตาม Generation</li>
        </ul>
        <p>การรู้ชิปช่วยแยกช่วงรุ่นได้ แต่ไม่ควรใช้ชิปเพียงอย่างเดียว</p>
        <p>ควรดูร่วมกับ:</p>
        <ul>
        <li>ขนาดจอ</li>
        <li>Generation</li>
        <li>ความจุ</li>
        <li>Wi-Fi / Cellular</li>
        <li>Model Number</li>
        </ul>
        <hr class="section-divider" />
        <h2>ความจุควรตรวจจากเครื่องจริง</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>64GB</li>
        <li>128GB</li>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        <li>ความจุอื่นตามรุ่น</li>
        </ul>
        <p>ไม่ควรคาดเดาจากกล่องเก่าหรือความจำถ้าเครื่องยังสามารถตรวจข้อมูลได้</p>
        <p>ความจุเป็นส่วนหนึ่งของ Configuration ที่มีผลต่อการแยกรุ่นและมูลค่า</p>
        <hr class="section-divider" />
        <h2>Wi-Fi กับ Cellular ต้องระบุให้ถูก</h2>
        <p>iPad รุ่นเดียวกันอาจมี:</p>
        <p><strong>Wi-Fi</strong></p>
        <p>หรือ:</p>
        <p><strong>Wi-Fi + Cellular</strong></p>
        <p>หากเป็น Cellular ควรแจ้งตามที่ตรวจได้</p>
        <p>ไม่จำเป็นต้องเผยแพร่ IMEI ต่อสาธารณะเพื่อถามราคาเบื้องต้น</p>
        <p>เริ่มจากรุ่น ความจุ ระบบเชื่อมต่อ รูปและสภาพก่อนก็ได้</p>
        <hr class="section-divider" />
        <h2>Battery ของ iPad ควรดูทั้งข้อมูลและอาการใช้งาน</h2>
        <p>iPad บางรุ่นหรือบางเวอร์ชันอาจไม่แสดงข้อมูล Battery ในรูปแบบเดียวกับ iPhone</p>
        <p>สามารถแจ้งจาก:</p>
        <ul>
        <li>ค่า Battery ที่ระบบแสดง หากมี</li>
        <li>ระยะเวลาการใช้งานจริง</li>
        <li>หมดเร็ว</li>
        <li>ดับเอง</li>
        <li>ชาร์จช้า</li>
        <li>ชาร์จไม่เข้า</li>
        <li>เคยเปลี่ยน Battery</li>
        <li>Battery บวม</li>
        </ul>
        <p>หาก Battery บวม ไม่ควรกดหน้าจอหรือฝาหลังบริเวณที่นูน และไม่ควรชาร์จซ้ำโดยไม่จำเป็น</p>
        <hr class="section-divider" />
        <h2>จอ iPad ควรตรวจทั้งภาพและ Touch</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>กระจกแตก</li>
        <li>Panel แตก</li>
        <li>เส้น</li>
        <li>จุดดำ</li>
        <li>สีผิดปกติ</li>
        <li>Touch ไม่ครบ</li>
        <li>Touch กระโดด</li>
        <li>จอกระพริบ</li>
        <li>Backlight มีอาการ</li>
        </ul>
        <p>ควรถ่ายจอขณะเปิดใช้งานถ้าเครื่องยังใช้งานได้</p>
        <hr class="section-divider" />
        <h2>เครื่องงอหรือฝาหลังผิดรูปควรแจ้ง</h2>
        <p>iPad มีพื้นที่ตัวเครื่องขนาดใหญ่ จึงควรถ่าย:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านหลัง</li>
        <li>ขอบด้านบน</li>
        <li>ขอบด้านล่าง</li>
        <li>ด้านข้าง</li>
        <li>Port</li>
        </ul>
        <p>หากตัวเครื่อง:</p>
        <ul>
        <li>งอ</li>
        <li>มีรอยกระแทก</li>
        <li>ฝาหลังบุบ</li>
        <li>จอเผยอ</li>
        <li>ขอบแยก</li>
        </ul>
        <p>ควรแจ้งตามสภาพ</p>
        <p>หากจอเผยอเพราะสงสัย Battery บวม ไม่ควรกดจอกลับเข้าที่</p>
        <hr class="section-divider" />
        <h2>Apple Pencil ต้องระบุ Generation หรือรุ่นที่ใช้ร่วมกัน</h2>
        <p>หากมี Apple Pencil รวมขาย ควรแจ้งว่าเป็นรุ่นใดเท่าที่ทราบ</p>
        <p>iPad แต่ละ Generation รองรับ Pencil ต่างกัน</p>
        <p>จึงไม่ควรเขียนเพียงว่า:</p>
        <p><strong>มีปากกา</strong></p>
        <p>หากไม่แน่ใจสามารถส่งรูป Pencil และ Model ของ iPad ประกอบ</p>
        <hr class="section-divider" />
        <h2>Keyboard และอุปกรณ์เสริมควรแยกให้ชัด</h2>
        <p>หากมี:</p>
        <ul>
        <li>Magic Keyboard</li>
        <li>Smart Keyboard</li>
        <li>Keyboard Case</li>
        <li>Apple Pencil</li>
        <li>Charger</li>
        <li>Cable</li>
        <li>Case</li>
        <li>กล่อง</li>
        </ul>
        <p>ควรแจ้งว่าอะไร <strong>รวมขายจริง</strong></p>
        <p>อุปกรณ์บางรายการอาจเป็นคนละ Generation กับตัวเครื่อง จึงควรแยกข้อมูล</p>
        <hr class="section-divider" />
        <h2>Port ชาร์จและระบบเชื่อมต่อควรทดสอบ</h2>
        <p>ตามรุ่นอาจใช้:</p>
        <ul>
        <li>Lightning</li>
        <li>USB-C</li>
        <li>ระบบอื่นตาม Generation</li>
        </ul>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ชาร์จไม่เข้า</li>
        <li>ต้องขยับสาย</li>
        <li>Port หลวม</li>
        <li>ต่อคอมไม่ได้</li>
        <li>อุปกรณ์เสริมไม่เชื่อมต่อ</li>
        <li>USB-C มีอาการ</li>
        </ul>
        <p>ไม่จำเป็นต้องซ่อมก่อนเช็กราคาทุกกรณี</p>
        <hr class="section-divider" />
        <h2>กล้อง Speaker และ Microphone ก็ควรแจ้งเมื่อมีปัญหา</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>กล้องไม่ขึ้น</li>
        <li>Focus มีอาการ</li>
        <li>Speaker แตก</li>
        <li>เสียงข้างหนึ่งมีปัญหา</li>
        <li>Microphone เบา</li>
        <li>ปุ่ม Volume ใช้ไม่ได้</li>
        <li>Power Button มีอาการ</li>
        </ul>
        <p>ควรแจ้งตามสิ่งที่พบโดยไม่จำเป็นต้องวินิจฉัยอะไหล่ภายใน</p>
        <hr class="section-divider" />
        <h2>เครื่องเคยซ่อมหรือเปลี่ยนอะไหล่ควรแจ้ง</h2>
        <p>เช่น:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>ซ่อม Port</li>
        <li>ซ่อม Board</li>
        <li>เปลี่ยนกล้อง</li>
        <li>เคยแกะเครื่อง</li>
        <li>เคยตก</li>
        <li>เคยโดนน้ำ</li>
        </ul>
        <p>ประวัติซ่อมเป็นข้อมูลประกอบสภาพ ไม่ได้หมายความว่าเครื่องจะไม่มีมูลค่า</p>
        <hr class="section-divider" />
        <h2>Apple ID และ Activation ต้องจัดการโดยเจ้าของ</h2>
        <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชี Apple และสถานะ Find My ของเครื่องของตนเองได้</p>
        <p>แต่เพื่อสอบถามราคาไม่ต้องส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>Passcode</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>ข้อมูลเหล่านี้ไม่ควรถูกส่งเพื่อขอราคาประเมิน</p>
        <hr class="section-divider" />
        <h2>iCloud หรือบัญชีที่ติดเครื่องไม่ใช่เรื่องที่ควรแก้ด้วยการขอรหัสจากผู้อื่น</h2>
        <p>หากเครื่องยังผูกกับบัญชี เจ้าของบัญชีควรเป็นผู้จัดการสถานะด้วยตนเอง</p>
        <p>ไม่ควรส่งรหัสผ่านหรือ OTP ให้บุคคลอื่นเพื่อข้ามการยืนยันบัญชี</p>
        <p>การประเมิน Hardware เบื้องต้นไม่จำเป็นต้องได้รับข้อมูลดังกล่าว</p>
        <hr class="section-divider" />
        <h2>ไม่มีกล่องหรือ Charger ยังเช็กราคาได้</h2>
        <p>สามารถแจ้งตามจริงว่า:</p>
        <ul>
        <li>มีกล่อง</li>
        <li>มี Charger</li>
        <li>มีสาย</li>
        <li>มี Pencil</li>
        <li>มี Keyboard</li>
        <li>ไม่มีอุปกรณ์บางรายการ</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่</p>
        <hr class="section-divider" />
        <h2>iPad เปิดไม่ติดยังส่งข้อมูลได้</h2>
        <p>สามารถส่ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>Generation</li>
        <li>ความจุ</li>
        <li>Wi-Fi / Cellular</li>
        <li>สี</li>
        <li>รูป</li>
        <li>Charger</li>
        <li>อาการก่อนเสีย</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หาก Battery บวม เครื่องร้อนผิดปกติ มีกลิ่นไหม้ หรือมีร่องรอยของเหลว ไม่ควรเปิดหรือชาร์จซ้ำหลายครั้งเพียงเพื่อทดสอบก่อนขาย</p>
        <hr class="section-divider" />
        <h2>หน้ายโสธรต่างจากหน้ารับซื้อ iPad หลัก</h2>
        <p>หน้า <a href="/รับซื้อไอแพด/">รับซื้อไอแพด</a> เป็น Broad iPad Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อไอแพด-ยโสธร-ipad/</code></p>
        <p>รักษา:</p>
        <p><strong>iPad + Yasothon</strong></p>
        <p>ไม่ได้เป็นหน้า iPhone หรือ Smartphone และไม่ควรขยายไปแข่งขันกับ <code>/รับซื้อไอแพด/</code> สำหรับ Broad iPad Intent</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคา iPad ในยโสธร</h2>
        <h3>1. แจ้งตระกูล</h3>
        <p>iPad / Air / mini / Pro</p>
        <h3>2. แจ้ง Generation หรือชิป</h3>
        <p>เท่าที่ตรวจได้</p>
        <h3>3. แจ้งความจุ</h3>
        <p>ตามเครื่องจริง</p>
