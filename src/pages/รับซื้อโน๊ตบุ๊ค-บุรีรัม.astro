const pageTitle = "รับซื้อโน๊ตบุ๊คบุรีรัมย์ Notebook Gaming เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในบุรีรัมย์ Notebook Laptop และ Gaming Notebook ประเมินจากรุ่น CPU GPU RAM SSD แบตเตอรี่ จอ สภาพและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
