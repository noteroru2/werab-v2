    "url": "/รับซื้อโน๊ตบุ๊ค-บุรีรัม/"
  }
];

const faqs = [
  {
    "question": "อยู่ต่างอำเภอในบุรีรัมย์เช็กราคาก่อนได้ไหม?",
    "answer": "สามารถเริ่มจากส่ง Model สเปก รูป Battery และสภาพก่อน แล้วจึงค่อยพิจารณาวิธีตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม"
  },
  {
    "question": "Gaming Notebook ต้องแจ้ง GPU ไหม?",
