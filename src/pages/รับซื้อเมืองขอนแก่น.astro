---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อ MacBook ขอนแก่น MacBook Air Pro เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ MacBook มือสองในขอนแก่น ทั้ง MacBook Air และ MacBook Pro ประเมินจากรุ่น ชิป RAM Storage Battery Cycle หน้าจอ สภาพ อุปกรณ์และประวัติซ่อม";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อแมคบุ๊ค",
    "url": "/รับซื้อแมคบุ๊ค/"
  },
  {
    "name": "รับซื้อ MacBook ขอนแก่น เช็กรุ่น ชิป Battery และสภาพก่อนขาย",
    "url": "/รับซื้อเมืองขอนแก่น/"
  }
];

const faqs = [
  {
    "question": "MacBook ต้องแจ้งชิป M1 M2 M3 หรือไม่?",
    "answer": "ควรแจ้ง เพราะ MacBook Air หรือ Pro ชื่อเดียวกันสามารถมีหลาย Generation และหลาย Configuration"
  },
  {
    "question": "Battery Cycle มีผลต่อการประเมินไหม?",
    "answer": "เป็นข้อมูลประกอบหนึ่งของสภาพ Battery ควรแจ้ง Cycle Count และ Maximum Capacity ถ้าตรวจได้"
  },
  {
    "question": "MacBook เคยเปลี่ยนจอยังขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบและสภาพหน้าจอปัจจุบัน"
  },
  {
    "question": "ไม่มี Charger ยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งว่าไม่มี Charger ไม่จำเป็นต้องซื้อใหม่ก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่"
  },
  {
    "question": "ต้องส่ง Apple ID Password เพื่อเช็กราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Login Password, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อ MacBook ขอนแก่น เช็กรุ่น ชิป Battery และสภาพก่อนขาย</h1>
        
        
        <p>จึงเน้น MacBook Air และ MacBook Pro โดยไม่ใช้หน้านี้แข่งขันกับหน้า iPhone หรือ iPad</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนประเมินควรส่ง:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>รุ่น + ปีหรือชิป + RAM + Storage + Battery + รูป + Charger</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อ MacBook ขอนแก่น เช็กรุ่น ชิป Battery และสภาพก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ผู้ขาย MacBook ในขอนแก่นส่งข้อมูลมาก่อนได้</h2>
        <p>สามารถเริ่มจากข้อมูลเครื่องก่อนเพื่อเช็กราคาเบื้องต้น</p>
        <p>ไม่จำเป็นต้องเดินทางพร้อม MacBook เพียงเพื่อสอบถามราคา</p>
        <p>หลังทราบข้อมูลแล้วจึงค่อยพิจารณาวิธีตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ทุกพื้นที่ในขอนแก่น</p>
        </div>
        <div class="comm-card">
          <h2>Apple Silicon และ Intel MacBook ต้องแยกให้ถูก</h2>
        <p>ควรแจ้งว่าเป็น:</p>
        <ul>
        <li>Intel MacBook</li>
        <li>Apple M1</li>
        <li>M2</li>
        <li>M3</li>
        <li>M4</li>
        <li>หรือรุ่นอื่น</li>
        </ul>
        <p>MacBook ชื่อ Air หรือ Pro เหมือนกันแต่คนละ Generation อาจมี Hardware และตลาดแตกต่างกัน</p>
        <p>หากไม่ทราบ สามารถส่งรูปหน้า About This Mac หรือข้อมูล Model ได้โดยไม่ต้องส่งรหัสผ่าน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM และ Storage สำคัญกับ MacBook</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>MacBook Air M2 / RAM 16GB / SSD 512GB</strong></p>
        <p>ช่วยแยก Configuration ได้ชัดกว่า:</p>
        <p><strong>MacBook Air M2</strong></p>
        <p>อย่างเดียว</p>
        <p>บาง Generation มีตัวเลือก RAM และ Storage หลายระดับ</p>
        </div>
        <div class="comm-card">
          <h2>Battery ควรแจ้ง Health และ Cycle ถ้าตรวจได้</h2>
        <p>ข้อมูลที่มีประโยชน์ เช่น:</p>
        <ul>
        <li>Maximum Capacity</li>
        <li>Cycle Count</li>
        <li>Battery Service Message</li>
        <li>อาการใช้งานจริง</li>
        </ul>
        <p>หาก Battery บวมควรหลีกเลี่ยงการกด Trackpad หรือฝาเครื่องและไม่ควรใช้งานหนักโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอ MacBook ควรถ่ายขณะเปิด</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>เส้น</li>
        <li>จุด</li>
        <li>สีผิดปกติ</li>
        <li>Backlight มีปัญหา</li>
        <li>จอแตก</li>
        <li>กระจกเสียหาย</li>
        <li>จอกระพริบ</li>
        </ul>
        <p>หากต่อจอนอกได้แต่จอในมีอาการ ควรแจ้งตามที่ตรวจพบ</p>
        </div>
        <div class="comm-card">
          <h2>Keyboard, Trackpad และ Port ควรตรวจ</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>Keyboard บางปุ่มเสีย</li>
        <li>Trackpad กดไม่ได้</li>
        <li>USB-C มีปัญหา</li>
        <li>MagSafe มีอาการ</li>
        <li>Speaker มีปัญหา</li>
        <li>Camera ไม่ทำงาน</li>
        </ul>
        <p>อาการแต่ละส่วนมีผลต่อความพร้อมใช้งานของเครื่อง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Charger มีหรือไม่มีควรแจ้ง</h2>
        <p>ควรระบุว่า:</p>
        <ul>
        <li>Charger เดิม</li>
        <li>Charger เทียบ</li>
        <li>มีเฉพาะสาย</li>
        <li>ไม่มี Charger</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้อ Charger ใหม่เพียงเพื่อเช็กราคา</p>
        </div>
        <div class="comm-card">
          <h2>MacBook เคยซ่อมต้องแจ้งไหม</h2>
        <p>ควรแจ้งถ้าทราบ เช่น:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>ซ่อม Logic Board</li>
        <li>เปลี่ยน Keyboard</li>
        <li>เปลี่ยน Top Case</li>
        <li>เคยโดนน้ำ</li>
        <li>เคยตก</li>
        </ul>
        <p>ประวัติซ่อมช่วยอธิบายสภาพของเครื่องได้ตรงขึ้น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Find My และบัญชี Apple ควรจัดการก่อนส่งมอบ</h2>
        <p>ก่อนซื้อขายจริง เจ้าของต้องสามารถจัดการบัญชีของตนเองและสถานะเครื่องได้</p>
        <p>แต่ในการสอบถามราคาเบื้องต้น ไม่ควรส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>Mac Login Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        </ul>
        <p>ไม่จำเป็นต้องให้ข้อมูลลับเหล่านี้เพื่อประเมิน Hardware</p>
        </div>
        <div class="comm-card">
          <h2>Serial Number ควรส่งอย่างไร</h2>
        <p>การประเมินเบื้องต้นสามารถเริ่มจากรุ่น ชิป RAM Storage Battery และรูปก่อน</p>
        <p>หากต้องใช้ Serial Number ในขั้นตอนตรวจสอบเพิ่มเติม ควรส่งผ่านช่องทางที่เหมาะสม และไม่จำเป็นต้องเผยแพร่สาธารณะ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>MacBook เปิดไม่ติดยังส่งข้อมูลได้ไหม</h2>
        <p>สามารถส่ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>ชิปหรือ CPU</li>
        <li>RAM</li>
        <li>Storage ถ้าทราบ</li>
        <li>Charger</li>
        <li>รูป</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>เครื่องที่เปิดไม่ได้มีความไม่แน่นอนมากกว่าเครื่องที่ตรวจสเปกได้</p>
        <p>หากมีกลิ่นไหม้ Battery บวม หรือความร้อนผิดปกติ ไม่ควรทดลองเปิดหรือชาร์จซ้ำหลายครั้ง</p>
        </div>
        
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา MacBook ในขอนแก่น</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งรุ่น</h3>
              <p>Air หรือ Pro พร้อม Generation</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้งชิปหรือ CPU</h3>
              <p>Intel หรือ Apple Silicon</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง RAM และ Storage</h3>
              <p>ตาม Configuration จริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง Battery</h3>
              <p>Health และ Cycle ถ้าตรวจได้</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. ส่งรูป</h3>
              <p>หน้าจอ ฝา Keyboard และด้านล่าง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง Charger</h3>
              <p>ของเดิม เทียบ หรือไม่มี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งอาการ</h3>
              <p>จอ Keyboard Trackpad Port หรืออื่น ๆ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติซ่อม</h3>
              <p>ถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. จัดการข้อมูลก่อนส่งมอบ</h3>
              <p>ไม่ต้องส่ง Password เพื่อสอบถามราคา</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น Configuration และสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคา MacBook ในขอนแก่น</h2>
        <p>ส่ง:</p>
        <p><strong>รุ่น + ชิป + RAM + Storage + Battery + รูป + Charger</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-white">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขาย MacBook มือสองในขอนแก่น" subtitle="" />
    </div>
  </section>
</BaseLayout>
