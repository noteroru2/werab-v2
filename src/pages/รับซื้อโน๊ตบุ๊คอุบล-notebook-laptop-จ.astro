---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คอุบลราชธานี Notebook Gaming เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในอุบลราชธานี Notebook Laptop และ Gaming Notebook ส่งรุ่น สเปก รูป แบตเตอรี่ สภาพและอุปกรณ์เพื่อเช็กราคาเบื้องต้นก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คอุบลราชธานี เช็กรุ่น สเปก และสภาพก่อนขาย",
    "url": "/รับซื้อโน๊ตบุ๊คอุบล-notebook-laptop-จ/"
  }
];

const faqs = [
  {
    "question": "อยู่ต่างอำเภอในอุบลราชธานีสามารถเช็กราคาก่อนได้ไหม?",
    "answer": "สามารถเริ่มจากส่งรุ่น สเปก รูป สภาพ Battery และอุปกรณ์เพื่อประเมินเบื้องต้นก่อน แล้วจึงค่อยพิจารณาวิธีตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม ไม่จำเป็นต้องเดินทางพร้อมเครื่องเพียงเพื่อถามราคาเบื้องต้น"
  },
  {
    "question": "Gaming Notebook ในอุบลต้องส่งสเปกอะไรบ้าง?",
    "answer": "ควรแจ้ง Model, CPU, GPU, RAM, SSD, หน้าจอถ้าทราบ, Battery และ Adapter โดยเฉพาะ GPU ควรแจ้งรุ่นเต็มเพราะมีผลต่อ Configuration และการประเมินเครื่อง Gaming"
  },
  {
    "question": "โน๊ตบุ๊คเปิดไม่ติดหรือ Battery เสื่อมยังขายได้ไหม?",
    "answer": "บางกรณีสามารถส่งมาประเมินตามสภาพได้ ควรแจ้งรุ่น สเปก อาการ ไฟสถานะ Adapter ประวัติซ่อม และสภาพเครื่องตามจริง เครื่องที่ไม่สามารถทดสอบได้จะมีความไม่แน่นอนสูงกว่าเครื่องปกติ"
  },
  {
    "question": "ไม่มี Adapter หรือไม่มีกล่องขายได้ไหม?",
    "answer": "สามารถส่งมาประเมินได้ ควรแจ้งอุปกรณ์ที่มีจริง ไม่จำเป็นต้องซื้อ Adapter หรือกล่องใหม่ก่อนเช็กราคา เพราะต้องเปรียบเทียบต้นทุนกับมูลค่าที่เพิ่มขึ้นก่อน"
  },
  {
    "question": "มี Notebook หลายเครื่องจากบริษัทในอุบลควรส่งข้อมูลอย่างไร?",
    "answer": "ควรจัดรายการตามรุ่น CPU RAM SSD จำนวนและสภาพ หากแต่ละกลุ่มมี Configuration ต่างกันควรแยกเป็นคนละรายการ และไม่จำเป็นต้องเปิดเผยข้อมูลบริษัทที่ไม่เกี่ยวข้องกับการประเมิน Hardware"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คอุบลราชธานี เช็กรุ่น สเปก และสภาพก่อนขาย</h1>
        <p>มีโน๊ตบุ๊คมือสองอยู่ในอุบลราชธานีและกำลังคิดว่าจะขาย แต่ยังไม่แน่ใจว่ารุ่นนี้ควรประเมินจากอะไร หรือควรเตรียมข้อมูลแบบไหนก่อนตัดสินใจ?</p>
        <p>สำหรับผู้ขายในอุบลราชธานี สามารถส่งข้อมูล Notebook, Laptop และ Gaming Notebook เพื่อเช็กราคาเบื้องต้นตามรุ่น สเปก สภาพ และอุปกรณ์จริง</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">สิ่งที่ควรส่งก่อนคือ:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>รุ่น + CPU + RAM + SSD + GPU ถ้ามี + รูป + Battery + สภาพ + อุปกรณ์</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        <div style="margin-top: 1rem;"><p>การส่งข้อมูลให้ครบก่อนช่วยให้ประเมินเบื้องต้นได้ตรงกว่าการแจ้งเพียงว่า “มีโน๊ตบุ๊คขายหนึ่งเครื่อง”</p></div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คอุบลราชธานี เช็กรุ่น สเปก และสภาพก่อนขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ในอุบลราชธานี ไม่จำเป็นต้องยกเครื่องมาเพื่อถามราคาก่อน</h2>
        <p>หากยังอยู่ในขั้นเช็กราคา สามารถเริ่มจากส่งข้อมูลและรูปก่อน</p>
        <p>เหมาะกับผู้ขายที่อยู่ทั้ง:</p>
        <ul>
        <li>อำเภอเมืองอุบลราชธานี</li>
        <li>วารินชำราบ</li>
        <li>เดชอุดม</li>
        <li>พิบูลมังสาหาร</li>
        <li>ตระการพืชผล</li>
        <li>เขื่องใน</li>
        <li>ม่วงสามสิบ</li>
        <li>น้ำยืน</li>
        <li>และพื้นที่อื่นในจังหวัดอุบลราชธานี</li>
        </ul>
        <p>การกล่าวถึงพื้นที่เหล่านี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้ออยู่ทุกอำเภอ</p>
        <p>จุดประสงค์คือให้ผู้ขายสามารถเริ่มเช็กราคาได้ก่อน แล้วจึงค่อยพิจารณาวิธีส่งมอบหรือนัดหมายตามพื้นที่และความเหมาะสม</p>
        </div>
        <div class="comm-card">
          <h2>โน๊ตบุ๊คแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียดโน๊ตบุ๊คหลายประเภทมาสอบถามได้ เช่น</p>
        <ul>
        <li>Notebook สำหรับทำงานทั่วไป</li>
        <li>Laptop สำหรับเรียน</li>
        <li>Gaming Notebook</li>
        <li>Notebook สำหรับงานกราฟิก</li>
        <li>Mobile Workstation</li>
        <li>Ultrabook</li>
        <li>Notebook ธุรกิจ</li>
        <li>Notebook เครื่องเก่า</li>
        <li>เครื่องมีรอย</li>
        <li>Battery เสื่อม</li>
        <li>จอมีตำหนิ</li>
        <li>Keyboard มีปัญหา</li>
        <li>ไม่มี Adapter</li>
        <li>เคยซ่อม</li>
        <li>เปิดไม่ติดบางกรณี</li>
        </ul>
        <p>แต่ละสภาพต้องประเมินต่างกัน</p>
        <p>เครื่องที่เปิดใช้งานและตรวจสเปกได้ครบ มีความไม่แน่นอนน้อยกว่าเครื่องที่ไม่สามารถทดสอบได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายควรรู้รุ่นเต็มของเครื่อง</h2>
        <p>ชื่อบนฝาเครื่องเพียงอย่างเดียวอาจยังไม่พอ</p>
        <p>ตัวอย่างเช่น Notebook ตระกูลเดียวกันอาจมีหลาย:</p>
        <ul>
        <li>Generation</li>
        <li>CPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>GPU</li>
        <li>หน้าจอ</li>
        <li>Refresh Rate</li>
        <li>Configuration</li>
        </ul>
        <p>จึงควรส่ง <strong>Model เต็ม</strong> หรือรหัสเครื่องถ้าหาได้</p>
        <p>ตำแหน่งที่มักใช้ตรวจ เช่น</p>
        <ul>
        <li>Sticker ใต้เครื่อง</li>
        <li>System Information</li>
        <li>BIOS</li>
        <li>About ใน Windows</li>
        <li>กล่อง</li>
        <li>ใบเสร็จ</li>
        <li>Application ของผู้ผลิต</li>
        </ul>
        <p>หากไม่แน่ใจ สามารถถ่ายรูปป้าย Model ส่งมาประกอบได้</p>
        </div>
        <div class="comm-card">
          <h2>CPU มีผลต่อราคาอย่างไร</h2>
        <p>CPU เป็นหนึ่งในข้อมูลหลักที่ใช้แยก Generation และระดับของเครื่อง</p>
        <p>ควรแจ้งรุ่นเต็ม เช่น</p>
        <ul>
        <li>Intel Core i5-12450H</li>
        <li>Intel Core i7-12700H</li>
        <li>Intel Core Ultra รุ่นต่าง ๆ</li>
        <li>AMD Ryzen 5 7535HS</li>
        <li>AMD Ryzen 7 7840HS</li>
        <li>หรือรุ่นอื่น</li>
        </ul>
        <p>คำว่า “Core i7” หรือ “Ryzen 7” อย่างเดียวอาจยังไม่พอ เพราะแต่ละ Generation มีประสิทธิภาพและอายุของ Platform ต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM และ SSD ควรแจ้งเท่าไร</h2>
        <p>ควรแจ้งความจุปัจจุบันของเครื่อง</p>
        <p>ตัวอย่าง:</p>
        <p><strong>RAM 16GB / SSD 512GB</strong></p>
        <p>หรือ</p>
        <p><strong>RAM 32GB / SSD 1TB</strong></p>
        <p>หากมีการอัปเกรดจากสเปกเดิม ควรแจ้ง Configuration ปัจจุบัน</p>
        <p>สำหรับเครื่องที่มี SSD มากกว่าหนึ่งลูก ควรระบุว่าสิ่งใดรวมขายจริง</p>
        </div>
        <div class="comm-card">
          <h2>Gaming Notebook ต้องแจ้งการ์ดจอให้ชัด</h2>
        <p>สำหรับ Gaming Notebook การ์ดจอมีผลต่อการแยกมูลค่าของเครื่องมาก</p>
        <p>ควรแจ้งรุ่นเต็ม เช่น</p>
        <ul>
        <li>GTX Series</li>
        <li>RTX 20 Series</li>
        <li>RTX 30 Series</li>
        <li>RTX 40 Series</li>
        <li>RTX 50 Series</li>
        <li>AMD Radeon รุ่นที่ติดตั้งใน Notebook</li>
        <li>GPU รุ่นอื่น</li>
        </ul>
        <p>เครื่องชื่อเดียวกันบางรุ่นมีหลาย GPU Configuration</p>
        <p>ดังนั้นไม่ควรใช้ชื่อ Series ของตัวเครื่องอย่างเดียวในการประเมิน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Gaming Notebook ในอุบลควรทดสอบอะไรก่อนขาย</h2>
        <p>ถ้าเครื่องยังใช้งานได้ ไม่จำเป็นต้อง Stress Test อย่างหนักเพียงเพื่อถามราคา</p>
        <p>สามารถตรวจเบื้องต้นว่า:</p>
        <ul>
        <li>เข้า Windows ได้</li>
        <li>ภาพแสดงผลปกติ</li>
        <li>GPU ถูกตรวจพบ</li>
        <li>Keyboard ใช้งานได้</li>
        <li>Touchpad ใช้งานได้</li>
        <li>Wi-Fi ใช้งานได้</li>
        <li>เสียงออก</li>
        <li>Port หลักใช้งานได้</li>
        <li>Battery มีอาการอย่างไร</li>
        <li>Adapter ชาร์จเข้า</li>
        </ul>
        <p>หากมีอาการเฉพาะเวลาเล่นเกม เช่น</p>
        <ul>
        <li>ดับ</li>
        <li>Restart</li>
        <li>ภาพแตก</li>
        <li>จอฟ้า</li>
        <li>GPU Error</li>
        <li>ร้อนผิดปกติ</li>
        <li>พัดลมมีเสียง</li>
        </ul>
        <p>ควรแจ้งตามอาการจริง</p>
        </div>
        <div class="comm-card">
          <h2>Battery เสื่อมยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินตามสภาพได้</p>
        <p>ควรแจ้งข้อมูลที่ตรวจสอบได้ เช่น</p>
        <ul>
        <li>Battery ใช้งานได้ตามปกติ</li>
        <li>Battery หมดเร็ว</li>
        <li>ต้องเสียบ Adapter</li>
        <li>Battery บวม</li>
        <li>Battery เคยเปลี่ยน</li>
        <li>Windows แจ้งเตือน Battery</li>
        <li>Battery Health ถ้ามีข้อมูลจากระบบ</li>
        </ul>
        <p>หาก Battery บวม ควรหลีกเลี่ยงการกดหรือใช้งานเครื่องโดยไม่จำเป็น เพราะอาจมีความเสี่ยงต่ออุปกรณ์และความปลอดภัย</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ไม่มี Adapter ยังเช็กราคาได้ไหม</h2>
        <p>ได้</p>
        <p>ควรแจ้งตั้งแต่ต้นว่า:</p>
        <p><strong>ไม่มี Adapter</strong></p>
        <p>หรือ</p>
        <p><strong>มี Adapter เทียบ</strong></p>
        <p>หรือ</p>
        <p><strong>มี Adapter เดิม</strong></p>
        <p>Adapter มีผลต่อความครบและความพร้อมใช้งาน แต่ไม่ใช่ปัจจัยเดียวในการประเมิน</p>
        <p>ไม่จำเป็นต้องรีบซื้อ Adapter ใหม่ก่อนรู้ว่าต้นทุนคุ้มกับมูลค่าที่เพิ่มหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>หน้าจอมีปัญหาควรแจ้งแบบไหน</h2>
        <p>ควรถ่ายรูปหน้าจอขณะเปิดเครื่อง และแจ้งอาการ เช่น</p>
        <ul>
        <li>มี Dead Pixel</li>
        <li>เป็นเส้น</li>
