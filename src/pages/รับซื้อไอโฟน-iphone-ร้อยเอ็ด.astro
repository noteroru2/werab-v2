---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อไอโฟนร้อยเอ็ด iPhone มือสอง เช็ก Battery และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPhone มือสองในร้อยเอ็ด ประเมินจากรุ่น ความจุ Battery Health หน้าจอ Face ID กล้อง สภาพ อุปกรณ์และประวัติซ่อม ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอโฟน",
    "url": "/รับซื้อไอโฟน/"
  },
  {
    "name": "รับซื้อไอโฟนร้อยเอ็ด เช็กรุ่น Battery Health และประวัติเครื่องก่อนขาย",
    "url": "/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/"
  }
];

const faqs = [
  {
    "question": "Battery Health ต่ำยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งเปอร์เซ็นต์ตามที่ระบบแสดงและประวัติเปลี่ยน Battery ถ้าทราบ ไม่จำเป็นต้องเปลี่ยนก่อนสอบถามราคา"
  },
  {
    "question": "iPhone เปลี่ยนจอมาแล้วประเมินได้หรือไม่?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบและสภาพหน้าจอ Touch และฟังก์ชันปัจจุบัน"
  },
  {
    "question": "Face ID ใช้ไม่ได้ยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการตามจริง เพราะเป็นส่วนหนึ่งของความพร้อมใช้งานของเครื่อง"
  },
  {
    "question": "ไม่มีกล่องยังขายได้หรือไม่?",
    "answer": "สามารถเช็กราคาได้ โดยแจ้งอุปกรณ์ที่รวมขายจริง ไม่จำเป็นต้องซื้อของใหม่มาเติมชุด"
  },
  {
    "question": "ต้องให้ Apple ID Password หรือ OTP เพื่อถามราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Passcode, PIN, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อไอโฟนร้อยเอ็ด เช็กรุ่น Battery Health และประวัติเครื่องก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/</code> รักษา Historical Search Intent:</p>
        <p><strong>iPhone + Roi Et</strong></p>
        <p>การประเมิน iPhone ควรดูมากกว่ารุ่นและสี โดยควรตรวจความจุ Battery Health หน้าจอ Face ID กล้อง สภาพตัวเครื่อง และประวัติซ่อมร่วมกัน</p>
        <p>ส่งก่อน:</p>
        <p><strong>รุ่น + ความจุ + สี + Battery Health + รูป + ตำหนิ + ประวัติซ่อมถ้ามี</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>เริ่มจากระบุ Generation และรุ่นย่อยให้ถูก</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>iPhone 13</li>
        <li>iPhone 13 Pro</li>
        <li>iPhone 13 Pro Max</li>
        <li>iPhone 14</li>
        <li>iPhone 15 Pro</li>
        <li>หรือรุ่นอื่น</li>
        </ul>
        <p>คำว่า:</p>
        <p><strong>iPhone Pro</strong></p>
        <p>อย่างเดียวไม่เพียงพอ</p>
        <p>ควรแจ้ง Generation พร้อมรุ่นย่อยและความจุ</p>
        <hr class="section-divider" />
        <h2>ความจุต้องใช้ของเครื่องจริง</h2>
        <p>ควรตรวจว่าเป็น:</p>
        <ul>
        <li>64GB</li>
        <li>128GB</li>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        <li>หรือความจุอื่นตามรุ่น</li>
        </ul>
        <p>ไม่ควรคาดเดาจากความจำ หากยังสามารถเปิดดูข้อมูลในเครื่องได้</p>
        <p>ความจุเป็นหนึ่งในข้อมูลสำคัญในการแยก Configuration</p>
        <hr class="section-divider" />
        <h2>Battery Health ควรส่งค่าที่ระบบแสดง</h2>
        <p>หาก iPhone ยังแสดง Battery Health สามารถส่งเปอร์เซ็นต์นั้นประกอบได้</p>
        <p>ควรแจ้งด้วยหาก:</p>
        <ul>
        <li>เคยเปลี่ยน Battery</li>
        <li>มีข้อความเกี่ยวกับชิ้นส่วน</li>
        <li>Battery หมดเร็ว</li>
        <li>เครื่องดับ</li>
        <li>ชาร์จผิดปกติ</li>
        <li>Battery บวม</li>
        </ul>
        <p>หาก Battery บวม ไม่ควรกดตัวเครื่องหรือชาร์จซ้ำโดยไม่จำเป็น</p>
        <hr class="section-divider" />
        <h2>ประวัติการเปลี่ยนอะไหล่ควรแจ้งตามที่ทราบ</h2>
        <p>ควรแจ้งหากเครื่องเคย:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อมระบบชาร์จ</li>
        <li>ซ่อม Board</li>
        <li>โดนน้ำ</li>
        <li>ตกกระแทกหนัก</li>
        </ul>
        <p>ประวัติซ่อมไม่ได้หมายความว่าเครื่องขายไม่ได้ แต่ช่วยให้สภาพที่ใช้ประเมินตรงกับเครื่องจริงมากขึ้น</p>
        <hr class="section-divider" />
        <h2>หน้าจอควรตรวจทั้งภาพและ Touch</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>รอย</li>
        <li>กระจกแตก</li>
        <li>จุด</li>
        <li>เส้น</li>
        <li>สีผิดปกติ</li>
        <li>Touch ไม่ครบ</li>
        <li>จอกระพริบ</li>
        <li>แสงผิดปกติ</li>
        </ul>
        <p>หากเคยเปลี่ยนจอ ควรแจ้งเท่าที่ทราบ</p>
        <hr class="section-divider" />
        <h2>Face ID ควรทดสอบก่อนขายหากเครื่องใช้งานได้</h2>
        <p>สามารถแจ้งว่า:</p>
        <ul>
        <li>Face ID ใช้งานได้</li>
        <li>ใช้งานไม่ได้</li>
        <li>ทำงานเป็นบางครั้ง</li>
        <li>ระบบแสดงข้อความผิดปกติ</li>
        </ul>
        <p>หากใช้ไม่ได้ ไม่ควรวินิจฉัยสาเหตุเองว่าเกิดจากชิ้นส่วนใดโดยไม่มีการตรวจ</p>
        <hr class="section-divider" />
        <h2>กล้องแต่ละตัวควรตรวจตามฟังก์ชัน</h2>
        <p>ควรสังเกต:</p>
        <ul>
        <li>โฟกัส</li>
        <li>ภาพสั่น</li>
        <li>Lens</li>
        <li>กล้องหน้า</li>
        <li>กล้องหลัง</li>
        <li>การสลับระยะตามรุ่น</li>
        </ul>
        <p>หากมีอาการ สามารถส่งตัวอย่างหรือแจ้งอาการตามที่พบ</p>
        <hr class="section-divider" />
        <h2>Speaker Microphone และ Port ชาร์จก็ควรแจ้ง</h2>
        <p>iPhone ที่หน้าจอและ Battery ปกติอาจยังมีอาการในส่วนอื่น</p>
        <p>เช่น:</p>
        <ul>
        <li>Speaker เสียงแตก</li>
        <li>Microphone เบา</li>
        <li>Port ชาร์จหลวม</li>
        <li>ชาร์จติดบางครั้ง</li>
        <li>ปุ่มมีปัญหา</li>
        <li>Vibration ผิดปกติ</li>
        </ul>
        <p>ควรแจ้งตามสภาพจริง</p>
        <hr class="section-divider" />
        <h2>Apple ID และ Find My ต้องจัดการโดยเจ้าของเครื่อง</h2>
        <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชีที่ผูกกับเครื่องของตนเองได้</p>
        <p>แต่เพื่อสอบถามราคา <strong>ไม่ต้องส่งรหัสลับ</strong></p>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>Passcode</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>การประเมินเบื้องต้นไม่จำเป็นต้องได้รับข้อมูลเหล่านี้</p>
        <hr class="section-divider" />
        <h2>IMEI และ Serial ไม่จำเป็นต้องโพสต์สาธารณะ</h2>
        <p>สามารถเริ่มจาก:</p>
        <p><strong>รุ่น + ความจุ + Battery + รูป + สภาพ</strong></p>
        <p>ก่อน</p>
        <p>หากภายหลังจำเป็นต้องใช้ IMEI หรือ Serial ในขั้นตอนตรวจสอบเพิ่มเติม ควรส่งผ่านช่องทางที่เหมาะสม ไม่ควรโพสต์ข้อมูลระบุตัวเครื่องสาธารณะโดยไม่จำเป็น</p>
        <hr class="section-divider" />
        <h2>ไม่มีกล่องหรือสายยังส่งมาประเมินได้</h2>
        <p>ควรแจ้งสิ่งที่มีจริง เช่น:</p>
        <ul>
        <li>กล่อง</li>
        <li>สาย</li>
        <li>Adapter</li>
        <li>เคส</li>
        <li>ใบเสร็จ</li>
        </ul>
        <p>ไม่มีอุปกรณ์บางอย่างยังสามารถเช็กราคาได้</p>
        <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่</p>
        <hr class="section-divider" />
        <h2>เครื่องเปิดไม่ติดยังส่งข้อมูลได้</h2>
        <p>สามารถเริ่มจาก:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>สี</li>
        <li>รูป</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        </ul>
        <p>เครื่องที่ไม่สามารถทดสอบฟังก์ชันได้จะมีความไม่แน่นอนมากกว่าเครื่องที่ใช้งานได้</p>
        <p>หาก Battery บวม เครื่องร้อน หรือมีกลิ่นไหม้ ไม่ควรชาร์จหรือเปิดซ้ำหลายครั้ง</p>
        <hr class="section-divider" />
        <h2>หน้าร้อยเอ็ดต่างจากหน้ารับซื้อ iPhone หลัก</h2>
        <p>หน้า <a href="/รับซื้อไอโฟน/">รับซื้อไอโฟน</a> เป็น Broad iPhone Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/</code></p>
        <p>รักษา:</p>
        <p><strong>iPhone + Roi Et</strong></p>
        <p>จึงไม่ควรเปลี่ยนหน้านี้ให้ครอบคลุมมือถือทุกระบบหรือแข่งขันกับ Parent ด้วย Intent ระดับประเทศ</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนเช็กราคา iPhone ในร้อยเอ็ด</h2>
        <h3>1. แจ้งรุ่น</h3>
        <p>Generation และรุ่นย่อย</p>
        <h3>2. แจ้งความจุ</h3>
        <p>ตามเครื่องจริง</p>
        <h3>3. แจ้ง Battery Health</h3>
        <p>ถ้าระบบแสดง</p>
        <h3>4. ส่งรูป</h3>
        <p>หน้า หลัง กรอบและชุดกล้อง</p>
        <h3>5. ตรวจหน้าจอ</h3>
        <p>รวม Touch และตำหนิ</p>
        <h3>6. ตรวจ Face ID และกล้อง</h3>
        <p>แจ้งอาการถ้ามี</p>
        <h3>7. แจ้งประวัติซ่อม</h3>
        <p>เท่าที่ทราบ</p>
        <h3>8. แจ้งอุปกรณ์</h3>
        <p>ตามสิ่งที่รวมขาย</p>
        <h3>9. เช็กราคาเบื้องต้น</h3>
        <p>ก่อนซื้ออะไหล่หรือซ่อมเพิ่ม</p>
        <h3>10. ตรวจสินค้า</h3>
        <p>ยืนยันรุ่น สภาพและสถานะก่อนซื้อขาย</p>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคา iPhone ในร้อยเอ็ด</h2>
        <p>ส่ง:</p>
        <p><strong>รุ่น + ความจุ + Battery Health + รูป + ตำหนิ</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <hr class="section-divider" />
      </article>
    </div>
  </main>

  <section class="section section-muted">
    <div class="container container-narrow">
      <FAQ
        items={faqs}
        title="คำถามที่พบบ่อยเกี่ยวกับการขาย iPhone ในร้อยเอ็ด"
      />
    </div>
  </section>

</BaseLayout>

<style>
  .content-container {
    padding: 2.5rem 0 4rem 0;
  }

  .prose-content {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 640px) {
    .prose-content {
      padding: 1.75rem 1.25rem;
    }
  }

  .prose-content h1 {
    font-size: 2.15rem;
    color: var(--color-primary);
    line-height: 1.3;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .prose-content h2 {
    font-size: 1.55rem;
    color: var(--color-primary);
    line-height: 1.35;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    line-height: 1.4;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-main);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .prose-content ul,
  .prose-content ol {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .prose-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 0.4rem;
  }

  .prose-content strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .prose-content a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .prose-content a:hover {
    color: var(--color-accent-hover);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--color-border);
    margin: 2.5rem 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .table th,
  .table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .table th {
    background-color: var(--color-bg-subtle);
    color: var(--color-primary);
    font-weight: 600;
  }

  .table tr:nth-child(even) {
    background-color: #fafbfc;
  }
</style>
