---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อไอโฟนร้อยเอ็ด iPhone มือสอง เช็ก Battery และสภาพก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อ iPhone มือสองในร้อยเอ็ด ประเมินจากรุ่น ความจุ Battery Health หน้าจอ Face ID กล้อง สภาพ อุปกรณ์และประวัติซ่อม ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอโฟน",
    "url": "/รับซื้อไอโฟน/"
  },
  {
    "name": "รับซื้อไอโฟนร้อยเอ็ด เช็กรุ่น Battery Health และประวัติเครื่องก่อนขาย",
    "url": "/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/"
  }
];

const faqs = [
  {
    "question": "Battery Health ต่ำยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งเปอร์เซ็นต์ตามที่ระบบแสดงและประวัติเปลี่ยน Battery ถ้าทราบ ไม่จำเป็นต้องเปลี่ยนก่อนสอบถามราคา"
  },
  {
    "question": "iPhone เปลี่ยนจอมาแล้วประเมินได้หรือไม่?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบและสภาพหน้าจอ Touch และฟังก์ชันปัจจุบัน"
  },
  {
    "question": "Face ID ใช้ไม่ได้ยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการตามจริง เพราะเป็นส่วนหนึ่งของความพร้อมใช้งานของเครื่อง"
  },
  {
    "question": "ไม่มีกล่องยังขายได้หรือไม่?",
    "answer": "สามารถเช็กราคาได้ โดยแจ้งอุปกรณ์ที่รวมขายจริง ไม่จำเป็นต้องซื้อของใหม่มาเติมชุด"
  },
  {
    "question": "ต้องให้ Apple ID Password หรือ OTP เพื่อถามราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Apple ID Password, Passcode, PIN, OTP หรือ Recovery Key เพื่อขอราคาประเมิน"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อไอโฟนร้อยเอ็ด เช็กรุ่น Battery Health และประวัติเครื่องก่อนขาย</h1>
        <p>หน้า <code>/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/</code> รักษา Historical Search Intent:</p>
        <p><strong>iPhone + Roi Et</strong></p>
        <p>การประเมิน iPhone ควรดูมากกว่ารุ่นและสี โดยควรตรวจความจุ Battery Health หน้าจอ Face ID กล้อง สภาพตัวเครื่อง และประวัติซ่อมร่วมกัน</p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ส่งก่อน:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>รุ่น + ความจุ + สี + Battery Health + รูป + ตำหนิ + ประวัติซ่อมถ้ามี</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.webp" type="image/webp" />
              <source srcset="/images/hero-smartphone.avif" type="image/avif" />
              <source srcset="/images/hero-smartphone.webp" type="image/webp" />
              <img
                src="/images/hero-smartphone.webp"
                alt="รับซื้อไอโฟนร้อยเอ็ด เช็กรุ่น Battery Health และประวัติเครื่องก่อนขาย"
                width="668"
                height="717"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เริ่มจากระบุ Generation และรุ่นย่อยให้ถูก</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>iPhone 13</li>
        <li>iPhone 13 Pro</li>
        <li>iPhone 13 Pro Max</li>
        <li>iPhone 14</li>
        <li>iPhone 15 Pro</li>
        <li>หรือรุ่นอื่น</li>
        </ul>
        <p>คำว่า:</p>
        <p><strong>iPhone Pro</strong></p>
        <p>อย่างเดียวไม่เพียงพอ</p>
        <p>ควรแจ้ง Generation พร้อมรุ่นย่อยและความจุ</p>
        </div>
        <div class="comm-card">
          <h2>ความจุต้องใช้ของเครื่องจริง</h2>
        <p>ควรตรวจว่าเป็น:</p>
        <ul>
        <li>64GB</li>
        <li>128GB</li>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        <li>หรือความจุอื่นตามรุ่น</li>
        </ul>
        <p>ไม่ควรคาดเดาจากความจำ หากยังสามารถเปิดดูข้อมูลในเครื่องได้</p>
        <p>ความจุเป็นหนึ่งในข้อมูลสำคัญในการแยก Configuration</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery Health ควรส่งค่าที่ระบบแสดง</h2>
        <p>หาก iPhone ยังแสดง Battery Health สามารถส่งเปอร์เซ็นต์นั้นประกอบได้</p>
        <p>ควรแจ้งด้วยหาก:</p>
        <ul>
        <li>เคยเปลี่ยน Battery</li>
        <li>มีข้อความเกี่ยวกับชิ้นส่วน</li>
        <li>Battery หมดเร็ว</li>
        <li>เครื่องดับ</li>
        <li>ชาร์จผิดปกติ</li>
        <li>Battery บวม</li>
        </ul>
        <p>หาก Battery บวม ไม่ควรกดตัวเครื่องหรือชาร์จซ้ำโดยไม่จำเป็น</p>
        </div>
        <div class="comm-card">
          <h2>ประวัติการเปลี่ยนอะไหล่ควรแจ้งตามที่ทราบ</h2>
        <p>ควรแจ้งหากเครื่องเคย:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อมระบบชาร์จ</li>
        <li>ซ่อม Board</li>
        <li>โดนน้ำ</li>
        <li>ตกกระแทกหนัก</li>
        </ul>
        <p>ประวัติซ่อมไม่ได้หมายความว่าเครื่องขายไม่ได้ แต่ช่วยให้สภาพที่ใช้ประเมินตรงกับเครื่องจริงมากขึ้น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอควรตรวจทั้งภาพและ Touch</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>รอย</li>
        <li>กระจกแตก</li>
        <li>จุด</li>
        <li>เส้น</li>
        <li>สีผิดปกติ</li>
        <li>Touch ไม่ครบ</li>
        <li>จอกระพริบ</li>
        <li>แสงผิดปกติ</li>
        </ul>
        <p>หากเคยเปลี่ยนจอ ควรแจ้งเท่าที่ทราบ</p>
        </div>
        <div class="comm-card">
          <h2>Face ID ควรทดสอบก่อนขายหากเครื่องใช้งานได้</h2>
        <p>สามารถแจ้งว่า:</p>
        <ul>
        <li>Face ID ใช้งานได้</li>
        <li>ใช้งานไม่ได้</li>
        <li>ทำงานเป็นบางครั้ง</li>
        <li>ระบบแสดงข้อความผิดปกติ</li>
        </ul>
        <p>หากใช้ไม่ได้ ไม่ควรวินิจฉัยสาเหตุเองว่าเกิดจากชิ้นส่วนใดโดยไม่มีการตรวจ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>กล้องแต่ละตัวควรตรวจตามฟังก์ชัน</h2>
        <p>ควรสังเกต:</p>
        <ul>
        <li>โฟกัส</li>
        <li>ภาพสั่น</li>
        <li>Lens</li>
        <li>กล้องหน้า</li>
        <li>กล้องหลัง</li>
        <li>การสลับระยะตามรุ่น</li>
        </ul>
        <p>หากมีอาการ สามารถส่งตัวอย่างหรือแจ้งอาการตามที่พบ</p>
        </div>
        <div class="comm-card">
          <h2>Speaker Microphone และ Port ชาร์จก็ควรแจ้ง</h2>
        <p>iPhone ที่หน้าจอและ Battery ปกติอาจยังมีอาการในส่วนอื่น</p>
        <p>เช่น:</p>
        <ul>
        <li>Speaker เสียงแตก</li>
        <li>Microphone เบา</li>
        <li>Port ชาร์จหลวม</li>
        <li>ชาร์จติดบางครั้ง</li>
        <li>ปุ่มมีปัญหา</li>
        <li>Vibration ผิดปกติ</li>
        </ul>
        <p>ควรแจ้งตามสภาพจริง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Apple ID และ Find My ต้องจัดการโดยเจ้าของเครื่อง</h2>
        <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชีที่ผูกกับเครื่องของตนเองได้</p>
        <p>แต่เพื่อสอบถามราคา <strong>ไม่ต้องส่งรหัสลับ</strong></p>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Apple ID Password</li>
        <li>Passcode</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>การประเมินเบื้องต้นไม่จำเป็นต้องได้รับข้อมูลเหล่านี้</p>
        </div>
        <div class="comm-card">
          <h2>IMEI และ Serial ไม่จำเป็นต้องโพสต์สาธารณะ</h2>
        <p>สามารถเริ่มจาก:</p>
        <p><strong>รุ่น + ความจุ + Battery + รูป + สภาพ</strong></p>
        <p>ก่อน</p>
        <p>หากภายหลังจำเป็นต้องใช้ IMEI หรือ Serial ในขั้นตอนตรวจสอบเพิ่มเติม ควรส่งผ่านช่องทางที่เหมาะสม ไม่ควรโพสต์ข้อมูลระบุตัวเครื่องสาธารณะโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ไม่มีกล่องหรือสายยังส่งมาประเมินได้</h2>
        <p>ควรแจ้งสิ่งที่มีจริง เช่น:</p>
        <ul>
        <li>กล่อง</li>
        <li>สาย</li>
        <li>Adapter</li>
        <li>เคส</li>
        <li>ใบเสร็จ</li>
        </ul>
        <p>ไม่มีอุปกรณ์บางอย่างยังสามารถเช็กราคาได้</p>
        <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนทราบว่าคุ้มกับมูลค่าที่เพิ่มหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดยังส่งข้อมูลได้</h2>
        <p>สามารถเริ่มจาก:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>สี</li>
        <li>รูป</li>
        <li>อาการ</li>
        <li>ประวัติซ่อม</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        </ul>
        <p>เครื่องที่ไม่สามารถทดสอบฟังก์ชันได้จะมีความไม่แน่นอนมากกว่าเครื่องที่ใช้งานได้</p>
        <p>หาก Battery บวม เครื่องร้อน หรือมีกลิ่นไหม้ ไม่ควรชาร์จหรือเปิดซ้ำหลายครั้ง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>หน้าร้อยเอ็ดต่างจากหน้ารับซื้อ iPhone หลัก</h2>
        <p>หน้า <a href="/รับซื้อไอโฟน/">รับซื้อไอโฟน</a> เป็น Broad iPhone Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อไอโฟน-iphone-ร้อยเอ็ด/</code></p>
        <p>รักษา:</p>
        <p><strong>iPhone + Roi Et</strong></p>
        <p>จึงไม่ควรเปลี่ยนหน้านี้ให้ครอบคลุมมือถือทุกระบบหรือแข่งขันกับ Parent ด้วย Intent ระดับประเทศ</p>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา iPhone ในร้อยเอ็ด</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งรุ่น</h3>
              <p>Generation และรุ่นย่อย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้งความจุ</h3>
              <p>ตามเครื่องจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. แจ้ง Battery Health</h3>
              <p>ถ้าระบบแสดง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. ส่งรูป</h3>
              <p>หน้า หลัง กรอบและชุดกล้อง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. ตรวจหน้าจอ</h3>
              <p>รวม Touch และตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. ตรวจ Face ID และกล้อง</h3>
              <p>แจ้งอาการถ้ามี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งประวัติซ่อม</h3>
              <p>เท่าที่ทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งอุปกรณ์</h3>
              <p>ตามสิ่งที่รวมขาย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เช็กราคาเบื้องต้น</h3>
              <p>ก่อนซื้ออะไหล่หรือซ่อมเพิ่ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
