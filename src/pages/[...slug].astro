---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBar from '../components/TrustBar.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';
import { normalizePath } from '../lib/seo/normalize';

const { slug } = Astro.params;
const currentPath = normalizePath(slug ? `/${slug}/` : '/');

// Resolve SEO logic
const seo = resolveSeo(currentPath);

// Fetch content from collection
const pages = await getCollection('pages');
const pageEntry = pages.find(p => normalizePath(`/${p.data.slug}/`) === currentPath || p.id === slug || p.id === `${slug}.md`);

if (!pageEntry) {
  Astro.response.status = 404;
}

const { Content } = pageEntry ? await render(pageEntry) : { Content: null };

// Breadcrumbs
const breadcrumbs = [
  ...(seo.parent ? [{ name: 'หมวดหมู่หลัก', url: seo.parent }] : []),
  { name: pageEntry?.data.title || seo.title || 'หน้าบริการ', url: currentPath }
];

// Internal Links
const internalLinks = getInternalLinks(seo);
---

{pageEntry && Content ? (
  <BaseLayout
    title={pageEntry.data.title}
    description={pageEntry.data.description}
    breadcrumbs={breadcrumbs}
    faqs={pageEntry.data.faqItems}
    noindex={seo.state !== 'INDEX'}
  >
    <Breadcrumb items={breadcrumbs} />

    <section class="section article-header-section">
      <div class="container container-narrow">
        <div class="header-meta">
          <span class="badge badge-accent">{pageEntry.data.contentCluster.toUpperCase()}</span>
          {pageEntry.data.updatedDate && (
            <span class="updated-text">อัปเดตล่าสุด: {pageEntry.data.updatedDate}</span>
          )}
        </div>
        <h1 class="page-main-h1">{pageEntry.data.h1 || pageEntry.data.title}</h1>
        <p class="page-lead-desc">{pageEntry.data.description}</p>
      </div>
    </section>

    <TrustBar />

    <section class="section">
      <div class="container container-narrow">
        <article class="prose-content card" style="padding: 2.5rem 2rem;">
          <Content />
        </article>

        {pageEntry.data.faqItems && pageEntry.data.faqItems.length > 0 && (
          <div style="margin-top: 3.5rem;">
            <FAQ items={pageEntry.data.faqItems} />
          </div>
        )}

        <RelatedLinks
          clusterLinks={internalLinks.clusterLinks}
          parentLink={internalLinks.parentLink}
          guideLinks={internalLinks.guideLinks}
        />
      </div>
    </section>

    <CTA />
  </BaseLayout>
) : (
  <BaseLayout title="404 ไม่พบหน้า | เรารับซื้อ.com" noindex={true}>
    <div class="section" style="text-align: center; padding: 5rem 1.5rem;">
      <h1 style="font-size: 3rem; color: var(--color-accent); margin-bottom: 1rem;">404</h1>
      <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 2rem;">ไม่พบหน้าที่คุณต้องการ</p>
      <a href="/" class="btn btn-primary">กลับสู่หน้าแรก</a>
    </div>
  </BaseLayout>
)}

<style>
  .article-header-section {
    padding: 3rem 0 2rem 0;
    text-align: center;
  }

  .header-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .updated-text {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }

  .page-main-h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .page-lead-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .prose-content :global(h2) {
    font-size: 1.6rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .prose-content :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .prose-content :global(ul) {
    margin-bottom: 1.5rem;
  }

  .prose-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
</style>
