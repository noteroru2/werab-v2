---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { resolveSeo } from '../lib/seo/resolve';
import { getInternalLinks } from '../lib/seo/internal-links';
import { normalizePath } from '../lib/seo/normalize';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const { slug } = Astro.params;
const currentPath = normalizePath(slug ? `/${slug}/` : '/');

// Resolve SEO logic
const seo = resolveSeo(currentPath);

// Fetch content from collection
const pages = await getCollection('pages');
const pageEntry = pages.find(p => normalizePath(`/${p.data.slug}/`) === currentPath || p.id === slug || p.id === `${slug}.md`);

if (!pageEntry) {
  Astro.response.status = 404;
}

const { Content } = pageEntry ? await render(pageEntry) : { Content: null };

// Breadcrumbs
const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  ...(seo.parent ? [{ name: seo.parent.replace(/\//g, ''), url: seo.parent }] : []),
  { name: pageEntry?.data.h1 || pageEntry?.data.title || seo.h1 || seo.title || 'หน้าบริการ', url: currentPath }
];

// Internal Links
const internalLinks = getInternalLinks(seo);
const editorialDate = pageEntry?.data.lastReviewed || pageEntry?.data.updatedDate || pageEntry?.data.pubDate;
const shouldUseArticleSchema = Boolean(pageEntry && ['guide', 'model', 'condition', 'location'].includes(pageEntry.data.pageType));

// Select product asset based on content cluster or title
let productImg = '/images/hero-speaker.webp';
let productImgMobile = '/images/hero-speaker-500.webp';
let productAvif = '/images/hero-speaker.avif';
let productAvifMobile = '/images/hero-speaker-500.avif';

if (pageEntry?.data.contentCluster === 'notebook' || pageEntry?.data.title.includes('โน๊ตบุ๊ค')) {
  productImg = '/images/hero-laptop.webp';
  productImgMobile = '/images/hero-laptop-500.webp';
  productAvif = '/images/hero-laptop.avif';
  productAvifMobile = '/images/hero-laptop-500.avif';
} else if (pageEntry?.data.contentCluster === 'pc' || pageEntry?.data.title.includes('คอม')) {
  productImg = '/images/hero-desktop-pc.webp';
  productImgMobile = '/images/hero-desktop-pc-500.webp';
  productAvif = '/images/hero-desktop-pc.avif';
  productAvifMobile = '/images/hero-desktop-pc-500.avif';
} else if (pageEntry?.data.contentCluster === 'camera' || pageEntry?.data.title.includes('กล้อง')) {
  productImg = '/images/hero-camera.webp';
  productImgMobile = '/images/hero-camera-500.webp';
  productAvif = '/images/hero-camera.avif';
  productAvifMobile = '/images/hero-camera-500.avif';
} else if (pageEntry?.data.contentCluster === 'macbook' || pageEntry?.data.title.includes('MacBook')) {
  productImg = '/images/hero-macbook.webp';
  productImgMobile = '/images/hero-macbook-500.webp';
  productAvif = '/images/hero-macbook.avif';
  productAvifMobile = '/images/hero-macbook-500.avif';
} else if (pageEntry?.data.contentCluster === 'ipad' || pageEntry?.data.title.includes('iPad')) {
  productImg = '/images/hero-tablet.webp';
  productImgMobile = '/images/hero-tablet-500.webp';
  productAvif = '/images/hero-tablet.avif';
  productAvifMobile = '/images/hero-tablet-500.avif';
} else if (pageEntry?.data.contentCluster === 'iphone' || pageEntry?.data.contentCluster === 'android' || pageEntry?.data.title.includes('iPhone')) {
  productImg = '/images/hero-smartphone.webp';
  productImgMobile = '/images/hero-smartphone-500.webp';
  productAvif = '/images/hero-smartphone.avif';
  productAvifMobile = '/images/hero-smartphone-500.avif';
} else if (pageEntry?.data.contentCluster === 'general' || pageEntry?.data.contentCluster === 'condition' || pageEntry?.data.contentCluster === 'valuation') {
  productImg = '/images/hero-it-products.webp';
  productImgMobile = '/images/hero-it-products-640.webp';
  productAvif = '/images/hero-it-products.avif';
  productAvifMobile = '/images/hero-it-products-640.avif';
}
---

{pageEntry && Content ? (
  <BaseLayout
    title={pageEntry.data.title}
    description={pageEntry.data.description}
    breadcrumbs={breadcrumbs}
    faqs={pageEntry.data.faqItems}
    noindex={seo.state !== 'INDEX'}
    socialImage={productImg}
    socialImageAlt={pageEntry.data.heroImageAlt || pageEntry.data.title}
    article={shouldUseArticleSchema ? {
      headline: pageEntry.data.h1 || pageEntry.data.title,
      description: pageEntry.data.description,
      image: productImg,
      datePublished: pageEntry.data.pubDate,
      dateModified: editorialDate,
      authorName: pageEntry.data.author || 'ทีมงานเรารับซื้อ'
    } : undefined}
  >
    <!-- COMMERCIAL LOCAL HERO -->
    <section class="commercial-hero commercial-hero-local">
      <div class="container">
        <div class="local-hero-grid">
          <div class="local-hero-left">
            <Breadcrumb items={breadcrumbs} />
            <h1 class="hero-h1">{pageEntry.data.h1 || pageEntry.data.title}</h1>
            <p class="hero-lead-text">{pageEntry.data.description}</p>

            {(pageEntry.data.author || pageEntry.data.reviewer || editorialDate) && (
              <p class="editorial-meta">
                {pageEntry.data.author && <span>เรียบเรียงโดย {pageEntry.data.author}</span>}
                {pageEntry.data.reviewer && <span>ตรวจทานโดย {pageEntry.data.reviewer}</span>}
                {editorialDate && <time datetime={editorialDate}>อัปเดต {new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' }).format(new Date(editorialDate))}</time>}
              </p>
            )}

            <div class="hero-intake-card">
              <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่งข้อมูล:</p>
              <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
                <strong>Brand + Model + สเปก + รูป + สภาพ + อุปกรณ์</strong>
              </p>
              <div class="hero-cta-bar">
                <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                  </svg>
                  <span>LINE: <strong>{getDisplayLine()}</strong></span>
                </a>
                <a href={getPhoneUrl()} class="btn btn-phone">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>โทร: <strong>{getDisplayPhone()}</strong></span>
                </a>
              </div>
            </div>
          </div>

          <div class="local-hero-right">
            <div class="local-product-visual-wrap">
              <picture>
                <source media="(max-width: 640px)" srcset={productAvifMobile} type="image/avif" />
                <source media="(max-width: 640px)" srcset={productImgMobile} type="image/webp" />
                <source srcset={productAvif} type="image/avif" />
                <source srcset={productImg} type="image/webp" />
                <img
                  src={productImg}
                  alt={pageEntry.data.title}
                  width="979"
                  height="667"
                  class="local-hero-product-img"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </picture>
            </div>
          </div>
        </div>
      </div>
    </section>

    <nav class="page-jump-nav" aria-label="สารบัญหน้านี้">
      <div class="container page-jump-inner">
        <span>ไปยัง:</span>
        <a href="#รายละเอียด">รายละเอียด</a>
        {pageEntry.data.faqItems && pageEntry.data.faqItems.length > 0 && <a href="#คำถามที่พบบ่อย">คำถามที่พบบ่อย</a>}
        <a href="#หน้าที่เกี่ยวข้อง">หน้าที่เกี่ยวข้อง</a>
      </div>
    </nav>

    <!-- CONTENT SECTION -->
    <section id="รายละเอียด" class="commercial-section section-white">
      <div class="container">
        <div class="comm-card" style="padding: 2.25rem 2rem;">
          <article class="prose-content">
            <Content />
          </article>
        </div>
      </div>
    </section>

    {pageEntry.data.faqItems && pageEntry.data.faqItems.length > 0 && (
      <section id="คำถามที่พบบ่อย" class="commercial-section section-surface">
        <div class="container">
          <FAQ items={pageEntry.data.faqItems} />
        </div>
      </section>
    )}

    <section id="หน้าที่เกี่ยวข้อง" class="commercial-section section-white">
      <div class="container">
        <RelatedLinks
          clusterLinks={internalLinks.clusterLinks}
          parentLink={internalLinks.parentLink}
          guideLinks={internalLinks.guideLinks}
        />
      </div>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title="404 ไม่พบหน้า | เรารับซื้อ.com" noindex={true}>
    <div class="commercial-section" style="text-align: center; padding: 5rem 1.5rem;">
      <h1 style="font-size: 3rem; color: #ff6412; margin-bottom: 1rem;">404</h1>
      <p style="font-size: 1.2rem; color: var(--text-muted); margin-bottom: 2rem;">ไม่พบหน้าที่คุณต้องการ</p>
      <a href="/" class="btn btn-line">กลับสู่หน้าแรก</a>
    </div>
  </BaseLayout>
)}
