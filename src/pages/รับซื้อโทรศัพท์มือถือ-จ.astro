---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโทรศัพท์มือถือมือสอง ภาคอีสาน เช็กราคาสมาร์ทโฟนก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโทรศัพท์มือถือมือสองสำหรับผู้ขายในภาคอีสาน ทั้ง iPhone และสมาร์ทโฟนหลายรุ่น ประเมินจากรุ่น ความจุ แบตเตอรี่ หน้าจอ สภาพ อุปกรณ์และประวัติซ่อม ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอโฟน",
    "url": "/รับซื้อไอโฟน/"
  },
  {
    "name": "รับซื้อโทรศัพท์มือถือมือสองในภาคอีสาน เช็กรุ่น สภาพ และราคาก่อนขาย",
    "url": "/รับซื้อโทรศัพท์มือถือ-จ/"
  }
];

const faqs = [
  {
    "question": "อยู่ต่างจังหวัดในภาคอีสานสามารถส่งรูปเช็กราคาก่อนได้ไหม?",
    "answer": "สามารถเริ่มจากส่งรุ่น ความจุ รูป Battery และสภาพเพื่อประเมินเบื้องต้นก่อน แล้วจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม"
  },
  {
    "question": "Android และ iPhone ใช้ข้อมูลประเมินเหมือนกันหรือไม่?",
    "answer": "มีข้อมูลพื้นฐานร่วมกัน เช่น รุ่น ความจุ สภาพหน้าจอ Battery และประวัติซ่อม แต่รายละเอียดเฉพาะรุ่นหรือระบบอาจแตกต่างกัน จึงควรแจ้งรุ่นเต็มของเครื่อง"
  },
  {
    "question": "เครื่องเปลี่ยนจอหรือ Battery มาแล้วขายได้ไหม?",
    "answer": "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งประวัติที่ทราบและอาการปัจจุบันตามจริง"
  },
  {
    "question": "เครื่องเปิดไม่ติดยังเช็กราคาได้ไหม?",
    "answer": "สามารถเริ่มจากรุ่น ความจุ รูป อาการ ประวัติตก โดนน้ำหรือซ่อมได้ แต่เครื่องที่ไม่สามารถทดสอบได้จะมีความไม่แน่นอนมากกว่าเครื่องใช้งานปกติ"
  },
  {
    "question": "ต้องส่ง Password หรือรหัสปลดล็อกเพื่อถามราคาหรือไม่?",
    "answer": "ไม่ต้องส่ง Password, PIN, OTP หรือ Recovery Code เพื่อขอราคาประเมินเบื้องต้น"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโทรศัพท์มือถือมือสองในภาคอีสาน เช็กรุ่น สภาพ และราคาก่อนขาย</h1>
        <p>หากมีโทรศัพท์มือถือมือสองอยู่ในภาคอีสานและกำลังคิดว่าจะขาย การเริ่มจากเช็กรุ่น ความจุ สภาพ แบตเตอรี่ และอุปกรณ์ก่อน ช่วยให้ประเมินเครื่องได้ตรงกว่าการแจ้งเพียงยี่ห้อหรือชื่อ Series</p>
        
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>ยี่ห้อ + รุ่นเต็ม + ความจุ + สี + สภาพ + Battery ถ้าตรวจได้ + รูปเครื่อง</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.webp" type="image/webp" />
              <source srcset="/images/hero-smartphone.avif" type="image/avif" />
              <source srcset="/images/hero-smartphone.webp" type="image/webp" />
              <img
                src="/images/hero-smartphone.webp"
                alt="รับซื้อโทรศัพท์มือถือมือสองในภาคอีสาน เช็กรุ่น สภาพ และราคาก่อนขาย"
                width="668"
                height="717"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>โทรศัพท์แบบไหนส่งข้อมูลมาเช็กราคาได้</h2>
        <p>สามารถเริ่มส่งรายละเอียดของสมาร์ทโฟนหลายประเภท เช่น</p>
        <ul>
        <li>iPhone</li>
        <li>Samsung Galaxy</li>
        <li>Samsung Galaxy S Series</li>
        <li>Samsung Galaxy Z Series</li>
        <li>OPPO</li>
        <li>vivo</li>
        <li>Xiaomi</li>
        <li>Redmi</li>
        <li>realme</li>
        <li>HONOR</li>
        <li>Google Pixel</li>
        <li>สมาร์ทโฟนรุ่นอื่น</li>
        </ul>
        <p>การระบุแบรนด์ไม่ได้หมายความว่ามีความเกี่ยวข้องหรือได้รับการแต่งตั้งจากผู้ผลิตรายใด</p>
        <p>มูลค่าของแต่ละเครื่องต้องดูรุ่นและสภาพจริงร่วมกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนประเมินควรรู้รุ่นเต็ม</h2>
        <p>ชื่ออย่าง:</p>
        <p><strong>Galaxy S</strong></p>
        <p>หรือ</p>
        <p><strong>iPhone Pro</strong></p>
        <p>ยังไม่เพียงพอ</p>
        <p>ควรแจ้งให้ชัด เช่น</p>
        <ul>
        <li>รุ่น</li>
        <li>Generation</li>
        <li>ความจุ</li>
        <li>สี</li>
        <li>RAM ถ้าเกี่ยวข้องและทราบ</li>
        <li>รุ่นเครื่องหรือ Model Number เมื่อจำเป็น</li>
        </ul>
        <p>โทรศัพท์ชื่อใกล้กันอาจมีราคามือสองต่างกันมาก</p>
        </div>
        <div class="comm-card">
          <h2>ความจุมีผลต่อการแยกเครื่อง</h2>
        <p>ควรแจ้ง Storage ที่ถูกต้อง เช่น</p>
        <ul>
        <li>128GB</li>
        <li>256GB</li>
        <li>512GB</li>
        <li>1TB</li>
        </ul>
        <p>ไม่ควรคาดเดาจากความจำหากสามารถเปิดดูข้อมูลในเครื่องได้</p>
        <p>สำหรับเครื่องที่เปิดไม่ได้ สามารถแจ้งเท่าที่ทราบและใช้ข้อมูลจากกล่องหรือหลักฐานเดิมประกอบ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>สภาพหน้าจอควรถ่ายให้เห็น</h2>
        <p>ควรถ่ายหน้าจอขณะเปิดเครื่องถ้าเครื่องยังใช้งานได้</p>
        <p>แจ้งหากมี:</p>
        <ul>
        <li>รอย</li>
        <li>จุด</li>
        <li>เส้น</li>
        <li>Burn-in</li>
        <li>สีผิดปกติ</li>
        <li>Touch มีปัญหา</li>
        <li>กระจกแตก</li>
        <li>หน้าจอแตก</li>
        <li>จอกระพริบ</li>
        <li>จอไม่แสดงผล</li>
        </ul>
        <p>อย่าสรุปว่าเสียเฉพาะ Panel หรือสายจอหากยังไม่ได้ตรวจ</p>
        </div>
        <div class="comm-card">
          <h2>ฝาหลัง กรอบ และกล้องควรตรวจด้วย</h2>
        <p>ควรถ่าย:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านหลัง</li>
        <li>กรอบเครื่อง</li>
        <li>มุมทั้งสี่</li>
        <li>ชุดกล้อง</li>
        <li>Port</li>
        <li>จุดที่มีรอยหรือแตก</li>
        </ul>
        <p>ตำหนิเล็กน้อยกับความเสียหายที่กระทบโครงสร้างควรพิจารณาต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery ควรแจ้งอย่างไร</h2>
        <p>สำหรับรุ่นที่สามารถตรวจ Battery Health ได้ ควรส่งข้อมูลนั้นประกอบ</p>
        <p>หากไม่มีเปอร์เซ็นต์ Health ให้แจ้งอาการจริง เช่น</p>
        <ul>
        <li>ใช้งานได้ปกติ</li>
        <li>หมดเร็ว</li>
        <li>ดับเมื่อ Battery เหลือน้อย</li>
        <li>ชาร์จช้า</li>
        <li>Battery บวม</li>
        <li>เคยเปลี่ยน Battery</li>
        </ul>
        <p>หาก Battery บวมควรหลีกเลี่ยงการกดเครื่องหรือใช้งานหนักโดยไม่จำเป็น</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเคยเปลี่ยนจอหรือ Battery ยังขายได้ไหม</h2>
        <p>สามารถส่งข้อมูลมาประเมินตามสภาพได้</p>
        <p>ควรแจ้งหากทราบว่าเคย:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อม Board</li>
        <li>ซ่อมระบบชาร์จ</li>
        <li>โดนน้ำ</li>
        <li>ตกกระแทกหนัก</li>
        </ul>
        <p>ประวัติซ่อมไม่ได้แปลว่าเครื่องไม่มีมูลค่า แต่มีผลต่อการประเมินความเสี่ยงและสภาพ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องติดล็อกบัญชีต้องแจ้งก่อน</h2>
        <p>ก่อนส่งมอบจริง เจ้าของควรตรวจเรื่องบัญชีของตนเอง เช่น Apple ID หรือบัญชีผู้ผลิตที่ผูกกับเครื่อง</p>
        <p>เพื่อขอราคาประเมินไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Code</li>
        <li>Email Password</li>
        <li>รหัสยืนยันบัญชี</li>
        </ul>
        <p>การประเมิน Hardware ไม่จำเป็นต้องได้รับรหัสลับเหล่านี้</p>
        </div>
        <div class="comm-card">
          <h2>IMEI หรือ Serial ควรส่งเมื่อไร</h2>
        <p>สำหรับการสอบถามราคาเบื้องต้น สามารถเริ่มจากรุ่น ความจุ และรูปก่อน</p>
        <p>หากจำเป็นต้องใช้ IMEI หรือ Serial ในขั้นตอนตรวจสอบภายหลัง ควรส่งผ่านช่องทางที่เหมาะสม และไม่ควรนำข้อมูลระบุตัวเครื่องไปโพสต์สาธารณะโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>มีกล่องหรือไม่มีอุปกรณ์มีผลไหม</h2>
        <p>ควรแจ้งสิ่งที่รวมขายจริง เช่น</p>
        <ul>
        <li>กล่อง</li>
        <li>สายชาร์จ</li>
        <li>Adapter</li>
        <li>เคส</li>
        <li>ใบเสร็จ</li>
        <li>อุปกรณ์อื่น</li>
        </ul>
        <p>ไม่มีอุปกรณ์บางอย่างยังสามารถส่งมาเช็กราคาได้</p>
        <p>ไม่จำเป็นต้องซื้อกล่องหรืออุปกรณ์ใหม่เพียงเพื่อเพิ่มความครบก่อนรู้ว่าคุ้มค่าหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดยังเริ่มประเมินได้หรือไม่</h2>
        <p>สามารถส่งข้อมูลตามสภาพได้</p>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>Storage</li>
        <li>อาการ</li>
        <li>ชาร์จเข้าไหม</li>
        <li>มีไฟหรือสั่นหรือไม่</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>เคยซ่อมหรือไม่</li>
        </ul>
        <p>หากเครื่องร้อนผิดปกติ มีกลิ่นไหม้ หรือ Battery บวม ไม่ควรเปิดหรือชาร์จซ้ำหลายครั้งโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ผู้ขายในภาคอีสานควรเริ่มจากข้อมูลก่อนการเดินทาง</h2>
        <p>ไม่ว่าจะอยู่จังหวัดใดในภาคอีสาน ขั้นตอนแรกสามารถเริ่มจากส่งข้อมูลเครื่องเพื่อเช็กราคาเบื้องต้น</p>
        <p>หลังจากทราบข้อมูลและความเป็นไปได้แล้ว จึงค่อยพิจารณาวิธีตรวจสินค้าและส่งมอบตามพื้นที่จริง</p>
        <p>หน้านี้ไม่ได้หมายความว่า:</p>
        <ul>
        <li>มีสาขาในทุกจังหวัด</li>
        <li>มีพนักงานประจำทุกพื้นที่</li>
        <li>รับประกันว่าจะเดินทางไปรับทุกกรณี</li>
        </ul>
        </div>
        <div class="comm-card">
          <h2>ปัจจัยหลักที่ใช้ประเมินโทรศัพท์มือถือมือสอง</h2>
        <h3>รุ่น</h3>
        <p>รุ่นและ Generation เป็นข้อมูลพื้นฐานที่สุด</p>
        <h3>ความจุ</h3>
        <p>Storage ที่ต่างกันอาจมีมูลค่าต่างกัน</p>
        <h3>สภาพหน้าจอ</h3>
        <p>รวมกระจก Panel Touch และตำหนิ</p>
        <h3>Battery</h3>
        <p>ดู Health หรืออาการเท่าที่ตรวจได้</p>
        <h3>ตัวเครื่อง</h3>
        <p>ดูกรอบ ฝาหลัง และรอยกระแทก</p>
        <h3>กล้องและระบบหลัก</h3>
        <p>ควรแจ้งหากมีอาการ</p>
        <h3>ประวัติซ่อม</h3>
        <p>รวมการเปลี่ยนอะไหล่และความเสียหายจากน้ำ</p>
        <h3>อุปกรณ์</h3>
        <p>พิจารณาตามสิ่งที่รวมขายจริง</p>
        <h3>สถานะบัญชี</h3>
        <p>ต้องพร้อมสำหรับการส่งมอบโดยไม่ขอรหัสลับจากผู้ขาย</p>
        <h3>ตลาดของรุ่น</h3>
        <p>ราคาของสมาร์ทโฟนแต่ละรุ่นเปลี่ยนแปลงได้ตามเวลา</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
