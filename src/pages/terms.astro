---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { BUSINESS_FACTS } from '../config/business';
import { resolveSeo } from '../lib/seo/resolve';
const seo = resolveSeo('/terms/');
const breadcrumbs = [{ name: 'หน้าแรก', url: '/' }, { name: 'เงื่อนไขการประเมินและซื้อขาย', url: '/terms/' }];
---
<BaseLayout title={seo.title} description={seo.description} breadcrumbs={breadcrumbs}>
  <section class="commercial-section section-white">
    <div class="container container-narrow">
      <Breadcrumb items={breadcrumbs} />
      <div class="comm-card">
        <h1>{seo.h1}</h1>
        <p>เงื่อนไขนี้ใช้เพื่ออธิบายความแตกต่างระหว่างการเช็กราคาเบื้องต้นและการตกลงซื้อขายจริงกับ {BUSINESS_FACTS.VERIFIED.brandName}</p>
        <h2>1. ราคาจากรูปและข้อมูลเป็นการประเมินเบื้องต้น</h2>
        <p>ราคาที่แจ้งก่อนเห็นสินค้าจริงอ้างอิงจากรุ่น สเปก สภาพ อาการ และอุปกรณ์ตามข้อมูลที่ผู้ขายส่งมา หากข้อมูลจริงต่างจากที่แจ้ง ราคาสุดท้ายอาจเปลี่ยนตามสิ่งที่ตรวจพบ</p>
        <h2>2. ราคาสุดท้ายต้องยืนยันก่อนส่งมอบ</h2>
        <p>เมื่อสามารถตรวจรุ่น สเปก การทำงาน ตำหนิ และอุปกรณ์ได้แล้ว ควรสรุปราคาสุดท้ายให้ชัดก่อนที่ผู้ขายจะตกลงส่งมอบสินค้า</p>
        <h2>3. ผู้ขายควรมีสิทธิ์จำหน่ายสินค้า</h2>
        <p>สินค้าที่นำมาขายควรอยู่ในสิทธิ์ของผู้ขายและไม่มีข้อจำกัดจากบัญชี ระบบล็อก หรือสิทธิ์ของบุคคลอื่นที่ขัดกับการส่งมอบ หากมีข้อสงสัยควรยืนยันสิทธิ์ให้เรียบร้อยก่อนทำรายการ</p>
        <h2>4. การสำรองและล้างข้อมูล</h2>
        <p>ผู้ขายควรสำรองข้อมูล ออกจากบัญชี และจัดการข้อมูลส่วนตัวก่อนส่งมอบ ไม่ควรส่ง Password, PIN, OTP หรือ Recovery Key เพื่อใช้ในขั้นตอนเช็กราคา</p>
        <h2>5. อุปกรณ์ที่รวมขาย</h2>
        <p>กล่อง Adapter, Charger, สาย, Lens, Battery, ปากกา หรืออุปกรณ์อื่นควรระบุให้ชัดว่ารวมอยู่ในราคาหรือไม่ เพื่อป้องกันความเข้าใจต่างกันตอนส่งมอบ</p>
      </div>
    </div>
  </section>
</BaseLayout>
