---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อมือถือยโสธร โทรศัพท์มือสอง iPhone Android เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อมือถือมือสองในยโสธร ทั้ง iPhone และ Android ประเมินจากรุ่น ความจุ Battery หน้าจอ กล้อง สภาพ อุปกรณ์และประวัติซ่อม ส่งรูปเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อไอโฟน",
    "url": "/รับซื้อไอโฟน/"
  },
  {
    "name": "รับซื้อมือถือยโสธร เช็กรุ่น แบตเตอรี่ หน้าจอ และสภาพก่อนขาย",
    "url": "/รับซื้อโทรศัพท์-มือถือ-ย/"
  }
];

const faqs = [
  {
    "question": "iPhone และ Android ส่งมาเช็กราคาได้เหมือนกันไหม?",
    "answer": "สามารถเริ่มจากข้อมูลพื้นฐานคล้ายกัน เช่น รุ่น ความจุ Battery รูปและสภาพ แต่รายละเอียดเฉพาะรุ่นอาจต่างกัน จึงควรแจ้งชื่อรุ่นเต็ม"
  },
  {
    "question": "Battery เสื่อมต้องเปลี่ยนก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี ควรเช็กราคาตามสภาพก่อน แล้วค่อยเปรียบเทียบค่าเปลี่ยน Battery กับมูลค่าที่คาดว่าจะเพิ่ม"
  },
  {
    "question": "มือถือเคยเปลี่ยนจอยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งประวัติที่ทราบ รวมถึงสภาพจอ Touch และฟังก์ชันต่าง ๆ ในปัจจุบัน"
  },
  {
    "question": "เครื่องเปิดไม่ติดต้องซ่อมก่อนหรือไม่?",
    "answer": "ไม่จำเป็นทุกกรณี สามารถส่งรุ่น ความจุ รูป อาการและประวัติความเสียหายมาเช็กราคาเบื้องต้นก่อน"
  },
  {
    "question": "ต้องส่ง Password หรือ OTP เพื่อเช็กราคาไหม?",
    "answer": "ไม่ต้อง และไม่ควรส่ง Password, PIN, OTP หรือ Recovery Code เพื่อขอราคาประเมิน"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อมือถือยโสธร เช็กรุ่น แบตเตอรี่ หน้าจอ และสภาพก่อนขาย</h1>
        
        
        
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ก่อนเช็กราคาควรส่ง:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>ยี่ห้อ + รุ่น + ความจุ + สี + Battery + รูป + ตำหนิ + ประวัติซ่อมถ้ามี</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-smartphone-500.webp" type="image/webp" />
              <source srcset="/images/hero-smartphone.avif" type="image/avif" />
              <source srcset="/images/hero-smartphone.webp" type="image/webp" />
              <img
                src="/images/hero-smartphone.webp"
                alt="รับซื้อมือถือยโสธร เช็กรุ่น แบตเตอรี่ หน้าจอ และสภาพก่อนขาย"
                width="668"
                height="717"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ยโสธรสามารถส่งรูปและข้อมูลเครื่องมาก่อนได้</h2>
        <p>ไม่จำเป็นต้องเดินทางพร้อมโทรศัพท์เพียงเพื่อถามราคาเบื้องต้น</p>
        <p>สามารถเริ่มจาก:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>รูปหน้าและหลัง</li>
        <li>Battery</li>
        <li>สภาพหน้าจอ</li>
        <li>กล้อง</li>
        <li>ระบบปลดล็อก</li>
        <li>อุปกรณ์</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หลังจากนั้นจึงค่อยพิจารณาขั้นตอนตรวจสินค้าและส่งมอบตามพื้นที่และความเหมาะสม</p>
        <p>หน้านี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ในทุกพื้นที่ของจังหวัดยโสธร</p>
        </div>
        <div class="comm-card">
          <h2>iPhone และ Android ต้องแจ้งรุ่นเต็มเหมือนกัน</h2>
        <p>สำหรับ iPhone ควรแจ้งเช่น:</p>
        <p><strong>iPhone 13 128GB</strong></p>
        <p>หรือ</p>
        <p><strong>iPhone 15 Pro 256GB</strong></p>
        <p>สำหรับ Android ควรแจ้ง:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>Storage</li>
        <li>RAM ถ้าทราบ</li>
        <li>สี</li>
        </ul>
        <p>การแจ้งเพียงว่าเป็น Samsung, OPPO, vivo หรือ Xiaomi ยังไม่เพียงพอสำหรับแยกรุ่น</p>
        <p>การกล่าวถึงแบรนด์เป็นเพียงข้อมูลจำแนกสินค้า ไม่ได้หมายถึงความเกี่ยวข้องหรือการแต่งตั้งจากผู้ผลิต</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>หน้าจอมีผลต่อสภาพของมือถืออย่างมาก</h2>
        <p>ควรแจ้งหากมี:</p>
        <ul>
        <li>กระจกแตก</li>
        <li>จอแตก</li>
        <li>เส้น</li>
        <li>จุดดำ</li>
        <li>Burn-in</li>
        <li>สีผิดปกติ</li>
        <li>Touch ใช้ไม่ได้บางตำแหน่ง</li>
        <li>จอกระพริบ</li>
        <li>จอไม่ขึ้น</li>
        </ul>
        <p>ควรถ่ายให้เห็นอาการชัดเจนถ้าเครื่องยังเปิดได้</p>
        </div>
        <div class="comm-card">
          <h2>Battery ควรแจ้งจากข้อมูลที่ตรวจได้</h2>
        <p>สำหรับรุ่นที่มี Battery Health สามารถส่งเปอร์เซ็นต์ประกอบได้</p>
        <p>หากไม่มีค่า Health ให้แจ้งอาการ เช่น:</p>
        <ul>
        <li>ใช้งานได้ปกติ</li>
        <li>หมดเร็ว</li>
        <li>ดับเอง</li>
        <li>ชาร์จช้า</li>
        <li>ชาร์จไม่เข้า</li>
        <li>Battery บวม</li>
        <li>เคยเปลี่ยน Battery</li>
        </ul>
        <p>ถ้า Battery บวม ไม่ควรกดบริเวณตัวเครื่องหรือชาร์จซ้ำโดยไม่จำเป็น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>กล้องและระบบปลดล็อกต้องแจ้งเมื่อมีอาการ</h2>
        <p>ตัวอย่าง:</p>
        <ul>
        <li>กล้องไม่โฟกัส</li>
        <li>กล้องสั่น</li>
        <li>Lens แตก</li>
        <li>Face ID ใช้ไม่ได้</li>
        <li>Fingerprint ใช้ไม่ได้</li>
        <li>Speaker แตก</li>
        <li>Microphone มีปัญหา</li>
        <li>Port ชาร์จหลวม</li>
        </ul>
        <p>ควรแจ้งตามอาการจริง โดยไม่จำเป็นต้องวินิจฉัยว่าอะไหล่ชิ้นใดเสีย</p>
        </div>
        <div class="comm-card">
          <h2>มือถือเคยซ่อมหรือเปลี่ยนอะไหล่ยังเช็กราคาได้</h2>
        <p>ควรแจ้งหากทราบว่าเคย:</p>
        <ul>
        <li>เปลี่ยนจอ</li>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนฝาหลัง</li>
        <li>เปลี่ยนกล้อง</li>
        <li>ซ่อม Board</li>
        <li>ซ่อม Port ชาร์จ</li>
        <li>โดนน้ำ</li>
        <li>ตกกระแทกหนัก</li>
        </ul>
        <p>ประวัติซ่อมเป็นหนึ่งในข้อมูลประกอบ ไม่ได้หมายความว่าเครื่องจะขายไม่ได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องติดบัญชีหรือยังมีข้อมูลส่วนตัวควรทำอย่างไร</h2>
        <p>เพื่อขอราคาเบื้องต้น <strong>ไม่ต้องส่งรหัสผ่าน</strong></p>
        <p>ไม่ควรส่ง:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Apple ID Password</li>
        <li>Google Password</li>
        <li>Recovery Code</li>
        <li>Email Password</li>
        </ul>
        <p>ก่อนส่งมอบจริง เจ้าของควรสามารถจัดการบัญชีที่ผูกกับเครื่องของตนเองได้</p>
        </div>
        <div class="comm-card">
          <h2>IMEI ไม่จำเป็นต้องโพสต์สาธารณะเพื่อถามราคา</h2>
        <p>การประเมินเบื้องต้นสามารถเริ่มจาก:</p>
        <p><strong>รุ่น + ความจุ + Battery + รูป + สภาพ</strong></p>
        <p>ก่อน</p>
        <p>หากขั้นตอนตรวจสอบภายหลังจำเป็นต้องใช้ข้อมูลระบุตัวเครื่อง ควรส่งผ่านช่องทางที่เหมาะสม ไม่จำเป็นต้องโพสต์ IMEI สาธารณะ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดหรือโดนน้ำยังส่งข้อมูลได้</h2>
        <p>ควรแจ้ง:</p>
        <ul>
        <li>รุ่น</li>
        <li>ความจุ</li>
        <li>อาการ</li>
        <li>ชาร์จแล้วมีการตอบสนองหรือไม่</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>เคยซ่อมหรือไม่</li>
        </ul>
        <p>หากเครื่องร้อนผิดปกติ Battery บวม หรือมีกลิ่นไหม้ ไม่ควรทดลองชาร์จหรือเปิดซ้ำหลายครั้ง</p>
        </div>
        <div class="comm-card">
          <h2>ไม่มีกล่องหรืออุปกรณ์ยังขายได้ไหม</h2>
        <p>สามารถส่งมาประเมินได้</p>
        <p>แจ้งตามจริงว่า:</p>
        <ul>
        <li>มีกล่องหรือไม่</li>
        <li>มีสายหรือไม่</li>
        <li>มี Adapter หรือไม่</li>
        <li>มีอุปกรณ์ใดรวมขาย</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้ออุปกรณ์ใหม่มาเติมชุดก่อนรู้ว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคามือถือในยโสธร</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. แจ้งยี่ห้อและรุ่น</h3>
              <p>ใช้ชื่อเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้งความจุ</h3>
              <p>ตามเครื่องจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่งรูป</h3>
              <p>หน้า หลัง กรอบ กล้องและตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้ง Battery</h3>
              <p>Health หรืออาการถ้ามี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้งหน้าจอและระบบปลดล็อก</h3>
              <p>หากมีปัญหา</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้งประวัติซ่อม</h3>
              <p>เท่าที่ทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งอุปกรณ์</h3>
              <p>ตามสิ่งที่รวมขาย</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. ประเมินเบื้องต้น</h3>
              <p>จากรุ่นและสภาพ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. ตัดสินใจก่อนขาย</h3>
              <p>ยังไม่จำเป็นต้องตกลงทันที</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น สภาพและสิ่งที่รวมขายก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคามือถือในยโสธร</h2>
        <p>ส่ง:</p>
        <p><strong>รุ่น + ความจุ + Battery + รูป + ตำหนิ + อุปกรณ์</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
