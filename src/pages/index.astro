---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อสินค้าไอทีมือสอง เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อสินค้าไอทีมือสอง โน๊ตบุ๊ค คอม MacBook iPhone iPad กล้อง ลำโพง และอุปกรณ์ไอที ส่งรุ่น รูป สภาพและอุปกรณ์เพื่อเช็กราคาเบื้องต้นก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
>
  <!-- 1. WIDE COMMERCIAL HERO (54% / 46% SPLIT) -->
  <section class="home-hero-section">
    <div class="commercial-container">
      <div class="home-hero-grid">
        <!-- LEFT COLUMN: 54% -->
        <div class="home-hero-left">
          <h1 class="home-hero-h1">รับซื้อสินค้าไอทีมือสอง <span class="h1-orange-accent">เช็กราคาก่อนขายก่อนตัดสินใจ</span></h1>

          <p class="home-hero-lead">มีสินค้าไอทีที่ไม่ได้ใช้แล้ว แต่ยังไม่แน่ใจว่าควรขายราคาเท่าไร?</p>

          <!-- COMMERCIAL VALUE & APPROACH CARD -->
          <div class="home-hero-approach-card">
            <p class="approach-label">เรารับซื้อ.com ใช้แนวทาง:</p>
            <p class="approach-slogan">
              <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
            </p>
            <p class="approach-desc">
              เริ่มจากส่งข้อมูลของสินค้าที่มีจริง ไม่จำเป็นต้องรีบเดินทางหรือรีบล้างข้อมูลเพียงเพื่อถามราคาเบื้องต้น
            </p>
          </div>

          <!-- INTAKE SPEC TAG & CTAS -->
          <div class="home-hero-intake-card">
            <div class="intake-spec-row">
              <span class="intake-prompt-badge">ส่ง:</span>
              <p class="intake-spec-text">
                <strong>รุ่น + สเปก + รูป + สภาพ + อุปกรณ์</strong>
              </p>
            </div>

            <div class="home-hero-cta-bar">
              <a
                href={getLineUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-line btn-hero-action"
                aria-label={`LINE ${getDisplayLine()} แอดไลน์เพื่อส่งรูปและเช็กราคา`}
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>

              <a
                href={getPhoneUrl()}
                class="btn btn-phone btn-hero-action"
                aria-label={`โทร ${getDisplayPhone()} ปรึกษาและเช็กราคา`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: 46% LARGE PRODUCT COMPOSITION -->
        <div class="home-hero-right">
          <div class="product-visual-wrapper">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-it-products-640.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-it-products-640.webp" type="image/webp" />
              <source srcset="/images/hero-it-products.avif" type="image/avif" />
              <source srcset="/images/hero-it-products.webp" type="image/webp" />
              <img
                src="/images/hero-it-products.webp"
                alt="รับซื้อสินค้าไอทีมือสอง โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad กล้อง ลำโพง"
                width="1097"
                height="777"
                class="hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CATEGORY SELECTION TILES (8 TILES DIRECTLY UNDER HERO) -->
  <section class="commercial-section section-white">
    <div class="commercial-container">
      <div class="section-title-wrap">
        <h2 class="section-main-h2">เลือกประเภทสินค้าที่ต้องการเช็กราคา</h2>
      </div>

      <div class="home-category-grid">
        <!-- 1. โน๊ตบุ๊ค -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="1" y1="20" x2="23" y2="20"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อโน๊ตบุ๊ค/">โน๊ตบุ๊ค</a></h3>
            <p class="cat-desc">Notebook, Laptop, Gaming Notebook และเครื่องมีตำหนิบางประเภท</p>
            <p class="cat-spec-hint">ควรส่ง CPU, RAM, SSD, GPU, Battery และ Adapter</p>
          </div>
        </div>

        <!-- 2. คอมพิวเตอร์ -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="14" rx="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อคอม/">คอมพิวเตอร์</a></h3>
            <p class="cat-desc">Desktop, Gaming PC และคอมประกอบ</p>
            <p class="cat-spec-hint">ควรส่ง CPU, GPU, RAM, SSD, Mainboard และ PSU</p>
          </div>
        </div>

        <!-- 3. MacBook -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                <path d="M2 20h20"></path>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อแมคบุ๊ค/">MacBook</a></h3>
            <p class="cat-desc">MacBook Air และ MacBook Pro</p>
            <p class="cat-spec-hint">ควรส่งรุ่น Chip, RAM, SSD, Battery และสภาพ</p>
          </div>
        </div>

        <!-- 4. iPhone -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อไอโฟน/">iPhone</a></h3>
            <p class="cat-desc">ควรส่งรุ่น ความจุ Battery Health หน้าจอ การทำงาน และสภาพ</p>
          </div>
        </div>

        <!-- 5. iPad -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อไอแพด/">iPad</a></h3>
            <p class="cat-desc">ควรส่งรุ่น Generation ความจุ Wi-Fi/Cellular และอุปกรณ์</p>
          </div>
        </div>

        <!-- 6. กล้องและเลนส์ -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อกล้อง/">กล้องและเลนส์</a></h3>
            <p class="cat-desc">ควรแยก Body กับ Lens พร้อมแจ้ง Sensor, Shutter, สภาพและอุปกรณ์</p>
          </div>
        </div>

        <!-- 7. ลำโพง -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                <circle cx="12" cy="14" r="4"></circle>
                <line x1="12" y1="6" x2="12.01" y2="6"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title"><a href="/รับซื้อลำโพง/">ลำโพง</a></h3>
            <p class="cat-desc">ควรแจ้ง Brand, Model, Battery, การเชื่อมต่อและสภาพเสียง</p>
          </div>
        </div>

        <!-- 8. อุปกรณ์ไอทีอื่น -->
        <div class="cat-tile">
          <div class="cat-tile-top">
            <div class="cat-icon-wrap" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="cat-content">
            <h3 class="cat-title">อุปกรณ์ไอทีอื่น</h3>
            <p class="cat-desc">สามารถส่งชื่อสินค้า รุ่น รูปและสภาพมาสอบถามเบื้องต้นได้</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. EVALUATION FACTORS (CENTERED COMMERCIAL SURFACE PANEL) -->
  <section class="commercial-section section-surface">
    <div class="commercial-container">
      <div class="evaluation-panel-card">
        <h2 class="evaluation-panel-h2">การประเมินราคาไม่ได้ดูแค่ชื่อรุ่น</h2>
        <p class="evaluation-panel-lead">สินค้ารุ่นเดียวกันอาจมีราคาต่างกันได้จาก:</p>

        <ul class="evaluation-factor-grid">
          <li class="factor-item"><span>สเปก</span></li>
          <li class="factor-item"><span>ความจุ</span></li>
          <li class="factor-item"><span>Battery</span></li>
          <li class="factor-item"><span>สภาพ</span></li>
          <li class="factor-item"><span>อุปกรณ์</span></li>
          <li class="factor-item"><span>ประวัติซ่อม</span></li>
          <li class="factor-item"><span>การทำงาน</span></li>
          <li class="factor-item"><span>ประกันที่ตรวจสอบได้</span></li>
          <li class="factor-item"><span>ความต้องการในตลาดมือสอง</span></li>
        </ul>

        <p class="evaluation-panel-footer">จึงควรส่งข้อมูลของสินค้าจริงประกอบกัน</p>
      </div>
    </div>
  </section>

  <!-- 4. INFORMATION TO SEND (NUMBERED STEP CARDS) -->
  <section class="commercial-section section-white">
    <div class="commercial-container">
      <div class="section-title-wrap">
        <h2 class="section-main-h2">ส่งข้อมูลอะไรแล้วช่วยให้ประเมินได้ง่ายขึ้น</h2>
      </div>

      <div class="grid-3">
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>รุ่น</h3>
          <p>ชื่อรุ่นเต็มหรือ Model Number</p>
        </div>
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>สเปก</h3>
          <p>เช่น CPU, GPU, RAM, SSD หรือความจุ</p>
        </div>
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>รูปสินค้า</h3>
          <p>ทุกด้านและตำหนิ</p>
        </div>
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>สภาพ</h3>
          <p>เปิดติดหรือไม่ มีอาการอะไร</p>
        </div>
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>อุปกรณ์</h3>
          <p>Adapter, Charger, Box, Cable หรืออุปกรณ์เสริม</p>
        </div>
        <div class="info-send-card">
          <div class="info-card-badge" aria-hidden="true"></div>
          <h3>ประวัติ</h3>
          <p>เคยซ่อม ตก โดนน้ำ หรือเปลี่ยนอะไหล่หรือไม่</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FLAWED PRODUCTS & REPAIR VS AS-IS (2-COLUMN COMPARISON) -->
  <section class="commercial-section section-surface">
    <div class="commercial-container">
      <div class="grid-2">
        <div class="comm-card comm-card-accent-amber">
          <h2>สินค้ามีตำหนิไม่จำเป็นต้องซ่อมก่อนทุกครั้ง</h2>
          <p class="card-lead-text">หากสินค้า:</p>
          <ul class="styled-bullet-list">
            <li>จอแตก</li>
            <li>Battery เสื่อม</li>
            <li>ไม่มี Adapter</li>
            <li>มีรอย</li>
            <li>เคยซ่อม</li>
            <li>เปิดไม่ติด</li>
            <li>มีฟังก์ชันเสีย</li>
          </ul>
          <div class="callout-inner-box">
            <p>สามารถเริ่มจากเช็กราคาตามสภาพก่อนได้</p>
            <p>ก่อนนำไปซ่อมควรเปรียบเทียบค่าใช้จ่ายกับส่วนต่างมูลค่าที่คาดว่าจะเพิ่ม</p>
          </div>
        </div>

        <div class="comm-card comm-card-accent-blue">
          <h2>ควรซ่อมก่อนขายหรือขายตามสภาพ</h2>
          <p class="card-lead-text">ให้เปรียบเทียบ:</p>
          <ol class="styled-numbered-list">
            <li>ราคาตามสภาพ</li>
            <li>ค่าซ่อม</li>
            <li>ความเสี่ยง</li>
            <li>เวลาที่ใช้</li>
            <li>ราคาหลังซ่อมโดยประมาณ</li>
          </ol>
          <div class="callout-inner-box">
            <p>ไม่จำเป็นต้องเลือกซ่อมเพียงเพราะสินค้ามีตำหนิ</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. UNKNOWN SPEC & NOT READY TO SELL (2-COLUMN CARDS) -->
  <section class="commercial-section section-white">
    <div class="commercial-container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ไม่รู้รุ่นหรือสเปกก็เริ่มได้</h2>
          <p class="card-lead-text">หากไม่ทราบข้อมูล สามารถเริ่มจากถ่ายรูป:</p>
          <ul class="styled-bullet-list">
            <li>ด้านหน้า</li>
            <li>ด้านหลัง</li>
            <li>Sticker</li>
            <li>ป้าย Model</li>
            <li>หน้าจอข้อมูลระบบ</li>
            <li>จุดตำหนิ</li>
          </ul>
          <p class="card-foot-note">จากนั้นค่อยช่วยแยกข้อมูลที่จำเป็นต่อการประเมิน</p>
        </div>

        <div class="comm-card">
          <h2>ยังไม่พร้อมขายก็เช็กราคาก่อนได้</h2>
          <p class="card-lead-text">การสอบถามราคาเบื้องต้นไม่จำเป็นต้องหมายความว่าต้องขายทันที</p>
          <p class="card-sub-lead">ผู้ขายสามารถใช้ข้อมูลเพื่อ:</p>
          <ul class="styled-bullet-list">
            <li>เปรียบเทียบ</li>
            <li>ตัดสินใจว่าจะขายหรือเก็บ</li>
            <li>พิจารณาว่าควรซ่อมหรือไม่</li>
            <li>เตรียมข้อมูลและอุปกรณ์ให้ครบ</li>
          </ul>
          <p class="card-foot-note">ราคาประเมินเบื้องต้นยังต้องตรวจสินค้าและสภาพจริงก่อนซื้อขาย</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PRIVACY & REGIONAL ONLINE (DISTINCT RHYTHM) -->
  <section class="commercial-section section-surface">
    <div class="commercial-container">
      <div class="grid-2">
        <div class="comm-card comm-card-privacy">
          <h2>ข้อมูลส่วนตัวควรจัดการเมื่อพร้อมส่งมอบ</h2>
          <div class="privacy-warning-box">
            <p>ไม่ควรส่ง Password หรือข้อมูลบัญชีที่ไม่จำเป็นเพื่อเช็กราคา</p>
          </div>
          <p class="card-lead-text">ก่อนส่งมอบควร:</p>
          <ol class="styled-numbered-list">
            <li>Backup ข้อมูลสำคัญ</li>
