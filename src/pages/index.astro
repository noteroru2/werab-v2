---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const pageTitle = "รับซื้อสินค้าไอทีมือสอง เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อสินค้าไอทีมือสอง โน๊ตบุ๊ค คอม MacBook iPhone iPad กล้อง ลำโพง และอุปกรณ์ไอที ส่งรุ่น รูป สภาพและอุปกรณ์เพื่อเช็กราคาเบื้องต้นก่อนตัดสินใจขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
>
  <div class="container" style="padding-top: 1.5rem;">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <main class="content-container">
    <div class="container container-narrow">
      <article class="prose-content">
        <h1>รับซื้อสินค้าไอทีมือสอง เช็กราคาก่อนขายก่อนตัดสินใจ</h1>
        <p>มีสินค้าไอทีที่ไม่ได้ใช้แล้ว แต่ยังไม่แน่ใจว่าควรขายราคาเท่าไร?</p>
        <p>เรารับซื้อ.com ใช้แนวทาง:</p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
        <p>เริ่มจากส่งข้อมูลของสินค้าที่มีจริง ไม่จำเป็นต้องรีบเดินทางหรือรีบล้างข้อมูลเพียงเพื่อถามราคาเบื้องต้น</p>
        <p>ส่ง:</p>
        <p><strong>รุ่น + สเปก + รูป + สภาพ + อุปกรณ์</strong></p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <hr class="section-divider" />
        <h2>เลือกประเภทสินค้าที่ต้องการเช็กราคา</h2>
        <h3><a href="/รับซื้อโน๊ตบุ๊ค/">โน๊ตบุ๊ค</a></h3>
        <p>Notebook, Laptop, Gaming Notebook และเครื่องมีตำหนิบางประเภท</p>
        <p>ควรส่ง CPU, RAM, SSD, GPU, Battery และ Adapter</p>
        <h3><a href="/รับซื้อคอม/">คอมพิวเตอร์</a></h3>
        <p>Desktop, Gaming PC และคอมประกอบ</p>
        <p>ควรส่ง CPU, GPU, RAM, SSD, Mainboard และ PSU</p>
        <h3><a href="/รับซื้อแมคบุ๊ค/">MacBook</a></h3>
        <p>MacBook Air และ MacBook Pro</p>
        <p>ควรส่งรุ่น Chip, RAM, SSD, Battery และสภาพ</p>
        <h3><a href="/รับซื้อไอโฟน/">iPhone</a></h3>
        <p>ควรส่งรุ่น ความจุ Battery Health หน้าจอ การทำงาน และสภาพ</p>
        <h3><a href="/รับซื้อไอแพด/">iPad</a></h3>
        <p>ควรส่งรุ่น Generation ความจุ Wi-Fi/Cellular และอุปกรณ์</p>
        <h3><a href="/รับซื้อกล้อง/">กล้องและเลนส์</a></h3>
        <p>ควรแยก Body กับ Lens พร้อมแจ้ง Sensor, Shutter, สภาพและอุปกรณ์</p>
        <h3><a href="/รับซื้อลำโพง/">ลำโพง</a></h3>
        <p>ควรแจ้ง Brand, Model, Battery, การเชื่อมต่อและสภาพเสียง</p>
        <h3>อุปกรณ์ไอทีอื่น</h3>
        <p>สามารถส่งชื่อสินค้า รุ่น รูปและสภาพมาสอบถามเบื้องต้นได้</p>
        <hr class="section-divider" />
        <h2>การประเมินราคาไม่ได้ดูแค่ชื่อรุ่น</h2>
        <p>สินค้ารุ่นเดียวกันอาจมีราคาต่างกันได้จาก:</p>
        <ul>
        <li>สเปก</li>
        <li>ความจุ</li>
        <li>Battery</li>
        <li>สภาพ</li>
        <li>อุปกรณ์</li>
        <li>ประวัติซ่อม</li>
        <li>การทำงาน</li>
        <li>ประกันที่ตรวจสอบได้</li>
        <li>ความต้องการในตลาดมือสอง</li>
        </ul>
        <p>จึงควรส่งข้อมูลของสินค้าจริงประกอบกัน</p>
        <hr class="section-divider" />
        <h2>ส่งข้อมูลอะไรแล้วช่วยให้ประเมินได้ง่ายขึ้น</h2>
        <h3>รุ่น</h3>
        <p>ชื่อรุ่นเต็มหรือ Model Number</p>
        <h3>สเปก</h3>
        <p>เช่น CPU, GPU, RAM, SSD หรือความจุ</p>
        <h3>รูปสินค้า</h3>
        <p>ทุกด้านและตำหนิ</p>
        <h3>สภาพ</h3>
        <p>เปิดติดหรือไม่ มีอาการอะไร</p>
        <h3>อุปกรณ์</h3>
        <p>Adapter, Charger, Box, Cable หรืออุปกรณ์เสริม</p>
        <h3>ประวัติ</h3>
        <p>เคยซ่อม ตก โดนน้ำ หรือเปลี่ยนอะไหล่หรือไม่</p>
        <hr class="section-divider" />
        <h2>สินค้ามีตำหนิไม่จำเป็นต้องซ่อมก่อนทุกครั้ง</h2>
        <p>หากสินค้า:</p>
        <ul>
        <li>จอแตก</li>
        <li>Battery เสื่อม</li>
        <li>ไม่มี Adapter</li>
        <li>มีรอย</li>
        <li>เคยซ่อม</li>
        <li>เปิดไม่ติด</li>
        <li>มีฟังก์ชันเสีย</li>
        </ul>
        <p>สามารถเริ่มจากเช็กราคาตามสภาพก่อนได้</p>
        <p>ก่อนนำไปซ่อมควรเปรียบเทียบค่าใช้จ่ายกับส่วนต่างมูลค่าที่คาดว่าจะเพิ่ม</p>
        <hr class="section-divider" />
        <h2>ควรซ่อมก่อนขายหรือขายตามสภาพ</h2>
        <p>ให้เปรียบเทียบ:</p>
        <ol>
        <li>ราคาตามสภาพ</li>
        <li>ค่าซ่อม</li>
        <li>ความเสี่ยง</li>
        <li>เวลาที่ใช้</li>
        <li>ราคาหลังซ่อมโดยประมาณ</li>
        </ol>
        <p>ไม่จำเป็นต้องเลือกซ่อมเพียงเพราะสินค้ามีตำหนิ</p>
        <hr class="section-divider" />
        <h2>ไม่รู้รุ่นหรือสเปกก็เริ่มได้</h2>
        <p>หากไม่ทราบข้อมูล สามารถเริ่มจากถ่ายรูป:</p>
        <ul>
        <li>ด้านหน้า</li>
        <li>ด้านหลัง</li>
        <li>Sticker</li>
        <li>ป้าย Model</li>
        <li>หน้าจอข้อมูลระบบ</li>
        <li>จุดตำหนิ</li>
        </ul>
        <p>จากนั้นค่อยช่วยแยกข้อมูลที่จำเป็นต่อการประเมิน</p>
        <hr class="section-divider" />
        <h2>ยังไม่พร้อมขายก็เช็กราคาก่อนได้</h2>
        <p>การสอบถามราคาเบื้องต้นไม่จำเป็นต้องหมายความว่าต้องขายทันที</p>
        <p>ผู้ขายสามารถใช้ข้อมูลเพื่อ:</p>
        <ul>
        <li>เปรียบเทียบ</li>
        <li>ตัดสินใจว่าจะขายหรือเก็บ</li>
        <li>พิจารณาว่าควรซ่อมหรือไม่</li>
        <li>เตรียมข้อมูลและอุปกรณ์ให้ครบ</li>
        </ul>
        <p>ราคาประเมินเบื้องต้นยังต้องตรวจสินค้าและสภาพจริงก่อนซื้อขาย</p>
        <hr class="section-divider" />
        <h2>ข้อมูลส่วนตัวควรจัดการเมื่อพร้อมส่งมอบ</h2>
        <p>ไม่ควรส่ง Password หรือข้อมูลบัญชีที่ไม่จำเป็นเพื่อเช็กราคา</p>
        <p>ก่อนส่งมอบควร:</p>
        <ol>
        <li>Backup ข้อมูลสำคัญ</li>
        <li>ตรวจบัญชี</li>
        <li>ออกจากระบบที่จำเป็น</li>
        <li>จัดการ Find My หรือ Activation Lock ในอุปกรณ์ที่เกี่ยวข้อง</li>
        <li>ล้างข้อมูลเมื่อพร้อมส่งมอบ</li>
        </ol>
        <p>เจ้าของบัญชีควรเป็นผู้จัดการข้อมูลและรหัสผ่านของตนเอง</p>
        <hr class="section-divider" />
        <h2>อยู่ต่างจังหวัดสามารถเริ่มออนไลน์ก่อน</h2>
        <p>หากไม่ได้อยู่ใกล้จุดนัดหมาย สามารถเริ่มจากส่งข้อมูลและรูปก่อน</p>
        <p>หลังจากตรวจรายละเอียดเบื้องต้นแล้วจึงค่อยพิจารณาวิธีส่งมอบตามประเภทสินค้า พื้นที่ และความเหมาะสม</p>
        <p>เว็บไซต์นี้ไม่ได้ใช้เพื่ออ้างว่ามีสาขาอยู่ในทุกจังหวัด</p>
        <hr class="section-divider" />
        <h2>ขั้นตอนตั้งแต่เช็กราคาจนถึงตัดสินใจ</h2>
        <h3>1. เลือกประเภทสินค้า</h3>
        <h3>2. ส่งรุ่นหรือสเปก</h3>
        <h3>3. ส่งรูป</h3>
        <h3>4. แจ้งสภาพและอาการ</h3>
        <h3>5. แจ้งอุปกรณ์</h3>
        <h3>6. ประเมินเบื้องต้น</h3>
        <h3>7. ผู้ขายพิจารณา</h3>
        <h3>8. เตรียมข้อมูลและบัญชีเมื่อพร้อมขาย</h3>
        <h3>9. ตรวจสินค้าจริง</h3>
        <h3>10. ดำเนินการซื้อขายเมื่อข้อมูลและสภาพตรงกัน</h3>
        <hr class="section-divider" />
        <h2>เริ่มเช็กราคาก่อนขาย</h2>
        <p>หากมีสินค้าอยู่ตอนนี้ เริ่มจากส่ง:</p>
        <p><strong>สินค้าอะไร + รุ่นอะไร + สเปกเท่าที่รู้ + รูป + สภาพ + อุปกรณ์</strong></p>
        <p>หากไม่รู้รุ่น ส่งรูปมาก่อนได้</p>
        <p>LINE: <strong>@webuy</strong></p>
        <p>โทร: <strong>064-257-9353</strong></p>
        <p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p>
      </article>
    </div>
  </main>

</BaseLayout>

<style>
  .content-container {
    padding: 2.5rem 0 4rem 0;
  }

  .prose-content {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 640px) {
    .prose-content {
      padding: 1.75rem 1.25rem;
    }
  }

  .prose-content h1 {
    font-size: 2.15rem;
    color: var(--color-primary);
    line-height: 1.3;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .prose-content h2 {
    font-size: 1.55rem;
    color: var(--color-primary);
    line-height: 1.35;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    line-height: 1.4;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-main);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .prose-content ul,
  .prose-content ol {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .prose-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 0.4rem;
  }

  .prose-content strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .prose-content a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .prose-content a:hover {
    color: var(--color-accent-hover);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--color-border);
    margin: 2.5rem 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .data-table th {
    background-color: var(--color-bg-subtle);
    color: var(--color-primary);
    font-weight: 600;
  }

  .data-table tr:nth-child(even) {
    background-color: #fafbfc;
  }
</style>
