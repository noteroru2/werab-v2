---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อโน๊ตบุ๊คสกลนคร Notebook Laptop เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อโน๊ตบุ๊คมือสองในสกลนคร Notebook Laptop และ Gaming Notebook ประเมินจากรุ่น CPU GPU RAM SSD Battery จอ สภาพและอุปกรณ์ ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊ค",
    "url": "/รับซื้อโน๊ตบุ๊ค/"
  },
  {
    "name": "รับซื้อโน๊ตบุ๊คสกลนคร เช็กรุ่น สเปก และสภาพก่อนตัดสินใจขาย",
    "url": "/รับซื้อโน๊ตบุ๊ค-สกลนคร/"
  }
];

const faqs = [
  {
    "question": "Notebook รุ่นเก่าในสกลนครยังเช็กราคาได้ไหม?",
    "answer": "ได้ ควรแจ้ง Model สเปก สภาพ Battery และอาการก่อน เพื่อเปรียบเทียบว่าควรขายตามสภาพหรือซ่อมก่อน"
  },
  {
    "question": "Gaming Notebook ต้องส่ง Adapter ด้วยหรือไม่?",
    "answer": "ควรแจ้งว่า Adapter เดิม เทียบ หรือไม่มี เพราะเป็นส่วนหนึ่งของ Configuration และความพร้อมใช้งาน โดยเฉพาะเครื่อง Gaming"
  },
  {
    "question": "จอเป็นเส้นยังประเมินได้ไหม?",
    "answer": "สามารถส่งมาประเมินตามสภาพได้ ควรถ่ายหน้าจอและแจ้งว่าต่อจอนอกใช้งานได้หรือไม่ถ้าเคยทดสอบ"
  },
  {
    "question": "เครื่องเปิดไม่ติดต้องซ่อมก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี ควรเช็กราคาตามสภาพก่อน แล้วเปรียบเทียบค่าใช้จ่ายและความเสี่ยงในการซ่อม"
  },
  {
    "question": "ขายโดยไม่รวม SSD ได้หรือไม่?",
    "answer": "สามารถแจ้งว่าไม่รวม SSD ได้ โดยราคาต้องอิง Configuration ที่ขายจริง"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อโน๊ตบุ๊คสกลนคร เช็กรุ่น สเปก และสภาพก่อนตัดสินใจขาย</h1>
        <p>Notebook มือสองควรประเมินจาก Configuration และสภาพของเครื่องจริง โดยเฉพาะเครื่องที่มีอายุหลายปีหรือผ่านการอัปเกรด RAM และ SSD</p>
        <p>หน้า <code>/รับซื้อโน๊ตบุ๊ค-สกลนคร/</code> รักษา Historical Intent:</p>
        <p><strong>Notebook + Sakon Nakhon</strong></p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ส่ง:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Model + CPU + RAM + SSD + GPU ถ้ามี + Battery + รูปเครื่อง</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-laptop-500.webp" type="image/webp" />
              <source srcset="/images/hero-laptop.avif" type="image/avif" />
              <source srcset="/images/hero-laptop.webp" type="image/webp" />
              <img
                src="/images/hero-laptop.webp"
                alt="รับซื้อโน๊ตบุ๊คสกลนคร เช็กรุ่น สเปก และสภาพก่อนตัดสินใจขาย"
                width="1200"
                height="755"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ในสกลนครเริ่มเช็กราคาจากข้อมูลก่อนได้</h2>
        <p>ผู้ขายสามารถส่งข้อมูลเบื้องต้นก่อนการเดินทางหรือส่งมอบสินค้า</p>
        <p>สิ่งที่ควรรู้คือ:</p>
        <ul>
        <li>เครื่องรุ่นอะไร</li>
        <li>สเปกปัจจุบัน</li>
        <li>Battery เป็นอย่างไร</li>
        <li>มีตำหนิอะไร</li>
        <li>อุปกรณ์ครบหรือไม่</li>
        </ul>
        <p>หลังจากนั้นจึงค่อยพิจารณาขั้นตอนต่อไปตามพื้นที่และความเหมาะสม</p>
        <p>ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำในทุกพื้นที่ของจังหวัด</p>
        </div>
        <div class="comm-card">
          <h2>Notebook รุ่นเก่าควรตรวจสเปกก่อนตัดสินใจซ่อม</h2>
        <p>เครื่องเก่าบางรุ่นอาจยังมีมูลค่าจาก:</p>
        <ul>
        <li>CPU</li>
        <li>RAM</li>
        <li>SSD</li>
        <li>GPU</li>
        <li>หน้าจอ</li>
        <li>อะไหล่</li>
        <li>สภาพโดยรวม</li>
        </ul>
        <p>หากมีอาการ ไม่ควรรีบซ่อมทุกกรณี</p>
        <p>ควรเช็กราคาตามสภาพก่อน แล้วเปรียบเทียบกับค่าใช้จ่าย</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>CPU ต้องใช้รหัสรุ่นเต็ม</h2>
        <p>ตัวอย่าง:</p>
        <p><strong>Intel Core i5-1135G7</strong></p>
        <p>หรือ</p>
        <p><strong>AMD Ryzen 5 5500U</strong></p>
        <p>ช่วยแยก Generation ได้ดีกว่าคำว่า Core i5 หรือ Ryzen 5 อย่างเดียว</p>
        </div>
        <div class="comm-card">
          <h2>Gaming Notebook ต้องแจ้ง GPU</h2>
        <p>หากเครื่องมี Dedicated GPU ควรระบุรุ่น</p>
        <p>เพราะ Notebook Gaming ชื่อ Series เดียวกันอาจมีหลาย GPU Configuration</p>
        <p>ควรแจ้ง Adapter ด้วย เพราะกำลังไฟของ Adapter อาจต่างกันตามรุ่น</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>RAM และ SSD ที่เพิ่มภายหลังมีผลกับ Configuration</h2>
        <p>ควรแจ้งของที่ติดตั้งอยู่ในปัจจุบัน</p>
        <p>ถ้าตั้งใจถอด SSD หรือ RAM บางส่วนเก็บไว้ ต้องแจ้งก่อนประเมิน</p>
        <p>ราคาควรอิงสิ่งที่ขายจริง ไม่ใช่ Configuration ที่เคยมีในอดีต</p>
        </div>
        <div class="comm-card">
          <h2>Battery เสื่อมกับระบบชาร์จเสียไม่เหมือนกัน</h2>
        <p>ควรแยกว่า:</p>
        <ul>
        <li>Battery หมดเร็ว</li>
        <li>Battery ไม่เก็บไฟ</li>
        <li>ชาร์จไม่เข้า</li>
        <li>Port หลวม</li>
        <li>Adapter มีปัญหา</li>
        <li>Battery บวม</li>
        </ul>
        <p>หากยังไม่ทราบสาเหตุ ไม่ควรระบุว่าเป็นอะไหล่ชิ้นใดแน่นอน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>จอมีปัญหาควรถ่ายตอนเปิดเครื่อง</h2>
        <p>อาการที่ควรแจ้ง เช่น</p>
        <ul>
        <li>เป็นเส้น</li>
        <li>มีจุด</li>
        <li>แตก</li>
        <li>กระพริบ</li>
        <li>สีผิดปกติ</li>
        <li>ไม่มีภาพ</li>
        </ul>
        <p>หากต่อ Monitor ภายนอกแล้วแสดงผลได้ ควรแจ้งข้อมูลนี้ประกอบ</p>
        </div>
        <div class="comm-card">
          <h2>Keyboard และบานพับมีผลต่อความพร้อมใช้งาน</h2>
        <p>ควรแจ้งหาก:</p>
        <ul>
        <li>ปุ่มเสีย</li>
        <li>ปุ่มหลุด</li>
        <li>Keyboard มีรอยน้ำ</li>
        <li>Touchpad มีปัญหา</li>
        <li>บานพับหลวม</li>
        <li>ฝาจอแยก</li>
        <li>Palmrest แตก</li>
        </ul>
        <p>ความเสียหายเหล่านี้อาจทำให้ต้นทุนการซ่อมต่างกัน</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เครื่องเคยซ่อมต้องแจ้งหรือไม่</h2>
        <p>ควรแจ้งเท่าที่ทราบ เช่น</p>
        <ul>
        <li>เปลี่ยน Battery</li>
        <li>เปลี่ยนจอ</li>
        <li>ซ่อม Mainboard</li>
        <li>เปลี่ยน SSD</li>
        <li>เพิ่ม RAM</li>
        <li>เปลี่ยน Keyboard</li>
        <li>ซ่อมบานพับ</li>
        </ul>
        <p>ไม่ได้หมายความว่าเครื่องที่เคยซ่อมจะขายไม่ได้ แต่ช่วยอธิบายสภาพได้ชัดขึ้น</p>
        </div>
        <div class="comm-card">
          <h2>เครื่องเปิดไม่ติดควรทดลองซ้ำไหม</h2>
        <p>หากไม่มีอาการอันตราย สามารถสังเกตข้อมูลพื้นฐานได้ เช่นไฟชาร์จหรือพัดลม</p>
        <p>แต่หาก:</p>
        <ul>
        <li>มีกลิ่นไหม้</li>
        <li>Battery บวม</li>
        <li>ร้อนผิดปกติ</li>
        <li>มีร่องรอยของเหลว</li>
        </ul>
        <p>ไม่ควรเปิดซ้ำหลายครั้งเพื่อทดสอบเพียงเพื่อขอราคา</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ข้อมูลส่วนตัวควรจัดการแยกจาก Hardware</h2>
        <p>สำหรับการประเมินเบื้องต้น ไม่ต้องให้:</p>
        <ul>
        <li>Password</li>
        <li>PIN</li>
        <li>OTP</li>
        <li>Recovery Key</li>
        <li>Email Password</li>
        </ul>
        <p>เจ้าของควรสำรองและจัดการข้อมูลของตนเองก่อนส่งมอบจริง</p>
        <p>สามารถแจ้งว่าไม่รวม SSD หากต้องการเก็บ Storage ไว้</p>
        </div>
        <div class="comm-card">
          <h2>Notebook หลายเครื่องจากองค์กร</h2>
        <p>สามารถจัดเป็นตาราง:</p>
        <div class="table-responsive"><table class="table table-bordered">
          <thead><tr><th>รุ่น</th><th>CPU</th><th>RAM</th><th>SSD</th><th>จำนวน</th><th>สภาพ</th></tr></thead>
          <tbody>
          <tr><td>รุ่น...</td><td>i5-...</td><td>8GB</td><td>256GB</td><td>7</td><td>ปกติ</td></tr>
          <tr><td>รุ่น...</td><td>i5-...</td><td>16GB</td><td>512GB</td><td>3</td><td>Battery เสื่อม</td></tr>
          <tr><td>รุ่น...</td><td>ไม่ทราบ</td><td>ไม่ทราบ</td><td>ไม่ทราบ</td><td>2</td><td>ยังไม่ได้ทดสอบ</td></tr>
          </tbody></table></div>
        <p>หากแต่ละเครื่องต่างกันมาก ควรแยกกลุ่มให้ชัด</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>หน้าสกลนครไม่แทนหน้ารับซื้อ Notebook หลัก</h2>
        <p>หน้า <a href="/รับซื้อโน๊ตบุ๊ค/"><code>/รับซื้อโน๊ตบุ๊ค/</code></a> เป็น Broad Money Hub</p>
        <p>ส่วน:</p>
        <p><code>/รับซื้อโน๊ตบุ๊ค-สกลนคร/</code></p>
        <p>มี Intent:</p>
        <p><strong>Notebook + Sakon Nakhon</strong></p>
        <p>จึงควรรักษาความเป็น Local Historical URL ไม่ขยายเป็นหน้า National Notebook อีกชุด</p>
      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคา Notebook ในสกลนคร</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Model</h3>
              <p>ชื่อรุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. ส่ง CPU</h3>
              <p>รหัสเต็มถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่ง RAM และ SSD</h3>
              <p>ของที่ติดตั้งจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. ส่ง GPU</h3>
              <p>หากมี</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Battery และ Adapter</h3>
              <p>ตามอาการจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. ส่งรูป</h3>
              <p>รวมหน้าจอและตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้งอาการ</h3>
              <p>Hardware หรือการใช้งาน</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติซ่อม</h3>
              <p>ถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เช็กราคาก่อนซ่อม</h3>
              <p>เปรียบเทียบต้นทุนก่อนตัดสินใจ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันสเปกและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคาโน๊ตบุ๊คในสกลนคร</h2>
        <p>ส่ง:</p>
        <p><strong>Model + CPU + RAM + SSD + GPU + Battery + รูป</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
