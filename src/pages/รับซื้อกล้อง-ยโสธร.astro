---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "รับซื้อกล้องยโสธร กล้องมือสอง มีอาการก็เช็กราคาได้ | เรารับซื้อ.com";
const pageDescription = "รับซื้อกล้องมือสองในยโสธร ทั้ง DSLR Mirrorless Body และ Lens เช็กสภาพ Sensor จอ EVF Shutter Focus รา ฝุ่น อาการเสียและต้นทุนก่อนซ่อมหรือขาย";

const breadcrumbs = [
  {
    "name": "หน้าแรก",
    "url": "/"
  },
  {
    "name": "รายการรับซื้อสินค้า",
    "url": "/รับซื้อ/"
  },
  {
    "name": "รับซื้อกล้อง",
    "url": "/รับซื้อกล้อง/"
  },
  {
    "name": "รับซื้อกล้องยโสธร เช็กสภาพและความคุ้มค่าก่อนซ่อมหรือขาย",
    "url": "/รับซื้อกล้อง-ยโสธร/"
  }
];

const faqs = [
  {
    "question": "กล้องมีราใน Lens ต้องล้างก่อนขายไหม?",
    "answer": "ไม่จำเป็นทุกกรณี ควรเช็กราคาตามสภาพก่อนและเปรียบเทียบค่าล้างหรือค่าซ่อมกับมูลค่าที่อาจเพิ่ม ไม่ควรแกะ Lens เองหากไม่มีความชำนาญ"
  },
  {
    "question": "Sensor มีจุดต้องทำความสะอาดก่อนหรือไม่?",
    "answer": "ควรตรวจให้แน่ใจก่อนว่าจุดสัมพันธ์กับ Sensor หรือ Lens และไม่ควรขัด Sensor ซ้ำหรือใช้สารที่ไม่เหมาะสมเพื่อเตรียมขาย"
  },
  {
    "question": "จอเสียแต่ EVF ใช้งานได้ยังประเมินได้ไหม?",
    "answer": "ได้ ควรแจ้งอาการของจอและ EVF แยกกัน รวมถึงฟังก์ชันอื่นที่ยังทำงานได้"
  },
  {
    "question": "กล้องเปิดไม่ติดต้องซ่อมก่อนเช็กราคาไหม?",
    "answer": "ไม่จำเป็น สามารถส่ง Model Lens รูป Battery Charger อาการและประวัติความเสียหายมาประเมินเบื้องต้นก่อน"
  },
  {
    "question": "Battery เสื่อมต้องซื้อใหม่ก่อนขายหรือไม่?",
    "answer": "ไม่จำเป็นทุกกรณี ควรเปรียบเทียบต้นทุน Battery ใหม่กับมูลค่าที่คาดว่าจะเพิ่มก่อนตัดสินใจ"
  }
];
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL LOCAL HERO -->
    <!-- COMMERCIAL LOCAL HERO -->
  <section class="commercial-hero commercial-hero-local">
    <div class="container">
      <div class="local-hero-grid">
        <div class="local-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อกล้องยโสธร เช็กสภาพและความคุ้มค่าก่อนซ่อมหรือขาย</h1>
        <p>กล้องที่มีอาการไม่ได้หมายความว่าต้องซ่อมหรือทำความสะอาดก่อนขายทุกตัว</p>
        
        
        <p>โดยเน้นการแยกว่า:</p>
        <p><strong>สภาพปัจจุบันเป็นอย่างไร → อะไรยังใช้งานได้ → การซ่อมหรือทำความสะอาดคุ้มก่อนขายหรือไม่</strong></p>
        <div class="hero-intake-card">
          <p style="font-weight: 600; margin-bottom: 0.35rem;">ข้อมูลเริ่มต้น:</p>
          <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
            <strong>Brand + Model + Lens + รูป + อาการ + Shutter Count ถ้าทราบ + Battery + Charger</strong>
          </p>
          <div class="hero-cta-bar">
            <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
              </svg>
              <span>LINE: <strong>{getDisplayLine()}</strong></span>
            </a>
            <a href={getPhoneUrl()} class="btn btn-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>โทร: <strong>{getDisplayPhone()}</strong></span>
            </a>
          </div>
        </div>
        </div>

        <div class="local-hero-right">
          <div class="local-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-camera-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-camera-500.webp" type="image/webp" />
              <source srcset="/images/hero-camera.avif" type="image/avif" />
              <source srcset="/images/hero-camera.webp" type="image/webp" />
              <img
                src="/images/hero-camera.webp"
                alt="รับซื้อกล้องยโสธร เช็กสภาพและความคุ้มค่าก่อนซ่อมหรือขาย"
                width="971"
                height="716"
                class="local-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อยู่ยโสธรไม่จำเป็นต้องซ่อมกล้องก่อนเช็กราคา</h2>
        <p>หากกล้องมี:</p>
        <ul>
        <li>จอเสีย</li>
        <li>EVF มีอาการ</li>
        <li>Focus มีปัญหา</li>
        <li>Sensor มีจุด</li>
        <li>Lens มีฝ้า</li>
        <li>Battery เสื่อม</li>
        <li>ปุ่มเสีย</li>
        <li>เปิดไม่ติด</li>
        </ul>
        <p>สามารถเริ่มจากส่งข้อมูลตามสภาพได้</p>
        <p>หลังทราบข้อมูลจึงค่อยเปรียบเทียบว่าการซ่อมหรือทำความสะอาดก่อนขายมีความคุ้มค่าหรือไม่</p>
        <p>หน้านี้ไม่ได้หมายความว่ามีสาขาหรือจุดรับซื้อประจำอยู่ในทุกพื้นที่ของยโสธร</p>
        </div>
        <div class="comm-card">
          <h2>จุดในภาพควรหาสาเหตุก่อนตัดสินใจล้าง Sensor</h2>
        <p>จุดในภาพอาจสัมพันธ์กับ:</p>
        <ul>
        <li>Sensor</li>
        <li>Lens</li>
        <li>ฝุ่น</li>
        <li>คราบ</li>
        <li>ระบบ Optical</li>
        <li>สาเหตุอื่น</li>
        </ul>
        <p>หากยังไม่แน่ใจ ไม่ควรขัด Sensor ซ้ำหลายครั้ง</p>
        <p>สามารถแจ้ง:</p>
        <ul>
        <li>จุดอยู่ตำแหน่งเดิมหรือไม่</li>
        <li>เปลี่ยน Lens แล้วจุดยังอยู่หรือไม่</li>
        <li>เกิดชัดที่ Aperture ใด</li>
        <li>มีภาพตัวอย่างหรือไม่</li>
        </ul>
        <p>ข้อมูลเหล่านี้มีประโยชน์กว่าการพยายามทำความสะอาดโดยไม่มีความชำนาญ</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Lens มีฝุ่น ฝ้า หรือสงสัยว่ามีราไม่ควรแกะเอง</h2>
        <p>สามารถตรวจด้วยสายตาและถ่ายรูปตามที่มองเห็น</p>
        <p>หากสงสัยว่ามี:</p>
        <ul>
        <li>ฝุ่น</li>
        <li>ฝ้า</li>
        <li>รา</li>
        <li>คราบ</li>
        <li>รอย</li>
        </ul>
        <p>ควรแจ้งตามสภาพ</p>
        <p>ไม่ควรถอดชิ้น Lens ภายในออกเพียงเพื่อทำให้ดูดีขึ้นก่อนขาย</p>
        <p>การแกะอาจสร้างความเสียหายเพิ่มหากไม่มีเครื่องมือหรือประสบการณ์</p>
        </div>
        <div class="comm-card">
          <h2>จอเสียกับ EVF เสียไม่ใช่อาการเดียวกัน</h2>
        <p>ควรตรวจว่า:</p>
        <ul>
        <li>จอหลังใช้งานได้หรือไม่</li>
        <li>Touch ใช้งานได้หรือไม่</li>
        <li>EVF ขึ้นภาพหรือไม่</li>
        <li>กล้องยังถ่ายได้หรือไม่</li>
        <li>Playback ทำงานหรือไม่</li>
        </ul>
        <p>หากจอหลังมีปัญหาแต่ EVF ยังใช้ได้ หรือกลับกัน ควรแจ้งแยกให้ชัด</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Shutter มีอาการควรแจ้งก่อนตัดสินใจซ่อม</h2>
        <p>อาการที่อาจพบ เช่น:</p>
        <ul>
        <li>Error</li>
        <li>กดถ่ายไม่ทำงาน</li>
        <li>ภาพบางส่วนผิดปกติ</li>
        <li>เสียง Shutter ผิดปกติ</li>
        <li>กล้องดับเมื่อถ่าย</li>
        </ul>
        <p>ไม่ควรรีบเปลี่ยน Shutter โดยยังไม่ทราบต้นทุนและมูลค่าของ Body</p>
        <p>สามารถเช็กราคาตามสภาพก่อนเพื่อเปรียบเทียบความคุ้มค่า</p>
        </div>
        <div class="comm-card">
          <h2>Auto Focus มีปัญหาควรลองแยก Body และ Lens</h2>
        <p>หากมี Lens มากกว่าหนึ่งตัว สามารถสังเกตว่า:</p>
        <ul>
        <li>เป็นกับ Lens ทุกตัวหรือไม่</li>
        <li>เป็นเฉพาะ Lens เดียวหรือไม่</li>
        <li>Manual Focus ใช้ได้หรือไม่</li>
        <li>Motor มีเสียงหรือไม่</li>
        </ul>
        <p>ไม่จำเป็นต้องถอดหรือแกะกลไก Focus เพื่อหาสาเหตุก่อนขาย</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Battery เสื่อมควรเปลี่ยนก่อนขายหรือไม่</h2>
        <p>ไม่จำเป็นทุกกรณี</p>
        <p>ควรแจ้งว่า:</p>
        <ul>
        <li>Battery ใช้งานได้</li>
        <li>หมดเร็ว</li>
        <li>ชาร์จไม่เข้า</li>
        <li>Battery บวม</li>
        <li>มี Battery กี่ก้อน</li>
        <li>เป็นของเดิมหรือของเทียบ</li>
        </ul>
        <p>แล้วเปรียบเทียบต้นทุนของ Battery ใหม่กับมูลค่าที่คาดว่าจะเพิ่มขึ้น</p>
        <p>หาก Battery บวมไม่ควรฝืนใส่กลับเข้า Body หรือชาร์จซ้ำ</p>
        </div>
        <div class="comm-card">
          <h2>กล้องเปิดไม่ติดยังเช็กราคาได้</h2>
        <p>สามารถส่ง:</p>
        <ul>
        <li>Brand</li>
        <li>Model</li>
        <li>Lens</li>
        <li>Battery</li>
        <li>Charger</li>
        <li>รูป</li>
        <li>อาการก่อนเสีย</li>
        <li>เคยตกหรือโดนน้ำหรือไม่</li>
        <li>ประวัติซ่อม</li>
        </ul>
        <p>หากมีกลิ่นไหม้ ความร้อนผิดปกติ หรือร่องรอยของเหลว ไม่ควรทดลองเปิดหรือชาร์จซ้ำหลายครั้ง</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เคยโดนน้ำหรือความชื้นควรแจ้ง</h2>
        <p>ความชื้นอาจสัมพันธ์กับหลายส่วน เช่น:</p>
        <ul>
        <li>Body</li>
        <li>Lens</li>
        <li>Connector</li>
        <li>Sensor</li>
        <li>EVF</li>
        <li>Circuit</li>
        </ul>
        <p>ควรแจ้งสิ่งที่ทราบตามจริง</p>
        <p>ไม่ควรพยายามเปิด Body หรือ Lens เพื่อเป่า/เช็ดภายในเองหากไม่มีความชำนาญ</p>
        </div>
        <div class="comm-card">
          <h2>การซ่อมก่อนขายควรคิดจากความคุ้มค่า</h2>
        <p>ก่อนซ่อมสามารถเปรียบเทียบ:</p>
        <ol>
        <li>มูลค่าตามสภาพปัจจุบัน</li>
        <li>ค่าอะไหล่</li>
        <li>ค่าแรง</li>
        <li>ความเสี่ยงจากการซ่อม</li>
        <li>ระยะเวลา</li>
        <li>มูลค่าที่คาดว่าจะเพิ่ม</li>
        </ol>
        <p>กล้องรุ่นเก่าบางตัวอาจไม่คุ้มกับการซ่อมบางรายการ แม้อาการนั้นจะซ่อมได้</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>อุปกรณ์ไม่ครบไม่จำเป็นต้องซื้อใหม่ก่อน</h2>
        <p>ควรแจ้งตามจริงว่ามี:</p>
        <ul>
        <li>Battery</li>
        <li>Charger</li>
        <li>Strap</li>
        <li>Cap</li>
        <li>Hood</li>
        <li>กล่อง</li>
        <li>คู่มือ</li>
        <li>Flash</li>
        <li>อุปกรณ์อื่น</li>
        </ul>
        <p>ไม่จำเป็นต้องซื้อของมาเติมชุดโดยยังไม่รู้ว่าคุ้มกับมูลค่าที่เพิ่มขึ้นหรือไม่</p>
        </div>
        <div class="comm-card">
          <h2>Serial Number ไม่จำเป็นต้องเปิดเผยสาธารณะ</h2>
        <p>เริ่มจาก:</p>
        <p><strong>Brand + Model + Lens + รูป + อาการ</strong></p>
        <p>ก่อน</p>
        <p>หากจำเป็นต้องใช้ Serial ในขั้นตอนตรวจสอบภายหลัง ควรส่งผ่านช่องทางที่เหมาะสม</p>
        </div>
      </div>
    </div>
  </section>

  <section class="commercial-section section-white">
    <div class="container">
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="comm-card">
        <h2>ขั้นตอนเช็กราคากล้องที่มีอาการในยโสธร</h2>
        <div class="process-grid" style="margin-top: 1.25rem;">
          <div class="process-step-item">
            <div>
              <h3>1. ส่ง Brand และ Model</h3>
              <p>ใช้รุ่นเต็ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>2. แจ้ง Lens</h3>
              <p>รุ่นที่รวมขายหรือใช้ทดสอบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>3. ส่งรูป</h3>
              <p>Body Lens จอและตำหนิ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>4. แจ้งอาการ</h3>
              <p>ตามที่เกิดขึ้นจริง</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>5. แจ้ง Shutter</h3>
              <p>Count หรืออาการถ้าทราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>6. แจ้ง Sensor / ภาพตัวอย่าง</h3>
              <p>หากมีจุดหรือคราบ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>7. แจ้ง Battery</h3>
              <p>จำนวนและสภาพ</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>8. แจ้งประวัติ</h3>
              <p>ตก น้ำ ความชื้น หรือซ่อม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>9. เปรียบเทียบก่อนซ่อม</h3>
              <p>ดูต้นทุนกับมูลค่าที่อาจเพิ่ม</p>
            </div>
          </div>
          <div class="process-step-item">
            <div>
              <h3>10. ตรวจสินค้า</h3>
              <p>ยืนยันรุ่น ฟังก์ชันและสภาพก่อนซื้อขาย</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL COMMERCIAL CTA -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="commercial-final-cta">
        <h2>เริ่มเช็กราคากล้องในยโสธร</h2>
        <p>ส่ง:</p>
        <p><strong>Brand + Model + Lens + รูป + อาการ + Shutter + Battery</strong></p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0;">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line btn-hero-line">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
            </svg>
            <span>LINE: <strong>{getDisplayLine()}</strong></span>
          </a>
          <a href={getPhoneUrl()} class="btn btn-phone btn-hero-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>โทร: <strong>{getDisplayPhone()}</strong></span>
          </a>
        </div>

        <div style="margin-top: 0.5rem;"><p><strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong></p></div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="commercial-section section-surface">
    <div class="container">
      <FAQ items={faqs} title="คำถามที่พบบ่อยเกี่ยวกับการขายกล้องในยโสธร" subtitle="" />
    </div>
  </section>
</BaseLayout>
