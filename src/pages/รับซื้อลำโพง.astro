---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

const pageTitle = "รับซื้อลำโพงมือสอง Bluetooth JBL Marshall เช็กราคาก่อนขาย | เรารับซื้อ.com";
const pageDescription = "รับซื้อลำโพงมือสอง Bluetooth และลำโพงพกพา ประเมินจากรุ่น แบตเตอรี่ เสียง ดอกลำโพง การเชื่อมต่อ สภาพ อุปกรณ์และประวัติซ่อม ส่งข้อมูลเช็กราคาก่อนขาย";

const breadcrumbs = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'รายการรับซื้อสินค้า', url: '/รับซื้อ/' },
  { name: 'รับซื้อลำโพง', url: '/รับซื้อลำโพง/' }
];

const faqs = [
  {
    question: "รับซื้อลำโพง Bluetooth มือสองยี่ห้ออะไรบ้าง?",
    answer: "สามารถส่งลำโพงหลายแบรนด์มาประเมินได้ เช่น JBL, Marshall, Harman Kardon, Bose, Sony และแบรนด์อื่น โดยควรแจ้งรุ่นเต็ม สภาพเสียง Battery การเชื่อมต่อ และอุปกรณ์"
  },
  {
    question: "ลำโพง Battery เสื่อมหรือชาร์จไม่เข้าขายได้ไหม?",
    answer: "บางกรณีสามารถส่งมาประเมินตามสภาพได้ ควรแจ้งอาการ Battery การชาร์จ สายหรือ Adapter ที่ใช้ และอาการของเครื่อง เพื่อพิจารณาความเสี่ยงและสภาพจริง"
  },
  {
    question: "ลำโพงมีเสียงแตกยังขายได้ไหม?",
    answer: "สามารถส่งข้อมูลมาประเมินตามสภาพได้ ควรแจ้งว่าเสียงแตกเกิดตลอดหรือเฉพาะบางระดับเสียง และมีอาการอื่นร่วมด้วยหรือไม่"
  },
  {
    question: "ลำโพงเคยซ่อมหรือโดนน้ำยังขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งประวัติที่ทราบ เช่น เปลี่ยน Battery ซ่อม Board ซ่อม Port หรือเคยโดนน้ำ เพื่อช่วยประเมินความเสี่ยงจากสภาพจริง"
  },
  {
    question: "ไม่มีกล่องหรือ Adapter ขายได้ไหม?",
    answer: "สามารถส่งมาประเมินได้ ควรแจ้งสิ่งที่มีจริง โดยรุ่น สภาพเสียง Battery การทำงาน และอุปกรณ์จะถูกพิจารณาร่วมกัน"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- COMMERCIAL HERO -->
  <section class="commercial-hero commercial-hero-hub">
    <div class="container">
      <div class="hub-hero-grid">
        <div class="hub-hero-left">
          <Breadcrumb items={breadcrumbs} />
          <h1 class="hero-h1">รับซื้อลำโพงมือสอง เช็กรุ่น เสียง แบตเตอรี่และสภาพก่อนขาย</h1>
          <p class="hero-lead-text">ต้องการขายลำโพงมือสอง แต่ยังไม่แน่ใจว่าควรส่งข้อมูลอะไรเพื่อเช็กราคา?</p>
          <p>
            ลำโพงรุ่นเดียวกันอาจมีมูลค่าต่างกันจาก <strong>สภาพเสียง แบตเตอรี่ การเชื่อมต่อ ดอกลำโพง ปุ่ม พอร์ต สภาพภายนอก ประวัติการซ่อม และอุปกรณ์</strong>
          </p>
          <p>
            ดังนั้นการแจ้งเพียงชื่อแบรนด์ยังไม่เพียงพอสำหรับการประเมินเบื้องต้น
          </p>

          <div class="hero-intake-card">
            <p style="font-weight: 600; margin-bottom: 0.35rem;">เริ่มจากส่ง:</p>
            <p style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.85rem;">
              <strong>Brand + Model + รูป + สภาพเสียง + Battery + การเชื่อมต่อ + อุปกรณ์</strong>
            </p>
            <div class="hero-cta-bar">
              <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
                </svg>
                <span>LINE: <strong>{getDisplayLine()}</strong></span>
              </a>
              <a href={getPhoneUrl()} class="btn btn-phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>โทร: <strong>{getDisplayPhone()}</strong></span>
              </a>
            </div>
          </div>
        </div>

        <div class="hub-hero-right">
          <div class="hub-product-visual-wrap">
            <picture>
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/images/hero-speaker-500.webp" type="image/webp" />
              <source srcset="/images/hero-speaker.avif" type="image/avif" />
              <source srcset="/images/hero-speaker.webp" type="image/webp" />
              <img
                src="/images/hero-speaker.webp"
                alt="รับซื้อลำโพงมือสอง ลำโพงบลูทูธ ลำโพง Marshall JBL Harman Kardon เช็กรุ่น เสียง แบตเตอรี่และสภาพก่อนขาย"
                width="979"
                height="667"
                class="hub-hero-product-img"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: SPEAKER TYPES & BRANDS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="comm-card">
        <h2>ลำโพงแบบไหนส่งมาประเมินได้</h2>
        <p>สามารถส่งรายละเอียดลำโพงมือสองหลายประเภทมาสอบถามได้ เช่น</p>
        <div class="grid-2" style="margin-bottom: 1.5rem;">
          <div>
            <ul>
              <li>ลำโพง Bluetooth</li>
              <li>ลำโพงพกพา</li>
              <li>Portable Speaker</li>
              <li>Wireless Speaker</li>
              <li>Smart Speaker บางประเภท</li>
              <li>Party Speaker</li>
              <li>ลำโพงตั้งโต๊ะ</li>
              <li>ลำโพงที่ใช้ Adapter</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>ลำโพงที่มี Battery ในตัว</li>
              <li>ลำโพงมีรอย</li>
              <li>Battery เสื่อม</li>
              <li>ชาร์จไม่เข้า</li>
              <li>เสียงแตกหรือมีอาการบางประเภท</li>
              <li>เครื่องเคยซ่อม</li>
              <li>เครื่องเปิดไม่ติดบางกรณี</li>
            </ul>
          </div>
        </div>

        <p>แบรนด์ที่พบในตลาดมือสอง เช่น</p>
        <ul>
          <li>JBL</li>
          <li>Marshall</li>
          <li>Harman Kardon</li>
          <li>Bose</li>
          <li>Sony</li>
          <li>Ultimate Ears</li>
          <li>Bang & Olufsen</li>
          <li>และแบรนด์อื่น</li>
        </ul>

        <p>การประเมินต้องดูรุ่นและสภาพจริงของสินค้า</p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MODEL IDENTIFICATION & SOUND QUALITY -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>ก่อนขายต้องรู้รุ่นลำโพงให้ชัด</h2>
          <p>ลำโพงแต่ละแบรนด์มีหลาย Series และหลาย Generation</p>
          <p>ตัวอย่างเช่น ลำโพงชื่อใกล้กันอาจต่างกันที่:</p>
          <ul>
            <li>ขนาด</li>
            <li>กำลังขับ</li>
            <li>Battery</li>
            <li>Port</li>
            <li>ระบบเชื่อมต่อ</li>
            <li>Generation</li>
            <li>ฟังก์ชันเพิ่มเติม</li>
          </ul>
          <p>ควรแจ้งชื่อรุ่นเต็มจาก:</p>
          <ul>
            <li>ตัวเครื่อง</li>
            <li>ป้ายด้านหลัง</li>
            <li>ป้ายด้านล่าง</li>
            <li>กล่อง</li>
            <li>เมนูใน Application หากมี</li>
            <li>เอกสารสินค้า</li>
          </ul>
          <p>หากไม่ทราบรุ่น สามารถส่งรูปตัวเครื่องและป้าย Model มาช่วยตรวจข้อมูลเบื้องต้นได้</p>
        </div>

        <div class="comm-card">
          <h2>สภาพเสียงเป็นปัจจัยสำคัญ</h2>
          <p>ก่อนขายควรทดลองเปิดเพลงหรือเสียงที่คุ้นเคยแล้วฟังหลายระดับเสียง</p>
          <p>สังเกตว่า:</p>
          <ul>
            <li>เสียงออกครบ</li>
            <li>ไม่มีเสียงแตกผิดปกติ</li>
            <li>ไม่มีเสียงซ่า</li>
            <li>ไม่มีเสียงกระพือ</li>
            <li>ไม่มีอาการเสียงขาด</li>
            <li>ซ้ายและขวาทำงานตามประเภทของลำโพง</li>
            <li>Bass ไม่ผิดปกติอย่างเห็นได้ชัด</li>
          </ul>
          <p>หากพบอาการ ควรแจ้งตามจริง</p>
          <p>ไม่จำเป็นต้องเปิดเสียงดังสุดเพื่อทดสอบ เพราะอาจเพิ่มความเสี่ยงให้กับลำโพงที่มีปัญหาอยู่แล้ว</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: AUDIO DISTORTION & BATTERY -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>เสียงแตกกับเสียงจากไฟล์เพลงควรแยกอย่างไร</h2>
          <p>หากได้ยินเสียงผิดปกติ ควรลองเปลี่ยน:</p>
          <ul>
            <li>เพลง</li>
            <li>อุปกรณ์ต้นทาง</li>
            <li>ระดับ Volume</li>
            <li>การเชื่อมต่อ</li>
          </ul>
          <p>เพื่อช่วยแยกว่าอาการมาจากลำโพงหรือแหล่งสัญญาณ</p>
          <p>หากเสียงแตกเกิดเฉพาะบางระดับหรือบางย่านเสียง ควรแจ้งรายละเอียดนี้ประกอบการประเมิน</p>
          <p>ไม่จำเป็นต้องแกะเครื่องเพื่อตรวจดอกลำโพงก่อนสอบถามราคา</p>
        </div>

        <div class="comm-card">
          <h2>Battery มีผลต่อราคาลำโพงไหม</h2>
          <p>มีผลมากสำหรับลำโพงพกพา</p>
          <p>ควรแจ้งอาการใช้งานจริง เช่น</p>
          <ul>
            <li>ใช้งาน Battery ได้ตามปกติ</li>
            <li>Battery หมดเร็ว</li>
            <li>ต้องเสียบสายตลอด</li>
            <li>ชาร์จไม่เต็ม</li>
            <li>ชาร์จไม่เข้า</li>
            <li>เปิดแล้วดับ</li>
            <li>Battery เคยเปลี่ยน</li>
          </ul>
          <p>หากไม่ทราบระยะเวลาการใช้งานแน่นอน ไม่จำเป็นต้องคาดเดาเป็นจำนวนชั่วโมง</p>
          <p>สามารถแจ้งจากประสบการณ์ใช้งานจริงได้</p>

          <h2 style="margin-top: 1.5rem;">ชาร์จไม่เข้ายังประเมินได้ไหม</h2>
          <p>บางกรณีสามารถส่งมาประเมินตามสภาพได้</p>
          <p>ควรแจ้ง:</p>
          <ul>
            <li>รุ่น</li>
            <li>อาการ</li>
            <li>ใช้สายหรือ Adapter อะไร</li>
            <li>มีไฟสถานะหรือไม่</li>
            <li>เปิดเครื่องได้หรือไม่</li>
            <li>Battery เคยมีอาการมาก่อนหรือไม่</li>
            <li>เคยซ่อมหรือไม่</li>
          </ul>
          <p>ปัญหาชาร์จอาจเกิดจาก Battery, Port, สาย, Adapter หรือระบบภายใน จึงไม่ควรระบุสาเหตุแน่นอนหากยังไม่ได้ตรวจ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: BLUETOOTH, WI-FI, BUTTONS & PORTS -->
  <section class="commercial-section section-surface">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Bluetooth ต้องทดสอบอะไร</h2>
          <p>สำหรับลำโพง Bluetooth ควรทดลอง:</p>
          <ol>
            <li>เปิด Bluetooth</li>
            <li>ค้นหาชื่ออุปกรณ์</li>
            <li>Pair กับโทรศัพท์หรืออุปกรณ์ที่ใช้งานได้</li>
            <li>เปิดเสียง</li>
            <li>ทดลองใช้งานระยะใกล้ตามปกติ</li>
            <li>Disconnect และเชื่อมใหม่ถ้าต้องการตรวจเพิ่ม</li>
          </ol>
          <p>ควรแจ้งหากพบ:</p>
          <ul>
            <li>หาอุปกรณ์ไม่เจอ</li>
            <li>Pair ไม่ได้</li>
            <li>เสียงขาด</li>
            <li>หลุดการเชื่อมต่อ</li>
            <li>เชื่อมได้แต่ไม่มีเสียง</li>
          </ul>

          <h2 style="margin-top: 1.5rem;">Wi-Fi หรือ Application มีผลไหม</h2>
          <p>ลำโพงบางรุ่นรองรับ Application, Wi-Fi หรือฟังก์ชันเฉพาะของผู้ผลิต</p>
          <p>หากฟังก์ชันเหล่านี้เป็นส่วนสำคัญของรุ่นและสามารถทดสอบได้ ควรแจ้งว่ายังใช้งานได้หรือไม่</p>
          <p>ไม่จำเป็นต้องส่ง:</p>
          <ul>
            <li>Password Wi-Fi</li>
            <li>Password บัญชี</li>
            <li>OTP</li>
            <li>ข้อมูลบัญชีส่วนตัว</li>
          </ul>
          <p>เพื่อใช้ในการเช็กราคา</p>
          <p>เจ้าของสามารถออกจากบัญชีหรือ Reset อุปกรณ์เมื่อพร้อมส่งมอบจริงได้ตามความเหมาะสมของรุ่น</p>
        </div>

        <div class="comm-card">
          <h2>ปุ่มและระบบควบคุมควรตรวจ</h2>
          <p>ควรลองปุ่มหรือส่วนควบคุมที่มี เช่น</p>
          <ul>
            <li>Power</li>
            <li>Volume</li>
            <li>Bluetooth</li>
            <li>Play/Pause</li>
            <li>Source</li>
            <li>Bass/Treble ถ้ามี</li>
            <li>ปุ่มเชื่อมลำโพงหลายตัว</li>
            <li>ปุ่ม Function อื่นตามรุ่น</li>
          </ul>
          <p>หากปุ่มกดยาก ค้าง หรือไม่ตอบสนองควรแจ้ง</p>

          <h2 style="margin-top: 1.5rem;">พอร์ตต่าง ๆ ต้องตรวจไหม</h2>
          <p>ขึ้นอยู่กับรุ่น</p>
          <p>ตัวอย่าง:</p>
          <ul>
            <li>USB-C</li>
            <li>Micro USB</li>
            <li>AUX</li>
            <li>USB</li>
            <li>Optical</li>
            <li>HDMI</li>
            <li>Power Input</li>
            <li>ช่อง Microphone</li>
            <li>ช่อง Guitar ในลำโพงบางประเภท</li>
          </ul>
          <p>ควรตรวจพอร์ตที่ใช้งานเป็นประจำ</p>
          <p>หากพอร์ตใดเสียหรือหลวมควรแจ้งตามจริง</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: ADAPTER, BODY, DROPS, WATER & REPAIRS -->
  <section class="commercial-section section-white">
    <div class="container">
      <div class="grid-2">
        <div class="comm-card">
          <h2>Adapter และสายไฟมีผลหรือไม่</h2>
          <p>มีผลต่อความครบและความพร้อมใช้งาน</p>
