---
import { getDisplayLine, getLineUrl, getDisplayPhone, getPhoneUrl } from '../config/business';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'หน้าแรก', path: '/' },
  { name: 'รายการรับซื้อสินค้า', path: '/รับซื้อ/' },
  { name: 'รับซื้อโน๊ตบุ๊ค', path: '/รับซื้อโน๊ตบุ๊ค/' },
  { name: 'รับซื้อคอม', path: '/รับซื้อคอม/' },
  { name: 'รับซื้อ MacBook', path: '/รับซื้อแมคบุ๊ค/' },
  { name: 'รับซื้อ iPhone', path: '/รับซื้อไอโฟน/' },
  { name: 'รับซื้อ iPad', path: '/รับซื้อไอแพด/' },
  { name: 'รับซื้อกล้อง', path: '/รับซื้อกล้อง/' }
];
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="เรารับซื้อ.com ศูนย์รับซื้อสินค้าไอทีมือสอง หน้าแรก">
      <div class="logo-text-group">
        <div class="logo-main">
          <span class="logo-prefix">เรารับซื้อ</span><span class="logo-dotcom">.com</span>
        </div>
        <span class="logo-tagline">ศูนย์รับซื้อสินค้าไอทีมือสอง</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="เมนูหลัก">
      <ul class="nav-list">
        {navItems.map(item => (
          <li>
            <a
              href={item.path}
              class={`nav-link ${currentPath === item.path ? 'active' : ''}`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop Header Action Buttons -->
    <div class="header-actions">
      <a
        href={getLineUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="header-line-btn"
        aria-label={`LINE ${getDisplayLine()} แอดไลน์เพื่อส่งรูปและเช็กราคา`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
        </svg>
        <span>LINE {getDisplayLine()}</span>
      </a>

      <a
        href={getPhoneUrl()}
        class="header-phone-btn"
        aria-label={`โทร ${getDisplayPhone()} ปรึกษาราคาเบื้องต้น`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>โทร {getDisplayPhone()}</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="เปิดเมนูนำทาง"
      >
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown / Drawer Navigation -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <div class="container mobile-drawer-inner">
      <nav aria-label="เมนูมือถือ">
        <ul class="mobile-nav-list">
          {navItems.map(item => (
            <li>
              <a
                href={item.path}
                class={`mobile-nav-link ${currentPath === item.path ? 'active' : ''}`}
              >
                <span>{item.name}</span>
                <span class="arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-contacts">
        <a
          href={getLineUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-line"
          style="width: 100%; justify-content: center;"
        >
          <span>LINE {getDisplayLine()}</span>
        </a>
        <a
          href={getPhoneUrl()}
          class="btn btn-phone"
          style="width: 100%; justify-content: center;"
        >
          <span>โทร {getDisplayPhone()}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function() {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        drawer.hidden = true;
        toggle.setAttribute('aria-label', 'เปิดเมนูนำทาง');
      } else {
        drawer.hidden = false;
        toggle.setAttribute('aria-label', 'ปิดเมนูนำทาง');
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 2px 14px rgb(6 27 53 / 0.06);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1.25rem;
  }

  /* Brand Logo */
  .brand-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-main {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
  }

  .logo-prefix {
    color: var(--navy-950);
  }

  .logo-dotcom {
    color: #c2410c;
    font-weight: 900;
    margin-left: 1px;
  }

  .logo-tagline {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 1px;
  }

  /* Desktop Navigation */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.65rem;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--navy-900);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #9a3412;
    background-color: var(--surface);
  }

  .nav-link.active {
    color: #9a3412;
    background-color: #ffedd5;
    font-weight: 700;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .header-line-btn {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    min-height: 44px;
    background-color: var(--success-bg);
    color: #065f46;
    border: 1px solid var(--success-border);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .header-line-btn:hover {
    background-color: #d1fae5;
    transform: translateY(-1px);
    color: #047857;
  }

  .header-phone-btn {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.05rem;
    min-height: 44px;
    background-color: #c2410c;
    color: #ffffff;
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgb(194 65 12 / 0.25);
    transition: background-color 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .header-phone-btn:hover {
    background-color: #9a3412;
    transform: translateY(-1px);
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .header-phone-btn {
      display: inline-flex;
    }
  }

  @media (min-width: 960px) {
    .header-line-btn {
      display: inline-flex;
    }
  }

  .mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-height: 44px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--navy-950);
    cursor: pointer;
    padding: 0;
  }

  .mobile-toggle:focus-visible {
    outline: 3px solid var(--orange-400);
    outline-offset: 2px;
  }

  .icon-close {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    background-color: #ffffff;
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    max-height: calc(100vh - var(--header-height));
    overflow-y: auto;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }

  .mobile-drawer-inner {
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0 0 1.25rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--surface);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: var(--orange-50);
    color: var(--orange-600);
  }

  .mobile-nav-link .arrow {
    color: var(--text-subtle);
    font-size: 1.2rem;
  }

  .mobile-drawer-contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
    .mobile-drawer {
      display: none !important;
    }
  }
</style>
