---
import { getDisplayPhone, getPhoneUrl, getDisplayLine, getLineUrl } from '../config/business';
---

<nav class="mobile-contact-bar" aria-label="ติดต่อและประเมินราคา">
  <div class="mobile-bar-inner">
    <a
      href={getLineUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="bar-btn btn-line"
      aria-label={`LINE ${getDisplayLine()} แอดไลน์เพื่อส่งรูปและเช็กราคา`}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
      </svg>
      <span class="bar-labels"><strong>ส่งรูปเช็กราคา</strong><small>LINE {getDisplayLine()}</small></span>
    </a>

    <a
      href={getPhoneUrl()}
      class="bar-btn btn-phone"
      aria-label={`โทร ${getDisplayPhone()} ปรึกษาและเช็กราคา`}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span class="bar-labels"><strong>โทรสอบถาม</strong><small>{getDisplayPhone()}</small></span>
    </a>
  </div>
</nav>

<style>
  .mobile-contact-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--border);
    box-shadow: 0 -4px 20px rgb(15 23 42 / 0.1);
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
  }

  .mobile-bar-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: 0.5rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .bar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 56px;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1;
    white-space: normal;
    min-width: 0;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .bar-labels {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    align-items: flex-start;
    line-height: 1.18;
  }

  .bar-labels strong {
    font-size: 0.85rem;
    font-weight: 850;
  }

  .bar-labels small {
    font-size: 0.72rem;
    line-height: 1.2;
    opacity: 0.96;
    font-weight: 650;
  }

  .bar-btn svg { flex-shrink: 0; }

  @media (max-width: 360px) {
    .mobile-bar-inner { grid-template-columns: minmax(0, 1.2fr) minmax(0, .9fr); gap: .35rem; }
    .bar-btn { padding: .3rem .25rem; gap: .25rem; }
    .bar-labels strong { font-size: .77rem; }
    .bar-labels small { font-size: .67rem; }
    .bar-btn svg { width: 16px; }
  }

  .bar-btn:active {
    transform: scale(0.98);
  }

  .bar-btn:focus-visible {
    outline: 3px solid var(--orange-400);
    outline-offset: 2px;
  }

  .btn-line {
    background-color: #047857;
    color: #ffffff;
    box-shadow: 0 2px 8px rgb(4 120 87 / 0.25);
  }

  .btn-phone {
    background-color: #c2410c;
    color: #ffffff;
    box-shadow: 0 2px 8px rgb(194 65 12 / 0.25);
  }

  @media (min-width: 768px) {
    .mobile-contact-bar {
      display: none;
    }
  }
</style>
