---
import { getLineUrl, getDisplayLine, getPhoneUrl, getDisplayPhone } from '../config/business';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
}

const {
  title = 'สนใจส่งรูปประเมินราคาเบื้องต้นได้ฟรี',
  subtitle = 'แจ้งรุ่น สเปก หรือส่งรูปภาพสินค้าเพื่อรับการประเมินราคาที่เป็นธรรมและรวดเร็วทาง LINE',
  badge = 'ติดต่อประเมินราคา'
} = Astro.props;
---

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      {badge && <span class="badge badge-accent cta-badge">{badge}</span>}
      <h2 class="cta-title">{title}</h2>
      <p class="cta-subtitle">{subtitle}</p>

      <div class="cta-buttons">
        <a
          href={getLineUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-cta-line"
          aria-label={`LINE ${getDisplayLine()} แอดไลน์เพื่อส่งรูปและเช็กราคา`}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 10.3c0-4.6-4.9-8.3-10.9-8.3C7.1 2 2.2 5.7 2.2 10.3c0 4.1 3.6 7.6 8.6 8.2.3.1.8.2.9.6.1.4.1 1 .1 1.4 0 .4-.2 1.5-.2 1.5s-.1.6.3.3c.4-.3 2.5-1.5 3.5-2.2.5-.3 1.1-.5 1.7-.5 4.3 0 7-3.7 7-7.3z"/>
          </svg>
          <span>แอด LINE: {getDisplayLine()}</span>
        </a>
        <a
          href={getPhoneUrl()}
          class="btn btn-cta-phone"
          aria-label={`โทร ${getDisplayPhone()} ปรึกษาและเช็กราคา`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>โทร {getDisplayPhone()}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 2.5rem 0;
  }

  .cta-box {
    background-color: var(--navy-950);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    box-shadow: var(--shadow-md);
    border: 1px solid #1e293b;
  }

  @media (min-width: 640px) {
    .cta-box {
      padding: 3rem 2rem;
    }
  }

  .cta-badge {
    margin-bottom: 1rem;
    background-color: #0b315f;
    color: #fdba74;
    border-color: #1e40af;
  }

  .cta-title {
    color: #ffffff;
    font-size: 1.65rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 2rem;
    }
  }

  .cta-subtitle {
    color: #cbd5e1;
    font-size: 1rem;
    max-width: 620px;
    margin: 0 auto 1.75rem auto;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-cta-line {
    background-color: #047857;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    font-size: 1rem;
    box-shadow: 0 4px 14px rgb(4 120 87 / 0.3);
  }

  .btn-cta-line:hover {
    background-color: #065f46;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .btn-cta-phone {
    background-color: #c2410c;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    font-size: 1rem;
    box-shadow: 0 4px 14px rgb(194 65 12 / 0.3);
  }

  .btn-cta-phone:hover {
    background-color: #9a3412;
    color: #ffffff;
    transform: translateY(-1px);
  }
</style>
