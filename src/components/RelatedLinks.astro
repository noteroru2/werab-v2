---
import type { InternalLinkItem } from '../lib/seo/internal-links';

interface Props {
  clusterLinks: InternalLinkItem[];
  parentLink?: InternalLinkItem;
  guideLinks?: InternalLinkItem[];
  title?: string;
}

const {
  clusterLinks,
  parentLink,
  guideLinks,
  title = 'บริการและข้อมูลที่เกี่ยวข้อง'
} = Astro.props;

const hasLinks = (parentLink || (clusterLinks && clusterLinks.length > 0) || (guideLinks && guideLinks.length > 0));
---

{hasLinks && (
  <div class="related-links-wrap">
    <h3 class="related-title">{title}</h3>

    <div class="links-sections-grid">
      {parentLink && (
        <div class="link-group">
          <span class="group-label">หมวดหมู่หลัก:</span>
          <a href={parentLink.path} class="parent-chip">
            <span aria-hidden="true">↑</span>
            <span>{parentLink.title}</span>
          </a>
        </div>
      )}

      {clusterLinks && clusterLinks.length > 0 && (
        <div class="link-group">
          <span class="group-label">บริการในกลุ่มเดียวกัน:</span>
          <div class="chips-flex">
            {clusterLinks.map(link => (
              <a href={link.path} class="link-chip">
                <span>{link.title}</span>
                {link.badge && <span class="chip-badge">{link.badge}</span>}
              </a>
            ))}
          </div>
        </div>
      )}

      {guideLinks && guideLinks.length > 0 && (
        <div class="link-group">
          <span class="group-label">คำแนะนำและราคา:</span>
          <div class="chips-flex">
            {guideLinks.map(guide => (
              <a href={guide.path} class="link-chip guide-chip">
                <span>{guide.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
)}

<style>
  .related-links-wrap {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-top: 3rem;
  }

  .related-title {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .links-sections-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .group-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .chips-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .link-chip, .parent-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-main);
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .parent-chip {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    font-weight: 600;
    align-self: flex-start;
  }

  .parent-chip:hover {
    background-color: var(--color-primary-light);
    color: #ffffff;
  }

  .link-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .chip-badge {
    font-size: 0.75rem;
    background-color: var(--color-accent-light);
    color: var(--color-accent-hover);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
</style>
