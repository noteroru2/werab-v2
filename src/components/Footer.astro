---
import { BUSINESS_FACTS, getDisplayPhone, getPhoneUrl, getDisplayLine, getLineUrl } from '../config/business';

const categories = [
  { name: 'รับซื้อสินค้าไอที', path: '/รับซื้อ/' },
  { name: 'รับซื้อโน๊ตบุ๊ค', path: '/รับซื้อโน๊ตบุ๊ค/' },
  { name: 'รับซื้อคอม', path: '/รับซื้อคอม/' },
  { name: 'รับซื้อ MacBook', path: '/รับซื้อแมคบุ๊ค/' },
  { name: 'รับซื้อ iPhone', path: '/รับซื้อไอโฟน/' },
  { name: 'รับซื้อ iPad', path: '/รับซื้อไอแพด/' },
  { name: 'รับซื้อกล้อง', path: '/รับซื้อกล้อง/' }
];

const guides: { name: string; path: string }[] = [
  { name: 'เช็กราคาก่อนขาย', path: '/เช็กราคาก่อนขาย/' },
  { name: 'มาตรฐานการประเมิน', path: '/ความน่าเชื่อถือ/' },
  { name: 'เกี่ยวกับเรา', path: '/เกี่ยวกับเรา/' },
  { name: 'ติดต่อส่งรูปประเมิน', path: '/contact/' }
];
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Column 1: Brand Info & Positioning -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="logo-main">
            <span class="logo-prefix">เรารับซื้อ</span><span class="logo-dotcom">.com</span>
          </div>
          <span class="logo-tagline">ศูนย์รับซื้อสินค้าไอทีมือสอง</span>
        </div>
        <p class="footer-positioning">
          <strong>ก่อนขาย เช็กราคา เข้าใจสภาพ แล้วค่อยตัดสินใจ</strong>
        </p>
        <p class="footer-desc">
          ข้อมูลและบริการรับประเมินสินค้าไอทีมือสองตามรุ่น สเปก สภาพ และอุปกรณ์ เพื่อให้ผู้ขายเช็กราคาเบื้องต้นก่อนตัดสินใจ
        </p>
        <div class="footer-contact-cards">
          <a href={getLineUrl()} target="_blank" rel="noopener noreferrer" class="contact-chip line-chip">
            <span class="chip-label">LINE:</span>
            <span class="chip-value">{getDisplayLine()}</span>
          </a>
          <a href={getPhoneUrl()} class="contact-chip phone-chip">
            <span class="chip-label">โทร:</span>
            <span class="chip-value">{getDisplayPhone()}</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Categories -->
      <div class="footer-col">
        <h3 class="footer-heading">หมวดสินค้าหลัก</h3>
        <ul class="footer-links">
          {categories.map(c => (
            <li><a href={c.path}>{c.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Seller Guides -->
      <div class="footer-col">
        <h3 class="footer-heading">ข้อมูลสำหรับผู้ขาย</h3>
        <ul class="footer-links">
          {guides.map(g => (
            <li><a href={g.path}>{g.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Privacy & Notice -->
      <div class="footer-col">
        <h3 class="footer-heading">คำแนะนำและความเป็นส่วนตัว</h3>
        <div class="privacy-notice-box">
          <p>
            ไม่ควรส่ง Password, OTP หรือข้อมูลบัญชีส่วนตัวที่ไม่จำเป็นเพื่อขอราคาประเมินเบื้องต้น
          </p>
          <p style="margin-top: 0.75rem;">
            ก่อนส่งมอบสินค้า เจ้าของควรสำรองข้อมูลและจัดการบัญชีของตนเองให้เรียบร้อย
          </p>
        </div>
      </div>
    </div>

    <div class="footer-policy-links" aria-label="ข้อมูลบริการและนโยบาย">
      <a href="/เกี่ยวกับเรา/">เกี่ยวกับเรา</a>
      <a href="/ความน่าเชื่อถือ/">มาตรฐานการประเมิน</a>
      <a href="/terms/">เงื่อนไขบริการ</a>
      <a href="/privacy-policy/">ความเป็นส่วนตัว</a>
      <a href="/contact/">ติดต่อเรา</a>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © 2026 {BUSINESS_FACTS.VERIFIED.brandName}
      </p>
      <p class="domain-info">
        โดเมนหลัก: <a href={BUSINESS_FACTS.VERIFIED.siteUrl}>{BUSINESS_FACTS.VERIFIED.displayDomain}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--navy-950);
    color: #e2e8f0;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    margin-top: auto;
    border-top: 1px solid #1e293b;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
      gap: 2.5rem;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .footer-brand .logo-main {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
  }

  .footer-brand .logo-prefix {
    color: #ffffff;
  }

  .footer-brand .logo-dotcom {
    color: var(--orange-500);
    font-weight: 900;
    margin-left: 1px;
  }

  .footer-brand .logo-tagline {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
    margin-top: 2px;
  }

  .footer-positioning {
    color: #fed7aa;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .footer-positioning strong {
    color: #fdba74;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .footer-contact-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .line-chip {
    background-color: rgba(6, 199, 85, 0.2);
    color: #86efac;
    border: 1px solid rgba(6, 199, 85, 0.4);
  }

  .line-chip:hover {
    background-color: rgba(6, 199, 85, 0.3);
    color: #ffffff;
  }

  .phone-chip {
    background-color: rgba(255, 100, 18, 0.2);
    color: #fed7aa;
    border: 1px solid rgba(255, 100, 18, 0.4);
  }

  .phone-chip:hover {
    background-color: rgba(255, 100, 18, 0.3);
    color: #ffffff;
  }

  .chip-label {
    font-weight: 700;
  }

  .chip-value {
    font-weight: 600;
  }

  .footer-heading {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 2px;
    background-color: var(--orange-500);
    border-radius: 2px;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: #cbd5e1;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--orange-400);
    transform: translateX(2px);
  }

  .privacy-notice-box {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    padding: 1rem;
    font-size: 0.82rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .privacy-notice-box p {
    margin-bottom: 0;
    color: #cbd5e1;
    font-size: 0.82rem;
  }


  .footer-policy-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem 1rem;
    padding: 1rem 0;
    margin-bottom: 1rem;
    border-top: 1px solid rgba(255,255,255,.1);
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .footer-policy-links a {
    color: #cbd5e1;
    font-size: .82rem;
    text-decoration: none;
  }

  .footer-policy-links a:hover { color: var(--orange-400); }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid #1e293b;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .footer-bottom p {
    margin-bottom: 0;
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .domain-info a {
    color: #cbd5e1;
    text-decoration: none;
  }

  .domain-info a:hover {
    color: var(--orange-400);
  }
</style>
